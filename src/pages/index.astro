---
// Úvod: výber mesta. Každé mesto má vlastné stránky pod /<mesto>/.
import Base from '../layouts/Base.astro';
import { MESTA } from '../mesta';
import obyv from '../../data/obyvatelstvo-bratislava.json';

const rokBa = obyv.mesto ? Object.keys((obyv.mesto as any).roky).sort().pop()! : '';
const pocetBa = rokBa ? (obyv.mesto as any).roky[rokBa] : null;
const fmt = (n: number) => n.toLocaleString('sk-SK');
const aktivne = MESTA.filter((m) => m.aktivne);
const pripravujeme = MESTA.filter((m) => !m.aktivne);
---
<Base title="mestovčíslach.sk – slovenské mestá v číslach" description="Otvorené dáta o slovenských mestách prehľadne a so zdrojmi: obyvatelia, voľby, peniaze, doprava, výstavba a živé údaje.">
  <section class="hero">
    <p class="kicker">Otvorené dáta</p>
    <h1>Slovenské mestá v číslach</h1>
    <p class="lead">Obyvatelia, voľby, rozpočet, zmluvy, doprava, výstavba aj živé údaje – prehľadne, so zdrojmi a bez registrácie. Vyberte si mesto.</p>
  </section>

  <ul class="mesta">
    {aktivne.map((m) => (
      <li>
        <a class="mesto card aktivne" href={`/${m.slug}`}>
          <span class="m-kraj">{m.kraj}</span>
          <span class="m-nazov" translate="no">{m.nazov}</span>
          {m.slug === 'bratislava' && pocetBa && <span class="m-cislo"><strong>{fmt(pocetBa)}</strong> obyvateľov ({rokBa})</span>}
          {m.popis && <span class="m-popis">{m.popis}</span>}
          <span class="m-dalej">Otvoriť <span aria-hidden="true">→</span></span>
        </a>
      </li>
    ))}
    {pripravujeme.map((m) => (
      <li>
        <div class="mesto card" aria-disabled="true">
          <span class="m-kraj">{m.kraj}</span>
          <span class="m-nazov" translate="no">{m.nazov}</span>
          <span class="m-stitok">Pripravujeme</span>
        </div>
      </li>
    ))}
  </ul>

  <section class="card info">
    <h2>Ako to funguje</h2>
    <p>Údaje berieme z verejných zdrojov – zo Štatistického úradu, z Centrálneho registra zmlúv, z Enviroportálu, od SHMÚ, z otvorených dát miest a ďalších. Pri každom čísle je uvedený zdroj. Postupne pribúdajú všetky krajské mestá; pri každom uvidíte, ktoré údaje sú pre neho dostupné.</p>
  </section>
</Base>

<style>
  .hero { padding: 48px 0 24px; }
  .kicker { color: var(--accent); font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; font-size: 0.75rem; margin: 0; }
  h1 { font-size: clamp(2.2rem, 7vw, 3.4rem); line-height: 1.05; letter-spacing: -0.035em; margin: 8px 0 12px; }
  .lead { color: var(--muted); font-size: 1.15rem; max-width: 40em; margin: 0; }
  .mesta { list-style: none; padding: 0; margin: 8px 0 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(230px, 1fr)); gap: 14px; }
  .mesto { display: flex; flex-direction: column; gap: 4px; height: 100%; padding: 18px; text-decoration: none; color: var(--text); }
  .mesto.aktivne { border: 2px solid var(--accent); transition: transform 0.15s; }
  .mesto.aktivne:hover { transform: translateY(-2px); }
  @media (prefers-reduced-motion: reduce) { .mesto.aktivne, .mesto.aktivne:hover { transition: none; transform: none; } }
  .mesto[aria-disabled='true'] { color: var(--muted); }
  .m-kraj { font-size: 0.75rem; color: var(--muted); text-transform: uppercase; letter-spacing: 0.05em; }
  .m-nazov { font-size: 1.45rem; font-weight: 800; letter-spacing: -0.02em; }
  .m-cislo { font-size: 0.9rem; color: var(--muted); }
  .m-cislo strong { color: var(--text); }
  .m-popis { font-size: 0.85rem; color: var(--muted); }
  .m-dalej { margin-top: auto; padding-top: 10px; font-weight: 700; color: var(--accent); }
  .m-stitok { margin-top: auto; align-self: flex-start; font-size: 0.75rem; padding: 2px 9px; border-radius: 999px; background: var(--line); color: var(--muted); }
  .info { margin-top: 24px; }
  .info h2 { font-size: 1.15rem; margin: 0 0 6px; }
  .info p { margin: 0; max-width: 52em; color: var(--muted); }
</style>
