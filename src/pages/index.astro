---
// Úvod: výber mesta. Každé mesto má vlastné stránky pod /<mesto>/.
import Base from '../layouts/Base.astro';
import { webSite } from '../lib/seo';
import { MESTA } from '../mesta';
import { foto } from '../lib/fotky';
import fs from 'node:fs';
import path from 'node:path';

const subor = path.join(process.cwd(), 'data', 'mesta', 'porovnanie.json');
const por: any[] = fs.existsSync(subor) ? JSON.parse(fs.readFileSync(subor, 'utf-8')).mesta : [];
const udaje = (slug: string) => por.find((p) => p.slug === slug);
const fmt = (n: number) => n.toLocaleString('sk-SK');
const znam = (n: number) => `${n > 0 ? '+' : n < 0 ? '−' : ''}${Math.abs(n).toLocaleString('sk-SK', { maximumFractionDigits: 1 })} %`;
const aktivne = MESTA.filter((m) => m.aktivne);
const pripravujeme = MESTA.filter((m) => !m.aktivne);
---
<Base title="mestovčíslach.sk – slovenské mestá v číslach" description="Otvorené dáta o slovenských mestách prehľadne a so zdrojmi: obyvatelia, voľby, peniaze, doprava, výstavba a živé údaje." jsonld={webSite()}>
  <section class="hero">
    <p class="kicker">Otvorené dáta</p>
    <h1>Slovenské mestá v číslach</h1>
    <p class="lead">Obyvatelia, voľby, rozpočet, zmluvy, doprava, výstavba aj živé údaje – prehľadne, so zdrojmi a bez registrácie. Vyberte si mesto.</p>
  </section>

  <ul class="mesta">
    {aktivne.map((m) => (
      <li>
        <a class={`mesto card aktivne${m.plne ? ' plne' : ''}`} href={`/${m.slug}`}>
          {foto(m.slug) && <span class="m-foto-obal"><img class="m-foto" src={foto(m.slug)!.src} srcset={foto(m.slug)!.srcset} sizes="(max-width: 600px) 100vw, 300px" alt="" loading="lazy" decoding="async" width="800" height="450" /></span>}
          <span class="m-kraj">{m.kraj}</span>
          <span class="m-nazov" translate="no">{m.nazov}</span>
          {udaje(m.slug) && <span class="m-cislo"><strong>{fmt(udaje(m.slug).obyvatelia)}</strong> obyvateľov · {znam(udaje(m.slug).zmena10)} za 10 rokov</span>}
          <span class="m-popis">{m.popis ?? 'Obyvatelia, voľby, práca, bývanie a stavby z celoštátnych zdrojov'}</span>
          <span class="m-dalej">Otvoriť <span aria-hidden="true">→</span></span>
        </a>
      </li>
    ))}
    {pripravujeme.map((m) => (
      <li>
        <div class="mesto card" aria-disabled="true">
          <span class="m-kraj">{m.kraj}</span>
          <span class="m-nazov" translate="no">{m.nazov}</span>
          <span class="m-stitok">Pripravujeme</span>
        </div>
      </li>
    ))}
  </ul>

  <a class="card porovnaj" href="/porovnanie"><strong>Porovnanie krajských miest</strong><span>Obyvatelia, vek, vzdelanie, nezamestnanosť, účasť vo voľbách, výstavba a ceny bývania vedľa seba</span><span class="m-dalej">Porovnať <span aria-hidden="true">→</span></span></a>

  <section class="card info">
    <h2>Ako to funguje</h2>
    <p>Údaje berieme z verejných zdrojov – zo Štatistického úradu, z Centrálneho registra zmlúv, z Enviroportálu, od SHMÚ, z otvorených dát miest a ďalších. Pri každom čísle je uvedený zdroj. Bratislava má najpodrobnejšie údaje vďaka bohatým otvoreným dátam mesta; pri ostatných krajských mestách sú zatiaľ celoštátne zdroje a mestské údaje budú pribúdať.</p>
  </section>

  <p class="kredity">Fotografie miest (farebne upravené): Wikimedia Commons – {aktivne.map((m, i) => { const f = foto(m.slug); return f && <>{i ? '; ' : ''}<span translate="no">{m.nazov}</span>: <a href={f.zdroj} rel="noopener">{f.autor}</a> ({f.licenciaUrl ? <a href={f.licenciaUrl} rel="noopener license">{f.licencia}</a> : f.licencia})</>; })}.</p>
</Base>

<style>
  .hero { padding: 48px 0 24px; }
  .kicker { color: var(--accent); font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; font-size: 0.75rem; margin: 0; }
  h1 { font-size: clamp(2.2rem, 7vw, 3.4rem); line-height: 1.05; letter-spacing: -0.035em; margin: 8px 0 12px; }
  .lead { color: var(--muted); font-size: 1.15rem; max-width: 40em; margin: 0; }
  .mesta { list-style: none; padding: 0; margin: 8px 0 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(230px, 1fr)); gap: 14px; }
  .mesto { display: flex; flex-direction: column; gap: 4px; height: 100%; padding: 18px; text-decoration: none; color: var(--text); overflow: hidden; }
  .m-foto-obal { position: relative; display: block; width: calc(100% + 36px); margin: -18px -18px 10px; aspect-ratio: 16 / 9; overflow: hidden; background: var(--line); isolation: isolate; }
  .m-foto-obal::after { content: ''; position: absolute; inset: 0; pointer-events: none; background: linear-gradient(115deg, rgba(19, 33, 63, 0.45), rgba(179, 18, 46, 0.25)); mix-blend-mode: multiply; transition: opacity 0.3s; }
  .m-foto { display: block; width: 100%; height: 100%; max-width: none; object-fit: cover; filter: saturate(0.65) contrast(1.18) brightness(1.02); transition: transform 0.3s, filter 0.3s; }
  /* pri prejdení myšou fotka ožije – skutočné farby */
  .mesto.aktivne:hover .m-foto { transform: scale(1.03); filter: none; }
  .mesto.aktivne:hover .m-foto-obal::after { opacity: 0; }
  .kredity { margin: 18px 0 0; font-size: 0.75rem; color: var(--muted); }
  .kredity a { color: inherit; }
  @media (prefers-reduced-motion: reduce) { .m-foto, .m-foto-obal::after { transition: none; } }
  .mesto.aktivne { transition: transform 0.15s, border-color 0.15s; }
  .mesto.aktivne:hover { border-color: var(--accent); }
  .mesto.plne { border: 2px solid var(--accent); }
  .porovnaj { display: flex; flex-direction: column; gap: 4px; margin-top: 14px; text-decoration: none; color: var(--text); padding: 18px; }
  .porovnaj strong { font-size: 1.2rem; }
  .porovnaj span { color: var(--muted); }
  .porovnaj .m-dalej { color: var(--accent); }
  .porovnaj:hover { border-color: var(--accent); }
  .mesto.aktivne:hover { transform: translateY(-2px); }
  @media (prefers-reduced-motion: reduce) { .mesto.aktivne, .mesto.aktivne:hover { transition: none; transform: none; } }
  .mesto[aria-disabled='true'] { color: var(--muted); }
  .m-kraj { font-size: 0.75rem; color: var(--muted); text-transform: uppercase; letter-spacing: 0.05em; }
  .m-nazov { font-size: 1.45rem; font-weight: 800; letter-spacing: -0.02em; }
  .m-cislo { font-size: 0.9rem; color: var(--muted); }
  .m-cislo strong { color: var(--text); }
  .m-popis { font-size: 0.85rem; color: var(--muted); }
  .m-dalej { margin-top: auto; padding-top: 10px; font-weight: 700; color: var(--accent); }
  .m-stitok { margin-top: auto; align-self: flex-start; font-size: 0.75rem; padding: 2px 9px; border-radius: 999px; background: var(--line); color: var(--muted); }
  .info { margin-top: 24px; }
  .info h2 { font-size: 1.15rem; margin: 0 0 6px; }
  .info p { margin: 0; max-width: 52em; color: var(--muted); }
</style>
