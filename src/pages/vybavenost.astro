---
import fs from 'node:fs';
import path from 'node:path';
import Base from '../layouts/Base.astro';

const nacitaj = (subor: string) => {
  const p = path.join(process.cwd(), 'data', subor);
  return fs.existsSync(p) ? JSON.parse(fs.readFileSync(p, 'utf-8')) : null;
};
const skoly = nacitaj('skoly-bratislava.json');
const rajon = nacitaj('rajonizacia-bratislava.json');
const iedu = nacitaj('skoly-iedu.json');
const soc = nacitaj('socialne-bratislava.json');
const pamReg = nacitaj('pamiatky-register.json');
const zsMc = iedu ? Object.entries<any>(iedu.mestske_casti).map(([mc, t]) => ({ mc, zs: t.zs?.ziakov ?? 0, zsSkol: t.zs?.skol ?? 0, ms: t.ms?.ziakov ?? 0, ss: t.ss?.ziakov ?? 0 }))
  .sort((a, b) => b.zs - a.zs) : [];
const socMc = soc ? Object.entries<any>(soc.mestske_casti).map(([mc, k]) => ({ mc, ...k, spolu: Object.values<number>(k).reduce((a, b) => a + b, 0) })).sort((a, b) => b.spolu - a.spolu) : [];
const jasle = soc?.druhy.find((d: any) => /deti do troch/.test(d.druh));
const seniori = soc?.druhy.filter((d: any) => /seniorov|opatrovateľskej služby/.test(d.druh));
const vyb = nacitaj('vybavenost-bratislava.json');
const obyv = nacitaj('obyvatelstvo-bratislava.json');

const fmt = (n: number) => n.toLocaleString('sk-SK');
const des = (n: number | null) => (n == null ? '–' : n.toLocaleString('sk-SK', { minimumFractionDigits: 1, maximumFractionDigits: 1 }));
const rok = obyv ? Object.keys(obyv.mesto.roky).sort().pop()! : '';
const casti = (obyv?.mestske_casti ?? []).map((c: any) => ({ kod: c.kod.slice(-6), nazov: c.nazov_kratky, obyv: c.roky[rok] }))
  .sort((a: any, b: any) => a.nazov.localeCompare(b.nazov, 'sk'));

const skolyTab = skoly ? casti.map((c: any) => {
  const zs = skoly.typy.zs.mestske_casti[c.kod] ?? 0;
  const ms = skoly.typy.ms.mestske_casti[c.kod] ?? 0;
  return { ...c, zs, ms, msNa10k: c.obyv ? (10000 * ms) / c.obyv : null };
}) : [];
const vybTab = vyb ? [...vyb.mestske_casti].sort((a: any, b: any) => (b.lekarne_na_10000 ?? 0) - (a.lekarne_na_10000 ?? 0)) : [];
const stav = vyb?.zdroj?.stav_osm ? new Date(vyb.zdroj.stav_osm).toLocaleDateString('sk-SK') : '';
---
<Base title="Vybavenosť Bratislavy – mestovcislach.sk" description="Školy a spádové obvody, jasle, sociálne služby, lekárne, zdravotníctvo a nabíjacie stanice v Bratislave podľa mestských častí.">
  <section class="hero">
    <p class="kicker">Bratislava</p>
    <h1>Vybavenosť</h1>
    <p class="lead">Školy, škôlky a spádové obvody, jasle a sociálne služby, lekárne, zdravotníctvo a nabíjacie stanice v mestských častiach.</p>
  </section>

  {skoly && (
    <>
      <h2 class="sekcia">Školy a škôlky</h2>
      <section class="kpis">
        <div class="card kpi">
          <p class="label">Základné školy</p>
          <p class="value">{skoly.typy.zs.spolu}</p>
          <p class="delta">{Object.entries(skoly.typy.zs.zriadovatel).sort((a: any, b: any) => b[1] - a[1]).map(([k, v]) => `${k} ${v}`).join(' · ')}</p>
        </div>
        <div class="card kpi">
          <p class="label">Materské školy</p>
          <p class="value">{skoly.typy.ms.spolu}</p>
          <p class="delta">v zozname mesta pre školský rok 2026</p>
        </div>
      </section>
      <section class="card">
        <div class="tabulka-obal">
          <table>
            <thead><tr><th>Mestská časť</th><th class="num">Základné školy</th><th class="num">Materské školy</th><th class="num">MŠ na 10 000 obyv.</th></tr></thead>
            <tbody>
              {skolyTab.map((c: any) => <tr><td>{c.nazov}</td><td class="num">{c.zs}</td><td class="num">{c.ms}</td><td class="num">{des(c.msNa10k)}</td></tr>)}
            </tbody>
          </table>
        </div>
        <p class="zdroj">
          Zriaďovateľ odhadnutý podľa názvu školy. Zdroj: <a href={skoly.typy.zs.zdroj.url}>{skoly.typy.zs.zdroj.nazov}</a> a
          <a href={skoly.typy.ms.zdroj.url}>{skoly.typy.ms.zdroj.nazov}</a>, data.bratislava.sk, licencia CC BY 4.0.
        </p>
      </section>
      {rajon && (
        <section class="card" id="spadova-skola">
          <h3>Do ktorej školy a škôlky patrí moja adresa?</h3>
          <p class="pozn">Spádová (obvodná) základná škola a materská škola podľa rajonizácie mesta. Zadajte ulicu a číslo domu.</p>
          <form id="rajon-form" class="rajon-form" autocomplete="off">
            <label class="pole ulica"><span>Ulica</span><input id="rajon-ulica" list="rajon-ulice" placeholder="napr. Romanova" required /></label>
            <label class="pole cislo"><span>Číslo</span><input id="rajon-cislo" inputmode="text" placeholder="12 alebo 3104/11" /></label>
            <button type="submit">Hľadať</button>
            <datalist id="rajon-ulice"></datalist>
          </form>
          <div id="rajon-vysledok" aria-live="polite"></div>
          <p class="zdroj">
            Spádová škola je tá, ktorá musí prednostne prijať dieťa s trvalým pobytom v obvode; rodič môže zvoliť aj inú školu.
            Pri materských školách rozhoduje o prijatí riaditeľ. Overte si to na webe školy alebo mestskej časti.
            {" "}{fmt(rajon.adries)} adries, {rajon.zakladne_skoly} základných škôl. Zdroj: {rajon.zdroj.map((z: any, i: number) => <>{i ? ' a ' : ''}<a href={z.url}>{z.nazov}</a></>)}, data.bratislava.sk, licencia CC BY 4.0.
          </p>
        </section>
      )}
      {iedu && (
        <>
          <section class="kpis">
            <div class="card kpi"><p class="label">Žiaci základných škôl</p><p class="value">{fmt(iedu.mesto.zs.ziakov)}</p><p class="delta">{iedu.mesto.zs.skol} škôl vrátane súkromných a cirkevných · {des(iedu.mesto.zs.ziakov_na_ucitela)} žiaka na učiteľa</p></div>
            <div class="card kpi"><p class="label">Žiaci stredných škôl</p><p class="value">{fmt(iedu.mesto.ss.ziakov)}</p><p class="delta">{iedu.mesto.ss.skol} škôl · {des(iedu.mesto.ss.ziakov_na_ucitela)} žiaka na učiteľa</p></div>
            <div class="card kpi"><p class="label">Deti v materských školách</p><p class="value">{fmt(iedu.mesto.ms.ziakov)}</p><p class="delta">{iedu.mesto.ms.skol} škôl a elokovaných pracovísk</p></div>
            <div class="card kpi"><p class="label">Umelecké školy a CVČ</p><p class="value">{fmt(iedu.mesto.zus.ziakov + iedu.mesto.cvc.ziakov)}</p><p class="delta">{iedu.mesto.zus.skol} ZUŠ, {iedu.mesto.cvc.skol} centier voľného času</p></div>
          </section>
          <section class="card">
            <h3>Žiaci podľa mestských častí</h3>
            <div class="tabulka-obal">
              <table>
                <thead><tr><th>Mestská časť</th><th class="num">Žiaci ZŠ</th><th class="num">Základné školy</th><th class="num">Deti v MŠ</th><th class="num">Žiaci SŠ</th></tr></thead>
                <tbody>{zsMc.map((c: any) => <tr><td>{c.mc}</td><td class="num">{fmt(c.zs)}</td><td class="num">{c.zsSkol}</td><td class="num">{fmt(c.ms)}</td><td class="num">{fmt(c.ss)}</td></tr>)}</tbody>
              </table>
            </div>
            <div class="dva-stlpce">
              <div>
                <h3>Najväčšie základné školy</h3>
                <ol class="zoznam">{iedu.najvacsie.zs.slice(0, 8).map((x: any) => <li>{x.nazov} <span>{x.mc} · {fmt(x.ziaci)} žiakov</span></li>)}</ol>
              </div>
              {iedu.zaujem_ss?.najzaujimavejsie?.length > 0 && (
                <div>
                  <h3>O ktoré stredné školy je najväčší záujem</h3>
                  <ol class="zoznam">{iedu.zaujem_ss.najzaujimavejsie.slice(0, 8).map((x: any) => <li>{x.nazov.replace(/,? ako organizačná zložka.*$/, '')} <span>{x.adresa} · {fmt(x.zaujem1)} prihlášok s 1. voľbou</span></li>)}</ol>
                </div>
              )}
            </div>
            <p class="zdroj">
              Počty žiakov, pedagógov a rozpočty škôl: <a href={iedu.zdroj.url}>{iedu.zdroj.nazov}</a>; záujem uchádzačov: <a href={iedu.zdroj_zaujem.url}>{iedu.zdroj_zaujem.nazov}</a> (posledné zverejnené prijímacie konanie).
              Údaje cez <a href="https://data.slovensko.sk">data.slovensko.sk</a>. Všetky školy sú aj na <a href="/mapa">mape</a>.
            </p>
          </section>
        </>
      )}
    </>
  )}

  {soc && (
    <>
      <h2 class="sekcia" id="socialne">Jasle a sociálne služby</h2>
      <section class="kpis">
        {jasle && <div class="card kpi"><p class="label">Jasle (deti do 3 rokov)</p><p class="value">{jasle.pocet}</p><p class="delta">registrovaných zariadení, spolu {fmt(jasle.kapacita)} miest</p></div>}
        {seniori?.length > 0 && <div class="card kpi"><p class="label">Zariadenia pre seniorov</p><p class="value">{seniori.reduce((a: number, d: any) => a + d.pocet, 0)}</p><p class="delta">{fmt(seniori.reduce((a: number, d: any) => a + (d.kapacita ?? 0), 0))} miest vrátane opatrovateľských zariadení</p></div>}
        <div class="card kpi"><p class="label">Sociálne služby spolu</p><p class="value">{soc.sluzieb}</p><p class="delta">s miestom poskytovania v Bratislave</p></div>
      </section>
      <section class="card">
        <div class="dva-stlpce">
          <div>
            <h3>Druhy služieb</h3>
            <div class="tabulka-obal">
              <table>
                <thead><tr><th>Služba</th><th class="num">Počet</th><th class="num">Kapacita</th></tr></thead>
                <tbody>{soc.druhy.slice(0, 14).map((d: any) => <tr><td>{d.druh.charAt(0).toUpperCase() + d.druh.slice(1)}</td><td class="num">{d.pocet}</td><td class="num">{d.kapacita ? fmt(d.kapacita) : '–'}</td></tr>)}</tbody>
              </table>
            </div>
          </div>
          <div>
            <h3>Podľa mestských častí</h3>
            <div class="tabulka-obal">
              <table>
                <thead><tr><th>Mestská časť</th><th class="num">Jasle</th><th class="num">Seniori</th><th class="num">Spolu</th></tr></thead>
                <tbody>{socMc.map((c: any) => <tr><td>{c.mc}</td><td class="num">{c.deti ?? 0}</td><td class="num">{c.seniori ?? 0}</td><td class="num">{c.spolu}</td></tr>)}</tbody>
              </table>
            </div>
          </div>
        </div>
        <p class="zdroj">
          Zdroj: <a href={soc.zdroj.url}>{soc.zdroj.nazov}</a> (data.slovensko.sk). Len aktívne služby s adresou v Bratislave; terénne služby bez pevného miesta nie sú započítané.
          Zverejňujeme len právnické osoby a samosprávu, bez telefónov, e-mailov a mien štatutárov. Jasle a ostatné služby nájdete aj na <a href="/mapa">mape</a>.
        </p>
      </section>
    </>
  )}

  {vyb && (
    <>
      <h2 class="sekcia">Zdravie a nabíjanie</h2>
      <section class="kpis">
        <div class="card kpi"><p class="label"><i class="bod" style="background:var(--v-0)"></i>Lekárne</p><p class="value">{fmt(vyb.mesto.lekarne)}</p></div>
        <div class="card kpi"><p class="label"><i class="bod" style="background:var(--v-2)"></i>Nemocnice a polikliniky</p><p class="value">{fmt(vyb.mesto.nemocnice)}</p></div>
        <div class="card kpi"><p class="label"><i class="bod" style="background:var(--v-3)"></i>Nabíjacie stanice</p><p class="value">{fmt(vyb.mesto.nabijanie)}</p><p class="delta">{fmt(vyb.mesto.nabijacie_miesta)} nabíjacích miest</p></div>
        {pamReg ? <div class="card kpi"><p class="label">Národné kultúrne pamiatky</p><p class="value">{fmt(pamReg.pamiatok)}</p><p class="delta">{fmt(pamReg.objektov)} pamiatkových objektov podľa registra MK SR, z toho {pamReg.mestske_casti['Staré Mesto']} v Starom Meste. <a href="/mapa#pamiatky">Na mape</a></p></div>
          : vyb.mesto.pamiatky != null && <div class="card kpi"><p class="label">Kultúrne pamiatky v OSM</p><p class="value">{fmt(vyb.mesto.pamiatky)}</p><p class="delta"><a href="/mapa">Na mape</a></p></div>}
      </section>

      <section class="card" id="vybavenost">
        <div class="hlavicka">
          <h3>Mapa</h3>
          <div class="filtre" role="group" aria-label="Zobraziť na mape">
            {Object.entries(vyb.kategorie).map(([k, nazov], i) => (
              <label><input type="checkbox" value={k} checked={k !== 'ambulancie'} /><i style={`background:var(--v-${i})`}></i>{nazov as string}</label>
            ))}
          </div>
        </div>
        <div id="mapa-vyb" role="img" aria-label="Mapa lekární, zdravotníckych zariadení a nabíjacích staníc"></div>
        <p class="zdroj">Ťuknite na bod pre adresu, otváracie hodiny a web (ak ich OpenStreetMap má). Ambulancie sú v OpenStreetMap zmapované len čiastočne, preto sú predvolene skryté.</p>
      </section>

      <section class="card">
        <h3>Mestské časti</h3>
        <div class="tabulka-obal">
          <table>
            <thead><tr><th>Mestská časť</th><th class="num">Lekárne</th><th class="num">na 10 000 obyv.</th><th class="num">Nabíjacie stanice</th><th class="num">Nabíjacie miesta</th></tr></thead>
            <tbody>
              {vybTab.map((c: any) => <tr><td>{c.nazov}</td><td class="num">{c.lekarne}</td><td class="num">{des(c.lekarne_na_10000)}</td><td class="num">{c.nabijanie}</td><td class="num">{c.nabijacie_miesta}</td></tr>)}
            </tbody>
          </table>
        </div>
        <p class="zdroj">
          Zdroj: © <a href={vyb.zdroj.url}>prispievatelia OpenStreetMap</a> (ODbL), stav {stav}. Portál mesta tieto zoznamy nezverejňuje;
          údaje z OSM nie sú oficiálny register a nemusia byť úplné. Nabíjacie miesta podľa uvedenej kapacity stanice (ak chýba, ráta sa 1).
        </p>
      </section>
    </>
  )}
</Base>

<script>
  import L from 'leaflet';
  import { osmPodklad } from '../scripts/podklad';
  import { popupMiesta } from '../scripts/miesto';
  import { najdi, rozdel, zoznamUlic, type Rajonizacia, type Vysledok } from '../scripts/rajon';
  import 'leaflet/dist/leaflet.css';

  const el = document.getElementById('mapa-vyb');
  if (el) {
    const css = getComputedStyle(document.documentElement);
    const tmava = document.documentElement.dataset.tema === 'tmava';
    const poradie = ['lekarne', 'ambulancie', 'nemocnice', 'nabijanie'];
    const farby = poradie.map((_, i) => css.getPropertyValue(`--v-${i}`).trim());
    const mapa = L.map(el, { scrollWheelZoom: false, zoomSnap: 0.25, preferCanvas: true });
    osmPodklad().addTo(mapa);
    mapa.setView([48.15, 17.11], 11.5);
    const vrstvy: Record<string, L.LayerGroup> = Object.fromEntries(poradie.map((k) => [k, L.layerGroup()]));

    fetch('/data/vybavenost-bratislava.json').then((r) => r.json()).then((d) => {
      for (const [lat, lon, kat, nazov, det] of d.body as [number, number, string, string, any][]) {
        L.circleMarker([lat, lon], {
          radius: window.innerWidth < 600 ? 4 : 5, weight: 1, color: tmava ? '#121417' : '#ffffff',
          fillColor: farby[poradie.indexOf(kat)], fillOpacity: 0.9,
        }).bindPopup(() => popupMiesta(nazov, d.kategorie[kat], det), { maxWidth: 280 }).addTo(vrstvy[kat]);
      }
      document.querySelectorAll<HTMLInputElement>('.filtre input').forEach((i) => {
        const prepni = () => (i.checked ? vrstvy[i.value].addTo(mapa) : vrstvy[i.value].remove());
        i.addEventListener('change', prepni);
        prepni();
      });
    });
  }

  // Spádová škola podľa adresy
  const form = document.getElementById('rajon-form') as HTMLFormElement | null;
  if (form) {
    const ulicaEl = document.getElementById('rajon-ulica') as HTMLInputElement;
    const cisloEl = document.getElementById('rajon-cislo') as HTMLInputElement;
    const vysl = document.getElementById('rajon-vysledok')!;
    let data: Promise<Rajonizacia> | null = null;
    const nacitaj = () => (data ??= fetch('/data/rajonizacia-bratislava.json').then((r) => r.json()).then((d: Rajonizacia) => {
      const dl = document.getElementById('rajon-ulice')!;
      dl.innerHTML = zoznamUlic(d).map((u) => `<option value="${u.replace(/"/g, '&quot;')}">`).join('');
      return d;
    }));
    ulicaEl.addEventListener('focus', nacitaj, { once: true });
    // odkaz z vyhľadávania: /vybavenost?ulica=Romanova, Petržalka#spadova-skola
    const zParam = new URLSearchParams(location.search).get('ulica');
    if (zParam) { ulicaEl.value = zParam; setTimeout(() => { form.requestSubmit(); cisloEl.focus(); }, 0); }
    const esc = (t: string) => t.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);
    const webOdkaz = (w: string) => (w && /^https?:\/\//.test(w) ? ` · <a href="${esc(w)}" target="_blank" rel="noopener">web školy</a>` : '');
    const karta = (v: Vysledok) => {
      const zs = v.zs.length
        ? v.zs.map((s) => /^Školský obvod/.test(s.nazov)
            ? `<li><b>${esc(s.nazov)}</b> – celá mestská časť je jeden spoločný obvod${s.web && /^https?:\/\//.test(s.web) ? ` · <a href="${esc(s.web)}" target="_blank" rel="noopener">nariadenie o obvodoch</a>` : ''}</li>`
            : `<li><b>${esc(s.nazov)}</b>${s.adresa ? `, ${esc(s.adresa)}` : ''}${webOdkaz(s.web)}</li>`).join('')
        : '<li class="tlmene">neuvedená</li>';
      const ms = v.ms.length ? v.ms.map((s) => `<li><b>${esc(s.nazov)}</b>${s.adresa && !s.nazov.includes(s.adresa) ? `, ${esc(s.adresa)}` : ''}</li>`).join('') : '<li class="tlmene">neuvedená</li>';
      const pozn = v.cislo && !v.presne ? `<p class="tlmene">Číslo ${esc(v.cislo)} sme na ulici nenašli – zobrazujeme všetky školy pre túto ulicu.</p>`
        : !v.cislo && (v.zs.length > 1 || v.ms.length > 1) ? '<p class="tlmene">Ulica patrí do viacerých obvodov – zadajte aj číslo domu.</p>' : '';
      return `<div class="rajon-karta"><p class="adresa">${esc(v.ulica)}${v.cislo ? ' ' + esc(v.cislo) : ''} <span>· ${esc(v.mc)}</span></p>${pozn}
        <div class="rajon-stlpce"><div><p class="nadpis">Základná škola</p><ul>${zs}</ul></div><div><p class="nadpis">Materská škola</p><ul>${ms}</ul></div></div></div>`;
    };
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      vysl.innerHTML = '<p class="tlmene">Hľadám…</p>';
      try {
        const d = await nacitaj();
        let { ulica, cislo, mc } = rozdel(ulicaEl.value);
        if (cisloEl.value.trim()) cislo = cisloEl.value.trim().replace(/\s+/g, '');
        const r = najdi(d, ulica, cislo, mc);
        vysl.innerHTML = r.length ? r.map(karta).join('')
          : `<p class="tlmene">Ulicu „${esc(ulica)}“ sme v rajonizácii nenašli. Skúste začiatok názvu, napr. „Hálkova“ namiesto „Hálkova ul.“.</p>`;
      } catch {
        vysl.innerHTML = '<p class="tlmene">Údaje sa nepodarilo načítať. Skúste to znova.</p>';
      }
    });
  }
</script>

<style>
  :global(:root) { --v-0: #138a5e; --v-1: #7a4fd1; --v-2: #c8102e; --v-3: #1f6fd1; }
  :global(:root[data-tema="tmava"]) { --v-0: #6ee7b7; --v-1: #c4a7ff; --v-2: #ff6b80; --v-3: #7cc4ff; }
  .hero { padding: 40px 0 8px; }
  .kicker { color: var(--accent); font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; font-size: 0.75rem; margin: 0; }
  h1 { font-size: clamp(2rem, 6vw, 3rem); line-height: 1.1; letter-spacing: -0.03em; margin: 8px 0 12px; }
  .lead { color: var(--muted); font-size: 1.1rem; max-width: 42em; margin: 0; }
  h2.sekcia { font-size: 1.5rem; letter-spacing: -0.02em; margin: 40px 0 16px; }
