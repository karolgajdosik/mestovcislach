// Kto žije v Bratislave – Sčítanie obyvateľov, domov a bytov 2021 podľa mestských častí.
import fs from 'node:fs';
import path from 'node:path';
import Base from '../layouts/Base.astro';

const p = path.join(process.cwd(), 'data', 'scitanie-bratislava.json');
// Nezamestnanosť v okresoch Bratislava I–V (ŠÚ SR, k 31. 12.)
const pn = path.join(process.cwd(), 'data', 'nezamestnanost-bratislava.json');
const nez = fs.existsSync(pn) ? JSON.parse(fs.readFileSync(pn, 'utf-8')) : null;
const miera = nez?.ukazovatele?.['Miera evidovanej nezamestnanosti'];
const uchadzaci = nez && Object.entries<any>(nez.ukazovatele).find(([k]) => /uchádzač/i.test(k) && /disponib/i.test(k))?.[1];
const nezRoky = miera ? Object.keys(miera['Slovenská republika'] ?? Object.values<any>(miera)[0]).filter((r) => Number(r) >= 2008) : [];
const nezRok = nezRoky[nezRoky.length - 1];
const grafNez = miera ? JSON.stringify({ roky: nezRoky, rady: Object.entries<any>(miera).map(([u, v]) => [u.replace('Okres ', ''), nezRoky.map((r) => v[r] ?? null)]) }) : '';
const sc = fs.existsSync(p) ? JSON.parse(fs.readFileSync(p, 'utf-8')) : null;

// Poradie a čitateľné názvy kategórií
const cist = (t: string) => t.trim()
  .replace(/ \(.*$/, '').replace(/ v Slovenskej republike$| na Slovensku$/, '')
  .replace(/^<?(\d+) m2 - (\d+) m2\)$/, '$1 – $2 m²').replace(/^<150 m2 a viac$/, '150 m² a viac').replace(/^menej ako 30 m2\)$/, 'menej ako 30 m²')
  .replace(/^(\d+) m2 - (\d+) m2\)$/, '$1 – $2 m²')
  .replace(/^Bez ukončeného vzdelania - osoby vo veku 0-14 rokov$/, 'deti do 14 rokov')
  .replace(/^Bez školského vzdelania - osoby vo veku 15 rokov a viac$/, 'bez školského vzdelania')
  .replace(/ - (slobodná|vydatá|rozvedená|vdova)$/, '').replace(/domácnosť$/, '')
  .replace(/^(\w)/, (c) => c.toUpperCase());
const PORADIE: Record<string, (string | RegExp)[]> = {
  vek: ['14 rokov alebo menej', 'Od 15 do 64 rokov', '65 rokov alebo viac'],
  vzdelanie: ['Základné', 'Stredné bez maturity', 'Stredné s maturitou', 'Vysokoškolské', /Bez školského/, /Nezistené/],
  domacnosti: [/^1-/, /^2-/, /^3-/, /^4-/, /^5/],
  byty_izby: [/^1 /, /^2 /, /^3 /, /^4 /, /^5 /, /^6 /, /^7 /, /^8 /, /^9 /, /Nezist/],
  byty_plocha: [/^menej/, /^<30/, /^<40/, /^<50/, /^<60/, /^<80/, /^<100/, /^120/, /^<150/, /nezist/],
};
// Kategórie, ktoré nezapočítavame do podielov (napr. deti pri vzdelaní)
const VYNECHAT: Record<string, RegExp> = { vzdelanie: /0-14 rokov/, vek: /^Neznáme$/ };
const TEMY = ['vek', 'vzdelanie', 'ekonomicka_aktivita', 'narodnost', 'jazyk', 'nabozenstvo', 'rodinny_stav', 'domacnosti', 'byty_vlastnictvo', 'byty_izby', 'byty_plocha'];
const POZNAMKY: Record<string, string> = {
  vzdelanie: 'Podiel z obyvateľov od 15 rokov.',
  rodinny_stav: 'Vrátane detí (slobodní).',
  domacnosti: 'Cenzové domácnosti podľa počtu členov.',
  ekonomicka_aktivita: 'Ekonomicky aktívni = pracujúci vrátane nezamestnaných hľadajúcich prácu.',
};

let pripravene: any = null;
if (sc) {
  const temy = TEMY.filter((t) => sc.temy[t]).map((t) => {
    const td = sc.temy[t];
    let kat: string[] = td.kategorie.filter((k: string) => !VYNECHAT[t]?.test(k));
    const por = PORADIE[t];
    if (por) {
      const idx = (k: string) => { const i = por.findIndex((r) => (typeof r === 'string' ? r === k.trim() : r.test(k))); return i < 0 ? 99 : i; };
      kat = [...kat].sort((a, b) => idx(a) - idx(b));
    }
    const podiely = (d: Record<string, number>) => {
      const spolu = kat.reduce((a, k) => a + (d[k] ?? 0), 0) || 1;
      return kat.map((k) => Math.round((1000 * (d[k] ?? 0)) / spolu) / 10);
    };
    return {
      id: t, nazov: td.nazov, poznamka: POZNAMKY[t] ?? '', kategorie: kat.map(cist),
      mesto: podiely(td.mesto), pocty_mesto: kat.map((k) => td.mesto[k] ?? 0),
      casti: Object.fromEntries(Object.entries(td.mestske_casti).map(([mc, d]: [string, any]) => [mc, podiely(d)])),
    };
  });
  const casti = Object.keys(sc.temy.vek.mestske_casti).sort((a, b) => a.localeCompare(b, 'sk'));
  const ukaz = (mc: string | null) => {
    const g = (t: string) => temy.find((x) => x.id === t)!;
    const v = (t: string, i: number) => (mc ? g(t).casti[mc][i] : g(t).mesto[i]);
    const vek = sc.temy.vek; const d = mc ? vek.mestske_casti[mc] : vek.mesto;
    const obyv = ['14 rokov alebo menej', 'Od 15 do 64 rokov', '65 rokov alebo viac', 'Neznáme'].reduce((a, k) => a + (d[k] ?? 0), 0);
    const kat = (t: string, r: RegExp) => g(t).kategorie.findIndex((k: string) => r.test(k));
    return {
      nazov: mc ?? 'Bratislava', obyvatelia: obyv,
      deti: v('vek', 0), seniori: v('vek', 2),
      vs: v('vzdelanie', kat('vzdelanie', /^Vysokoškolské/)),
      bez_vyznania: v('nabozenstvo', kat('nabozenstvo', /^Bez náboženského/i)),
      slovenska: v('narodnost', kat('narodnost', /^Slovensk/)),
      jednoclenne: v('domacnosti', 0),
      vlastne: v('byty_vlastnictvo', kat('byty_vlastnictvo', /^Vlastný byt/i)) + v('byty_vlastnictvo', kat('byty_vlastnictvo', /vlastnom rodinnom/i)),
    };
  };
  pripravene = { temy, casti, prehlad: [ukaz(null), ...casti.map(ukaz)] };
}
const pct = (n: number) => n.toLocaleString('sk-SK', { minimumFractionDigits: 1, maximumFractionDigits: 1 }) + ' %';
const fmt = (n: number) => n.toLocaleString('sk-SK');
const ba = pripravene?.prehlad[0];
const pu = path.join(process.cwd(), 'data', 'mc-ukazovatele.json');
const index = fs.existsSync(pu) ? JSON.parse(fs.readFileSync(pu, 'utf-8')).index_rozvoja : null;
const indexMax = index ? Math.max(...Object.values<number>(index.mestske_casti)) : 1;
const des = (n: number) => n.toLocaleString('sk-SK', { minimumFractionDigits: 1, maximumFractionDigits: 1 });
// Prognózy z Katalógu dát (Bratislava 2050 – tabuľky mesta)
const tab = (pref: string) => {
  const dir = path.join(process.cwd(), 'public', 'data', 'tabulky');
  const f = fs.existsSync(dir) ? fs.readdirSync(dir).find((x) => x.startsWith(pref)) : null;
  return f ? { ...JSON.parse(fs.readFileSync(path.join(dir, f), 'utf-8')), id: f.replace('.json', '') } : null;
};
const progPocet = tab('35e2060c'), progVek = tab('d97203f6'), progStarnutie = tab('a2042a88'), scenare = tab('2bc509db');
const hodnotaMcRok = (t: any, mc: string, rok: number) => t?.riadky.find((r: any[]) => r[0] === mc && Number(r[1]) === rok)?.[2] ?? null;
const prognoza = progPocet ? [...new Set<string>(progPocet.riadky.map((r: any[]) => r[0]))].map((mc) => {
  const a = hodnotaMcRok(progPocet, mc, 2022), b = hodnotaMcRok(progPocet, mc, 2035);
  return { mc, a, b, zmena: a && b ? (100 * (b - a)) / a : null, vek: hodnotaMcRok(progVek, mc, 2035), vek22: hodnotaMcRok(progVek, mc, 2022), starnutie: hodnotaMcRok(progStarnutie, mc, 2035) };
}).sort((x, y) => (y.zmena ?? 0) - (x.zmena ?? 0)) : [];
const SCENARE: Record<string, string> = { 'Velmi vysoky': 'veľmi vysoký', Vysoky: 'vysoký', Stredny: 'stredný', Nizky: 'nízky', 'Nulova migracia': 'nulová migrácia' };
const grafScenare = scenare ? JSON.stringify(Object.entries([...scenare.riadky].sort((a: any[], b: any[]) => a[1] - b[1]).reduce((acc: any, r: any[]) => {
  (acc[SCENARE[r[0]] ?? r[0]] ??= []).push([r[1], r[2]]); return acc;
}, {}))) : '';
---
<Base title="Obyvatelia Bratislavy – sčítanie 2021 – mestovcislach.sk" description="Kto žije v Bratislave a v jej mestských častiach: vek, vzdelanie, národnosť, náboženstvo, domácnosti a byty podľa sčítania 2021.">
  <section class="hero">
    <p class="kicker">Bratislava · sčítanie 2021</p>
    <h1>Obyvatelia</h1>
    <p class="lead">Kto žije v Bratislave a jej mestských častiach – vek, vzdelanie, národnosť, viera, domácnosti a byty podľa Sčítania obyvateľov, domov a bytov 2021.</p>
  </section>

  {!pripravene ? <div class="card"><p>Dáta sa pripravujú.</p></div> : (
    <div id="obyv" data-d={JSON.stringify(pripravene)}>
      <section class="kpis">
        <div class="card kpi"><p class="label">Obyvatelia pri sčítaní</p><p class="value">{fmt(ba.obyvatelia)}</p><p class="delta">k 1. 1. 2021</p></div>
        <div class="card kpi"><p class="label">S vysokoškolským vzdelaním</p><p class="value">{pct(ba.vs)}</p><p class="delta">z obyvateľov od 15 rokov</p></div>
        <div class="card kpi"><p class="label">Seniori 65+</p><p class="value">{pct(ba.seniori)}</p><p class="delta">deti do 14 rokov {pct(ba.deti)}</p></div>
        <div class="card kpi"><p class="label">Jednočlenné domácnosti</p><p class="value">{pct(ba.jednoclenne)}</p><p class="delta">z cenzových domácností</p></div>
      </section>

      <section class="card">
        <div class="hlavicka">
          <h2>Porovnanie</h2>
          <label class="vyber">Mestská časť
            <select id="obyv-mc">
              <option value="">celá Bratislava</option>
              {pripravene.casti.map((c: string) => <option>{c}</option>)}
            </select>
          </label>
        </div>
        <p class="legenda-obyv"><span><i class="ja"></i><b id="obyv-nazov">Bratislava</b></span><span><i class="ba"></i>priemer Bratislavy</span></p>
        <div class="temy-mriezka" id="obyv-temy"></div>
      </section>

      <section class="card">
        <h2>Mestské časti v číslach</h2>
        <div class="tabulka-obal">
          <table>
            <thead><tr><th>Mestská časť</th><th class="num">Obyvatelia</th><th class="num">Deti 0–14</th><th class="num">Seniori 65+</th><th class="num">VŠ vzdelanie</th><th class="num">Bez vyznania</th><th class="num">Slovenská nár.</th><th class="num">1-členné dom.</th><th class="num">Vlastné byty</th></tr></thead>
            <tbody>
              {pripravene.prehlad.map((r: any, i: number) => (
                <tr class={i === 0 ? 'spolu' : ''}><td>{r.nazov}</td><td class="num">{fmt(r.obyvatelia)}</td><td class="num">{pct(r.deti)}</td><td class="num">{pct(r.seniori)}</td><td class="num">{pct(r.vs)}</td><td class="num">{pct(r.bez_vyznania)}</td><td class="num">{pct(r.slovenska)}</td><td class="num">{pct(r.jednoclenne)}</td><td class="num">{pct(r.vlastne)}</td></tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="zdroj">
          Zdroj: <a href="https://statdata.statistics.sk">Štatistický úrad SR – Sčítanie obyvateľov, domov a bytov 2021 (STATdata)</a>, licencia CC BY 4.0.
          Údaje sú k rozhodujúcemu okamihu sčítania 1. 1. 2021. Podiely sú zo všetkých osôb, domácností či bytov vrátane kategórie „nezistené“ (pri vzdelaní z obyvateľov od 15 rokov). Mesto = súčet 17 mestských častí.
        </p>
      </section>

      {prognoza.length > 0 && (
        <section class="card" id="prognoza" data-scenare={grafScenare}>
          <h2>Prognóza do roku 2035</h2>
          <p class="pozn-index">
            Podľa prognózy mesta do roku 2035 najviac porastú {prognoza.slice(0, 3).map((r: any) => `${r.mc} (${r.zmena > 0 ? '+' : ''}${des(r.zmena)} %)`).join(', ')};
            obyvateľov ubudne najmä v častiach {prognoza.slice(-3).reverse().map((r: any) => `${r.mc} (${des(r.zmena)} %)`).join(', ')}. Prognózy pochádzajú z podkladov stratégie Bratislava 2050.
          </p>
          {scenare && <div class="chart nizky-prog"><canvas id="g-scenare" role="img" aria-label="Prognóza počtu obyvateľov Bratislavy podľa scenárov"></canvas></div>}
          <div class="tabulka-obal">
            <table>
              <thead><tr><th>Mestská časť</th><th class="num">2022</th><th class="num">2035</th><th class="num">Zmena</th><th class="num">Priemerný vek 2022 → 2035</th><th class="num">Index starnutia 2035</th></tr></thead>
              <tbody>{prognoza.map((r: any) => <tr><td>{r.mc}</td><td class="num">{r.a ? fmt(r.a) : '–'}</td><td class="num">{r.b ? fmt(r.b) : '–'}</td><td class="num">{r.zmena != null ? `${r.zmena > 0 ? '+' : ''}${des(r.zmena)} %` : '–'}</td><td class="num">{r.vek22 && r.vek ? `${des(r.vek22)} → ${des(r.vek)}` : '–'}</td><td class="num">{r.starnutie ? des(r.starnutie) : '–'}</td></tr>)}</tbody>
            </table>
          </div>
          <p class="zdroj">Index starnutia = počet ľudí nad 65 rokov na 100 detí do 14 rokov. Zdroj: tabuľky <a href={`/katalog/${progPocet.id}`}>{progPocet.nazov}</a>, <a href={`/katalog/${progVek?.id}`}>priemerný vek</a>, <a href={`/katalog/${progStarnutie?.id}`}>index starnutia</a>{scenare && <>, <a href={`/katalog/${scenare.id}`}>scenáre pre mesto</a></>} (data.bratislava.sk).</p>
        </section>
      )}

      {miera && nezRok && (
        <section class="card" id="nezamestnanost" data-graf={grafNez}>
          <h2>Nezamestnanosť</h2>
          <p class="pozn-index">
            Miera evidovanej nezamestnanosti na konci roka {nezRok}: Bratislava I {des(miera['Okres Bratislava I']?.[nezRok])} % až
            {' '}{Object.entries<any>(miera).filter(([u]) => u.startsWith('Okres')).sort((a, b) => b[1][nezRok] - a[1][nezRok])[0][0].replace('Okres ', '')} {des(Math.max(...Object.entries<any>(miera).filter(([u]) => u.startsWith('Okres')).map(([, v]) => v[nezRok])))} %;
            celé Slovensko {des(miera['Slovenská republika']?.[nezRok])} %. Úrady práce vedú údaje za okresy, nie za mestské časti.
          </p>
          <div class="chart nizky-prog"><canvas id="g-nez" role="img" aria-label="Miera evidovanej nezamestnanosti v okresoch Bratislavy a na Slovensku"></canvas></div>
          <div class="tabulka-obal"><table>
            <thead><tr><th>Okres</th><th>Mestské časti</th><th class="num">Miera {nezRok}</th>{uchadzaci && <th class="num">Uchádzači</th>}</tr></thead>
            <tbody>{Object.entries<any>(miera).map(([u, v]) => <tr><td>{u.replace('Okres ', '')}</td><td class="mensie">{nez.okresy_mc[u] ?? ''}</td><td class="num">{v[nezRok] != null ? des(v[nezRok]) + ' %' : '–'}</td>{uchadzaci && <td class="num">{uchadzaci[u]?.[nezRok] != null ? fmt(uchadzaci[u][nezRok]) : '–'}</td>}</tr>)}</tbody>
          </table></div>
          <p class="zdroj">Miera = disponibilní uchádzači o zamestnanie / ekonomicky aktívne obyvateľstvo, k 31. 12. Zdroj: <a href={nez.zdroj.url}>{nez.zdroj.nazov}</a>.</p>
        </section>
      )}

      {index && (
        <section class="card" id="index-rozvoja">
          <h2>Index regionálneho rozvoja</h2>
          <p class="pozn-index">{index.popis} Priemer všetkých {index.obci_v_kraji} obcí Bratislavského kraja: <b>{des(index.priemer_kraja)}</b>.</p>
          <ol class="index-zoznam">
            {Object.entries<number>(index.mestske_casti).map(([mc, v]) => (
              <li><span class="mc">{mc}</span><span class="pruh-obal"><span class="pruh" style={`width:${(v / indexMax) * 100}%`}></span></span><span class="num">{des(v)}</span></li>
            ))}
          </ol>
          <p class="zdroj">Zdroj: <a href={index.zdroj.url}>{index.zdroj.nazov}</a> (data.slovensko.sk).</p>
        </section>
      )}
    </div>
  )}
</Base>

<script>
  import ChartP from 'chart.js/auto';
  const pr = document.getElementById('prognoza');
  if (pr?.dataset.scenare && document.getElementById('g-scenare')) {
    const sc: [string, [number, number][]][] = JSON.parse(pr.dataset.scenare);
    const css = getComputedStyle(document.documentElement);
    const FARBY = ['#7f1d1d', '#c8102e', '#1f6fd1', '#94a3b8', '#a16207'];
    new ChartP(document.getElementById('g-scenare') as HTMLCanvasElement, {
      type: 'line',
      data: { labels: sc[0][1].map((x) => x[0]), datasets: sc.map(([n, body], i) => ({ label: n, data: body.map((x) => x[1]), borderColor: FARBY[i % 5], backgroundColor: FARBY[i % 5], pointRadius: 0, borderWidth: n === 'stredný' ? 3 : 1.5 })) },
      options: { maintainAspectRatio: false, plugins: { legend: { labels: { color: css.getPropertyValue('--muted').trim() } } },
        scales: { y: { ticks: { callback: (v) => Number(v).toLocaleString('sk-SK') } } } },
    });
  }

  const nz = document.getElementById('nezamestnanost');
  if (nz?.dataset.graf) {
    const g = JSON.parse(nz.dataset.graf);
    const FARBY = ['#1f6fd1', '#0ea5e9', '#14b8a6', '#a16207', '#c8102e', '#64748b', '#111827'];
    new ChartP(document.getElementById('g-nez') as HTMLCanvasElement, {
      type: 'line',
      data: { labels: g.roky, datasets: g.rady.map(([n, d]: [string, number[]], i: number) => ({ label: n, data: d, borderColor: FARBY[i % 7], backgroundColor: FARBY[i % 7], pointRadius: 0, borderWidth: /Slovensk/.test(n) ? 3 : 1.5, borderDash: /kraj/.test(n) ? [4, 3] : [] })) },
      options: { maintainAspectRatio: false, interaction: { mode: 'index', intersect: false },
        plugins: { tooltip: { callbacks: { label: (c) => ` ${c.dataset.label}: ${Number(c.parsed.y).toLocaleString('sk-SK')} %` } } },
        scales: { y: { ticks: { callback: (v) => v + ' %' } } } },
    });
  }

  const el = document.getElementById('obyv');
  if (el?.dataset.d) {
    const d = JSON.parse(el.dataset.d);
    const temyEl = document.getElementById('obyv-temy')!;
    const sel = document.getElementById('obyv-mc') as HTMLSelectElement;
    const nazovEl = document.getElementById('obyv-nazov')!;
    const pct = (n: number) => n.toLocaleString('sk-SK', { minimumFractionDigits: 1, maximumFractionDigits: 1 }) + ' %';
    const esc = (t: string) => t.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);
    const vykresli = () => {
      const mc = sel.value;
      nazovEl.textContent = mc || 'Bratislava';
      temyEl.innerHTML = d.temy.map((t: any) => {
        const ja = mc ? t.casti[mc] : t.mesto;
        const max = Math.max(...ja, ...t.mesto, 1);
        const riadky = t.kategorie.map((k: string, i: number) => {
          if (ja[i] < 0.05 && t.mesto[i] < 0.05) return '';
          return `<div class="r"><span class="k">${esc(k)}</span><span class="h">${pct(ja[i])}</span>
            <div class="p"><i style="width:${(100 * ja[i]) / max}%"></i>${mc ? `<b style="left:${(100 * t.mesto[i]) / max}%" title="Bratislava ${pct(t.mesto[i])}"></b>` : ''}</div></div>`;
        }).join('');
        return `<div class="tema"><h3>${esc(t.nazov)}</h3>${riadky}${t.poznamka ? `<p class="pozn">${esc(t.poznamka)}</p>` : ''}</div>`;
      }).join('');
    };
    sel.addEventListener('change', vykresli);
    vykresli();
  }
</script>

<style>
  .hero { padding: 40px 0 24px; }
  .kicker { color: var(--accent); font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; font-size: 0.75rem; margin: 0; }
  h1 { font-size: clamp(2rem, 6vw, 3rem); line-height: 1.1; letter-spacing: -0.03em; margin: 8px 0 12px; }
  .lead { color: var(--muted); font-size: 1.1rem; max-width: 42em; margin: 0; }
  h2 { font-size: 1.1rem; margin: 0; }
  section.card { margin-top: 16px; }
  .kpis { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 16px; }
  .kpi .label { color: var(--muted); font-size: 0.85rem; margin: 0; }
  .kpi .value { font-size: 2.1rem; font-weight: 800; letter-spacing: -0.03em; margin: 4px 0; font-variant-numeric: tabular-nums; }
