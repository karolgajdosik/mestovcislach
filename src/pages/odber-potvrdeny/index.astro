---
// Sem presmeruje Brevo po kliknutí na „Potvrdiť odber“ (functions/api/odber.ts, redirectionUrl).
import Base from '../../layouts/Base.astro';
---
<Base title="Odber potvrdený – mestovcislach.sk" description="Odber e-mailových upozornení z mestovcislach.sk je potvrdený." noindex>
  <section class="hero">
    <p class="kicker">Upozornenia</p>
    <h1>Odber je potvrdený</h1>
    <p class="lead" id="potvrdene-text">Ďakujeme. Ranný súhrn noviniek vám budeme posielať, len keď bude niečo nové. Odhlásiť sa môžete kedykoľvek odkazom v každom e-maile.</p>
    <p><a href="/" id="spat">Späť na mestovcislach.sk</a></p>
  </section>
</Base>
<script>
  const k = new URLSearchParams(location.search).get('k');
  const a = document.getElementById('spat') as HTMLAnchorElement;
  if (k?.startsWith('tyzdennik-')) {
    const s = k.slice(10);
    if (/^[a-z-]+$/.test(s)) a.href = `/${s}`;
    document.getElementById('potvrdene-text')!.textContent = 'Ďakujeme. Týždenník mesta vám príde každý piatok popoludní. Odhlásiť sa môžete kedykoľvek odkazom v každom e-maile.';
  } else if (k === 'dodavatel') a.href = '/dodavatelia';
  else if (k && /^[a-z-]+$/.test(k)) a.href = ['trnava', 'nitra', 'trencin', 'zilina', 'banska-bystrica', 'presov', 'kosice'].includes(k) ? `/${k}/upozornenia` : '/bratislava/upozornenia';
</script>
<style>
  .hero { padding: 40px 0 20px; }
  .kicker { color: var(--accent); font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; font-size: 0.75rem; margin: 0; }
  h1 { font-size: clamp(2rem, 6vw, 3rem); line-height: 1.1; letter-spacing: -0.03em; margin: 8px 0 12px; }
  .lead { color: var(--muted); font-size: 1.1rem; max-width: 42em; margin: 0 0 16px; }
</style>
