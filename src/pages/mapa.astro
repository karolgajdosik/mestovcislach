---
// Spoločná mapa Bratislavy: všetky geodáta webu ako prepínateľné vrstvy.
// Menšie vrstvy sú priamo v stránke, väčšie sa načítajú z /data/*.json až po zapnutí.
import fs from 'node:fs';
import path from 'node:path';
import Base from '../layouts/Base.astro';

const nacitaj = (subor: string) => {
  const p = path.join(process.cwd(), 'data', subor);
  return fs.existsSync(p) ? JSON.parse(fs.readFileSync(p, 'utf-8')) : null;
};
const hranice = nacitaj('hranice-bratislava.geojson');
const obyv = nacitaj('obyvatelstvo-bratislava.json');
const mhd = nacitaj('doprava-bratislava.json');
const bajk = nacitaj('bajk-bratislava.json');
const prostredie = nacitaj('prostredie-bratislava.json');
const scit = nacitaj('scitace-bratislava.json');
// Sčítače zlúčené podľa miesta: [lat, lon, názov, {kategória: priemer za pracovný deň}]
const scitaceBody = new Map<string, any[]>();
for (const [kat, v] of Object.entries<any>(scit?.kategorie ?? {})) {
  for (const s of v.scitace) {
    const b = scitaceBody.get(s.nazov) ?? [s.lat, s.lon, s.nazov, {}];
    b[3][kat] = s.pracovny_den_spolu;
    scitaceBody.set(s.nazov, b);
  }
}

const rok = obyv ? Object.keys(obyv.mesto.roky).sort().pop()! : '';
const mc = new Map<string, any>((obyv?.mestske_casti ?? []).map((c: any) => [c.kod.slice(-6), c]));
const inline = {
  hranice: hranice && {
    type: 'FeatureCollection',
    features: hranice.features.map((f: any) => {
      const c = mc.get(f.properties.kod_obce);
      return { type: 'Feature', geometry: f.geometry, properties: { n: c?.nazov_kratky ?? f.properties.nazov, o: c?.roky[rok], r: f.properties.rozloha_km2 } };
    }),
  },
  mhd: mhd?.zastavky.map((z: any) => [z.lat, z.lon, z.nazov, z.odchody]) ?? null,
  bajk: bajk?.stanice.map((s: any) => [s.lat, s.lon, s.nazov]) ?? null,
  skladky: prostredie?.cierne_skladky.body.map((b: any) => [b.lat, b.lon]) ?? null,
  scitace: scit ? [...scitaceBody.values()] : null,
};

// Vrstvy: kľúč, názov, skupina, farba (CSS premenná), zdroj, predvolene zapnutá
const vrstvy = [
  ['hranice', 'Mestské časti', 'Základ', '--m-hranice', true],
  ['uzavierky', 'Uzávierky a rozkopávky', 'Na cestách dnes', '--m-uzavierky', false],
  ['poruchy', 'Poruchy vedení', 'Na cestách dnes', '--m-poruchy', false],
  ['mhd', 'Zastávky MHD', 'Doprava', '--m-mhd', false],
  ['scitace', 'Sčítače dopravy', 'Doprava', '--m-scitace', false],
  ['cyklo', 'Cyklotrasy', 'Doprava', '--m-cyklo', false],
  ['bajk', 'Stanice BAjk', 'Doprava', '--m-bajk', false],
  ['lekarne', 'Lekárne', 'Vybavenosť', '--m-lekarne', false],
  ['nemocnice', 'Nemocnice a polikliniky', 'Vybavenosť', '--m-nemocnice', false],
  ['ambulancie', 'Ambulancie (neúplné)', 'Vybavenosť', '--m-ambulancie', false],
  ['nabijanie', 'Nabíjacie stanice', 'Vybavenosť', '--m-nabijanie', false],
  ['jasle', 'Jasle (deti do 3 rokov)', 'Školy a sociálne služby', '--m-jasle', false],
  ['skoly_ms', 'Materské školy', 'Školy a sociálne služby', '--m-skoly_ms', false],
  ['skoly_zs', 'Základné školy', 'Školy a sociálne služby', '--m-skoly_zs', false],
  ['obvody', 'Spádové obvody ZŠ', 'Školy a sociálne služby', '--m-obvody', false],
  ['skoly_ss', 'Stredné a špeciálne školy', 'Školy a sociálne služby', '--m-skoly_ss', false],
  ['skoly_zus', 'Umelecké školy a CVČ', 'Školy a sociálne služby', '--m-skoly_zus', false],
  ['socialne', 'Sociálne služby', 'Školy a sociálne služby', '--m-socialne', false],
  ['bezbarierove', 'Bezbariérové miesta', 'Mesto pre ľudí', '--m-bezbarierove', false],
  ['fontany', 'Pitné fontány', 'Mesto pre ľudí', '--m-fontany', false],
  ['sportoviska', 'Športoviská', 'Mesto pre ľudí', '--m-sportoviska', false],
  ['bezdomovci', 'Pomoc ľuďom bez domova', 'Mesto pre ľudí', '--m-bezdomovci', false],
  ['veterina', 'Veterinárne ambulancie', 'Mesto pre ľudí', '--m-veterina', false],
  ['podnety', 'Podnety občanov (12 mesiacov)', 'Mesto pre ľudí', '--m-podnety', false],
  ['pamiatky', 'Kultúrne pamiatky (register)', 'Kultúra a príroda', '--m-pamiatky', false],
  ['pamiatky_osm', 'Pamiatky s fotkami (OSM)', 'Kultúra a príroda', '--m-pamiatky_osm', false],
  ['muzea', 'Múzeá a galérie', 'Kultúra a príroda', '--m-muzea', false],
  ['kultura', 'Divadlá, kiná a knižnice', 'Kultúra a príroda', '--m-kultura', false],
  ['stromy', 'Chránené stromy', 'Kultúra a príroda', '--m-stromy', false],
  ['vysadba', 'Vysadené stromy (od 2019)', 'Kultúra a príroda', '--m-vysadba', false],
  ['starostlivost', 'Ošetrené dreviny', 'Kultúra a príroda', '--m-starostlivost', false],
  ['narodne', 'Chránené územia', 'Kultúra a príroda', '--m-narodne', true],
  ['natura', 'Natura 2000', 'Kultúra a príroda', '--m-natura', false],
  ['hluk_den', 'Hluk z ciest – celý deň', 'Prostredie', '--m-hluk', false],
  ['hluk_noc', 'Hluk z ciest – noc', 'Prostredie', '--m-hluk', false],
  ['hluk_priemysel', 'Hluk z priemyslu', 'Prostredie', '--m-hluk', false],
  ['skladky', 'Čierne skládky 2025', 'Prostredie', '--m-skladky', false],
  ['k_riziko_horucavy', 'Riziko horúčav', 'Klíma a obyvatelia', '--m-klima', false],
  ['k_citlivost_horucavy', 'Citlivosť obyvateľov na horúčavy', 'Klíma a obyvatelia', '--m-klima', false],
  ['k_riziko_zrazky_budovy', 'Riziko prívalových dažďov pre budovy', 'Klíma a obyvatelia', '--m-klima', false],
  ['k_riziko_doprava', 'Riziko zrážok pre dopravu', 'Klíma a obyvatelia', '--m-klima', false],
  ['k_riziko_celkove', 'Riziko zmeny klímy celkovo', 'Klíma a obyvatelia', '--m-klima', false],
  ['k_kupaliska', 'Dostupnosť kúpalísk', 'Klíma a obyvatelia', '--m-klima', false],
  ['k_hustota', 'Hustota obyvateľov (1 km²)', 'Klíma a obyvatelia', '--m-klima', false],
] as const;
const skupiny = [...new Set(vrstvy.map((v) => v[2]))];
---
<Base title="Mapa Bratislavy – mestovcislach.sk" description="Interaktívna mapa Bratislavy: mestské časti, MHD, cyklotrasy, školy a spádové obvody, jasle, sociálne služby, lekárne, pamiatky, hluk, chránená príroda.">
  <section class="hero">
    <p class="kicker">Bratislava</p>
    <h1>Mapa</h1>
    <p class="lead">Všetky mapové údaje na jednom mieste, vrátane dnešných uzávierok a porúch. Vrstvy zapnete v paneli, po ťuknutí na bod uvidíte adresu, otváracie hodiny, web a fotku, ak ich OpenStreetMap má.</p>
  </section>

  <div class="mapa-obal" id="mapa-bratislava" data-inline={JSON.stringify(inline)}>
    <div id="mapa"></div>
    <details class="panel" open>
      <summary>Vrstvy</summary>
      <div class="panel-obsah">
        <fieldset class="podklad">
          <legend>Podklad</legend>
          <label><input type="radio" name="podklad" value="mapa" checked />Mapa</label>
          <label><input type="radio" name="podklad" value="orto" />Letecká snímka</label>
        </fieldset>
        {skupiny.map((sk) => (
          <fieldset>
            <legend>{sk}</legend>
            {vrstvy.filter((v) => v[2] === sk).map(([k, nazov, , farba, zap]) => (
              <label><input type="checkbox" value={k} checked={zap} /><i style={`background:var(${farba})`}></i>{nazov}</label>
            ))}
            {sk === 'Klíma a obyvatelia' && <p class="legenda-klima" hidden><span class="lk-nazov"></span><span class="lk-skala"><i style="--c:#fef3c7"></i><i style="--c:#fcd34d"></i><i style="--c:#f59e0b"></i><i style="--c:#dc2626"></i><i style="--c:#7f1d1d"></i></span><span class="lk-text">nízke → vysoké</span></p>}
            {sk === 'Prostredie' && <p class="legenda-hluk" hidden><span style="--c:#facc15">55</span><span style="--c:#f97316">60</span><span style="--c:#dc2626">65</span><span style="--c:#7e22ce">70+</span> dB</p>}
          </fieldset>
        ))}
      </div>
    </details>
  </div>

  <p class="zdroj">
    Zdroje: kultúrne pamiatky – register MK SR, polohy podľa registra adries MV SR; školy – Digitálna mapa škôl MŠVVaM SR; spádové obvody – rajonizácia
    hlavného mesta (hranice približné); sociálne služby a jasle – register MPSVR SR; chránené stromy – ŠOP SR; hluk – strategické hlukové mapy ÚVZ SR
    (všetko <a href="https://data.slovensko.sk">data.slovensko.sk</a>); mestské časti, múzeá a kultúra, pamiatky s fotkami, cyklotrasy, lekárne, zdravotníctvo a nabíjanie © prispievatelia
    <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> (ODbL); zastávky MHD, BAjk, sčítače a čierne skládky –
    <a href="https://data.bratislava.sk">data.bratislava.sk</a> (CC BY 4.0); uzávierky a poruchy – živo z evidencie hlavného mesta; chránené územia a Natura 2000 –
    <a href="https://www.eea.europa.eu/en/datahub">EEA</a>; letecká snímka – © Esri, Maxar, Earthstar Geographics;
    podkladová mapa © prispievatelia OpenStreetMap; fotky Wikimedia Commons (autori a licencie po kliknutí na fotku). Údaje z OSM nie sú oficiálne registre a nemusia byť úplné.
  </p>
</Base>

<script>
  import L from 'leaflet';
  import { osmPodklad } from '../scripts/podklad';
  import { uzavierky, poruchy, popup, type Obmedzenie } from '../scripts/uzavierky';
  import { popupMiesta } from '../scripts/miesto';
  import { popupPamiatky, popupSkoly, popupSocialne, popupStromy, popupObvodu, popupVrstvy } from '../scripts/popupy';
  import 'leaflet/dist/leaflet.css';

  const obal = document.getElementById('mapa-bratislava')!;
  const inline = JSON.parse(obal.dataset.inline!);
  const css = getComputedStyle(document.documentElement);
  const farba = (k: string) => css.getPropertyValue(`--m-${k}`).trim();
  const tmava = window.matchMedia('(prefers-color-scheme: dark)').matches;
  const okraj = tmava ? '#121417' : '#ffffff';
  const fmt = (n: number) => n?.toLocaleString('sk-SK');
  const mobil = window.innerWidth < 600;

  const mapa = L.map('mapa', { zoomSnap: 0.25, preferCanvas: true, scrollWheelZoom: !mobil });
  const podklady: Record<string, L.Layer> = {
    mapa: osmPodklad(),
    // Letecká snímka Esri World Imagery (bez kľúča) + referenčné vrstvy s cestami a názvami.
    orto: L.layerGroup(),
  };
  const ESRI = 'https://server.arcgisonline.com/ArcGIS/rest/services/';
  mapa.createPane('popisky');
  const panePopisky = mapa.getPane('popisky')!;
  panePopisky.style.zIndex = '450';
  panePopisky.style.pointerEvents = 'none';
  const snimka = L.tileLayer(`${ESRI}World_Imagery/MapServer/tile/{z}/{y}/{x}`, {
    maxZoom: 19, attribution: 'Snímky © Esri, Maxar, Earthstar Geographics',
  }).addTo(podklady.orto as L.LayerGroup);
  for (const vrstva of ['Reference/World_Transportation', 'Reference/World_Boundaries_and_Places']) {
    L.tileLayer(`${ESRI}${vrstva}/MapServer/tile/{z}/{y}/{x}`, { maxZoom: 19, pane: 'popisky' }).addTo(podklady.orto as L.LayerGroup);
  }
  let chyby = 0;
  snimka.on('tileerror', () => {
    chyby += 1;
    if (chyby === 8) {
      const r = obal.querySelector<HTMLInputElement>('input[value=orto]')!;
      r.disabled = true;
      r.parentElement!.title = 'Letecká snímka je momentálne nedostupná';
      obal.querySelector<HTMLInputElement>('input[value=mapa]')!.click();
    }
  });
  podklady.mapa.addTo(mapa);
  mapa.setView([48.155, 17.11], mobil ? 10.75 : 11.5);

  const bod = (lat: number, lon: number, k: string, r = mobil ? 4 : 5) =>
    L.circleMarker([lat, lon], { radius: r, weight: 1, color: okraj, fillColor: farba(k), fillOpacity: 0.9 });
  const cache: Record<string, Promise<any>> = {};
  const json = (url: string) => (cache[url] ??= fetch(url).then((r) => r.json()));

  // Tvorba vrstiev – každá sa vytvorí až pri prvom zapnutí.
  const tvorba: Record<string, () => Promise<L.Layer>> = {
    hranice: async () => {
      const v = L.geoJSON(inline.hranice, {
        style: { color: farba('hranice'), weight: 1.5, fillOpacity: 0.04, fillColor: farba('hranice') },
        onEachFeature: (f: any, l) => l.bindPopup(`<strong>${f.properties.n}</strong><br>${fmt(f.properties.o)} obyvateľov<br>${f.properties.r.toLocaleString('sk-SK')} km²`),
      });
      mapa.fitBounds(v.getBounds(), { padding: [8, 8] });
      return v;
    },
    mhd: async () => {
      const max = Math.max(...inline.mhd.map((z: any[]) => z[3]));
      return L.layerGroup(inline.mhd.map(([lat, lon, n, o]: any[]) =>
        bod(lat, lon, 'mhd', 2 + 8 * Math.sqrt(o / max)).bindPopup(`<strong>${n}</strong><br>${fmt(o)} odchodov za pracovný deň`)));
    },
    bajk: async () => L.layerGroup(inline.bajk.map(([lat, lon, n]: any[]) => bod(lat, lon, 'bajk').bindPopup(`<strong>${n}</strong><br>Stanica Slovnaft BAjk`))),
    skladky: async () => L.layerGroup(inline.skladky.map(([lat, lon]: any[]) => bod(lat, lon, 'skladky', 6).bindPopup('Čierna skládka nahlásená v roku 2025'))),
    scitace: async () => {
      const J: Record<string, string> = { auta: 'áut', cyklisti: 'cyklistov', chodci: 'chodcov' };
      return L.layerGroup(inline.scitace.map(([lat, lon, n, k]: any[]) => bod(lat, lon, 'scitace', mobil ? 5 : 6).bindPopup(
        `<strong>Sčítač ${n}</strong><br>${Object.entries(k).map(([kat, v]) => `${fmt(v as number)} ${J[kat]}`).join('<br>')}<br><span style="opacity:.75">priemer za pracovný deň · <a href="/doprava#premavka">kedy je špička</a></span>`)));
    },
    uzavierky: async () => obmedzenia(await uzavierky(), 'uzavierky'),
    poruchy: async () => obmedzenia(await poruchy(), 'poruchy'),
    cyklo: async () => L.geoJSON(await json('/data/cyklotrasy-bratislava.geojson'), { style: { color: farba('cyklo'), weight: 2.5 }, interactive: false }),
    narodne: async () => priroda('narodne'),
    natura: async () => priroda('natura'),
  };
  function obmedzenia(zoz: Obmedzenie[], k: string) {
    return L.layerGroup(zoz.map((o) => L.circleMarker([o.lat, o.lon], {
      radius: o.uzavierka === 'úplná' ? 8 : 6, weight: 1.5, color: okraj, fillColor: farba(k), fillOpacity: o.planovana ? 0.45 : 0.95,
    }).bindPopup(popup(o))));
  }
  async function priroda(typ: string) {
    const d = await json('/data/priroda-bratislava.geojson');
    return L.geoJSON({ ...d, features: d.features.filter((f: any) => f.properties.t === typ) }, {
      style: { color: farba(typ), weight: 1, fillColor: farba(typ), fillOpacity: typ === 'natura' ? 0.15 : 0.25, dashArray: typ === 'natura' ? '4 3' : undefined },
      onEachFeature: (f: any, l) => l.bindPopup(`<strong>${f.properties.n}</strong><br>${f.properties.k}<br>${f.properties.km2.toLocaleString('sk-SK')} km² v Bratislave`),
    });
  }
  for (const k of ['lekarne', 'nemocnice', 'ambulancie', 'nabijanie']) {
    tvorba[k] = async () => {
      const d = await json('/data/vybavenost-bratislava.json');
      return L.layerGroup(d.body.filter((b: any[]) => b[2] === k).map(([lat, lon, , n, det]: any[]) =>
        bod(lat, lon, k).bindPopup(() => popupMiesta(n, d.kategorie[k], det), { maxWidth: 280 })));
    };
  }
  for (const k of ['muzea', 'kultura']) {
    tvorba[k] = async () => {
      const d = await json('/data/pamiatky-bratislava.json');
      return L.layerGroup(d.body.filter((b: any[]) => b[2] === k).map(([lat, lon, , n, det]: any[]) =>
        bod(lat, lon, k).bindPopup(() => popupMiesta(n, d.kategorie[k] ?? '', det), { maxWidth: 280 })));
    };
  }
  tvorba.pamiatky_osm = async () => {
    const d = await json('/data/pamiatky-bratislava.json');
    return L.layerGroup(d.body.filter((b: any[]) => b[2] === 'pamiatky').map(([lat, lon, , n, det]: any[]) =>
      bod(lat, lon, 'pamiatky_osm').bindPopup(() => popupMiesta(n, 'Pamiatka (OpenStreetMap)', det), { maxWidth: 280 })));
  };
  // Oficiálny register pamiatok MK SR (poloha podľa registra adries)
  tvorba.pamiatky = async () => {
    const d = await json('/data/pamiatky-register.json');
    return L.layerGroup(d.body.map(([lat, lon, n, det]: any[]) => bod(lat, lon, 'pamiatky').bindPopup(() => popupPamiatky(n, det), { maxWidth: 280 })));
  };
  tvorba.stromy = async () => {
    const d = await json('/data/stromy-sop.json');
    return L.layerGroup(d.body.map(([lat, lon, n, det]: any[]) => bod(lat, lon, 'stromy').bindPopup(() => popupStromy(n, det), { maxWidth: 280 })));
  };
  const SKOLY: Record<string, string[]> = { skoly_ms: ['ms'], skoly_zs: ['zs'], skoly_ss: ['ss', 'spec'], skoly_zus: ['zus', 'cvc'] };
  for (const [k, typy] of Object.entries(SKOLY)) {
    tvorba[k] = async () => {
      const d = await json('/data/skoly-iedu.json');
      return L.layerGroup(d.body.filter((b: any[]) => typy.includes(b[2])).map(([lat, lon, t, n, det]: any[]) =>
        bod(lat, lon, k).bindPopup(() => popupSkoly(n, t, det), { maxWidth: 280 })));
    };
  }
  for (const k of ['jasle', 'socialne']) {
    tvorba[k] = async () => {
      const d = await json('/data/socialne-bratislava.json');
      return L.layerGroup(d.body.filter((b: any[]) => (b[2] === 'deti') === (k === 'jasle')).map(([lat, lon, kat, n, det]: any[]) =>
        bod(lat, lon, k).bindPopup(() => popupSocialne(n, d.kategorie[kat], det), { maxWidth: 280 })));
    };
  }
  tvorba.obvody = async () => {
    const d = await json('/data/obvody-zs-bratislava.geojson');
    const PALETA = ['#1f6fd1', '#c8102e', '#138a5e', '#a16207', '#7a4fd1', '#0e7490', '#db2777', '#4d7c0f'];
    return L.geoJSON(d, {
      style: (f: any) => ({ color: PALETA[f.properties.zs % PALETA.length], weight: 1, fillColor: PALETA[f.properties.zs % PALETA.length], fillOpacity: 0.18 }),
      onEachFeature: (f: any, l) => l.bindPopup(popupObvodu(f.properties), { maxWidth: 280 }),
    });
  };
  for (const k of ['bezbarierove', 'fontany', 'sportoviska', 'bezdomovci', 'veterina']) {
    tvorba[k] = async () => {
      const d = await json('/data/vrstvy-bratislava.json');
      return L.layerGroup(d.body.filter((b: any[]) => b[2] === k).map(([lat, lon, , n, det]: any[]) =>
        bod(lat, lon, k).bindPopup(() => popupVrstvy(n, d.kategorie[k], det), { maxWidth: 280 })));
    };
  }
  for (const k of ['vysadba', 'starostlivost']) {
    tvorba[k] = async () => {
      const d = await json('/data/stromy-mesto.json');
      return L.layerGroup(d.body.filter((b: any[]) => b[2] === k).map(([lat, lon, , n, det]: any[]) =>
        bod(lat, lon, k, mobil ? 2.5 : 3).bindPopup(() => popupVrstvy(n, d.kategorie[k], det), { maxWidth: 280 })));
    };
  }
  tvorba.podnety = async () => {
    const d = await json('/data/podnety-bratislava.json');
    return L.layerGroup(d.body.map(([lat, lon, kat, pod, stav, dat]: any[]) => bod(lat, lon, 'podnety', mobil ? 2.5 : 3)
      .bindPopup(`<strong>${kat}</strong>${pod ? `<br>${pod}` : ''}<br>stav: ${stav}<br><span style="opacity:.75">nahlásené ${dat.split('-').reverse().join('. ')} · podnety magistrátu</span>`)));
  };
  // Mriežky klimatického atlasu a hustoty – vždy len jedna naraz, farba podľa kvintilov
  const KLIMA_FARBY = ['#fef3c7', '#fcd34d', '#f59e0b', '#dc2626', '#7f1d1d'];
  const klimaRenderer = L.canvas({ padding: 0.2 });
  for (const k of ['riziko_horucavy', 'citlivost_horucavy', 'riziko_zrazky_budovy', 'riziko_doprava', 'riziko_celkove', 'kupaliska', 'hustota']) {
    tvorba[`k_${k}`] = async () => {
      const d = await json(`/data/klima/${k}.json`);
      const trieda = (v: number) => d.hranice.filter((h: number) => v > h).length;
      const lg = obal.querySelector<HTMLElement>('.legenda-klima')!;
      lg.querySelector('.lk-nazov')!.textContent = d.nazov;
      return L.layerGroup(d.bunky.map(([s1, w, n, e, v]: number[]) => L.rectangle([[s1, w], [n, e]], {
        renderer: klimaRenderer, stroke: false, fillColor: KLIMA_FARBY[trieda(v)], fillOpacity: 0.55,
      }).bindPopup(`<strong>${d.nazov}</strong><br>hodnota ${v.toLocaleString('sk-SK')} (${['veľmi nízka', 'nízka', 'stredná', 'vysoká', 'veľmi vysoká'][trieda(v)]} v rámci mesta)<br><span style="opacity:.75">${d.popis}</span>`)));
    };
  }
  const HLUK: Record<string, string> = { 55: '#facc15', 60: '#f97316', 65: '#dc2626', 70: '#7e22ce' };
  const HLUK_VRSTVY: Record<string, string> = { hluk_den: 'cesty_lden', hluk_noc: 'cesty_lnight', hluk_priemysel: 'priemysel_lden' };
  for (const [k, v] of Object.entries(HLUK_VRSTVY)) {
    tvorba[k] = async () => {
      const d = await json('/data/hluk-bratislava.json');
      const vrstva = d.vrstvy[v];
      return L.layerGroup(Object.entries<any>(vrstva.ciary).map(([db, ciary]) =>
        L.polyline(ciary, { color: HLUK[db], weight: Number(db) >= 65 ? 2.2 : 1.6, opacity: 0.9 })
          .bindPopup(`<strong>${db === '70' ? '70 dB a viac' : `${db} dB`}</strong><br>${vrstva.nazov}<br><span style="opacity:.75">izofóna strategickej hlukovej mapy (ÚVZ SR); WHO odporúča pri hluku z ciest najviac 53 dB (Lden) a 45 dB v noci</span>`)));
    };
  }

  const hotove: Record<string, L.Layer> = {};
  const poradie = ['natura', 'narodne', 'hranice', 'cyklo', 'mhd', 'bajk', 'scitace', 'lekarne', 'nemocnice', 'ambulancie', 'nabijanie', 'k_riziko_horucavy', 'k_citlivost_horucavy', 'k_riziko_zrazky_budovy', 'k_riziko_doprava', 'k_riziko_celkove', 'k_kupaliska', 'k_hustota', 'obvody', 'hluk_den', 'hluk_noc', 'hluk_priemysel', 'jasle', 'skoly_ms', 'skoly_zs', 'skoly_ss', 'skoly_zus', 'socialne', 'bezbarierove', 'fontany', 'sportoviska', 'bezdomovci', 'veterina', 'podnety', 'vysadba', 'starostlivost', 'pamiatky', 'pamiatky_osm', 'muzea', 'kultura', 'stromy', 'skladky', 'uzavierky', 'poruchy'];
  async function prepni(k: string, zapnut: boolean) {
    if (!zapnut) { hotove[k]?.remove(); return; }
    try {
      hotove[k] ??= await tvorba[k]();
      hotove[k].addTo(mapa);
      // plochy dozadu, aby body ostali klikateľné
      if (['natura', 'narodne', 'hranice', 'obvody'].includes(k) || k.startsWith('k_')) (hotove[k] as any).bringToBack?.();
    } catch {
      const i = obal.querySelector<HTMLInputElement>(`input[value="${k}"]`);
      if (i) { i.checked = false; i.disabled = true; i.parentElement!.title = 'Údaje sa nepodarilo načítať'; }
    }
  }
  obal.querySelectorAll<HTMLInputElement>('input[type=checkbox]').forEach((i) => {
    if (!tvorba[i.value] || (inline[i.value] === null)) { i.disabled = true; return; }
    i.addEventListener('change', () => {
      // mriežky klímy a hustoty sa navzájom vylučujú
      if (i.value.startsWith('k_') && i.checked) {
        obal.querySelectorAll<HTMLInputElement>('input[value^="k_"]').forEach((x) => { if (x !== i && x.checked) { x.checked = false; prepni(x.value, false); } });
      }
      obal.querySelector<HTMLElement>('.legenda-klima')!.hidden = ![...obal.querySelectorAll<HTMLInputElement>('input[value^="k_"]')].some((x) => x.checked);
      prepni(i.value, i.checked);
      const hluk = [...obal.querySelectorAll<HTMLInputElement>('input[value^=hluk]')].some((x) => x.checked);
      obal.querySelector<HTMLElement>('.legenda-hluk')!.hidden = !hluk;
    });
  });
  // odkaz /mapa#hluk, #skoly, #pamiatky… zapne zodpovedajúce vrstvy
  const HASH: Record<string, string[]> = { hluk: ['hluk_den'], skoly: ['skoly_zs', 'obvody'], pamiatky: ['pamiatky'], socialne: ['jasle', 'socialne'],
    horucavy: ['k_riziko_horucavy', 'fontany'], klima: ['k_riziko_celkove'], hustota: ['k_hustota'], sport: ['sportoviska'], bezbarierove: ['bezbarierove'],
    podnety: ['podnety'], stromy: ['vysadba'], fontany: ['fontany'] };
  for (const k of HASH[location.hash.slice(1)] ?? []) {
    const i = obal.querySelector<HTMLInputElement>(`input[value="${k}"]`);
    if (i) i.checked = true;
    if (k.startsWith('hluk')) obal.querySelector<HTMLElement>('.legenda-hluk')!.hidden = false;
    if (k.startsWith('k_')) obal.querySelector<HTMLElement>('.legenda-klima')!.hidden = false;
  }
  (async () => {
    for (const k of poradie) {
      const i = obal.querySelector<HTMLInputElement>(`input[value="${k}"]`);
      if (i?.checked && !i.disabled) await prepni(k, true);
    }
  })();
  obal.querySelectorAll<HTMLInputElement>('input[name=podklad]').forEach((i) =>
    i.addEventListener('change', () => {
      Object.entries(podklady).forEach(([k, l]) => (k === i.value ? l.addTo(mapa) : l.remove()));
      (podklady[i.value] as any).bringToBack?.();
    }),
  );
  if (mobil) obal.querySelector('details')!.removeAttribute('open');
</script>

