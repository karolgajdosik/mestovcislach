---
// Spoločná mapa Bratislavy: všetky geodáta webu ako prepínateľné vrstvy.
// Menšie vrstvy sú priamo v stránke, väčšie sa načítajú z /data/*.json až po zapnutí.
import fs from 'node:fs';
import path from 'node:path';
import Base from '../layouts/Base.astro';

const nacitaj = (subor: string) => {
  const p = path.join(process.cwd(), 'data', subor);
  return fs.existsSync(p) ? JSON.parse(fs.readFileSync(p, 'utf-8')) : null;
};
const hranice = nacitaj('hranice-bratislava.geojson');
const obyv = nacitaj('obyvatelstvo-bratislava.json');
const mhd = nacitaj('doprava-bratislava.json');
const bajk = nacitaj('bajk-bratislava.json');
const prostredie = nacitaj('prostredie-bratislava.json');
const scit = nacitaj('scitace-bratislava.json');
// Sčítače zlúčené podľa miesta: [lat, lon, názov, {kategória: priemer za pracovný deň}]
const scitaceBody = new Map<string, any[]>();
for (const [kat, v] of Object.entries<any>(scit?.kategorie ?? {})) {
  for (const s of v.scitace) {
    const b = scitaceBody.get(s.nazov) ?? [s.lat, s.lon, s.nazov, {}];
    b[3][kat] = s.pracovny_den_spolu;
    scitaceBody.set(s.nazov, b);
  }
}

const rok = obyv ? Object.keys(obyv.mesto.roky).sort().pop()! : '';
const mc = new Map<string, any>((obyv?.mestske_casti ?? []).map((c: any) => [c.kod.slice(-6), c]));
const inline = {
  hranice: hranice && {
    type: 'FeatureCollection',
    features: hranice.features.map((f: any) => {
      const c = mc.get(f.properties.kod_obce);
      return { type: 'Feature', geometry: f.geometry, properties: { n: c?.nazov_kratky ?? f.properties.nazov, o: c?.roky[rok], r: f.properties.rozloha_km2 } };
    }),
  },
  mhd: mhd?.zastavky.map((z: any) => [z.lat, z.lon, z.nazov, z.odchody]) ?? null,
  bajk: bajk?.stanice.map((s: any) => [s.lat, s.lon, s.nazov]) ?? null,
  skladky: prostredie?.cierne_skladky.body.map((b: any) => [b.lat, b.lon]) ?? null,
  scitace: scit ? [...scitaceBody.values()] : null,
};

// Vrstvy: kľúč, názov, skupina, farba (CSS premenná), zdroj, predvolene zapnutá
const vrstvy = [
  ['hranice', 'Mestské časti', 'Základ', '--m-hranice', true],
  ['uzavierky', 'Uzávierky a rozkopávky', 'Na cestách dnes', '--m-uzavierky', false],
  ['poruchy', 'Poruchy vedení', 'Na cestách dnes', '--m-poruchy', false],
  ['mhd', 'Zastávky MHD', 'Doprava', '--m-mhd', false],
  ['scitace', 'Sčítače dopravy', 'Doprava', '--m-scitace', false],
  ['cyklo', 'Cyklotrasy', 'Doprava', '--m-cyklo', false],
  ['bajk', 'Stanice BAjk', 'Doprava', '--m-bajk', false],
  ['lekarne', 'Lekárne', 'Vybavenosť', '--m-lekarne', false],
  ['nemocnice', 'Nemocnice a polikliniky', 'Vybavenosť', '--m-nemocnice', false],
  ['ambulancie', 'Ambulancie (neúplné)', 'Vybavenosť', '--m-ambulancie', false],
  ['nabijanie', 'Nabíjacie stanice', 'Vybavenosť', '--m-nabijanie', false],
  ['jasle', 'Jasle (deti do 3 rokov)', 'Školy a sociálne služby', '--m-jasle', false],
  ['skoly_ms', 'Materské školy', 'Školy a sociálne služby', '--m-skoly_ms', false],
  ['skoly_zs', 'Základné školy', 'Školy a sociálne služby', '--m-skoly_zs', false],
  ['obvody', 'Spádové obvody ZŠ', 'Školy a sociálne služby', '--m-obvody', false],
  ['skoly_ss', 'Stredné a špeciálne školy', 'Školy a sociálne služby', '--m-skoly_ss', false],
  ['skoly_zus', 'Umelecké školy a CVČ', 'Školy a sociálne služby', '--m-skoly_zus', false],
  ['socialne', 'Sociálne služby', 'Školy a sociálne služby', '--m-socialne', false],
  ['bezbarierove', 'Bezbariérové miesta', 'Mesto pre ľudí', '--m-bezbarierove', false],
  ['fontany', 'Pitné fontány', 'Mesto pre ľudí', '--m-fontany', false],
  ['sportoviska', 'Športoviská', 'Mesto pre ľudí', '--m-sportoviska', false],
  ['bezdomovci', 'Pomoc ľuďom bez domova', 'Mesto pre ľudí', '--m-bezdomovci', false],
  ['veterina', 'Veterinárne ambulancie', 'Mesto pre ľudí', '--m-veterina', false],
  ['ochladzovanie', 'Ochladzovacie miesta v lete', 'Mesto pre ľudí', '--m-ochladzovanie', false],
  ['debarierizacie', 'Debarierizované chodníky', 'Mesto pre ľudí', '--m-debarierizacie', false],
  ['fixpointy', 'Fixpointy (injekčné striekačky)', 'Mesto pre ľudí', '--m-fixpointy', false],
  ['podnety', 'Podnety občanov (posledný rok v dátach)', 'Mesto pre ľudí', '--m-podnety', false],
  ['pamiatky', 'Kultúrne pamiatky (register)', 'Kultúra a príroda', '--m-pamiatky', false],
  ['pamiatky_osm', 'Pamiatky s fotkami (OSM)', 'Kultúra a príroda', '--m-pamiatky_osm', false],
  ['muzea', 'Múzeá a galérie', 'Kultúra a príroda', '--m-muzea', false],
  ['kultura', 'Divadlá, kiná a knižnice', 'Kultúra a príroda', '--m-kultura', false],
  ['stromy', 'Chránené stromy', 'Kultúra a príroda', '--m-stromy', false],
  ['vysadba', 'Vysadené stromy (od 2019)', 'Kultúra a príroda', '--m-vysadba', false],
  ['starostlivost', 'Ošetrené dreviny', 'Kultúra a príroda', '--m-starostlivost', false],
  ['narodne', 'Chránené územia', 'Kultúra a príroda', '--m-narodne', true],
  ['natura', 'Natura 2000', 'Kultúra a príroda', '--m-natura', false],
  ['hluk_den', 'Hluk z ciest – celý deň', 'Prostredie', '--m-hluk', false],
  ['hluk_noc', 'Hluk z ciest – noc', 'Prostredie', '--m-hluk', false],
  ['hluk_priemysel', 'Hluk z priemyslu', 'Prostredie', '--m-hluk', false],
  ['skladky', 'Čierne skládky 2025', 'Prostredie', '--m-skladky', false],
  ['k_riziko_horucavy', 'Riziko horúčav', 'Klíma a obyvatelia', '--m-klima', false],
  ['k_citlivost_horucavy', 'Citlivosť obyvateľov na horúčavy', 'Klíma a obyvatelia', '--m-klima', false],
  ['k_riziko_zrazky_budovy', 'Riziko prívalových dažďov pre budovy', 'Klíma a obyvatelia', '--m-klima', false],
  ['k_riziko_doprava', 'Riziko zrážok pre dopravu', 'Klíma a obyvatelia', '--m-klima', false],
  ['k_riziko_celkove', 'Riziko zmeny klímy celkovo', 'Klíma a obyvatelia', '--m-klima', false],
  ['k_citlivost_celkova', 'Citlivosť na zmenu klímy celkovo', 'Klíma a obyvatelia', '--m-klima', false],
  ['k_citlivost_zrazky_budovy', 'Citlivosť budov na zrážky', 'Klíma a obyvatelia', '--m-klima', false],
  ['k_citlivost_doprava', 'Citlivosť dopravy na zrážky', 'Klíma a obyvatelia', '--m-klima', false],
  ['k_kapacita_budov_zrazky', 'Kapacita budov zvládnuť zrážky', 'Klíma a obyvatelia', '--m-klima', false],
  ['k_kupaliska', 'Dostupnosť kúpalísk', 'Klíma a obyvatelia', '--m-klima', false],
  ['k_hustota', 'Hustota obyvateľov (1 km²)', 'Klíma a obyvatelia', '--m-klima', false],
] as const;
// Témy v bočnom paneli: id, názov, krátky popis, farba značky, vrstvy, čo sa zapne pri prvom otvorení
const TEMY: [string, string, string, string, string[], string[]][] = [
  ['cesty', 'Na cestách dnes', 'uzávierky, rozkopávky, poruchy', '--m-uzavierky', ['uzavierky', 'poruchy'], ['uzavierky', 'poruchy']],
  ['doprava', 'Doprava', 'MHD, cyklotrasy, BAjk, nabíjanie', '--m-mhd', ['mhd', 'cyklo', 'bajk', 'scitace', 'nabijanie'], ['mhd']],
  ['skoly', 'Školy a škôlky', 'ZŠ, MŠ, jasle, spádové obvody', '--m-skoly_zs', ['skoly_zs', 'skoly_ms', 'jasle', 'obvody', 'skoly_ss', 'skoly_zus'], ['skoly_zs', 'skoly_ms']],
  ['zdravie', 'Zdravie', 'lekárne, nemocnice, ambulancie', '--m-lekarne', ['lekarne', 'nemocnice', 'ambulancie', 'veterina'], ['lekarne']],
  ['sport', 'Šport a voľný čas', 'ihriská, kurty, fontány', '--m-sportoviska', ['sportoviska', 'fontany', 'ochladzovanie'], ['sportoviska']],
  ['kultura', 'Kultúra a pamiatky', 'pamiatky, múzeá, divadlá, kiná', '--m-pamiatky', ['pamiatky', 'pamiatky_osm', 'muzea', 'kultura'], ['pamiatky']],
  ['zelen', 'Príroda a zeleň', 'chránené územia, stromy', '--m-narodne', ['narodne', 'natura', 'stromy', 'vysadba', 'starostlivost'], ['narodne']],
  ['klima', 'Klíma a obyvatelia', 'horúčavy, prívalové dažde, hustota', '--m-klima', vrstvy.filter((v) => v[0].startsWith('k_')).map((v) => v[0]), ['k_riziko_horucavy']],
  ['prostredie', 'Hluk a čistota', 'hluk, čierne skládky, podnety', '--m-hluk', ['hluk_den', 'hluk_noc', 'hluk_priemysel', 'skladky', 'podnety'], ['hluk_den']],
  ['pomoc', 'Prístupnosť a pomoc', 'bezbariérovosť, sociálne služby', '--m-bezbarierove', ['bezbarierove', 'debarierizacie', 'socialne', 'bezdomovci', 'fixpointy'], ['bezbarierove']],
];
const vrstva = (k: string) => vrstvy.find((v) => v[0] === k)!;
const nazvyVrstiev = Object.fromEntries(vrstvy.map((v) => [v[0], v[1]]));
const temaVrstvy = Object.fromEntries(TEMY.flatMap((t) => t[4].map((k) => [k, t[0]])));
---
<Base title="Mapa Bratislavy – mestovcislach.sk" description="Interaktívna mapa Bratislavy: mestské časti, MHD, cyklotrasy, školy a spádové obvody, jasle, sociálne služby, lekárne, pamiatky, hluk, chránená príroda.">
  <div class="mapa-app" id="mapa-bratislava" data-inline={JSON.stringify(inline)} data-nazvy={JSON.stringify(nazvyVrstiev)}
    data-temy={JSON.stringify(Object.fromEntries(TEMY.map((t) => [t[0], { n: t[1], v: t[4], p: t[5] }])))} data-tema-vrstvy={JSON.stringify(temaVrstvy)}>
    <aside class="bocny" id="bocny" data-stav="zbalene" aria-label="Vrstvy a hľadanie na mape">
      <button type="button" class="uchyt" id="uchyt" aria-label="Rozbaliť alebo zbaliť panel" aria-expanded="false"><span></span></button>
      <div class="bocny-hlava">
        <h1>Mapa Bratislavy</h1>
        <div class="m-hladaj">
          <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5" /><path d="m15.5 15.5 5 5" /></svg>
          <input id="m-q" type="search" placeholder="Hľadať miesto, mestskú časť alebo vrstvu" autocomplete="off" aria-controls="m-vysledky" />
          <div class="m-vysledky" id="m-vysledky" hidden></div>
        </div>
        <div class="aktivne" id="aktivne" aria-live="polite"></div>
      </div>
      <div class="bocny-telo">
        <div class="temy" id="temy">
          {TEMY.map(([id, nazov, popis, f]) => (
            <button type="button" class="tema" data-tema={id} style={`--t:var(${f})`}>
              <span class="tema-nazov">{nazov}</span>
              <span class="tema-popis">{popis}</span>
              <span class="tema-pocet" data-pocet></span>
            </button>
          ))}
        </div>
        {TEMY.map(([id, nazov, popis, f, kluce]) => (
          <section class="tema-panel" data-tema={id} hidden style={`--t:var(${f})`}>
            <button type="button" class="spat">Všetky témy</button>
            <h2>{nazov}</h2>
            <div class="vrstvy">
              {kluce.map((k) => (
                <label class="vrstva"><input type="checkbox" value={k} checked={vrstva(k)[4]} /><i style={`background:var(${vrstva(k)[3]})`}></i><span>{vrstva(k)[1]}</span></label>
              ))}
            </div>
            {id === 'klima' && <p class="pozn">Mriežky sa prekrývajú, preto sa zobrazuje vždy len jedna.</p>}
            {id === 'cesty' && <p class="pozn">Načítané naživo z evidencie hlavného mesta. Svetlejšie body sú plánované.</p>}
          </section>
        ))}
        <label class="zaklad"><input type="checkbox" value="hranice" checked />Hranice mestských častí</label>
      </div>
    </aside>
    <div class="mapa-plocha">
      <div id="mapa"></div>
      <fieldset class="podklad" aria-label="Podklad mapy">
        <label><input type="radio" name="podklad" value="mapa" checked /><span>Mapa</span></label>
        <label><input type="radio" name="podklad" value="orto" /><span>Snímka</span></label>
      </fieldset>
      <div class="legendy">
        <p class="legenda-klima" hidden><span class="lk-nazov"></span><span class="lk-skala"><i style="--c:#fef3c7"></i><i style="--c:#fcd34d"></i><i style="--c:#f59e0b"></i><i style="--c:#dc2626"></i><i style="--c:#7f1d1d"></i></span><span class="lk-text">nízke → vysoké</span></p>
        <p class="legenda-hluk" hidden><span style="--c:#facc15">55</span><span style="--c:#f97316">60</span><span style="--c:#dc2626">65</span><span style="--c:#7e22ce">70+</span> dB</p>
      </div>
    </div>
  </div>

  <details class="zdroje"><summary>Zdroje údajov na mape</summary><p class="zdroj">
    Zdroje: kultúrne pamiatky – register MK SR, polohy podľa registra adries MV SR; školy – Digitálna mapa škôl MŠVVaM SR; spádové obvody – rajonizácia
    hlavného mesta (hranice približné); sociálne služby a jasle – register MPSVR SR; chránené stromy – ŠOP SR; hluk – strategické hlukové mapy ÚVZ SR
    (všetko <a href="https://data.slovensko.sk">data.slovensko.sk</a>); mestské časti, múzeá a kultúra, pamiatky s fotkami, cyklotrasy, lekárne, zdravotníctvo a nabíjanie © prispievatelia
    <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> (ODbL); zastávky MHD, BAjk, sčítače a čierne skládky –
    <a href="https://data.bratislava.sk">data.bratislava.sk</a> (CC BY 4.0); uzávierky a poruchy – živo z evidencie hlavného mesta; chránené územia a Natura 2000 –
    <a href="https://www.eea.europa.eu/en/datahub">EEA</a>; letecká snímka – © Esri, Maxar, Earthstar Geographics;
    podkladová mapa © prispievatelia OpenStreetMap; fotky Wikimedia Commons (autori a licencie po kliknutí na fotku). Údaje z OSM nie sú oficiálne registre a nemusia byť úplné.
  </p></details>
</Base>

<script>
  import L from 'leaflet';
  import { osmPodklad } from '../scripts/podklad';
  import { uzavierky, poruchy, popup, type Obmedzenie } from '../scripts/uzavierky';
  import { popupMiesta } from '../scripts/miesto';
  import { popupPamiatky, popupSkoly, popupSocialne, popupStromy, popupObvodu, popupVrstvy } from '../scripts/popupy';
  import 'leaflet/dist/leaflet.css';

  const obal = document.getElementById('mapa-bratislava')!;
  const inline = JSON.parse(obal.dataset.inline!);
  const css = getComputedStyle(document.documentElement);
  const farba = (k: string) => css.getPropertyValue(`--m-${k}`).trim();
  const tmava = window.matchMedia('(prefers-color-scheme: dark)').matches;
  const okraj = tmava ? '#121417' : '#ffffff';
  const fmt = (n: number) => n?.toLocaleString('sk-SK');
  const mobil = window.innerWidth < 600;

  const mapa = L.map('mapa', { zoomSnap: 0.25, preferCanvas: true, scrollWheelZoom: !mobil });
  const podklady: Record<string, L.Layer> = {
    mapa: osmPodklad(),
    // Letecká snímka Esri World Imagery (bez kľúča) + referenčné vrstvy s cestami a názvami.
    orto: L.layerGroup(),
  };
  const ESRI = 'https://server.arcgisonline.com/ArcGIS/rest/services/';
  mapa.createPane('popisky');
  const panePopisky = mapa.getPane('popisky')!;
  panePopisky.style.zIndex = '450';
  panePopisky.style.pointerEvents = 'none';
  const snimka = L.tileLayer(`${ESRI}World_Imagery/MapServer/tile/{z}/{y}/{x}`, {
    maxZoom: 19, attribution: 'Snímky © Esri, Maxar, Earthstar Geographics',
  }).addTo(podklady.orto as L.LayerGroup);
  for (const vrstva of ['Reference/World_Transportation', 'Reference/World_Boundaries_and_Places']) {
    L.tileLayer(`${ESRI}${vrstva}/MapServer/tile/{z}/{y}/{x}`, { maxZoom: 19, pane: 'popisky' }).addTo(podklady.orto as L.LayerGroup);
  }
  let chyby = 0;
  snimka.on('tileerror', () => {
    chyby += 1;
    if (chyby === 8) {
      const r = obal.querySelector<HTMLInputElement>('input[value=orto]')!;
      r.disabled = true;
      r.parentElement!.title = 'Letecká snímka je momentálne nedostupná';
      obal.querySelector<HTMLInputElement>('input[value=mapa]')!.click();
    }
  });
  podklady.mapa.addTo(mapa);
  mapa.setView([48.155, 17.11], mobil ? 10.75 : 11.5);

  const bod = (lat: number, lon: number, k: string, r = mobil ? 4 : 5) =>
    L.circleMarker([lat, lon], { radius: r, weight: 1, color: okraj, fillColor: farba(k), fillOpacity: 0.9 });
  const cache: Record<string, Promise<any>> = {};
  const json = (url: string) => (cache[url] ??= fetch(url).then((r) => r.json()));

  // Tvorba vrstiev – každá sa vytvorí až pri prvom zapnutí.
  const tvorba: Record<string, () => Promise<L.Layer>> = {
    hranice: async () => {
      const v = L.geoJSON(inline.hranice, {
        style: { color: farba('hranice'), weight: 1.5, fillOpacity: 0.04, fillColor: farba('hranice') },
        onEachFeature: (f: any, l) => l.bindPopup(`<strong>${f.properties.n}</strong><br>${fmt(f.properties.o)} obyvateľov<br>${f.properties.r.toLocaleString('sk-SK')} km²`),
      });
      if (!location.hash.startsWith('#miesto&')) mapa.fitBounds(v.getBounds(), { padding: [8, 8] });
      return v;
    },
    mhd: async () => {
      const max = Math.max(...inline.mhd.map((z: any[]) => z[3]));
      return L.layerGroup(inline.mhd.map(([lat, lon, n, o]: any[]) =>
        bod(lat, lon, 'mhd', 2 + 8 * Math.sqrt(o / max)).bindPopup(`<strong>${n}</strong><br>${fmt(o)} odchodov za pracovný deň`)));
    },
    bajk: async () => L.layerGroup(inline.bajk.map(([lat, lon, n]: any[]) => bod(lat, lon, 'bajk').bindPopup(`<strong>${n}</strong><br>Stanica Slovnaft BAjk`))),
    skladky: async () => L.layerGroup(inline.skladky.map(([lat, lon]: any[]) => bod(lat, lon, 'skladky', 6).bindPopup('Čierna skládka nahlásená v roku 2025'))),
    scitace: async () => {
      const J: Record<string, string> = { auta: 'áut', cyklisti: 'cyklistov', chodci: 'chodcov' };
      return L.layerGroup(inline.scitace.map(([lat, lon, n, k]: any[]) => bod(lat, lon, 'scitace', mobil ? 5 : 6).bindPopup(
        `<strong>Sčítač ${n}</strong><br>${Object.entries(k).map(([kat, v]) => `${fmt(v as number)} ${J[kat]}`).join('<br>')}<br><span style="opacity:.75">priemer za pracovný deň · <a href="/doprava#premavka">kedy je špička</a></span>`)));
    },
    uzavierky: async () => obmedzenia(await uzavierky(), 'uzavierky'),
    poruchy: async () => obmedzenia(await poruchy(), 'poruchy'),
    cyklo: async () => L.geoJSON(await json('/data/cyklotrasy-bratislava.geojson'), { style: { color: farba('cyklo'), weight: 2.5 }, interactive: false }),
    narodne: async () => priroda('narodne'),
    natura: async () => priroda('natura'),
  };
  function obmedzenia(zoz: Obmedzenie[], k: string) {
    return L.layerGroup(zoz.map((o) => L.circleMarker([o.lat, o.lon], {
      radius: o.uzavierka === 'úplná' ? 8 : 6, weight: 1.5, color: okraj, fillColor: farba(k), fillOpacity: o.planovana ? 0.45 : 0.95,
    }).bindPopup(popup(o))));
  }
  async function priroda(typ: string) {
    const d = await json('/data/priroda-bratislava.geojson');
    return L.geoJSON({ ...d, features: d.features.filter((f: any) => f.properties.t === typ) }, {
      style: { color: farba(typ), weight: 1, fillColor: farba(typ), fillOpacity: typ === 'natura' ? 0.15 : 0.25, dashArray: typ === 'natura' ? '4 3' : undefined },
      onEachFeature: (f: any, l) => l.bindPopup(`<strong>${f.properties.n}</strong><br>${f.properties.k}<br>${f.properties.km2.toLocaleString('sk-SK')} km² v Bratislave`),
    });
  }
  for (const k of ['lekarne', 'nemocnice', 'ambulancie', 'nabijanie']) {
    tvorba[k] = async () => {
      const d = await json('/data/vybavenost-bratislava.json');
      return L.layerGroup(d.body.filter((b: any[]) => b[2] === k).map(([lat, lon, , n, det]: any[]) =>
        bod(lat, lon, k).bindPopup(() => popupMiesta(n, d.kategorie[k], det), { maxWidth: 280 })));
    };
  }
  for (const k of ['muzea', 'kultura']) {
    tvorba[k] = async () => {
      const d = await json('/data/pamiatky-bratislava.json');
      return L.layerGroup(d.body.filter((b: any[]) => b[2] === k).map(([lat, lon, , n, det]: any[]) =>
        bod(lat, lon, k).bindPopup(() => popupMiesta(n, d.kategorie[k] ?? '', det), { maxWidth: 280 })));
    };
  }
  tvorba.pamiatky_osm = async () => {
    const d = await json('/data/pamiatky-bratislava.json');
    return L.layerGroup(d.body.filter((b: any[]) => b[2] === 'pamiatky').map(([lat, lon, , n, det]: any[]) =>
      bod(lat, lon, 'pamiatky_osm').bindPopup(() => popupMiesta(n, 'Pamiatka (OpenStreetMap)', det), { maxWidth: 280 })));
  };
  // Oficiálny register pamiatok MK SR (poloha podľa registra adries)
  tvorba.pamiatky = async () => {
    const d = await json('/data/pamiatky-register.json');
    return L.layerGroup(d.body.map(([lat, lon, n, det]: any[]) => bod(lat, lon, 'pamiatky').bindPopup(() => popupPamiatky(n, det), { maxWidth: 280 })));
  };
  tvorba.stromy = async () => {
    const d = await json('/data/stromy-sop.json');
    return L.layerGroup(d.body.map(([lat, lon, n, det]: any[]) => bod(lat, lon, 'stromy').bindPopup(() => popupStromy(n, det), { maxWidth: 280 })));
  };
  const SKOLY: Record<string, string[]> = { skoly_ms: ['ms'], skoly_zs: ['zs'], skoly_ss: ['ss', 'spec'], skoly_zus: ['zus', 'cvc'] };
  for (const [k, typy] of Object.entries(SKOLY)) {
    tvorba[k] = async () => {
      const d = await json('/data/skoly-iedu.json');
      return L.layerGroup(d.body.filter((b: any[]) => typy.includes(b[2])).map(([lat, lon, t, n, det]: any[]) =>
        bod(lat, lon, k).bindPopup(() => popupSkoly(n, t, det), { maxWidth: 280 })));
    };
  }
  for (const k of ['jasle', 'socialne']) {
    tvorba[k] = async () => {
      const d = await json('/data/socialne-bratislava.json');
      return L.layerGroup(d.body.filter((b: any[]) => (b[2] === 'deti') === (k === 'jasle')).map(([lat, lon, kat, n, det]: any[]) =>
        bod(lat, lon, k).bindPopup(() => popupSocialne(n, d.kategorie[kat], det), { maxWidth: 280 })));
    };
  }
  tvorba.obvody = async () => {
    const d = await json('/data/obvody-zs-bratislava.geojson');
    const PALETA = ['#1f6fd1', '#c8102e', '#138a5e', '#a16207', '#7a4fd1', '#0e7490', '#db2777', '#4d7c0f'];
    return L.geoJSON(d, {
      style: (f: any) => ({ color: PALETA[f.properties.zs % PALETA.length], weight: 1, fillColor: PALETA[f.properties.zs % PALETA.length], fillOpacity: 0.18 }),
      onEachFeature: (f: any, l) => l.bindPopup(popupObvodu(f.properties), { maxWidth: 280 }),
    });
  };
  for (const k of ['bezbarierove', 'fontany', 'sportoviska', 'bezdomovci', 'veterina', 'ochladzovanie', 'debarierizacie', 'fixpointy']) {
    tvorba[k] = async () => {
      const d = await json('/data/vrstvy-bratislava.json');
      return L.layerGroup(d.body.filter((b: any[]) => b[2] === k).map(([lat, lon, , n, det]: any[]) =>
        bod(lat, lon, k).bindPopup(() => popupVrstvy(n, d.kategorie[k], det), { maxWidth: 280 })));
    };
  }
  for (const k of ['vysadba', 'starostlivost']) {
    tvorba[k] = async () => {
      const d = await json('/data/stromy-mesto.json');
      return L.layerGroup(d.body.filter((b: any[]) => b[2] === k).map(([lat, lon, , n, det]: any[]) =>
        bod(lat, lon, k, mobil ? 2.5 : 3).bindPopup(() => popupVrstvy(n, d.kategorie[k], det), { maxWidth: 280 })));
    };
  }
  tvorba.podnety = async () => {
    const d = await json('/data/podnety-bratislava.json');
    return L.layerGroup(d.body.map(([lat, lon, kat, pod, stav, dat]: any[]) => bod(lat, lon, 'podnety', mobil ? 2.5 : 3)
      .bindPopup(`<strong>${kat}</strong>${pod ? `<br>${pod}` : ''}<br>stav: ${stav}<br><span style="opacity:.75">nahlásené ${dat.split('-').reverse().join('. ')} · podnety magistrátu (mesto ich zverejnilo len do roku ${d.body.length ? d.body.reduce((a: string, b: any[]) => (b[5] > a ? b[5] : a), '').slice(0, 4) : ''})</span>`)));
  };
  // Mriežky klimatického atlasu a hustoty – vždy len jedna naraz, farba podľa kvintilov
  const KLIMA_FARBY = ['#fef3c7', '#fcd34d', '#f59e0b', '#dc2626', '#7f1d1d'];
  const klimaRenderer = L.canvas({ padding: 0.2 });
  for (const k of ['riziko_horucavy', 'citlivost_horucavy', 'riziko_zrazky_budovy', 'riziko_doprava', 'riziko_celkove', 'citlivost_celkova', 'citlivost_zrazky_budovy', 'citlivost_doprava', 'kapacita_budov_zrazky', 'kupaliska', 'hustota']) {
    tvorba[`k_${k}`] = async () => {
      const d = await json(`/data/klima/${k}.json`);
      const trieda = (v: number) => d.hranice.filter((h: number) => v > h).length;
      const lg = obal.querySelector<HTMLElement>('.legenda-klima')!;
      lg.querySelector('.lk-nazov')!.textContent = d.nazov;
      return L.layerGroup(d.bunky.map(([s1, w, n, e, v]: number[]) => L.rectangle([[s1, w], [n, e]], {
        renderer: klimaRenderer, stroke: false, fillColor: KLIMA_FARBY[trieda(v)], fillOpacity: 0.55,
      }).bindPopup(`<strong>${d.nazov}</strong><br>hodnota ${v.toLocaleString('sk-SK')} (${['veľmi nízka', 'nízka', 'stredná', 'vysoká', 'veľmi vysoká'][trieda(v)]} v rámci mesta)<br><span style="opacity:.75">${d.popis}</span>`)));
    };
  }
  const HLUK: Record<string, string> = { 55: '#facc15', 60: '#f97316', 65: '#dc2626', 70: '#7e22ce' };
  const HLUK_VRSTVY: Record<string, string> = { hluk_den: 'cesty_lden', hluk_noc: 'cesty_lnight', hluk_priemysel: 'priemysel_lden' };
  for (const [k, v] of Object.entries(HLUK_VRSTVY)) {
    tvorba[k] = async () => {
      const d = await json('/data/hluk-bratislava.json');
      const vrstva = d.vrstvy[v];
      return L.layerGroup(Object.entries<any>(vrstva.ciary).map(([db, ciary]) =>
        L.polyline(ciary, { color: HLUK[db], weight: Number(db) >= 65 ? 2.2 : 1.6, opacity: 0.9 })
          .bindPopup(`<strong>${db === '70' ? '70 dB a viac' : `${db} dB`}</strong><br>${vrstva.nazov}<br><span style="opacity:.75">izofóna strategickej hlukovej mapy (ÚVZ SR); WHO odporúča pri hluku z ciest najviac 53 dB (Lden) a 45 dB v noci</span>`)));
    };
  }

  const hotove: Record<string, L.Layer> = {};
  const poradie = ['natura', 'narodne', 'hranice', 'cyklo', 'mhd', 'bajk', 'scitace', 'lekarne', 'nemocnice', 'ambulancie', 'nabijanie', 'k_riziko_horucavy', 'k_citlivost_horucavy', 'k_riziko_zrazky_budovy', 'k_riziko_doprava', 'k_riziko_celkove', 'k_citlivost_celkova', 'k_citlivost_zrazky_budovy', 'k_citlivost_doprava', 'k_kapacita_budov_zrazky', 'k_kupaliska', 'k_hustota', 'obvody', 'hluk_den', 'hluk_noc', 'hluk_priemysel', 'jasle', 'skoly_ms', 'skoly_zs', 'skoly_ss', 'skoly_zus', 'socialne', 'bezbarierove', 'fontany', 'sportoviska', 'bezdomovci', 'veterina', 'ochladzovanie', 'debarierizacie', 'fixpointy', 'podnety', 'vysadba', 'starostlivost', 'pamiatky', 'pamiatky_osm', 'muzea', 'kultura', 'stromy', 'skladky', 'uzavierky', 'poruchy'];
  async function prepni(k: string, zapnut: boolean) {
    if (!zapnut) { hotove[k]?.remove(); return; }
    try {
      hotove[k] ??= await tvorba[k]();
      hotove[k].addTo(mapa);
      // plochy dozadu, aby body ostali klikateľné
      if (['natura', 'narodne', 'hranice', 'obvody'].includes(k) || k.startsWith('k_')) (hotove[k] as any).bringToBack?.();
    } catch {
      const i = obal.querySelector<HTMLInputElement>(`input[value="${k}"]`);
      if (i) { i.checked = false; i.disabled = true; i.parentElement!.title = 'Údaje sa nepodarilo načítať'; }
    }
  }
  // ---------- Bočný panel: témy, zapnuté vrstvy, hľadanie ----------
  const NAZVY: Record<string, string> = JSON.parse(obal.dataset.nazvy!);
  const TEMY: Record<string, { n: string; v: string[]; p: string[] }> = JSON.parse(obal.dataset.temy!);
  const TEMA_VRSTVY: Record<string, string> = JSON.parse(obal.dataset.temaVrstvy!);
  const bocny = document.getElementById('bocny')!;
  const uchyt = document.getElementById('uchyt')!;
  const vstupy = () => [...obal.querySelectorAll<HTMLInputElement>('input[type=checkbox]')];
  const vstup = (k: string) => obal.querySelector<HTMLInputElement>(`input[type=checkbox][value="${k}"]`);
  const escH = (t: string) => t.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);

  const rozbal = (ano: boolean) => { bocny.dataset.stav = ano ? 'rozbalene' : 'zbalene'; uchyt.setAttribute('aria-expanded', String(ano)); };
  uchyt.addEventListener('click', () => rozbal(bocny.dataset.stav !== 'rozbalene'));

  function legendy() {
    obal.querySelector<HTMLElement>('.legenda-klima')!.hidden = !vstupy().some((x) => x.value.startsWith('k_') && x.checked);
    obal.querySelector<HTMLElement>('.legenda-hluk')!.hidden = !vstupy().some((x) => x.value.startsWith('hluk') && x.checked);
  }
  // štítky zapnutých vrstiev a počty pri témach
  function prehlad() {
    const zap = vstupy().filter((x) => x.checked && x.value !== 'hranice');
    const akt = document.getElementById('aktivne')!;
    akt.innerHTML = zap.length
      ? zap.map((x) => `<button type="button" class="stitok" data-k="${x.value}" title="Vypnúť"><i style="background:var(--m-${x.value.startsWith('k_') ? 'klima' : x.value.startsWith('hluk') ? 'hluk' : x.value})"></i>${escH(NAZVY[x.value] ?? x.value)}<span aria-hidden="true">×</span></button>`).join('')
        + (zap.length > 1 ? '<button type="button" class="stitok vypni-vsetko">Vypnúť všetko</button>' : '')
      : '<p class="tlmene">Vyberte tému alebo hľadajte miesto.</p>';
    obal.querySelectorAll<HTMLElement>('.tema').forEach((t) => {
      const n = TEMY[t.dataset.tema!].v.filter((k) => vstup(k)?.checked).length;
      t.querySelector('[data-pocet]')!.textContent = n ? String(n) : '';
      t.classList.toggle('ma-zapnute', n > 0);
    });
    legendy();
  }
  function nastav(k: string, zapnut: boolean) {
    const i = vstup(k);
    if (!i || i.disabled || i.checked === zapnut) return;
    i.checked = zapnut;
    zmena(i);
  }
  function zmena(i: HTMLInputElement) {
    // mriežky klímy a hustoty sa navzájom vylučujú
    if (i.value.startsWith('k_') && i.checked) vstupy().forEach((x) => { if (x !== i && x.value.startsWith('k_') && x.checked) { x.checked = false; prepni(x.value, false); } });
    prepni(i.value, i.checked);
    prehlad();
  }
  vstupy().forEach((i) => {
    if (!tvorba[i.value] || (inline[i.value] === null)) { i.disabled = true; return; }
    i.addEventListener('change', () => zmena(i));
  });
  document.getElementById('aktivne')!.addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest<HTMLElement>('.stitok');
    if (!b) return;
    if (b.classList.contains('vypni-vsetko')) vstupy().filter((x) => x.checked && x.value !== 'hranice').forEach((x) => nastav(x.value, false));
    else nastav(b.dataset.k!, false);
  });

  // témy: dlaždica otvorí zoznam vrstiev a pri prvom otvorení zapne hlavné vrstvy témy
  const otvorTemu = (id: string | null, zapnutHlavne = true) => {
    document.getElementById('temy')!.hidden = !!id;
    obal.querySelectorAll<HTMLElement>('.tema-panel').forEach((p) => (p.hidden = p.dataset.tema !== id));
    if (id && zapnutHlavne && !TEMY[id].v.some((k) => vstup(k)?.checked)) TEMY[id].p.forEach((k) => nastav(k, true));
    if (id) rozbal(true);
  };
  obal.querySelectorAll<HTMLElement>('.tema').forEach((t) => t.addEventListener('click', () => otvorTemu(t.dataset.tema!)));
  obal.querySelectorAll<HTMLElement>('.spat').forEach((b) => b.addEventListener('click', () => otvorTemu(null)));

  // odkaz /mapa#hluk, #skoly, #tema=zdravie… zapne vrstvy a otvorí tému
  const HASH: Record<string, string[]> = { hluk: ['hluk_den'], skoly: ['skoly_zs', 'obvody'], pamiatky: ['pamiatky'], socialne: ['jasle', 'socialne'],
    horucavy: ['k_riziko_horucavy', 'fontany', 'ochladzovanie'], klima: ['k_riziko_celkove'], hustota: ['k_hustota'], sport: ['sportoviska'], bezbarierove: ['bezbarierove'],
    podnety: ['podnety'], stromy: ['vysadba'], fontany: ['fontany'] };
  const h = location.hash.slice(1);
  const zHashu = h.startsWith('tema=') ? TEMY[h.slice(5)]?.p ?? [] : HASH[h] ?? [];
  zHashu.forEach((k) => { const i = vstup(k); if (i && !i.disabled) i.checked = true; });
  if (zHashu.length) otvorTemu(h.startsWith('tema=') ? h.slice(5) : TEMA_VRSTVY[zHashu[0]], false);
  prehlad();
  (async () => {
    for (const k of poradie) {
      const i = vstup(k);
      if (i?.checked && !i.disabled) await prepni(k, true);
    }
  })();
  obal.querySelectorAll<HTMLInputElement>('input[name=podklad]').forEach((i) =>
    i.addEventListener('change', () => {
      Object.entries(podklady).forEach(([k, l]) => (k === i.value ? l.addTo(mapa) : l.remove()));
      (podklady[i.value] as any).bringToBack?.();
    }),
  );

  // hľadanie v paneli: vrstvy, mestské časti a miesta (index zdieľaný s vyhľadávaním v hlavičke)
  const q = document.getElementById('m-q') as HTMLInputElement;
  const mv = document.getElementById('m-vysledky')!;
  const normH = (t: string) => t.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '');
  let miesta: Promise<{ n: string; s: string; k: string; lat: number; lon: number; t: string }[]> | null = null;
  const nacitajMiesta = () => (miesta ??= fetch('/data/hladanie.json').then((r) => r.json()).then((d) => d.polozky
    .filter((p: any[]) => p[0] === 'Miesta').map((p: any[]) => ({ n: p[1], s: p[2], k: p[4], lat: p[5], lon: p[6], t: normH(`${p[1]} ${p[2]} ${p[4]}`) }))));
  const zhoda = (text: string, slova: string[]) => slova.every((w) => text.includes(w));
  let vyber = 0;
  async function hladajNaMape() {
    const t = normH(q.value.trim());
    if (t.length < 2) { mv.hidden = true; return; }
    const slova = t.split(/\s+/);
    const vrstvyZ = Object.entries(NAZVY).filter(([k, n]) => k !== 'hranice' && zhoda(normH(`${n} ${TEMY[TEMA_VRSTVY[k]]?.n ?? ''}`), slova)).slice(0, 4);
    const casti = (inline.hranice?.features ?? []).filter((f: any) => zhoda(normH(f.properties.n), slova)).slice(0, 3);
    const body = (await nacitajMiesta()).filter((m) => zhoda(m.t, slova))
      .sort((a, b) => Number(!normH(a.n).startsWith(slova[0])) - Number(!normH(b.n).startsWith(slova[0]))).slice(0, 8);
    if (normH(q.value.trim()) !== t) return;
    const r = (attrs: string, nazov: string, popis: string, typ: string) => `<button type="button" class="mv-r" data-typ="${typ}" ${attrs}><span class="mv-n">${escH(nazov)}</span><span class="mv-p">${escH(popis)}</span></button>`;
    mv.innerHTML = (vrstvyZ.length ? '<p class="mv-sk">Vrstvy</p>' + vrstvyZ.map(([k, n]) => r(`data-k="${k}"`, n, vstup(k)?.checked ? 'zapnutá · ťuknutím vypnete' : TEMY[TEMA_VRSTVY[k]]?.n ?? '', 'vrstva')).join('') : '')
      + (casti.length ? '<p class="mv-sk">Mestské časti</p>' + casti.map((f: any) => r(`data-mc="${escH(f.properties.n)}"`, f.properties.n, `${fmt(f.properties.o)} obyvateľov`, 'mc')).join('') : '')
      + (body.length ? '<p class="mv-sk">Miesta</p>' + body.map((m) => r(`data-lat="${m.lat}" data-lon="${m.lon}" data-n="${escH(m.n)}" data-kat="${escH(m.k)}"`, m.n, [m.k, m.s].filter(Boolean).join(' · '), 'miesto')).join('') : '')
      || '<p class="mv-prazdne">Nič sa nenašlo. Skúste kratší výraz alebo názov ulice.</p>';
    mv.hidden = false;
    vyber = 0;
    oznacVyber();
  }
  const riadkyMv = () => [...mv.querySelectorAll<HTMLButtonElement>('.mv-r')];
  const oznacVyber = () => riadkyMv().forEach((b, i) => b.classList.toggle('vybrany', i === vyber));
  function zvol(b: HTMLButtonElement) {
    if (b.dataset.k) { const i = vstup(b.dataset.k)!; nastav(b.dataset.k, !i.checked); }
    else if (b.dataset.mc) {
      const f = inline.hranice.features.find((x: any) => x.properties.n === b.dataset.mc);
      if (f) mapa.fitBounds(L.geoJSON(f).getBounds(), { padding: [20, 20] });
      if (mobil) rozbal(false);
    } else if (b.dataset.lat) {
      location.hash = `miesto&${new URLSearchParams({ lat: b.dataset.lat, lon: b.dataset.lon!, n: b.dataset.n!, k: b.dataset.kat! })}`;
      if (mobil) rozbal(false);
    }
    q.value = '';
    mv.hidden = true;
  }
  let casovacQ: number;
  q.addEventListener('focus', () => { nacitajMiesta(); if (mobil) rozbal(true); });
  q.addEventListener('input', () => { clearTimeout(casovacQ); casovacQ = window.setTimeout(hladajNaMape, 80); });
  q.addEventListener('keydown', (e) => {
    const r = riadkyMv();
    if (e.key === 'ArrowDown') { e.preventDefault(); vyber = Math.min(vyber + 1, r.length - 1); oznacVyber(); r[vyber]?.scrollIntoView({ block: 'nearest' }); }
    else if (e.key === 'ArrowUp') { e.preventDefault(); vyber = Math.max(vyber - 1, 0); oznacVyber(); r[vyber]?.scrollIntoView({ block: 'nearest' }); }
    else if (e.key === 'Enter' && r[vyber]) { e.preventDefault(); zvol(r[vyber]); }
    else if (e.key === 'Escape') { q.value = ''; mv.hidden = true; }
  });
  mv.addEventListener('click', (e) => { const b = (e.target as HTMLElement).closest<HTMLButtonElement>('.mv-r'); if (b) zvol(b); });

  // odkaz z vyhľadávania: /mapa#miesto&lat=…&lon=…&n=názov&k=kategória → priblížiť a označiť miesto
  let oznacene: L.Layer | null = null;
  const zobrazMiesto = () => {
    if (!location.hash.startsWith('#miesto&')) return;
    const p = new URLSearchParams(location.hash.slice(8));
    const lat = Number(p.get('lat')), lon = Number(p.get('lon'));
    if (!Number.isFinite(lat) || !Number.isFinite(lon)) return;
    oznacene?.remove();
    const esc = (t: string) => t.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);
    oznacene = L.circleMarker([lat, lon], { radius: 11, color: '#fff', weight: 3, fillColor: '#c8102e', fillOpacity: 1 }).addTo(mapa)
      .bindPopup(`<div class="mf"><strong class="mf-nazov">${esc(p.get('n') ?? '')}</strong><span class="mf-kat">${esc(p.get('k') ?? '')}</span></div>`);
    mapa.setView([lat, lon], 17);
    setTimeout(() => (oznacene as L.CircleMarker).openPopup(), 300);
  };
  setTimeout(zobrazMiesto, 0);
  window.addEventListener('hashchange', zobrazMiesto);
</script>

<style>
  :global(:root) {
    --m-hranice: #5d636e; --m-mhd: #c8102e; --m-cyklo: #1f6fd1; --m-bajk: #0e7490;
    --m-lekarne: #138a5e; --m-nemocnice: #b91c1c; --m-ambulancie: #7a4fd1; --m-nabijanie: #db2777;
    --m-pamiatky: #a16207; --m-stromy: #4d7c0f; --m-narodne: #16a34a; --m-natura: #65a30d; --m-skladky: #57534e;
    --m-uzavierky: #d97706; --m-poruchy: #a21caf; --m-scitace: #0f766e; --m-muzea: #9333ea; --m-kultura: #e11d48;
    --m-pamiatky_osm: #ca8a04; --m-jasle: #f472b6; --m-skoly_ms: #fb923c; --m-skoly_zs: #2563eb; --m-skoly_ss: #4338ca;
    --m-skoly_zus: #0891b2; --m-socialne: #9d174d; --m-obvody: #60a5fa; --m-hluk: #f97316;
