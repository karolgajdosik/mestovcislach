      <ul class="ob-bary">
        {VZDT.filter(([k]) => oby.vzd![k] != null).map(([k, n]) => <li><span>{n}</span><span class="pruh" aria-hidden="true"><i style={`width:${oby.vzd![k]}%`}></i></span><span class="num"><strong>{des(oby.vzd![k], 0)} %</strong> <small>({vzdOkr[k] != null ? `okres ${des(vzdOkr[k], 0)} %` : '–'})</small></span></li>)}
      </ul>
      {oby.jaz && <p class="pozn">Materinský jazyk: {(jazIne.length ? oby.jaz.filter(([, x]) => x >= 1) : oby.jaz.slice(0, 1)).map(([n, x]) => `${n.toLowerCase()} ${des(x, x < 10 ? 1 : 0)} %`).join(', ')}{!jazIne.length ? ' – iný jazyk má menej ako 1 % obyvateľov' : ''}.</p>}
      <p class="zdroj">Zdroj: ŠÚ SR – Sčítanie obyvateľov, domov a bytov 2021 (STATdata om7809rr, om7804rr). Vzdelanie ľudí od 15 rokov so zisteným údajom ({fmt(oby.vzd_n ?? 0)}); okres = všetci obyvatelia okresu spolu. Skupiny menšie ako 5 ľudí sú zlúčené.</p>
    </section>
  )}

  {vk && vkSpolu > 0 && (
    <section class="card" id="vek">
      <h2>Veková pyramída {vkI!.rok}</h2>
      <div class="ob-pyramida" role="img" aria-label={`Veková pyramída obyvateľov ${o.nazov} k 31. 12. ${vkI!.rok}`}>
        <div class="hl"><span>Muži</span><span></span><span>Ženy</span></div>
        {vkI!.skupiny.map((sk, i) => i).reverse().map((i) => (
          <div><span class="m"><i style={`width:${(100 * vk.m[i]) / vkMax}%`}></i><small>{vk.m[i] || ''}</small></span><span class="v">{vkI!.skupiny[i]}</span><span class="z"><i style={`width:${(100 * vk.z[i]) / vkMax}%`}></i><small>{vk.z[i] || ''}</small></span></div>
        ))}
      </div>
      <p class="zdroj">Zdroj: ŠÚ SR – vekové skupiny trvale bývajúcich obyvateľov k 31. 12. {vkI!.rok} (STATdata om7006rr).</p>
    </section>
  )}

  {so2 && (so2.dom || so2.byty || so2.ekon) && (
    <section class="card" id="domacnosti">
      <h2>Domácnosti, byty a práca</h2>
      <ul class="ob-cisla">
        {so2.dom && <li><b>{des(so2.dom.priem, 1)}</b><span>priemerný počet ľudí v domácnosti; {des(so2.dom.jedn, 0)} % domácností tvorí jeden človek{so2.dom.deti != null ? `, ${des(so2.dom.deti, 0)} % má deti` : ''}</span></li>}
        {so2.byty?.m2 && <li><b>{fmt(so2.byty.m2)} m²</b><span>priemerná plocha bytu{so2.byty.izby ? `, ${des(so2.byty.izby, 1)} obytnej miestnosti` : ''}</span></li>}
        {so2.byty?.vlastne != null && <li><b>{des(so2.byty.vlastne, 0)} %</b><span>bytov vo vlastníctve obyvateľov{so2.byty.najom ? `; ${des(so2.byty.najom, 0)} % v nájme` : ''}{so2.byty.druzstvo ? `, ${des(so2.byty.druzstvo, 0)} % družstevných` : ''}</span></li>}
        {so2.ekon && <li><b>{des(so2.ekon.aktivni, 0)} %</b><span>obyvateľov pracuje alebo hľadá prácu (ekonomicky aktívni); {des(so2.ekon.dochodcovia, 0)} % dôchodcov, {des(so2.ekon.deti_studenti, 0)} % detí a študentov</span></li>}
        {so2.cudzinci && so2.cudzinci[0] >= 5 && <li><b>{des(so2.cudzinci[1], 1)} %</b><span>obyvateľov má cudzie štátne občianstvo ({fmt(so2.cudzinci[0])}{so2.cudzinci[2] ? `, z toho ${fmt(so2.cudzinci[2])} české` : ''})</span></li>}
      </ul>
      {so2.byty?.energia && <p class="pozn">Čím sa kúri: {ENERGIA.filter(([k]) => (so2.byty!.energia![k] ?? 0) >= 1).sort(([x], [y]) => (so2.byty!.energia![y] ?? 0) - (so2.byty!.energia![x] ?? 0)).map(([k, n]) => `${n} ${des(so2.byty!.energia![k]!, 0)} %`).join(', ')} (podiel bytov podľa hlavného zdroja energie).</p>}
      {vodaL != null && vodaL > 20 && vodaL < 400 && <p class="pozn">Domácnosti spotrebovali v roku {kulI!.rok_voda} v priemere {fmt(vodaL)} litrov pitnej vody z verejného vodovodu na obyvateľa a deň.</p>}
      <p class="zdroj">Zdroj: ŠÚ SR – Sčítanie obyvateľov, domov a bytov 2021 (domácnosti, byty, ekonomická aktivita, štátna príslušnosť); spotreba pitnej vody (STATdata vh5003rr). Priemerný počet ľudí v domácnosti je odhad (domácnosti s 5 a viac členmi rátame ako 5,6).</p>
    </section>
  )}

  {byv && (
    <section class="card" id="byvanie">
      <h2>Domy, kanalizácia, plyn, voda</h2>
      <ul class="ob-bary">
        {([['Kanalizácia', 'kanal', 'domy pripojené na verejnú kanalizáciu'], ['Plyn', 'plyn', 'domy s plynovou prípojkou'], ['Verejný vodovod', 'vodovod', 'domy s vodou z verejnej siete']] as const).filter(([, k]) => byv[k] != null).map(([n, k, pozn]) => (
          <li><span>{n}<small>{pozn}</small></span><span class="pruh" aria-hidden="true"><i style={`width:${byv[k]}%`}></i></span><span class="num"><strong>{des(byv[k], 0)} %</strong> <small>({byvOkr[k] != null ? `okres ${des(byvOkr[k]!, 0)} %` : '–'})</small></span></li>
        ))}
      </ul>
      {byv.kanal != null && byv.kanal < 50 && byv.zumpa != null && <p class="pozn">{des(byv.zumpa, 0)} % domov má septik alebo žumpu{byv.cov ? `, ${des(byv.cov, 0)} % domácu čističku` : ''}.</p>}
      {byv.vek_domov && <p class="pozn">Domy postavené alebo zrekonštruované: do 1945 {des(byv.vek_domov[0], 0)} % · 1946–1980 {des(byv.vek_domov[1], 0)} % · 1981–2000 {des(byv.vek_domov[2], 0)} % · 2001–2009 {des(byv.vek_domov[3], 0)} % · od 2010 {des(byv.vek_domov[4], 0)} %.</p>}
      {byv.kurenie && <p class="pozn">Kúrenie v bytoch: ústredné vlastné {des(byv.kurenie[1], 0)} %, diaľkové (teplárne) {des(byv.kurenie[0], 0)} %, etážové {des(byv.kurenie[2], 0)} %, kachle a iné samostatné telesá {des(byv.kurenie[3], 0)} %.</p>}
      <p class="zdroj">Zdroj: ŠÚ SR – Sčítanie obyvateľov, domov a bytov 2021 ({byv.domov ? `${fmt(byv.domov)} domov` : ''}). Podiely sú z domov, pri ktorých bol údaj zistený; okres = všetky domy okresu spolu. Odvtedy mohla obec kanalizáciu alebo plynovod rozšíriť.</p>
    </section>
  )}

  {v && (
    <section class="card" id="volby">
      <h2>Komunálne voľby 2026</h2>
      {v.starosta.length > 0 && (
        <>
          <h3>Voľba {titulStarostu === 'Starosta' ? 'starostu' : 'primátora / starostu'}</h3>
          <ul class="ob-bary">
            {v.starosta.map((k) => (
              <li><span class={k.zvoleny ? 'zv' : ''} translate="no">{k.meno}<small>{/^nezávisl/i.test(k.strany) ? 'nezávislý kandidát' : skrat(k.strany)}{k.zvoleny ? ' · zvolený(-á)' : ''}</small></span>
                <span class="pruh" aria-hidden="true"><i style={`width:${k.podiel}%`}></i></span>
                <span class="num">{des(k.podiel)} % <small>{fmt(k.hlasy)} hlasov</small></span></li>
            ))}
          </ul>
          {v.kandidatov === 1 && <p class="pozn">Kandidoval jediný kandidát.</p>}
        </>
      )}
      {v.poslanci.length > 0 && (
        <>
          <h3>Zvolení poslanci</h3>
          <div class="ob-obal">
            <table class="ob-tab">
              <thead><tr><th>Meno</th><th>Strana</th>{obvody && <th class="num">Obvod</th>}<th class="num">Hlasy</th></tr></thead>
              <tbody>{v.poslanci.map((x, i) => <tr><td translate="no">{vacsia ? <a href={`${u}/poslanci/${idsP[i]}`}>{x.meno}</a> : x.meno}</td><td translate="no">{/^nezávisl/i.test(x.strany) ? 'nezávislý' : skrat(x.strany)}</td>{obvody && <td class="num">{x.obvod_c}</td>}<td class="num">{fmt(x.hlasy)}</td></tr>)}</tbody>
            </table>
          </div>
          {v.mandaty.length > 1 && <p class="pozn">Mandáty: {v.mandaty.map((m) => `${/^nezávisl/i.test(m.strany) ? 'nezávislí' : skrat(m.strany)} ${m.mandaty}`).join(', ')}.</p>}
        </>
      )}
      {st22 && (
        <details class="ob-starsie">
          <summary>Voľba {titulStarostu === 'Starosta' ? 'starostu' : 'primátora / starostu'} v roku 2022</summary>
          <ul class="ob-bary">
            {st22.map(([m, s_, h, pc, z]) => (
              <li><span class={z ? 'zv' : ''} translate="no">{m}<small>{/^nezávisl/i.test(s_) ? 'nezávislý kandidát' : skrat(s_)}{z ? ' · zvolený(-á)' : ''}</small></span>
                <span class="pruh" aria-hidden="true"><i style={`width:${pc}%`}></i></span>
                <span class="num">{des(pc)} % <small>{fmt(h)} hlasov</small></span></li>
            ))}
          </ul>
          {st22.length === 1 && <p class="pozn">Kandidoval jediný kandidát.</p>}
        </details>
      )}
      <p class="zdroj">Zdroj: Štatistický úrad SR – výsledky komunálnych volieb 24. 10. 2026{st22 ? ' a 29. 10. 2022' : ''}. Uvádzame len meno, stranu a hlasy.</p>
    </section>
  )}

  {(celostatne.length > 0 || starsie.length > 0) && (
    <section class="card" id="volby-celostatne">
      <h2>Ako sa tu volilo</h2>
      <div class="ob-volby">
        {celostatne.map(({ id, v: vv, x }) => (
          <div>
            <h3>{vv!.nazov}</h3>
            <p class="pozn">Účasť <strong>{des(x![0])} %</strong> (okres {vv!.okresy[o.okres] != null ? `${des(vv!.okresy[o.okres])} %` : '–'}, Slovensko {des(vv!.sr.ucast)} %)</p>
            <ul class="ob-bary">
              {x![1].slice(0, jePrez(id) ? 4 : 5).map(([i, pct]) => { const sr = vv!.sr.s.find(([j]) => j === i)?.[1]; return (
                <li><span translate="no">{jePrez(id) ? vv!.strany[i] : skratStrany(vv!.strany[i])}</span><span class="pruh" aria-hidden="true"><i style={`width:${pct}%`}></i></span><span class="num"><strong>{des(pct)} %</strong>{sr != null && <small> (SR {des(sr)} %)</small>}</span></li>
              ); })}
            </ul>
          </div>
        ))}
      </div>
      {starsie.length > 0 && (
        <details class="ob-starsie">
          <summary>Staršie voľby (2019, 2020)</summary>
          <div class="ob-volby">
            {starsie.map(({ id, v: vv, x }) => (
              <div>
                <h3>{vv!.nazov}</h3>
                <p class="pozn">Účasť <strong>{des(x![0])} %</strong> (okres {vv!.okresy[o.okres] != null ? `${des(vv!.okresy[o.okres])} %` : '–'}, Slovensko {des(vv!.sr.ucast)} %)</p>
                <ul class="ob-bary">
                  {x![1].slice(0, jePrez(id) ? 4 : 5).map(([i, pct]) => { const sr = vv!.sr.s.find(([j]) => j === i)?.[1]; return (
                    <li><span translate="no">{jePrez(id) ? vv!.strany[i] : skratStrany(vv!.strany[i])}</span><span class="pruh" aria-hidden="true"><i style={`width:${pct}%`}></i></span><span class="num"><strong>{des(pct)} %</strong>{sr != null && <small> (SR {des(sr)} %)</small>}</span></li>
                  ); })}
                </ul>
              </div>
            ))}
          </div>
        </details>
      )}
      {ucRad.length > 0 && (
        <>
          <h3>Účasť v ďalších hlasovaniach</h3>
          <div class="ob-obal">
            <table class="ob-tab">
              <thead><tr><th></th><th class="num">{o.nazov}</th><th class="num">okres</th><th class="num">Slovensko</th></tr></thead>
              <tbody>
                {v?.ucast && <tr><td>Komunálne voľby 2026</td><td class="num">{des(v.ucast.ucast_pct)} %</td><td class="num">–</td><td class="num">–</td></tr>}
                {ucRad.map(({ u, x }) => <tr><td>{u!.nazov}</td><td class="num">{des(x!)} %</td><td class="num">{u!.okresy[o.okres] != null ? `${des(u!.okresy[o.okres])} %` : '–'}</td><td class="num">{des(u!.sr)} %</td></tr>)}
              </tbody>
            </table>
          </div>
        </>
      )}
      <p class="zdroj">Zdroj: ŠÚ SR – výsledky volieb do NR SR 2020 a 2023, voľby prezidenta 2019 a 2024, voľby do Európskeho parlamentu 2024, voľby do orgánov samosprávy obcí a krajov 2022 a referendum 2023 (otvorené dáta, volby.statistics.sk). Podiel z platných hlasov v obci.</p>
    </section>
  )}

  {(hP || roz) && (
    <section class="card" id="hospodarenie">
      <h2>Hospodárenie obce {hRok ?? roz?.rok}</h2>
      {hP && <ul class="ob-cisla">
        {hP.vynosy != null && <li><b>{eur(hP.vynosy)}</b><span>výnosy</span></li>}
        {hP.naklady != null && <li><b>{eur(hP.naklady)}</b><span>náklady</span></li>}
        {hP.vysledok != null && <li><b class={hP.vysledok < 0 ? 'zaporne' : ''}>{hP.vysledok > 0 ? '+' : hP.vysledok < 0 ? '−' : ''}{eur(Math.abs(hP.vysledok))}</b><span>{hP.vysledok < 0 ? 'strata' : 'zisk'} (účtovný výsledok)</span></li>}
      </ul>}
      {hTab.length > 0 && (
        <div class="ob-obal">
          <table class="ob-tab">
            <thead><tr><th>Na obyvateľa</th><th class="num">{o.nazov}</th><th class="num">medián obcí okresu</th></tr></thead>
            <tbody>{hTab.map((x) => <tr><td>{x.n}{x.pozn && <><br /><small>{x.pozn}</small></>}</td><td class="num">{fmt(Math.round(x.obec!))} €</td><td class="num">{x.okres != null ? `${fmt(Math.round(x.okres))} €` : '–'}</td></tr>)}</tbody>
          </table>
        </div>
      )}
      {hRoky.length > 1 && (
        <p class="pozn">Výsledok hospodárenia po rokoch: {hRoky.map((r) => { const v = hosp![r].vysledok; return v != null ? `${r} ${v > 0 ? '+' : v < 0 ? '−' : ''}${eur(Math.abs(v))}` : null; }).filter(Boolean).join(' · ')}.</p>
      )}
      {roz && rozSpolu > 0 && (
