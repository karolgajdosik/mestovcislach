    {v && v.poslanci.length > 0 && <li><b>{v.poslanci.length}</b><span>poslancov obecného zastupiteľstva</span></li>}
    {wk?.[0] && <li><b>{wk[0]}</b><span>prvá písomná zmienka</span></li>}
    {wk?.[1] && <li><b>{fmt(wk[1])} m</b><span>nadmorská výška</span></li>}
  </ul>

  <div class="ob-dva">
    {rad.length > 2 && (
      <section class="card">
        <h2>Počet obyvateľov {rad[0][0]} – {rad[rad.length - 1][0]}</h2>
        <svg class="ob-graf" viewBox={`0 0 ${W} ${H}`} role="img" aria-label={`Počet obyvateľov: ${rad[0][0]} ${fmt(rad[0][1])}, ${rad[rad.length - 1][0]} ${fmt(rad[rad.length - 1][1])}`}>
          <path class="plocha" d={`${ciara}L${sx(rad.length - 1)},${H - P}L${sx(0)},${H - P}Z`} />
          <path class="ciara" d={ciara} />
          <text x={P} y={H - 6}>{rad[0][0]}</text><text x={W - P} y={H - 6} text-anchor="end">{rad[rad.length - 1][0]}</text>
          <text x={P} y={14}>{fmt(maxV)}</text><text x={P} y={H - P - 4}>{fmt(minV)}</text>
        </svg>
        <p class="zdroj">Trvale bývajúci obyvatelia k 31. 12. Zdroj: ŠÚ SR – STATdata (om7101rr).</p>
      </section>
