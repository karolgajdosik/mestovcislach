        <ul class="ob-bary">
          {sklad.map((x) => <li><span>{x.n}</span><span class="pruh" aria-hidden="true"><i style={`width:${Math.min(100, x.obec! * 2)}%`}></i></span><span class="num"><strong>{des(x.obec!)} %</strong> <small>({x.okres != null ? `${des(x.okres)} %` : '–'})</small></span></li>)}
        </ul>
        {top('narodnost').length > 0 && <p class="pozn">Národnosť: {top('narodnost').map(([k, x]) => `${k} ${des((100 * x) / spolu)} %`).join(', ')}.</p>}
        {top('nabozenstvo').length > 0 && <p class="pozn">Náboženstvo: {top('nabozenstvo').map(([k, x]) => `${kratkeNab(k)} ${des((100 * x) / spolu)} %`).join(', ')}.</p>}
      </section>
    )}
  </div>

  {(poh?.rad || poh?.vek != null) && (
    <section class="card" id="pohyb">
      <h2>Narodení, zomrelí, sťahovanie</h2>
      {his.length > 10 && (
        <>
          <div class="ob-stlpce ob-his" role="img" aria-label={`Počet obyvateľov ${his[0][0]}–${his[his.length - 1][0]}`}>
            {his.map(([r, x]) => <div title={`${r}: ${fmt(x)} obyvateľov`}><span style={`height:${Math.max(3, 100 * (x - hisMin * 0.9) / (hisMax - hisMin * 0.9 || 1))}%`}></span><small>{Number(r) % 5 === 0 ? `’${r.slice(2)}` : ''}</small></div>)}
          </div>
          <p class="pozn">Počet obyvateľov: {fmt(his[0][1])} v roku {his[0][0]} → {fmt(his[his.length - 1][1])} v roku {his[his.length - 1][0]} ({his[his.length - 1][1] >= his[0][1] ? '+' : '−'}{des(Math.abs(100 * (his[his.length - 1][1] - his[0][1]) / his[0][1]), 0)} %); najviac {fmt(hisMax)} ({his.find(([, x]) => x === hisMax)![0]}), najmenej {fmt(hisMin)} ({his.find(([, x]) => x === hisMin)![0]}).</p>
        </>
      )}
      <ul class="ob-cisla">
        {poh.vek != null && <li><b>{des(poh.vek)} r.</b><span>priemerný vek ({poh.vek_rok}){vekOkr != null ? `, okres ${des(vekOkr)}` : ''}{poh.vek10 != null ? `; pred 10 rokmi ${des(poh.vek10)}` : ''}</span></li>}
        {pohRad.length > 0 && <li><b>{pohSum[0] - pohSum[1] > 0 ? '+' : pohSum[0] - pohSum[1] < 0 ? '−' : ''}{fmt(Math.abs(pohSum[0] - pohSum[1]))}</b><span>prirodzený prírastok za {pohRad.length} rokov ({fmt(pohSum[0])} narodených, {fmt(pohSum[1])} zomrelých)</span></li>}
        {pohRad.length > 0 && <li><b>{pohSum[2] > 0 ? '+' : pohSum[2] < 0 ? '−' : ''}{fmt(Math.abs(pohSum[2]))}</b><span>saldo sťahovania za {pohRad.length} rokov ({pohSum[2] >= 0 ? 'viac ľudí sa prisťahovalo, ako odsťahovalo' : 'viac ľudí sa odsťahovalo, ako prisťahovalo'})</span></li>}
      </ul>
      {pohRad.length > 2 && (
        <div class="ob-obal">
          <table class="ob-tab ob-pohyb">
            <thead><tr><th>Rok</th><th class="num">Narodení</th><th class="num">Zomrelí</th><th class="num">Sťahovanie</th><th class="num">Spolu</th></tr></thead>
            <tbody>{pohRad.slice().reverse().map(([r, [a, b, c]]) => { const z = a - b + c; const zn = (v: number) => `${v > 0 ? '+' : v < 0 ? '−' : ''}${fmt(Math.abs(v))}`; return <tr><td>{r}</td><td class="num">{fmt(a)}</td><td class="num">{fmt(b)}</td><td class={`num ${c < 0 ? 'zaporne' : ''}`}>{zn(c)}</td><td class={`num ${z < 0 ? 'zaporne' : ''}`}>{zn(z)}</td></tr>; })}</tbody>
          </table>
        </div>
      )}
      <p class="zdroj">Zdroj: ŠÚ SR – pohyb obyvateľstva a indexy vekového zloženia (STATdata om7103rr, om7052rr){his.length ? '; počet obyvateľov k 31. 12. (om7101rr), stĺpce začínajú od 90 % minima' : ''}.</p>
    </section>
  )}

  {oby?.vzd && (
    <section class="card" id="vzdelanie">
