---
// Profil obce: obyvatelia a vývoj, sčítanie 2021 v porovnaní s okresom, komunálne voľby 2026 (starosta/primátor, poslanci),
// počasie teraz a obce v okolí. Krajské mestá sa negenerujú – majú vlastné stránky (/trnava …).
import Base from '../../../../layouts/Base.astro';
import '../../../../styles/stranka.css';
import '../../../../styles/obce.css';
import PoslatZnamemu from '../../../../components/PoslatZnamemu.astro';
import Kalendar from '../../../../components/Kalendar.astro';
import { kraje, obceKraja, odkaz, posledne, zmena10, km, webMesta, jeVacsia, idsPoslancov, kvizObce, urlObce, zmluvyObce, zmluvyInfo, eiaObce, eiaWeb, KAT_EIA, hospodarenieObce, medianOkresu, nezamInfo, odpadInfo, skolyInfo, volbyInfo, pohybInfo, byvanieInfo, firmyInfo, sluzbyInfo, turizmusInfo, vlakyInfo, type Obec } from '../../../../lib/obce';
import { skrat, skratStrany } from '../../../../lib/zastupitelstvo';

export function getStaticPaths() {
  return kraje().flatMap((k) => obceKraja(k.slug).filter((o) => !webMesta(o.nazov))
    .map((o) => ({ params: { kraj: o.kraj_slug, okres: o.okres_slug, obec: o.slug }, props: { o } })));
}
const { o } = Astro.props as { o: Obec };
const fmt = (n: number) => n.toLocaleString('sk-SK');
const des = (n: number, d = 1) => n.toLocaleString('sk-SK', { minimumFractionDigits: d, maximumFractionDigits: d });
const bezTit = (m: string) => m.split(/[\s,]+/).filter((s) => s && !s.includes('.') && !/^(PhD|MBA|LL|MPH|MPA|DiS|CSc|ArtD|MSc)$/i.test(s)).join(' ');
const p = posledne(o.obyvatelia);
const z10 = zmena10(o.obyvatelia);
const v = o.volby2026;
const st = v?.starosta.find((k) => k.zvoleny);
const titulStarostu = (p?.[1] ?? 0) >= 5000 ? 'Primátor/starosta' : 'Starosta';
// okres – súčty pre porovnanie sčítania
const okresObce = obceKraja(o.kraj_slug).filter((x) => x.okres_slug === o.okres_slug);
const sucet = (tema: string) => {
  const s: Record<string, number> = {};
  for (const x of okresObce) for (const [k, val] of Object.entries(x.scitanie?.[tema] ?? {})) s[k] = (s[k] ?? 0) + val;
  return s;
};
const pct = (t: Record<string, number> | undefined, f: (k: string) => boolean) => {
  if (!t) return null;
  const spolu = t.Spolu || 0;
  if (!spolu) return null;
  return (100 * Object.entries(t).filter(([k]) => k !== 'Spolu' && f(k)).reduce((a, [, x]) => a + x, 0)) / spolu;
};
const UK: [string, string, (k: string) => boolean][] = [
  ['Deti do 14 rokov', 'vek', (k) => k === '14 rokov alebo menej'],
  ['Ľudia nad 65 rokov', 'vek', (k) => k === '65 rokov alebo viac'],
  ['Vysokoškolské vzdelanie', 'vzdelanie', (k) => /vysokoškolsk/i.test(k)],
];
const sklad = UK.map(([n, t, f]) => ({ n, obec: pct(o.scitanie?.[t], f), okres: pct(sucet(t), f) })).filter((x) => x.obec != null);
const top = (tema: string, n = 3) => Object.entries(o.scitanie?.[tema] ?? {}).filter(([k]) => k !== 'Spolu' && !/^(nezisten|Nezisten|iná|Iná|ostatné)/.test(k)).slice(0, n);
const spolu = o.scitanie?.vek?.Spolu ?? 0;
const kratkeNab = (k: string) => k.split(' / ').pop()!.replace(/ v Slovenskej republike| na Slovensku/g, '');
// graf obyvateľov (SVG)
const rad = Object.entries(o.obyvatelia).sort(([a], [b]) => a.localeCompare(b));
const W = 600, H = 160, P = 24;
const minV = Math.min(...rad.map(([, x]) => x)), maxV = Math.max(...rad.map(([, x]) => x));
const sx = (i: number) => P + (i * (W - 2 * P)) / Math.max(1, rad.length - 1);
const sy = (x: number) => H - P - ((x - minV) / Math.max(1, maxV - minV)) * (H - 2 * P);
const ciara = rad.map(([, x], i) => `${i ? 'L' : 'M'}${sx(i).toFixed(1)},${sy(x).toFixed(1)}`).join('');
// obce v okolí
const okolie = o.poloha ? obceKraja(o.kraj_slug)
  .filter((x) => x.kod !== o.kod && x.poloha).map((x) => ({ x, d: km(o.poloha!, x.poloha!) })).sort((a, b) => a.d - b.d).slice(0, 8) : [];
const obvody = v && v.obvodov > 1;
const vacsia = jeVacsia(o);
const maKviz = vacsia && kvizObce(o).length >= 5;
const u = urlObce(o);
const idsP = idsPoslancov(v?.poslanci ?? []);
const hosp = hospodarenieObce(o.kod);
const hRoky = hosp ? Object.keys(hosp).sort() : [];
const hRok = hRoky[hRoky.length - 1];
const hP = hosp && hRok ? hosp[hRok] : null;
const obyvH = p?.[1] ?? 0;
const naOb = (v?: number) => (v != null && obyvH ? v / obyvH : null);
const HUK: [string, (h: Record<string, number | undefined>) => number | undefined, string][] = [
  ['Daňové výnosy', (h) => h.danove_vynosy, 'hlavne podiel na dani z príjmov a daň z nehnuteľností'],
  ['Náklady spolu', (h) => h.naklady, ''],
  ['Mzdy a odvody', (h) => h.osobne_naklady, 'zamestnanci obce a jej škôl'],
  ['Bankové úvery', (h) => h.bankove_uvery, 'stav na konci roka'],
  ['Záväzky spolu', (h) => h.zavazky, 'úvery, dodávatelia, ŠFRB a iné'],
];
const hTab = hP && hRok ? HUK.map(([n, f, pozn]) => ({ n, pozn, obec: naOb(f(hP)), okres: medianOkresu(okresObce, hRok, f) })).filter((x) => x.obec != null) : [];
const zm = zmluvyObce(o.kod);
const zmInfo = zmluvyInfo();
const eia = eiaObce(o.kod);
const eur = (n: number) => n >= 1e6 ? `${des(n / 1e6)} mil. €` : `${fmt(Math.round(n))} €`;
const datum = (d: string) => d.split('-').reverse().map((x, i) => (i < 2 ? String(Number(x)) : x)).join('. ');
// nezamestnanosť (ÚPSVaR)
const nezI = nezamInfo();
const nez = nezI?.obce?.[o.kod] ?? null;
const nezOkres = nezI?.okresy?.[o.okres] ?? null;
const MES = ['január', 'február', 'marec', 'apríl', 'máj', 'jún', 'júl', 'august', 'september', 'október', 'november', 'december'];
const mesiacText = (m: string) => `${MES[Number(m.slice(5, 7)) - 1]} ${m.slice(0, 4)}`;
const nezRad = nez ? Object.entries(nez.rad).sort(([a], [b]) => a.localeCompare(b)) : [];
const nezMax = Math.max(1, ...nezRad.map(([, x]) => x), nezOkres ?? 0);
const nezRok = nez && nezRad.length >= 13 ? nezRad[nezRad.length - 1][1] - nezRad[0][1] : null;
// odpad (ŠÚ SR)
const odI = odpadInfo();
const od = odI?.obce?.[o.kod] ?? null;
const odRok = od ? Object.keys(od).sort().pop()! : null;
const odP = od && odRok ? od[odRok] : null;
const odOkr = odI?.okresy?.[o.okres] ?? null;
// školy (MŠVVaM)
const skI = skolyInfo();
const sk = skI?.obce?.[o.kod] ?? null;
const SK_TVARY: Record<string, [string, string, string]> = {
  ms: ['materská škola', 'materské školy', 'materských škôl'], zs: ['základná škola', 'základné školy', 'základných škôl'],
  ss: ['stredná škola', 'stredné školy', 'stredných škôl'], spec: ['špeciálna škola', 'špeciálne školy', 'špeciálnych škôl'],
  zus: ['umelecká škola (ZUŠ)', 'umelecké školy (ZUŠ)', 'umeleckých škôl (ZUŠ)'], cvc: ['centrum voľného času', 'centrá voľného času', 'centier voľného času'],
};
const skTvar = (t_: string, n: number) => { const f = SK_TVARY[t_]; return f ? f[n === 1 ? 0 : n < 5 ? 1 : 2] : t_; };
// eurofondy a dotácie (zmluvy o NFP v CRZ)
const nfp = zm?.nfp && zm.nfp[0] > 0 ? zm : null;
const zmlText = (n: number) => (n === 1 ? 'zmluva' : n < 5 ? 'zmluvy' : 'zmlúv');
// celoštátne voľby
const VOLI = volbyInfo()?.volby ?? {};
const celostatne = ['nrsr2023', 'prez2024_1', 'prez2024_2', 'ep2024'].map((id) => ({ id, v: VOLI[id], x: VOLI[id]?.obce?.[o.kod] })).filter((a) => a.v && a.x);
const jePrez = (id: string) => id.startsWith('prez');
// pohyb obyvateľstva a vek
const pohI = pohybInfo();
const poh = pohI?.obce?.[o.kod] ?? null;
const pohRad = poh?.rad ? Object.entries(poh.rad).sort(([a], [b]) => a.localeCompare(b)) : [];
const pohSum = pohRad.reduce((a, [, r]) => [a[0] + r[0], a[1] + r[1], a[2] + r[2], a[3] + r[3]], [0, 0, 0, 0]);
const vekOkr = pohI?.okresy?.[o.okres]?.vek ?? null;
const pohMax = Math.max(1, ...pohRad.flatMap(([, r]) => [r[0], r[1], r[2], r[3]]));
// bývanie (SODB 2021)
const byvI = byvanieInfo();
const byv = byvI?.obce?.[o.kod] ?? null;
const byvOkr = byvI?.okresy?.[o.okres] ?? {};
// firmy
const firI = firmyInfo();
const fir = firI?.obce?.[o.kod] ?? null;
const firRoky = fir ? Object.keys(fir).sort() : [];
const firP = fir && firRoky.length ? fir[firRoky[firRoky.length - 1]] : null;
const firS = fir && firRoky.length > 5 ? fir[firRoky[firRoky.length - 6]] : null;
// služby, vlaky, turizmus
const sluI = sluzbyInfo();
const slu = sluI?.obce?.[o.kod] ?? null;
const vlI = vlakyInfo();
const vl = vlI?.obce?.[o.kod] ?? null;
const ZDR: [string, [string, string, string]][] = [
  ['vseob', ['ambulancia všeobecného lekára', 'ambulancie všeobecného lekára', 'ambulancií všeobecného lekára']], ['deti', ['ambulancia detského lekára', 'ambulancie detského lekára', 'ambulancií detského lekára']],
  ['zubar', ['zubná ambulancia', 'zubné ambulancie', 'zubných ambulancií']], ['gyn', ['gynekologická ambulancia', 'gynekologické ambulancie', 'gynekologických ambulancií']],
  ['spec', ['ambulancia špecialistu', 'ambulancie špecialistov', 'ambulancií špecialistov']], ['lekarne', ['lekáreň', 'lekárne', 'lekární']],
  ['polikliniky', ['poliklinika', 'polikliniky', 'polikliník']], ['nemocnice', ['nemocnica', 'nemocnice', 'nemocníc']], ['rzp', ['stanica záchrannej služby', 'stanice záchrannej služby', 'staníc záchrannej služby']],
];
const tvar = (f: [string, string, string], n: number) => f[n === 1 ? 0 : n < 5 ? 1 : 2];
const turI = turizmusInfo();
const tur = turI?.obce?.[o.kod] ?? null;
const turRoky = tur ? Object.keys(tur).sort() : [];
const turRok = turRoky.filter((r) => Number(r) < new Date().getFullYear()).pop() ?? turRoky[turRoky.length - 1];
const turP = tur && turRok ? tur[turRok] : null;
const popis = `${o.nazov} (okres ${o.okres}): ${p ? `${fmt(p[1])} obyvateľov` : ''}${z10 != null ? `, za 10 rokov ${z10 > 0 ? '+' : ''}${des(z10)} %` : ''}${st ? `. Starosta 2026: ${bezTit(st.meno)}` : ''}. Sčítanie 2021, voľby a poslanci.`;
---
<Base title={`${o.nazov} – obec v číslach (okres ${o.okres}) – mestovcislach.sk`} description={popis}
  drobceky={[[o.kraj, `/${o.kraj_slug}`], [`Okres ${o.okres}`, `/${o.kraj_slug}/${o.okres_slug}`], [o.nazov, `/${o.kraj_slug}/${o.okres_slug}/${o.slug}`]]}>
  <section class="hero">
    <p class="ob-cesta"><a href="/">Slovensko</a> › <a href={`/${o.kraj_slug}`}>{o.kraj}</a> › <a href={`/${o.kraj_slug}/${o.okres_slug}`}>okres {o.okres}</a></p>
    <h1 translate="no">{o.nazov}</h1>
    <p class="lead">Obyvatelia, sčítanie 2021 a komunálne voľby 2026{st ? <> – {titulStarostu.toLowerCase()} <strong translate="no">{bezTit(st.meno)}</strong></> : ''}.</p>
    <p class="ob-akcie"><PoslatZnamemu text={`${o.nazov} v číslach`} />{maKviz && <a class="ob-kviz" href={`${u}/kviz`}>Kvíz: poznáte {o.nazov}?</a>}</p>
  </section>

  <ul class="ob-cisla">
    {p && <li><b>{fmt(p[1])}</b><span>obyvateľov k 31. 12. {p[0]}</span></li>}
    {z10 != null && <li><b>{z10 > 0 ? '+' : z10 < 0 ? '−' : ''}{des(Math.abs(z10))} %</b><span>zmena počtu obyvateľov za 10 rokov</span></li>}
    {v?.ucast && <li><b>{des(v.ucast.ucast_pct)} %</b><span>účasť v komunálnych voľbách 2026</span></li>}
    {v && v.poslanci.length > 0 && <li><b>{v.poslanci.length}</b><span>poslancov obecného zastupiteľstva</span></li>}
  </ul>

  <div class="ob-dva">
    {rad.length > 2 && (
      <section class="card">
        <h2>Počet obyvateľov {rad[0][0]} – {rad[rad.length - 1][0]}</h2>
        <svg class="ob-graf" viewBox={`0 0 ${W} ${H}`} role="img" aria-label={`Počet obyvateľov: ${rad[0][0]} ${fmt(rad[0][1])}, ${rad[rad.length - 1][0]} ${fmt(rad[rad.length - 1][1])}`}>
          <path class="plocha" d={`${ciara}L${sx(rad.length - 1)},${H - P}L${sx(0)},${H - P}Z`} />
          <path class="ciara" d={ciara} />
          <text x={P} y={H - 6}>{rad[0][0]}</text><text x={W - P} y={H - 6} text-anchor="end">{rad[rad.length - 1][0]}</text>
          <text x={P} y={14}>{fmt(maxV)}</text><text x={P} y={H - P - 4}>{fmt(minV)}</text>
        </svg>
        <p class="zdroj">Trvale bývajúci obyvatelia k 31. 12. Zdroj: ŠÚ SR – STATdata (om7101rr).</p>
      </section>
    )}

    {sklad.length > 0 && (
      <section class="card">
        <h2>Kto tu býva</h2>
        <p class="pozn">Sčítanie 2021 ({fmt(spolu)} obyvateľov); v zátvorke priemer okresu {o.okres}.</p>
        <ul class="ob-bary">
          {sklad.map((x) => <li><span>{x.n}</span><span class="pruh" aria-hidden="true"><i style={`width:${Math.min(100, x.obec! * 2)}%`}></i></span><span class="num"><strong>{des(x.obec!)} %</strong> <small>({x.okres != null ? `${des(x.okres)} %` : '–'})</small></span></li>)}
        </ul>
        {top('narodnost').length > 0 && <p class="pozn">Národnosť: {top('narodnost').map(([k, x]) => `${k} ${des((100 * x) / spolu)} %`).join(', ')}.</p>}
        {top('nabozenstvo').length > 0 && <p class="pozn">Náboženstvo: {top('nabozenstvo').map(([k, x]) => `${kratkeNab(k)} ${des((100 * x) / spolu)} %`).join(', ')}.</p>}
      </section>
    )}
  </div>

  {(poh?.rad || poh?.vek != null) && (
    <section class="card" id="pohyb">
      <h2>Narodení, zomrelí, sťahovanie</h2>
      <ul class="ob-cisla">
        {poh.vek != null && <li><b>{des(poh.vek)} r.</b><span>priemerný vek ({poh.vek_rok}){vekOkr != null ? `, okres ${des(vekOkr)}` : ''}{poh.vek10 != null ? `; pred 10 rokmi ${des(poh.vek10)}` : ''}</span></li>}
        {pohRad.length > 0 && <li><b>{pohSum[0] - pohSum[1] > 0 ? '+' : pohSum[0] - pohSum[1] < 0 ? '−' : ''}{fmt(Math.abs(pohSum[0] - pohSum[1]))}</b><span>prirodzený prírastok za {pohRad.length} rokov ({fmt(pohSum[0])} narodených, {fmt(pohSum[1])} zomrelých)</span></li>}
        {pohRad.length > 0 && <li><b>{pohSum[2] - pohSum[3] > 0 ? '+' : pohSum[2] - pohSum[3] < 0 ? '−' : ''}{fmt(Math.abs(pohSum[2] - pohSum[3]))}</b><span>saldo sťahovania za {pohRad.length} rokov ({fmt(pohSum[2])} prisťahovaných, {fmt(pohSum[3])} vysťahovaných)</span></li>}
      </ul>
      {pohRad.length > 2 && (
        <div class="ob-obal">
          <table class="ob-tab ob-pohyb">
            <thead><tr><th>Rok</th><th class="num">Narodení</th><th class="num">Zomrelí</th><th class="num">Prisťahovaní</th><th class="num">Vysťahovaní</th><th class="num">Spolu</th></tr></thead>
            <tbody>{pohRad.slice().reverse().map(([r, [a, b, c, d]]) => { const z = a - b + c - d; return <tr><td>{r}</td><td class="num">{fmt(a)}</td><td class="num">{fmt(b)}</td><td class="num">{fmt(c)}</td><td class="num">{fmt(d)}</td><td class={`num ${z < 0 ? 'zaporne' : ''}`}>{z > 0 ? '+' : z < 0 ? '−' : ''}{fmt(Math.abs(z))}</td></tr>; })}</tbody>
          </table>
        </div>
      )}
      <p class="zdroj">Zdroj: ŠÚ SR – pohyb obyvateľstva a indexy vekového zloženia (STATdata om7103rr, om7052rr).</p>
    </section>
  )}

  {byv && (
    <section class="card" id="byvanie">
      <h2>Domy, kanalizácia, plyn, voda</h2>
      <ul class="ob-bary">
        {([['Kanalizácia', 'kanal', 'domy pripojené na verejnú kanalizáciu'], ['Plyn', 'plyn', 'domy s plynovou prípojkou'], ['Verejný vodovod', 'vodovod', 'domy s vodou z verejnej siete']] as const).filter(([, k]) => byv[k] != null).map(([n, k, pozn]) => (
          <li><span>{n}<small>{pozn}</small></span><span class="pruh" aria-hidden="true"><i style={`width:${byv[k]}%`}></i></span><span class="num"><strong>{des(byv[k], 0)} %</strong> <small>({byvOkr[k] != null ? `okres ${des(byvOkr[k]!, 0)} %` : '–'})</small></span></li>
        ))}
      </ul>
      {byv.kanal != null && byv.kanal < 50 && byv.zumpa != null && <p class="pozn">{des(byv.zumpa, 0)} % domov má septik alebo žumpu{byv.cov ? `, ${des(byv.cov, 0)} % domácu čističku` : ''}.</p>}
      {byv.vek_domov && <p class="pozn">Domy postavené alebo zrekonštruované: do 1945 {des(byv.vek_domov[0], 0)} % · 1946–1980 {des(byv.vek_domov[1], 0)} % · 1981–2000 {des(byv.vek_domov[2], 0)} % · 2001–2009 {des(byv.vek_domov[3], 0)} % · od 2010 {des(byv.vek_domov[4], 0)} %.</p>}
      {byv.kurenie && <p class="pozn">Kúrenie v bytoch: ústredné vlastné {des(byv.kurenie[1], 0)} %, diaľkové (teplárne) {des(byv.kurenie[0], 0)} %, etážové {des(byv.kurenie[2], 0)} %, kachle a iné samostatné telesá {des(byv.kurenie[3], 0)} %.</p>}
      <p class="zdroj">Zdroj: ŠÚ SR – Sčítanie obyvateľov, domov a bytov 2021 ({byv.domov ? `${fmt(byv.domov)} domov` : ''}). Odvtedy mohla obec kanalizáciu alebo plynovod rozšíriť.</p>
    </section>
  )}

  {v && (
    <section class="card" id="volby">
      <h2>Komunálne voľby 2026</h2>
      {v.starosta.length > 0 && (
        <>
          <h3>Voľba {titulStarostu === 'Starosta' ? 'starostu' : 'primátora / starostu'}</h3>
          <ul class="ob-bary">
            {v.starosta.map((k) => (
              <li><span class={k.zvoleny ? 'zv' : ''} translate="no">{k.meno}<small>{/^nezávisl/i.test(k.strany) ? 'nezávislý kandidát' : skrat(k.strany)}{k.zvoleny ? ' · zvolený(-á)' : ''}</small></span>
                <span class="pruh" aria-hidden="true"><i style={`width:${k.podiel}%`}></i></span>
                <span class="num">{des(k.podiel)} % <small>{fmt(k.hlasy)} hlasov</small></span></li>
            ))}
          </ul>
          {v.kandidatov === 1 && <p class="pozn">Kandidoval jediný kandidát.</p>}
        </>
      )}
      {v.poslanci.length > 0 && (
        <>
          <h3>Zvolení poslanci</h3>
          <div class="ob-obal">
            <table class="ob-tab">
              <thead><tr><th>Meno</th><th>Strana</th>{obvody && <th class="num">Obvod</th>}<th class="num">Hlasy</th></tr></thead>
              <tbody>{v.poslanci.map((x, i) => <tr><td translate="no">{vacsia ? <a href={`${u}/poslanci/${idsP[i]}`}>{x.meno}</a> : x.meno}</td><td translate="no">{/^nezávisl/i.test(x.strany) ? 'nezávislý' : skrat(x.strany)}</td>{obvody && <td class="num">{x.obvod_c}</td>}<td class="num">{fmt(x.hlasy)}</td></tr>)}</tbody>
            </table>
          </div>
          {v.mandaty.length > 1 && <p class="pozn">Mandáty: {v.mandaty.map((m) => `${/^nezávisl/i.test(m.strany) ? 'nezávislí' : skrat(m.strany)} ${m.mandaty}`).join(', ')}.</p>}
        </>
      )}
      <p class="zdroj">Zdroj: Štatistický úrad SR – výsledky komunálnych volieb 24. 10. 2026. Uvádzame len meno, stranu a hlasy.</p>
    </section>
  )}

  {celostatne.length > 0 && (
    <section class="card" id="volby-celostatne">
      <h2>Ako sa tu volilo</h2>
      <div class="ob-volby">
        {celostatne.map(({ id, v: vv, x }) => (
          <div>
            <h3>{vv!.nazov}</h3>
            <p class="pozn">Účasť <strong>{des(x![0])} %</strong> (okres {vv!.okresy[o.okres] != null ? `${des(vv!.okresy[o.okres])} %` : '–'}, Slovensko {des(vv!.sr.ucast)} %)</p>
            <ul class="ob-bary">
              {x![1].slice(0, jePrez(id) ? 4 : 5).map(([i, pct]) => { const sr = vv!.sr.s.find(([j]) => j === i)?.[1]; return (
                <li><span translate="no">{jePrez(id) ? vv!.strany[i] : skratStrany(vv!.strany[i])}</span><span class="pruh" aria-hidden="true"><i style={`width:${pct}%`}></i></span><span class="num"><strong>{des(pct)} %</strong>{sr != null && <small> (SR {des(sr)} %)</small>}</span></li>
              ); })}
            </ul>
          </div>
        ))}
      </div>
      <p class="zdroj">Zdroj: ŠÚ SR – výsledky volieb do NR SR 2023, voľby prezidenta 2024 a voľby do Európskeho parlamentu 2024 (otvorené dáta, volby.statistics.sk). Podiel z platných hlasov v obci.</p>
    </section>
  )}

  {hP && (
    <section class="card" id="hospodarenie">
      <h2>Hospodárenie obce {hRok}</h2>
      <ul class="ob-cisla">
        {hP.vynosy != null && <li><b>{eur(hP.vynosy)}</b><span>výnosy</span></li>}
        {hP.naklady != null && <li><b>{eur(hP.naklady)}</b><span>náklady</span></li>}
        {hP.vysledok != null && <li><b class={hP.vysledok < 0 ? 'zaporne' : ''}>{hP.vysledok > 0 ? '+' : hP.vysledok < 0 ? '−' : ''}{eur(Math.abs(hP.vysledok))}</b><span>{hP.vysledok < 0 ? 'strata' : 'zisk'} (účtovný výsledok)</span></li>}
      </ul>
      {hTab.length > 0 && (
        <div class="ob-obal">
          <table class="ob-tab">
            <thead><tr><th>Na obyvateľa</th><th class="num">{o.nazov}</th><th class="num">medián obcí okresu</th></tr></thead>
            <tbody>{hTab.map((x) => <tr><td>{x.n}{x.pozn && <><br /><small>{x.pozn}</small></>}</td><td class="num">{fmt(Math.round(x.obec!))} €</td><td class="num">{x.okres != null ? `${fmt(Math.round(x.okres))} €` : '–'}</td></tr>)}</tbody>
          </table>
        </div>
      )}
      {hRoky.length > 1 && (
        <p class="pozn">Výsledok hospodárenia po rokoch: {hRoky.map((r) => { const v = hosp![r].vysledok; return v != null ? `${r} ${v > 0 ? '+' : v < 0 ? '−' : ''}${eur(Math.abs(v))}` : null; }).filter(Boolean).join(' · ')}.</p>
      )}
      <p class="zdroj">Zdroj: <a href="https://www.registeruz.sk" rel="noopener">Register účtovných závierok</a> – individuálna účtovná závierka obce (bez obecných firiem). Účtovný výsledok nie je to isté ako prebytok rozpočtu: zahŕňa napr. odpisy majetku. Na obyvateľa podľa počtu obyvateľov {p?.[0]}.</p>
    </section>
  )}

  {nez && nezI && (
    <section class="card" id="nezamestnanost">
      <h2>Nezamestnanosť</h2>
      <ul class="ob-cisla">
        {nez.pdu != null && <li><b>{des(nez.pdu, 1)} %</b><span>miera nezamestnanosti ({mesiacText(nezI.mesiac)})</span></li>}
        {nezOkres != null && <li><b>{des(nezOkres, 1)} %</b><span>okres {o.okres}</span></li>}
        {nezI.sr != null && <li><b>{des(nezI.sr, 1)} %</b><span>Slovensko</span></li>}
        <li><b>{fmt(nez.uoz)}</b><span>{nez.uoz === 1 ? 'uchádzač' : nez.uoz > 1 && nez.uoz < 5 ? 'uchádzači' : 'uchádzačov'} o zamestnanie{nez.abs ? `, z toho ${fmt(nez.abs)} ${nez.abs === 1 ? 'absolvent' : nez.abs < 5 ? 'absolventi' : 'absolventov'}` : ''}</span></li>
      </ul>
      {nezRad.length > 2 && (
        <div class="ob-stlpce" role="img" aria-label={`Miera nezamestnanosti za posledných ${nezRad.length} mesiacov`}>
          {nezRad.map(([m, x]) => <div title={`${mesiacText(m)}: ${des(x, 2)} %`}><span style={`height:${Math.max(2, (x / nezMax) * 100)}%`}></span><small>{m.slice(5, 7) === '01' || m === nezRad[0][0] ? `${Number(m.slice(5, 7))}/${m.slice(2, 4)}` : Number(m.slice(5, 7))}</small></div>)}
        </div>
      )}
      {nezRok != null && <p class="pozn">Za posledný rok {Math.abs(nezRok) < 0.05 ? 'bez výraznej zmeny' : `${nezRok < 0 ? 'pokles' : 'nárast'} o ${des(Math.abs(nezRok), 1)} percentuálneho bodu`}.</p>}
      <p class="zdroj">Zdroj: <a href={nezI.zdroj?.url ?? 'https://www.upsvr.gov.sk'} rel="noopener">ÚPSVaR – mesačná štatistika uchádzačov o zamestnanie podľa obcí</a>. Miera = podiel disponibilných uchádzačov o zamestnanie na obyvateľoch v produktívnom veku (PDU, takto ju ÚPSVaR počíta pre obce a okresy). V malých obciach ju výrazne posunie aj pár ľudí.</p>
    </section>
  )}

  {firP && (
    <section class="card" id="firmy">
      <h2>Firmy a živnostníci</h2>
      <ul class="ob-cisla">
        <li><b>{fmt(firP[0])}</b><span>firiem (obchodné spoločnosti, družstvá a iné ziskové právnické osoby)</span></li>
        <li><b>{fmt(firP[2])}</b><span>živnostníkov{firP[3] > 0 ? ` a ${fmt(firP[3])} ďalších podnikateľov (napr. SHR, slobodné povolania)` : ''}</span></li>
        <li><b>{fmt(firP[1])}</b><span>neziskových organizácií (občianske združenia, nadácie, cirkevné a iné)</span></li>
      </ul>
      {firS && <p class="pozn">Za 5 rokov ({firRoky[firRoky.length - 6]} → {firRoky[firRoky.length - 1]}): firmy {fmt(firS[0])} → {fmt(firP[0])}, živnostníci {fmt(firS[2])} → {fmt(firP[2])}.</p>}
      <p class="zdroj">Zdroj: ŠÚ SR – Register organizácií, stav k 31. 12. {firRoky[firRoky.length - 1]} (STATdata og3805rr, og3808rr). Podľa sídla, resp. bydliska podnikateľa – len počty, bez mien.</p>
    </section>
  )}

  {nfp && (
    <section class="card" id="eurofondy">
      <h2>Eurofondy a dotácie</h2>
      <p><b>{fmt(nfp.nfp![0])}</b> {zmlText(nfp.nfp![0])} o nenávratnom finančnom príspevku v hodnote <b>{eur(nfp.nfp![1])}</b> od roku {zmInfo!.od.slice(0, 4)}.</p>
      <ul class="ob-zmluvy">
        {nfp.nfp_zoz!.map(([d, p_, s, pr, id]) => <li><a href={`https://www.crz.gov.sk/zmluva/${id}/`} rel="noopener"><b>{eur(s)}</b> <span translate="no">{p_}</span></a><small>{datum(d)}{pr ? ` · ${pr}` : ''}</small></li>)}
      </ul>
      <p class="zdroj">Zdroj: <a href="https://www.crz.gov.sk" rel="noopener">Centrálny register zmlúv</a> – zmluvy o poskytnutí nenávratného finančného príspevku (NFP) uzavreté od 1. 1. {zmInfo!.od.slice(0, 4)}, bez dodatkov: eurofondy (Program Slovensko, Program rozvoja vidieka), plán obnovy a ďalšie. Suma je maximálna výška príspevku podľa zmluvy, nie to, čo už obec dostala. Staršie projekty nájdete na <a href="https://www.itms2014.sk" rel="noopener">itms2014.sk</a>.</p>
    </section>
  )}

  {zmInfo && (
    <section class="card" id="zmluvy">
      <h2>Zmluvy v registri zmlúv</h2>
      {zm ? (
        <>
          <ul class="ob-roky">
            {Object.entries(zm.roky).map(([r, [n, s]]) => <li><b>{r}</b> {fmt(n)} {n === 1 ? 'zmluva' : n < 5 ? 'zmluvy' : 'zmlúv'} · {eur(s)}</li>)}
          </ul>
          {zm.partneri.length > 0 && (
            <>
              <h3>Najväčší zmluvní partneri za posledné 2 roky</h3>
              <div class="ob-obal">
                <table class="ob-tab">
                  <thead><tr><th>Partner</th><th class="num">Zmlúv</th><th class="num">Spolu</th></tr></thead>
                  <tbody>{zm.partneri.map(([n, c, s]) => <tr><td translate="no">{n}</td><td class="num">{fmt(c)}</td><td class="num">{eur(s)}</td></tr>)}</tbody>
                </table>
              </div>
            </>
          )}
          {zm.najvacsie.length > 0 && (
            <>
              <h3>Najväčšie zmluvy za posledných 12 mesiacov</h3>
              <ul class="ob-zmluvy">
                {zm.najvacsie.map(([d, p, s, pr, id]) => <li><a href={`https://www.crz.gov.sk/zmluva/${id}/`} rel="noopener"><b>{eur(s)}</b> <span translate="no">{p}</span></a><small>{datum(d)}{pr ? ` · ${pr}` : ''}</small></li>)}
              </ul>
            </>
          )}
          {zm.podozrive ? <p class="pozn">{zm.podozrive === 1 ? 'Jednu zmluvu' : `${zm.podozrive} zmluvy`} s nepravdepodobne vysokou sumou (zjavná chyba v registri) do súm nezapočítavame.</p> : null}
          {zm.fo[0] > 0 && <p class="pozn">Ďalších {fmt(zm.fo[0])} zmlúv s fyzickými osobami alebo partnermi bez IČO ({eur(zm.fo[1])}) len započítavame, bez mien.</p>}
        </>
      ) : (
        <p>Od roku {zmInfo.od.slice(0, 4)} sme v Centrálnom registri zmlúv nenašli žiadnu zmluvu obce. Obec ich pravdepodobne zverejňuje na vlastnom webe.</p>
      )}
      <p class="zdroj">Zdroj: <a href="https://www.crz.gov.sk" rel="noopener">Centrálny register zmlúv</a>, zmluvy od 1. 1. {zmInfo.od.slice(0, 4)} do {datum(zmInfo.do)}. Obce môžu zmluvy zverejňovať aj na vlastnom webe – tu sú len tie z CRZ, vrátane zmlúv zverejnených partnerom (napr. ministerstvom pri dotácii).</p>
    </section>
  )}

  {eia && (
    <section class="card" id="eia">
      <h2>Čo sa tu stavia a plánuje</h2>
      <p><b>{fmt(eia.spolu)}</b> {eia.spolu === 1 ? 'zámer' : eia.spolu < 5 ? 'zámery' : 'zámerov'} v posudzovaní vplyvov na životné prostredie (EIA/SEA){eia.aktivne ? `, z toho ${fmt(eia.aktivne)} ešte ${eia.aktivne > 1 && eia.aktivne < 5 ? 'prebiehajú' : 'prebieha'}` : ''}.</p>
      <ul class="ob-zmluvy">
        {eia.zamery.slice(0, 8).map(([seo, n, stav, zmena, typ, kat, uk]) => <li><a href={`${eiaWeb()}${seo}`} rel="noopener">{n}</a><small>{KAT_EIA[kat] ?? kat} · {typ} · {stav}{zmena ? ` · ${datum(zmena)}` : ''}{uk ? '' : ' · prebieha'}</small></li>)}
      </ul>
      <p class="zdroj">Zdroj: Enviroportál MŽP SR / SAŽP – informačný systém EIA/SEA. Zámer sa posudzuje ešte pred stavebným povolením.</p>
    </section>
  )}

  {(slu || vl || sluI) && (
    <section class="card" id="sluzby">
      <h2>Lekár, lekáreň, pošta, vlak</h2>
      <ul class="ob-zoznam">
        {slu?.zdravie ? ZDR.filter(([k]) => slu.zdravie![k]).map(([k, f]) => <li><b>{fmt(slu.zdravie![k])}</b> {tvar(f, slu.zdravie![k])}</li>) : <li>Žiadna ambulancia ani lekáreň (podľa štatistiky {sluI?.roky?.zdravie}).</li>}
        <li>{slu?.posta ? <><b>{slu.posta === 1 ? 'Pošta' : `${slu.posta} pošty`}</b> v obci</> : 'Pošta v obci nie je.'}</li>
        {slu?.kniznica && <li><b>Obecná knižnica</b>{slu.kniznica[1] ? ` · ${fmt(slu.kniznica[1])} kníh a iných jednotiek` : ''}</li>}
        {vl ? vl.map(([n, c]) => <li><b>Vlak:</b> <span translate="no">{n}</span> · {fmt(c)} {c === 1 ? 'vlak' : c < 5 ? 'vlaky' : 'vlakov'} v pracovný deň</li>) : vlI && <li>Železničná stanica ani zastávka v obci nie je.</li>}
      </ul>
      {turP && turP.zariadeni ? <p class="pozn">Ubytovanie ({turRok}): {fmt(turP.zariadeni)} {turP.zariadeni === 1 ? 'ubytovacie zariadenie' : turP.zariadeni < 5 ? 'ubytovacie zariadenia' : 'ubytovacích zariadení'}{turP.lozok ? ` s ${fmt(turP.lozok)} lôžkami` : ''}{turP.vyuzitie ? `, využitie lôžok ${des(turP.vyuzitie)} %` : ''}.</p> : null}
      <p class="zdroj">Zdroj: ŠÚ SR – zdravotníctvo za obce ({sluI?.roky?.zdravie}), pošty a knižnice ({sluI?.roky?.posta}); ŽSR – grafikon vlakovej dopravy (GTFS){vlI?.den ? `, počet vlakov ${datum(vlI.den)}` : ''}{turP ? '; ŠÚ SR – kapacity ubytovacích zariadení' : ''}. Ambulancie sú počítané podľa sídla – mená lekárov neuvádzame.</p>
    </section>
  )}

  {sk && skI && (
    <section class="card" id="skoly">
      <h2>Školy a škôlky</h2>
      <ul class="ob-cisla">
        {Object.entries(sk.typy).map(([t_, [n, z]]) => <li><b>{fmt(n)}</b><span>{skTvar(t_, n)}{z ? ` · ${fmt(z)} ${t_ === 'cvc' ? 'členov' : t_ === 'ms' ? 'detí' : 'žiakov'}` : ''}</span></li>)}
      </ul>
      <ul class="ob-zmluvy">
        {sk.zoznam.map(([n, t_, z]) => <li><span>{n}</span><small>{skTvar(t_, 1).replace(/^./, (c) => c.toUpperCase())}{z ? ` · ${fmt(z)} ${t_ === 'cvc' ? 'členov' : t_ === 'ms' ? 'detí' : 'žiakov'}` : ''}</small></li>)}
      </ul>
      <p class="zdroj">Zdroj: <a href="https://mapaskol.iedu.sk" rel="noopener">MŠVVaM SR – Digitálna mapa škôl</a> (aktuálny školský rok). Súčasti spojených škôl (napr. ZŠ s MŠ) sú uvedené zvlášť, bez jedální a školských klubov.</p>
    </section>
  )}
  {!sk && skI && (
    <section class="card" id="skoly">
      <h2>Školy a škôlky</h2>
      <p>V obci nie je podľa Digitálnej mapy škôl žiadna škola ani škôlka – deti dochádzajú do okolitých obcí.</p>
      <p class="zdroj">Zdroj: <a href="https://mapaskol.iedu.sk" rel="noopener">MŠVVaM SR – Digitálna mapa škôl</a>.</p>
    </section>
  )}

  {odP && odI && odRok && (
    <section class="card" id="odpad">
      <h2>Komunálny odpad {odRok}</h2>
      <div class="ob-obal">
        <table class="ob-tab">
          <thead><tr><th></th><th class="num">{o.nazov}</th><th class="num">medián obcí okresu</th></tr></thead>
          <tbody>
            <tr><td>Podiel triedeného odpadu<br /><small>odhad zo štatistiky, nie úradná úroveň vytriedenia</small></td><td class="num">{des(odP.triedene, 0)} %</td><td class="num">{odOkr?.triedene != null ? `${des(odOkr.triedene, 0)} %` : '–'}</td></tr>
            {odP.kg_zmes != null && <tr><td>Zmesový odpad na obyvateľa<br /><small>čierna nádoba – čím menej, tým lepšie</small></td><td class="num">{fmt(odP.kg_zmes)} kg</td><td class="num">{odOkr?.kg_zmes != null ? `${fmt(odOkr.kg_zmes)} kg` : '–'}</td></tr>}
            {odP.kg != null && <tr><td>Všetok komunálny odpad na obyvateľa</td><td class="num">{fmt(odP.kg)} kg</td><td class="num">–</td></tr>}
          </tbody>
        </table>
      </div>
      <p class="pozn">Medián všetkých obcí Slovenska: podiel triedeného {des(odI.sr.triedene, 0)} %, zmesový odpad {fmt(odI.sr.kg_zmes)} kg na obyvateľa.</p>
      {Object.keys(od!).length > 1 && <p class="pozn">Podiel triedeného po rokoch: {Object.entries(od!).sort(([a], [b]) => a.localeCompare(b)).map(([r, x]) => `${r} ${des(x.triedene, 0)} %`).join(' · ')}.</p>}
      <p class="zdroj">Zdroj: <a href="https://statdata.statistics.sk" rel="noopener">ŠÚ SR</a> – množstvo komunálneho odpadu podľa druhov za obce (ročný výkaz obce). Podiel triedeného = všetok komunálny odpad okrem zmesového, objemného a uličného smetia. Úradnú úroveň vytriedenia (od nej závisí poplatok za skládkovanie) počíta obec podľa vyhlášky trochu inak a môže sa líšiť.</p>
    </section>
  )}

  <Kalendar kraj={o.kraj} />

  {o.poloha && (
    <section class="card" id="pocasie" data-poloha={JSON.stringify(o.poloha)}>
      <h2>Počasie teraz</h2>
      <p id="po-text" aria-live="polite">Načítavam…</p>
      <p class="zdroj">Open-Meteo (CC BY 4.0).</p>
    </section>
  )}

  {okolie.length > 0 && (
    <section class="card">
      <h2>Obce v okolí</h2>
      <ul class="ob-zoznam">
        {okolie.map(({ x, d }) => <li><a href={odkaz({ nazov: x.nazov, url: `/${x.kraj_slug}/${x.okres_slug}/${x.slug}` })}><span translate="no">{x.nazov}</span><small>{des(d)} km · {fmt(posledne(x.obyvatelia)?.[1] ?? 0)} ob.</small></a></li>)}
      </ul>
    </section>
  )}
  <p class="zdroj">Pozri aj <a href={`/${o.kraj_slug}/${o.okres_slug}`}>všetky obce okresu {o.okres}</a> a <a href={`/${o.kraj_slug}`}>{o.kraj}</a>.</p>
</Base>

<script>
  import { pocasie } from '../../../../scripts/zive';
  const sek = document.getElementById('pocasie');
  if (sek) {
    const [lat, lon] = JSON.parse(sek.dataset.poloha!) as [number, number];
    pocasie([lat, lon]).then((p) => {
      document.getElementById('po-text')!.innerHTML = `<strong>${p.teplota} °C</strong>, ${p.stav}. Dnes ${p.min} až ${p.max} °C, vietor ${p.vietor} km/h.`;
    }).catch(() => { document.getElementById('po-text')!.textContent = 'Predpoveď sa nepodarilo načítať.'; });
  }
</script>
