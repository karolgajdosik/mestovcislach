---
// Prehľad krajského mesta z celoštátnych zdrojov (data/mesta/<slug>.json, scripts/zber_mesta.py).
// Bratislava má vlastné, podrobnejšie stránky v src/pages/bratislava/.
import fs from 'node:fs';
import path from 'node:path';
import { castiMesta } from '../../lib/casti-mesta';
import Base from '../../layouts/Base.astro';
import { MESTA, type Mesto } from '../../mesta';
import { KATEGORIE_EIA } from '../../lib/eia';
import { maMapu, maSamospravu, mapaMesta } from '../../lib/mapa';
import VolbyMapa from '../../components/VolbyMapa.astro';
import FotoMesta from '../../components/FotoMesta.astro';
import VolbyPorovnanie from '../../components/VolbyPorovnanie.astro';
import { maZivot } from '../../lib/temy';

export function getStaticPaths() {
  return MESTA.filter((m) => m.aktivne && !m.plne).map((m) => ({ params: { mesto: m.slug }, props: { m } }));
}
const { m } = Astro.props as { m: Mesto };
const citaj = (...c: string[]) => {
  const p = path.join(process.cwd(), ...c);
  return fs.existsSync(p) ? JSON.parse(fs.readFileSync(p, 'utf-8')) : null;
};
const d = citaj('data', 'mesta', `${m.slug}.json`) ?? {};
const por = citaj('data', 'mesta', 'porovnanie.json')?.mesta ?? [];
const eia = citaj('public', 'data', 'mesta', `eia-${m.slug}.json`);
const katalog = (m as any).katalog ? citaj('data', `katalog-stav-${m.slug}.json`) : null;

const fmt = (n: number | null | undefined) => (n == null ? '–' : Math.round(n).toLocaleString('sk-SK'));
const des = (n: number | null | undefined, k = 1) => (n == null ? '–' : n.toLocaleString('sk-SK', { minimumFractionDigits: k, maximumFractionDigits: k }));
const znam = (n: number | null | undefined) => (n == null ? '–' : `${n > 0 ? '+' : n < 0 ? '−' : ''}${des(Math.abs(n))} %`);
const datum = (x?: string) => (x ? new Date(x).toLocaleDateString('sk-SK', { day: 'numeric', month: 'numeric', year: 'numeric' }) : '');

// obyvatelia
const roky: Record<string, number> = d.obyvatelia?.roky ?? {};
const rokyZ = Object.keys(roky).sort();
const posl = rokyZ[rokyZ.length - 1];
const ja = por.find((p: any) => p.slug === m.slug) ?? {};
const casti = Object.entries<Record<string, number>>(d.obyvatelia?.casti ?? {})
  .map(([n, r]) => ({ n, v: r[posl], z: r[String(Number(posl) - 10)] ? 100 * (r[posl] / r[String(Number(posl) - 10)] - 1) : null }))
  .filter((c) => c.v).sort((a, b) => b.v - a.v);
// poradie medzi krajskými mestami
const poradie = (k: string, vysoko = true) => {
  const h = por.filter((p: any) => p[k] != null).sort((a: any, b: any) => (vysoko ? b[k] - a[k] : a[k] - b[k]));
  const i = h.findIndex((p: any) => p.slug === m.slug);
  return i < 0 ? '' : `${i + 1}. z ${h.length}`;
};

// sčítanie
const sc = d.scitanie ?? {};
const podiely = (t: Record<string, number> | undefined, n = 6, bez: RegExp = /^Spolu$/) => {
  if (!t) return [];
  const spolu = t.Spolu ?? Object.entries(t).filter(([k]) => k !== 'Spolu').reduce((s, [, v]) => s + v, 0);
  return Object.entries(t).filter(([k]) => !bez.test(k)).sort((a, b) => b[1] - a[1]).slice(0, n).map(([k, v]) => [k.replace(/ \/ .*$/, '').replace(/ v Slovenskej republike.*$/, ''), (100 * v) / spolu] as [string, number]);
};
const vek = podiely(sc.vek, 3, /^(Spolu|Neznáme)$/);
const vzdelanie = podiely(sc.vzdelanie, 6, /^(Spolu|Bez ukončeného vzdelania - osoby vo veku 0-14 rokov)$/);
const narodnost = podiely(sc.narodnost, 5);
const nabozenstvo = podiely(sc.nabozenstvo, 5);

// voľby
const komRoky = Object.keys(d.komunalne ?? {}).sort();
const kom = komRoky.length ? d.komunalne[komRoky[komRoky.length - 1]] : null;
const komRok = komRoky[komRoky.length - 1];
const nrsr = d.volby?.nrsr2023;
const ep = d.volby?.ep2024;

// práca a bývanie
const praca = d.praca?.mesacne ?? {};
const mesiace = Object.keys(praca).sort();
const pracaPosl = mesiace.length ? praca[mesiace[mesiace.length - 1]] : null;
const byty = d.byty ?? {};
const bytyRoky = Object.keys(byty).sort();
const ceny = d.ceny?.kraj ?? {};
const cenyQ = Object.keys(ceny).sort();
const cenyPosl = cenyQ[cenyQ.length - 1];

// čo sa stavia
const zamery: any[] = eia?.zamery ?? [];
const aktivne = zamery.filter((z) => !z.ukoncene);
const zobrazit = [...aktivne, ...zamery.filter((z) => z.ukoncene)].slice(0, 12);
const mesiac = (k: string) => { const [r, mm] = k.split('-'); return `${Number(mm)}/${r}`; };
const profilyMc = !m.plne && !!castiMesta(m.slug);
const mcSlug = (n: string) => n.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
---
<Base title={`${m.nazov} v číslach – mestovcislach.sk`} description={`${m.nazov}: obyvatelia, sčítanie 2021, voľby, nezamestnanosť, výstavba bytov, ceny bývania a stavebné zámery z otvorených dát.`}>
  <FotoMesta slug={m.slug} nazov={m.nazov}>
    <p class="kicker">{m.kraj}</p>
    <h1><span translate="no">{m.nazov}</span> v číslach</h1>
  </FotoMesta>
  <section class="hero hero-pod">
    <p class="lead">Údaje z celoštátnych zdrojov – Štatistického úradu, volieb, úradov práce a Enviroportálu. {maMapu(m.slug) ? <> Na <a href={`/${m.slug}/mapa`}>mape mesta</a> nájdete lekárne, školy, zastávky, ihriská či úrady.</> : ''}{maZivot(m.slug) ? <> Školy, vlaky, kriminalitu, ovzdušie a kultúru nájdete v časti <a href={`/${m.slug}/zivot`}>Život v meste</a>.</> : ''}{maSamospravu(m.slug) ? <> Zmluvy, faktúry a hlasovania poslancov sú na stránke <a href={`/${m.slug}/samosprava`}>Samospráva</a>.</> : ''} Podrobnejšie mestské dáta (rozpočet, doprava) pribudnú podľa toho, čo mesto zverejňuje.</p>
  </section>

  <div class="kpis">
    <div class="card kpi"><p class="label">Obyvatelia {posl}</p><p class="value">{fmt(roky[posl])}</p><p class="delta">{znam(ja.zmena10)} za 10 rokov · {poradie('obyvatelia')} krajských miest</p></div>
    <div class="card kpi"><p class="label">Seniori 65+</p><p class="value">{des(ja.seniori)} %</p><p class="delta">sčítanie 2021 · {poradie('seniori')} najstaršie</p></div>
    <div class="card kpi"><p class="label">Vysokoškoláci</p><p class="value">{des(ja.vs)} %</p><p class="delta">všetkých obyvateľov · {poradie('vs')} najvzdelanejšie</p></div>
    <div class="card kpi"><p class="label">Nezamestnanosť (PDU)</p><p class="value">{des(ja.pdu, 2)} %</p><p class="delta">okres{m.okresy.length > 1 ? 'y' : ''} {m.okresy.join(', ')} · {mesiace.length ? mesiac(mesiace[mesiace.length - 1]) : ''}</p></div>
  </div>

  <section class="card" id="teraz" data-mesto={m.slug} data-rieka={(m as any).rieka_id ?? ''}>
    <h2>Teraz v meste</h2>
    <div class="teraz">
      <div class="blok"><h3>Výstrahy SHMÚ</h3><div id="t-vystrahy" aria-live="polite"><p class="pozn">Načítavam…</p></div></div>
      <div class="blok"><h3>Ovzdušie</h3><ul id="t-ovzdusie" class="stanice"><li class="pozn">Načítavam…</li></ul><p class="zdroj">Index kvality ovzdušia (IKO) zo staníc SHMÚ: dobrá 0–33, zhoršená 34–66, zlá 67–100, veľmi zlá nad 100.</p></div>
      {(m as any).rieka_id && <div class="blok"><h3>Rieka</h3><div id="t-rieka"><p class="pozn">Načítavam…</p></div></div>}
    </div>
  </section>

  <section class="card" id="obyvatelia">
    <h2>Obyvatelia</h2>
    <p class="pozn">Počet obyvateľov k 31. 12. podľa Štatistického úradu SR.</p>
    <div class="graf"><canvas id="g-obyv" data-rad={JSON.stringify(rokyZ.filter((r) => Number(r) >= 1996).map((r) => [r, roky[r]]))} role="img" aria-label={`Vývoj počtu obyvateľov – ${m.nazov}`}></canvas></div>
    {casti.length > 0 && (
      <>
        <h3>Mestské časti ({posl})</h3>
        <div class="tabulka-obal">
          <table>
            <thead><tr><th>Mestská časť</th><th class="num">Obyvatelia</th><th class="num">Zmena za 10 rokov</th></tr></thead>
            <tbody>{casti.map((c) => <tr><td translate="no">{profilyMc ? <a href={`/${m.slug}/mestske-casti/${mcSlug(c.n)}`}>{c.n}</a> : c.n}</td><td class="num">{fmt(c.v)}</td><td class="num">{znam(c.z)}</td></tr>)}</tbody>
          </table>
        </div>
        {profilyMc && <p><a href={`/${m.slug}/mestske-casti`}>Profily mestských častí – vek, vzdelanie, voľby, dostupnosť a mapa →</a></p>}
      </>
    )}
    <p class="zdroj">Zdroj: ŠÚ SR – DATAcube (om7101rr).</p>
  </section>

  {Object.keys(sc).length > 0 && (
    <section class="card" id="scitanie">
      <h2>Kto tu žije</h2>
      <p class="pozn">Sčítanie obyvateľov, domov a bytov 2021.</p>
      <div class="stlpce">
        {[['Vek', vek], ['Najvyššie vzdelanie', vzdelanie], ['Národnosť', narodnost], ['Náboženstvo', nabozenstvo]].filter(([, v]) => (v as any[]).length).map(([n, v]) => (
          <div>
            <h3>{n}</h3>
            <ul class="pruhy">{(v as [string, number][]).map(([k, p]) => <li><span class="p-n">{k}</span><span class="p-h">{des(p)} %</span><span class="p-p" aria-hidden="true"><i style={`width:${Math.min(100, p)}%`}></i></span></li>)}</ul>
          </div>
        ))}
      </div>
      <p class="zdroj">Zdroj: ŠÚ SR – Sčítanie obyvateľov, domov a bytov 2021 (STATdata), CC BY 4.0.</p>
    </section>
  )}

  <section class="card" id="volby">
    <h2>Voľby</h2>
    {!d.komunalne?.['2026'] && Date.now() < Date.parse('2026-11-15') && (
      <p class="priebezne">Komunálne a krajské voľby sú v <strong>sobotu 24. októbra 2026</strong>. Výsledky voľby primátora a mestského zastupiteľstva sa tu objavia automaticky počas volebnej noci – zdroj Štatistického úradu SR kontrolujeme každých 15 minút.</p>
    )}
    {kom && (
      <div class="blok">
        <h3>Voľba primátora {komRok}</h3>
        {kom.spracovanie?.priebezne && <p class="priebezne" role="status"><strong>Priebežné výsledky</strong> – spracovaných {fmt(kom.spracovanie.okrsky)} z {fmt(kom.spracovanie.spolu)} okrskov ({des(kom.spracovanie.pct)} %). Obnovuje sa každých 15 minút.</p>}
        <p class="pozn">Účasť {des(kom.ucast?.ucast_pct)} % · {fmt(kom.ucast?.volili)} voličov{ja.ucast_komunalne != null && ` · ${poradie('ucast_komunalne')} krajských miest podľa účasti`}</p>
        <ul class="pruhy kandidati">{kom.primator.slice(0, 6).map((k: any) => (
          <li class={k.zvoleny ? 'zvoleny' : ''}><span class="p-n"><strong translate="no">{k.meno}</strong>{k.zvoleny && <em> zvolený</em>}<small translate="no">{k.strany.length > 90 ? k.strany.slice(0, 88) + '…' : k.strany}</small></span><span class="p-h">{des(k.podiel)} %</span><span class="p-p" aria-hidden="true"><i style={`width:${k.podiel}%`}></i></span></li>
        ))}</ul>
        {komRoky.length > 1 && (() => {
          const s = d.komunalne[komRoky[komRoky.length - 2]];
          const r = (rok: string, x: any) => ({ rok, ucast: x.ucast?.ucast_pct, kandidati: x.primator, mandaty: x.zastupitelstvo?.mandaty, poslancov: x.zastupitelstvo?.poslancov });
          return <VolbyPorovnanie stary={r(komRoky[komRoky.length - 2], s)} novy={r(komRok, kom)} priebezne={!!kom.spracovanie?.priebezne} />;
        })()}
        {kom.mestske_casti?.length > 1 && <><h3>Voľba primátora podľa mestských častí</h3><VolbyMapa casti={kom.mestske_casti} hranice={mapaMesta(m.slug)?.hranice} nazovKey="n" priebezne={!!kom.spracovanie?.priebezne} mesto={m.nazov} tabulka /></>}
        {kom.zastupitelstvo.poslancov > 0 && <>
        <h3>Mestské zastupiteľstvo – {kom.zastupitelstvo.poslancov} poslancov</h3>
        <ul class="mandaty">{kom.zastupitelstvo.mandaty.map((x: any) => <li><b>{x.mandaty}</b> <span translate="no">{x.strany.length > 110 ? x.strany.slice(0, 108) + '…' : x.strany}</span></li>)}</ul>
        </>}
      </div>
    )}
    <div class="dva">
      {[nrsr, ep].filter(Boolean).map((v: any) => (
        <div class="blok">
          <h3>{v.nazov}</h3>
          <p class="pozn">Účasť {des(v.ucast)} % (Slovensko {des(v.ucast_sr)} %)</p>
          <ul class="pruhy">{v.strany.slice(0, 6).map((s: any) => <li><span class="p-n" translate="no">{s.nazov}</span><span class="p-h">{des(s.podiel)} %</span><span class="p-p" aria-hidden="true"><i style={`width:${s.podiel * 2}%`}></i></span></li>)}</ul>
        </div>
      ))}
    </div>
    <p class="vb-viac"><a href={`/${m.slug}/volby`}>Komunálne voľby 2026 – podrobné výsledky {m.v} →</a></p>
    <p class="zdroj">Zdroj: Štatistický úrad SR – volby.statistics.sk a volbysr.sk. Pri kandidátoch uvádzame len meno, stranu a hlasy.</p>
  </section>

  <section class="card" id="praca">
    <h2>Práca a bývanie</h2>
    <div class="dva">
      {pracaPosl && (
        <div class="blok">
          <h3>Nezamestnanosť – {mesiac(mesiace[mesiace.length - 1])}</h3>
          <p class="pozn">Podiel disponibilných uchádzačov o zamestnanie na obyvateľoch v produktívnom veku (PDU). Údaje sú za okres, teda aj s obcami okolo mesta.</p>
          <ul class="pruhy">{Object.entries<any>(pracaPosl).map(([o, v]) => <li><span class="p-n">{/kraj|republika|Slovensko/i.test(o) ? o : `okres ${o}`}<small>{fmt(v.uoz)} uchádzačov</small></span><span class="p-h">{des(v.pdu, 2)} %</span><span class="p-p" aria-hidden="true"><i style={`width:${Math.min(100, v.pdu * 10)}%`}></i></span></li>)}</ul>
          <p class="zdroj">Zdroj: ÚPSVaR – mesačná štatistika.</p>
        </div>
      )}
      {cenyPosl && (
        <div class="blok">
          <h3>Ceny bývania v kraji</h3>
          <p class="pozn">Medziročná zmena cien predaných bytov a domov – {m.kraj} ({cenyPosl.replace(/^(\d{4})-Q(\d)$/, '$2. Q $1')}: <strong>{znam(ceny[cenyPosl])}</strong>, Slovensko {znam(d.ceny?.sr?.[cenyPosl])}).</p>
          <div class="graf maly"><canvas id="g-ceny" data-rad={JSON.stringify(cenyQ.map((q) => [q.replace(/^(\d{4})-Q(\d)$/, '$2Q $1'), ceny[q], d.ceny?.sr?.[q] ?? null]))} role="img" aria-label="Medziročná zmena cien bývania v kraji a na Slovensku"></canvas></div>
          <p class="zdroj">Zdroj: ŠÚ SR – index realizačných cien nehnuteľností (sp3801qr). Ceny za mesto ani €/m² nie sú v otvorených dátach.</p>
        </div>
      )}
    </div>
    {bytyRoky.length > 0 && (
      <div class="blok">
        <h3>Koľko bytov pribúda</h3>
        <p class="pozn">Dokončené a začaté byty v okres{m.okresy.length > 1 ? 'och' : 'e'} {m.okresy.join(', ')}. Priemer za 10 rokov: {fmt(ja.byty_10r)} dokončených bytov ročne. Rok 2025 je z nového registra a nemusí byť porovnateľný.</p>
        <div class="graf"><canvas id="g-byty" data-rad={JSON.stringify(bytyRoky.map((r) => [r, byty[r].DOKONC_BYT ?? null, byty[r].ZAC_BYT ?? null]))} role="img" aria-label="Dokončené a začaté byty podľa rokov"></canvas></div>
        <p class="zdroj">Zdroj: ŠÚ SR – DATAcube (st3004rr).</p>
      </div>
    )}
  </section>

  <section class="card" id="stavby">
    <h2>Čo sa stavia</h2>
    {zamery.length ? (
      <>
        <p class="pozn">Väčšie stavby a plány v posudzovaní vplyvov na životné prostredie (EIA/SEA). Práve sa posudzuje <strong>{aktivne.length}</strong> z {zamery.length} zámerov od roku 2000.</p>
        <ol class="zamery">{zobrazit.map((z) => (
          <li>
            <span class="z-hlava"><span class="z-kat" style={`--f:${(KATEGORIE_EIA[z.kat] ?? KATEGORIE_EIA.ine)[1]}`}>{(KATEGORIE_EIA[z.kat] ?? KATEGORIE_EIA.ine)[0]}</span><span class={`z-stav ${z.ukoncene ? 'ukoncene' : 'aktivne'}`}>{z.ukoncene ? 'ukončené' : 'posudzuje sa'}</span></span>
            <a href={`${eia.web}${z.seo}`} rel="noopener" translate="no">{z.nazov}</a>
            <small>{z.stav} · zmena {datum(z.zmena)}{z.mc?.length ? ` · ${z.mc.join(', ')}` : ''}{z.navrhovatel ? ` · ${z.navrhovatel}` : ''}</small>
          </li>
        ))}</ol>
        <p class="zdroj">Zdroj: Enviroportál MŽP SR – informačný systém EIA/SEA, aktualizované denne. Navrhovateľov uvádzame len pri firmách a inštitúciách. Nové zámery môžete <a href={`/${m.slug}/upozornenia`}>odoberať ako upozornenia</a>.</p>
      </>
    ) : <p class="pozn">Zámery z Enviroportálu sa práve zbierajú – pribudnú do jedného dňa.</p>}
  </section>

  {katalog && (
    <section class="card porovnaj">
      <h2>Otvorené dáta mesta</h2>
      <p class="pozn">{m.nazov} zverejňuje {katalog.datasety.length} datasetov na portáli <a href={(m as any).katalog.portal}>{(m as any).katalog.nazov}</a>. {katalog.pocty.katalog ?? 0} tabuliek si môžete pozrieť s grafom a stiahnuť v CSV.</p>
      <p><a class="tlacidlo" href={`/${m.slug}/katalog`}>Katalóg dát mesta</a></p>
    </section>
  )}

  <section class="card porovnaj">
    <h2>Ako si <span translate="no">{m.nazov}</span> stojí medzi krajskými mestami</h2>
    <p><a class="tlacidlo" href={`/porovnanie#${m.slug}`}>Porovnať všetkých 8 krajských miest</a></p>
  </section>
</Base>

<script>
  import Chart from 'chart.js/auto';
  import { vystrahy, ovzdusie, dunaj, stupenDunaja, farbaOvzdusia } from '../../scripts/zive';

  // Teraz v meste – výstrahy, ovzdušie, rieka (živo zo SHMÚ)
  {
    const t = document.getElementById('teraz');
    if (t) {
      const mesto = t.dataset.mesto!;
      const hx = (x: unknown) => String(x ?? '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!);
      const cas = (ms: number) => new Date(ms).toLocaleString('sk-SK', { day: 'numeric', month: 'numeric', hour: '2-digit', minute: '2-digit' });
      const vy = document.getElementById('t-vystrahy')!;
      vystrahy(mesto).then((d) => {
        const v = d.vystrahy ?? [];
        vy.innerHTML = v.length
          ? v.map((x: any) => `<p class="vystraha" data-stav="${hx(x.farba)}"><strong>${hx(x.udalost)}</strong> · ${hx(x.stupen)}<br><small>${x.od ? `od ${cas(Date.parse(x.od))}` : ''}${x.do ? ` do ${cas(Date.parse(x.do))}` : ''}</small></p>`).join('')
          : '<p><strong>Žiadne platné výstrahy</strong> pre okres' + (mesto === 'kosice' ? 'y mesta' : ' mesta') + '.</p>';
      }).catch(() => (vy.innerHTML = '<p class="pozn">Výstrahy sú teraz nedostupné.</p>'));
      const ov = document.getElementById('t-ovzdusie')!;
      ovzdusie(mesto).then((d) => {
        ov.innerHTML = (d.stanice ?? []).map((s: any) => `<li><span translate="no">${hx(s.nazov)}</span><span class="iko" data-stav="${farbaOvzdusia(s.kategoria?.stupen)}">${hx(s.kategoria?.nazov ?? '–')} <b>${hx(s.iko ?? '–')}</b></span><small>${cas(s.cas)}</small></li>`).join('') || '<li class="pozn">Žiadne aktuálne merania.</li>';
      }).catch(() => (ov.innerHTML = '<li class="pozn">Merania SHMÚ sú teraz nedostupné.</li>'));
      const ri = document.getElementById('t-rieka');
      if (ri && t.dataset.rieka) dunaj(t.dataset.rieka).then((d) => {
        const st = stupenDunaja(d);
        ri.innerHTML = `<p class="velke">${hx(d.stav)} cm <small>${hx(d.trend ?? '')}</small></p><p class="pozn">${hx(d.stanica)} · meranie ${cas(d.cas)}${d.teplota != null ? ` · voda ${hx(d.teplota)} °C` : ''}</p>`
          + `<p>${st ? `<strong>${st}. stupeň povodňovej aktivity</strong>` : d.spa?.[1] ? `Do 1. stupňa povodňovej aktivity chýba <strong>${d.spa[1] - d.stav} cm</strong>.` : ''}</p>`
          + `<p class="zdroj"><a href="${hx(d.zdroj?.url)}" rel="noopener">SHMÚ – vodomerná stanica</a></p>`;
      }).catch(() => (ri.innerHTML = '<p class="pozn">Údaje SHMÚ sú teraz nedostupné.</p>'));
    }
  }
  const css = getComputedStyle(document.documentElement);
  const muted = css.getPropertyValue('--muted').trim();
  const akc = css.getPropertyValue('--accent').trim();
  const modra = document.documentElement.dataset.tema === 'tmava' ? '#7cc4ff' : '#1f6fd1';
  const fmt = (n: number) => n.toLocaleString('sk-SK');
  const osi = { x: { grid: { display: false }, ticks: { color: muted, maxRotation: 0, autoSkip: true } }, y: { ticks: { color: muted } } };
  const obyv = document.getElementById('g-obyv') as HTMLCanvasElement | null;
  if (obyv) {
    const rad: [string, number][] = JSON.parse(obyv.dataset.rad!);
    new Chart(obyv, { type: 'line', data: { labels: rad.map((r) => r[0]), datasets: [{ label: 'Obyvatelia', data: rad.map((r) => r[1]), borderColor: akc, backgroundColor: akc, pointRadius: 0, borderWidth: 2.5, tension: 0.2 }] },
      options: { maintainAspectRatio: false, plugins: { legend: { display: false }, tooltip: { callbacks: { label: (c) => ` ${fmt(c.parsed.y)} obyvateľov` } } }, scales: osi } });
  }
  const ceny = document.getElementById('g-ceny') as HTMLCanvasElement | null;
  if (ceny) {
    const rad: [string, number, number | null][] = JSON.parse(ceny.dataset.rad!);
    new Chart(ceny, { type: 'line', data: { labels: rad.map((r) => r[0]), datasets: [
      { label: 'Kraj', data: rad.map((r) => r[1]), borderColor: akc, backgroundColor: akc, pointRadius: 0, borderWidth: 2.5, tension: 0.25 },
      { label: 'Slovensko', data: rad.map((r) => r[2]), borderColor: muted, backgroundColor: muted, pointRadius: 0, borderWidth: 2, borderDash: [5, 4], tension: 0.25 },
    ] }, options: { maintainAspectRatio: false, interaction: { mode: 'index', intersect: false }, plugins: { legend: { position: 'bottom' }, tooltip: { callbacks: { label: (c) => ` ${c.dataset.label}: ${c.parsed.y > 0 ? '+' : ''}${c.parsed.y.toLocaleString('sk-SK')} %` } } },
      scales: { ...osi, y: { ticks: { color: muted, callback: (v) => `${v} %` } } } } });
  }
  const byty = document.getElementById('g-byty') as HTMLCanvasElement | null;
  if (byty) {
    const rad: [string, number | null, number | null][] = JSON.parse(byty.dataset.rad!);
    new Chart(byty, { type: 'bar', data: { labels: rad.map((r) => r[0]), datasets: [
      { label: 'Dokončené byty', data: rad.map((r) => r[1]), backgroundColor: akc },
      { label: 'Začaté byty', data: rad.map((r) => r[2]), backgroundColor: modra },
    ] }, options: { maintainAspectRatio: false, plugins: { legend: { position: 'bottom' } }, scales: osi } });
  }
</script>

