---
// Súboj miest: každý deň jedna otázka „Ktoré mesto má viac …?“ (rovnaká pre všetkých), séria správnych dní a štatistiky
// v localStorage, súhrn tipov ostatných (functions/api/suboj.ts, ak je nastavená KV väzba). Potom ľubovoľne ďalšie kolá.
import Base from '../layouts/Base.astro';
import '../styles/stranka.css';
import { MESTA } from '../mesta';
import { ukazovatele } from '../lib/ukazovatele';

const mesta = Object.fromEntries(MESTA.filter((m) => m.aktivne).map((m) => [m.slug, m.nazov]));
const u = ukazovatele().map(({ id, nazov, jednotka, des, hodnoty, rok, zdroj, otazka }) => ({ id, nazov, jednotka, des, hodnoty, rok, zdroj, otazka }));
---
<Base title="Súboj miest – denná otázka – mestovcislach.sk" description="Každý deň jedna otázka: ktoré z dvoch krajských miest má viac? Tipnite si, udržte sériu a porovnajte sa s ostatnými. Odpovede z otvorených dát.">
  <section class="hero">
    <p class="kicker">Hra</p>
    <h1>Súboj miest</h1>
    <p class="lead">Každý deň nová otázka – rovnaká pre všetkých. Ktoré z dvoch miest má viac? Tipnite si a udržte sériu.</p>
  </section>

  <div class="sb" id="suboj" data-u={JSON.stringify(u)} data-mesta={JSON.stringify(mesta)}>
    <section class="card sb-karta" aria-live="polite">
      <p class="sb-stitok" id="sb-stitok">Otázka dňa</p>
      <h2 id="sb-otazka">…</h2>
      <div class="sb-volby" id="sb-volby"></div>
      <div class="sb-vysledok" id="sb-vysledok" hidden></div>
      <div class="sb-tl" id="sb-tl" hidden>
        <button type="button" id="sb-dalsia">Ďalšia otázka (tréning)</button>
        <button type="button" id="sb-share">Zdieľať</button>
      </div>
    </section>

    <section class="card sb-stat">
      <h2>Vaša bilancia</h2>
      <ul class="sb-cisla">
        <li><b id="sb-seria">0</b><span>dní v sérii</span></li>
        <li><b id="sb-naj">0</b><span>najdlhšia séria</span></li>
        <li><b id="sb-dni">0</b><span>otázok dňa</span></li>
        <li><b id="sb-uspesnost">–</b><span>úspešnosť</span></li>
      </ul>
      <div class="sb-mesta" id="sb-mesta"></div>
      <p class="pozn">Bilancia sa ukladá len vo vašom prehliadači. Súhrn tipov ostatných obsahuje len počty, nie kto odpovedal.</p>
    </section>
  </div>
  <p class="pozn">Odpovede vychádzajú z otvorených dát Štatistického úradu SR (DATAcube, Sčítanie 2021, Urban Audit) a ÚPSVaR – pri každej otázke je zdroj a rok. Viac v <a href="/porovnaj">Porovnaj dve mestá</a> a v kvízoch miest.</p>
</Base>

<script>
  type U = { id: string; nazov: string; jednotka: string; des: number; hodnoty: Record<string, number>; rok: string; zdroj: string; otazka: string };
  const obal = document.getElementById('suboj')!;
  const UK: U[] = JSON.parse(obal.dataset.u!);
  const MESTA: Record<string, string> = JSON.parse(obal.dataset.mesta!);
  const KLUC = 'suboj-stav';
  type Stav = { dni: Record<string, { volba: string; spravne: boolean }>; trening: [number, number]; mesta: Record<string, [number, number]> };
  const citaj = (): Stav => { try { return { dni: {}, trening: [0, 0], mesta: {}, ...JSON.parse(localStorage.getItem(KLUC) || '{}') }; } catch { return { dni: {}, trening: [0, 0], mesta: {} }; } };
  const zapis = (s: Stav) => { try { localStorage.setItem(KLUC, JSON.stringify(s)); } catch { /* */ } };
  const hx = (t: string) => t.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);
  const f = (u: U, v: number) => `${v.toLocaleString('sk-SK', { minimumFractionDigits: u.des, maximumFractionDigits: u.des })}${u.jednotka}`;
  const den = new Intl.DateTimeFormat('sv-SE', { timeZone: 'Europe/Bratislava' }).format(new Date());

  // všetky dvojice s rozdielom aspoň 5 % (aby otázka nebola lotéria)
  const DVOJICE: [U, string, string][] = [];
  for (const u of UK) {
    const s = Object.keys(u.hodnoty);
    for (let i = 0; i < s.length; i++) for (let j = i + 1; j < s.length; j++) {
      const a = u.hodnoty[s[i]], b = u.hodnoty[s[j]];
      if (Math.abs(a - b) / Math.max(Math.abs(a), Math.abs(b), 1e-9) >= 0.05) DVOJICE.push([u, s[i], s[j]]);
    }
  }
  const hash = (t: string) => { let h = 2166136261; for (const c of t) { h ^= c.charCodeAt(0); h = Math.imul(h, 16777619); } return h >>> 0; };
  const denna = (): [U, string, string] => { const x = DVOJICE[hash(`suboj-${den}`) % DVOJICE.length]; return hash(den) % 2 ? [x[0], x[2], x[1]] : x; };
  let aktualna: [U, string, string] = denna();
  let jeDenna = true;

  function zobraz() {
    const [u, a, b] = aktualna;
    const s = citaj();
    document.getElementById('sb-stitok')!.textContent = jeDenna ? `Otázka dňa · ${new Date(den).toLocaleDateString('sk-SK', { day: 'numeric', month: 'long' })}` : 'Tréning';
    document.getElementById('sb-otazka')!.textContent = u.otazka;
    document.getElementById('sb-volby')!.innerHTML = [a, b].map((x) => `<button type="button" class="sb-volba" data-s="${x}"><span>${hx(MESTA[x])}</span></button>`).join('<span class="sb-vs" aria-hidden="true">vs.</span>');
    document.getElementById('sb-vysledok')!.hidden = true;
    document.getElementById('sb-tl')!.hidden = true;
    const uz = jeDenna ? s.dni[den] : null;
    if (uz) vyhodnot(uz.volba, false);
  }

  async function vyhodnot(volba: string, nova = true) {
    const [u, a, b] = aktualna;
    const spravna = u.hodnoty[a] > u.hodnoty[b] ? a : b;
    const ok = volba === spravna;
    document.querySelectorAll<HTMLButtonElement>('.sb-volba').forEach((btn) => {
      btn.disabled = true;
      const s = btn.dataset.s!;
      btn.classList.toggle('spravna', s === spravna);
      btn.classList.toggle('zla', s === volba && !ok);
      btn.insertAdjacentHTML('beforeend', `<b>${f(u, u.hodnoty[s])}</b>`);
    });
    if (nova) {
      const s = citaj();
      if (jeDenna) s.dni[den] = { volba, spravne: ok };
      else s.trening = [s.trening[0] + (ok ? 1 : 0), s.trening[1] + 1];
      for (const m of [a, b]) { const x = s.mesta[m] ?? [0, 0]; s.mesta[m] = [x[0] + (ok ? 1 : 0), x[1] + 1]; }
      zapis(s);
    }
    const v = document.getElementById('sb-vysledok')!;
    v.hidden = false;
    v.innerHTML = `<p class="sb-verdikt ${ok ? 'ok' : 'zle'}">${ok ? 'Správne!' : 'Tentoraz nie.'}</p><p>${hx(u.nazov)}: ${hx(MESTA[a])} ${f(u, u.hodnoty[a])}, ${hx(MESTA[b])} ${f(u, u.hodnoty[b])}. <small>Zdroj: ${hx(u.zdroj)}${u.rok ? `, ${u.rok}` : ''}.</small></p><p class="sb-ini" id="sb-ini"></p>`;
    document.getElementById('sb-tl')!.hidden = false;
    statistiky();
    if (jeDenna) {
      try {
        const r = await fetch(nova ? '/api/suboj' : `/api/suboj?den=${den}`, nova ? { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ den, volba }) } : undefined);
        if (!r.ok) return;
        const p = (await r.json()).pocty as Record<string, number>;
        const spolu = (p[a] ?? 0) + (p[b] ?? 0);
        if (spolu >= 3) document.getElementById('sb-ini')!.textContent = `Ostatní dnes tipovali: ${MESTA[a]} ${Math.round((100 * (p[a] ?? 0)) / spolu)} %, ${MESTA[b]} ${Math.round((100 * (p[b] ?? 0)) / spolu)} % (${spolu} tipov).`;
      } catch { /* bez súhrnu */ }
    }
  }

  function statistiky() {
    const s = citaj();
    const dni = Object.keys(s.dni).sort();
    let seria = 0, naj = 0, akt = 0, pred = '';
    for (const d of dni) {
      const nadvazuje = pred && Date.parse(d) - Date.parse(pred) === 864e5;
      akt = s.dni[d].spravne ? (nadvazuje ? akt + 1 : 1) : 0;
      naj = Math.max(naj, akt); pred = d;
    }
    // aktuálna séria platí, ak posledná odpoveď je dnes alebo včera
    const vcera = new Date(Date.parse(den) - 864e5).toISOString().slice(0, 10);
    seria = pred === den || pred === vcera ? akt : 0;
    const spravne = dni.filter((d) => s.dni[d].spravne).length + s.trening[0], vsetky = dni.length + s.trening[1];
    document.getElementById('sb-seria')!.textContent = String(seria);
    document.getElementById('sb-naj')!.textContent = String(naj);
    document.getElementById('sb-dni')!.textContent = String(dni.length);
    document.getElementById('sb-uspesnost')!.textContent = vsetky ? `${Math.round((100 * spravne) / vsetky)} %` : '–';
    const m = Object.entries(s.mesta).filter(([, [, n]]) => n >= 2).map(([k, [o, n]]) => ({ k, p: o / n, n })).sort((x, y) => y.p - x.p);
    document.getElementById('sb-mesta')!.innerHTML = m.length >= 2
      ? `<p>Najlepšie vám ide mesto <strong>${hx(MESTA[m[0].k])}</strong> (${Math.round(100 * m[0].p)} % správne), najviac vás prekvapuje mesto <strong>${hx(MESTA[m.at(-1)!.k])}</strong> (${Math.round(100 * m.at(-1)!.p)} %).</p>` : '';
  }

  obal.addEventListener('click', (e) => { const b = (e.target as Element).closest<HTMLButtonElement>('.sb-volba'); if (b && !b.disabled) vyhodnot(b.dataset.s!); });
  document.getElementById('sb-dalsia')!.addEventListener('click', () => {
    jeDenna = false;
    let x: [U, string, string];
    do { x = DVOJICE[Math.floor(Math.random() * DVOJICE.length)]; } while (x === aktualna);
    aktualna = Math.random() < 0.5 ? x : [x[0], x[2], x[1]];
    zobraz();
    document.getElementById('sb-otazka')!.focus?.();
  });
  document.getElementById('sb-share')!.addEventListener('click', async () => {
    const s = citaj(); const d = s.dni[den];
    const text = d ? `Súboj miest ${den}: ${d.spravne ? '✅' : '❌'} – ${aktualna[0].otazka} Skúste aj vy:` : 'Súboj miest – ktoré mesto má viac? Skúste:';
    try { if (navigator.share) await navigator.share({ text, url: 'https://mestovcislach.sk/suboj' }); else await navigator.clipboard.writeText(`${text} https://mestovcislach.sk/suboj`); } catch { /* */ }
  });
  zobraz();
  statistiky();
</script>

<style>
  .sb-karta { text-align: center; }
  .sb-stitok { margin: 0; color: var(--accent); font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; font-size: 0.78rem; }
  .sb-karta h2 { font-size: clamp(1.3rem, 4vw, 1.8rem); margin: 8px auto 18px; max-width: 28em; }
  .sb-volby { display: grid; grid-template-columns: 1fr auto 1fr; gap: 12px; align-items: center; max-width: 640px; margin: 0 auto; }
  .sb-volby :global(.sb-vs) { font-weight: 800; color: var(--muted); }
  .sb-volby :global(.sb-volba) { min-height: 110px; padding: 14px; border-radius: 18px; border: 2px solid var(--line); background: var(--bg); color: var(--text); font: inherit; font-size: 1.3rem; font-weight: 800; cursor: pointer; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 6px; transition: transform 0.15s, border-color 0.15s; }
  .sb-volby :global(.sb-volba:hover:not(:disabled)) { border-color: var(--accent); transform: translateY(-2px); }
  .sb-volby :global(.sb-volba:disabled) { cursor: default; }
  .sb-volby :global(.sb-volba b) { font-size: 1rem; font-weight: 700; color: var(--muted); }
  .sb-volby :global(.sb-volba.spravna) { border-color: #16a34a; background: color-mix(in srgb, #16a34a 12%, var(--bg)); }
  .sb-volby :global(.sb-volba.zla) { border-color: #dc2626; background: color-mix(in srgb, #dc2626 10%, var(--bg)); }
  .sb-vysledok { max-width: 36em; margin: 16px auto 0; }
  .sb-vysledok :global(.sb-verdikt) { font-size: 1.4rem; font-weight: 800; margin: 0; }
  .sb-vysledok :global(.sb-verdikt.ok) { color: #15803d; }
  .sb-vysledok :global(.sb-verdikt.zle) { color: #b91c1c; }
  :global(:root[data-tema='tmava']) .sb-vysledok :global(.sb-verdikt.ok) { color: #4ade80; }
  :global(:root[data-tema='tmava']) .sb-vysledok :global(.sb-verdikt.zle) { color: #f87171; }
  .sb-vysledok :global(small), .sb-vysledok :global(.sb-ini) { color: var(--muted); }
  .sb-tl { display: flex; flex-wrap: wrap; justify-content: center; gap: 8px; margin-top: 14px; }
  .sb-tl button { min-height: 44px; padding: 0 16px; border-radius: 12px; border: 1.5px solid var(--line); background: var(--card); color: var(--text); font: inherit; font-weight: 700; cursor: pointer; }
  .sb-tl button:first-child { background: var(--accent); border-color: var(--accent); color: var(--na-akcente, #fff); }
  .sb-cisla { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: 8px; text-align: center; }
  .sb-cisla b { display: block; font-size: 1.8rem; font-variant-numeric: tabular-nums; }
  .sb-cisla span { font-size: 0.8rem; color: var(--muted); }
  .pozn { font-size: 0.82rem; color: var(--muted); }
  @media (max-width: 600px) { .sb-volby { grid-template-columns: 1fr; } .sb-cisla { grid-template-columns: repeat(2, 1fr); } }
  @media (prefers-reduced-motion: reduce) { .sb-volby :global(.sb-volba) { transition: none; } }
</style>
