---
import fs from 'node:fs';
import path from 'node:path';
import Base from '../layouts/Base.astro';

const nacitaj = (subor: string) => {
  const p = path.join(process.cwd(), 'data', subor);
  return fs.existsSync(p) ? JSON.parse(fs.readFileSync(p, 'utf-8')) : null;
};
const mhd = nacitaj('doprava-bratislava.json');
const stat = nacitaj('doprava-statistiky-bratislava.json');
const hranice = nacitaj('hranice-bratislava.geojson');
const obyv = nacitaj('obyvatelstvo-bratislava.json');

const fmt = (n: number) => n.toLocaleString('sk-SK');
const datum = (d: string) => new Date(d).toLocaleDateString('sk-SK', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' });
const plat = (s: string) => s && `${s.slice(6, 8)}. ${s.slice(4, 6)}. ${s.slice(0, 4)}`.replace(/^0/, '').replace(/ 0/, ' ');

// Názvy mestských častí podľa ŠÚ SR (OSM má niektoré odlišné).
const nazvy = new Map<string, string>((obyv?.mestske_casti ?? []).map((c: any) => [c.kod.slice(-6), c.nazov_kratky]));
const casti = (mhd?.mestske_casti ?? []).map((c: any) => ({ ...c, nazov: nazvy.get(c.kod_obce) ?? c.nazov }))
  .sort((a: any, b: any) => b.odchody - a.odchody);

const linkySpolu = mhd ? Object.values(mhd.mesto.linky as Record<string, number>).reduce((a, b) => a + b, 0) : 0;
const cest = stat?.cestujuci?.rocne as Record<string, number> | undefined;
const cestRoky = cest ? Object.keys(cest).sort() : [];
const cestPosl = cestRoky[cestRoky.length - 1];
const cestPred = cestRoky[cestRoky.length - 2];

const mapa = mhd && hranice ? JSON.stringify({
  hranice: { type: 'FeatureCollection', features: hranice.features.map((f: any) => ({ type: 'Feature', geometry: f.geometry, properties: {} })) },
  zastavky: mhd.zastavky.map((z: any) => [z.lat, z.lon, z.nazov, z.odchody, z.linky.join(', ')]),
}) : '';
const cyklo = nacitaj('cyklo-bratislava.json');
const bajk = nacitaj('bajk-bratislava.json');
const km1 = (n: number) => n.toLocaleString('sk-SK', { minimumFractionDigits: 1, maximumFractionDigits: 1 }) + ' km';
const grafCest = cest ? JSON.stringify({ roky: cestRoky, data: cestRoky.map((r) => cest[r]) }) : '';
const scitace = nacitaj('scitace-bratislava.json');
const csd = nacitaj('csd-bratislava.json');
const csdCesty = (csd?.cesty ?? []).filter((c: any) => c['2015'] && /^(D|R|I\/|II\/)/.test(c.cesta)).slice(0, 14);
const csdTis = (v: any) => (v?.priemer ? v.priemer.toLocaleString('sk-SK') : '–');
const KAT: Record<string, [string, string]> = { auta: ['Autá', 'áut'], cyklisti: ['Cyklisti', 'cyklistov'], chodci: ['Chodci', 'chodcov'] };
const obdobie = scitace ? `${new Date(scitace.obdobie.od).toLocaleDateString('sk-SK')} – ${new Date(scitace.obdobie.do).toLocaleDateString('sk-SK')}` : '';
---
<Base title="Doprava v Bratislave – mestovcislach.sk" description="Doprava v Bratislave: aktuálne uzávierky a poruchy na cestách, kedy je najviac premávky podľa sčítačov, MHD a cyklotrasy.">
  <section class="hero">
    <p class="kicker">Bratislava</p>
    <h1>Doprava</h1>
    <p class="lead">Aktuálne uzávierky a poruchy na cestách, kedy je najviac premávky, MHD podľa cestovných poriadkov a cyklotrasy.</p>
    <nav class="kotvy" aria-label="Na tejto stránke">
      <a href="#naozivo">Uzávierky dnes</a><a href="#premavka">Kedy je premávka</a><a href="#doprava">MHD</a><a href="#cyklo">Cyklotrasy</a>
    </nav>
  </section>

  <div id="naozivo">
    <h2 class="sekcia">Uzávierky a poruchy dnes</h2>
    <section class="kpis">
      <div class="card kpi"><p class="label"><i class="bod" style="width:10px;height:10px;border-radius:50%;vertical-align:0;background:var(--uz-0)"></i>Úplné uzávierky</p><p class="value" data-pocet="uplne">…</p><p class="delta">cesta je zavretá</p></div>
      <div class="card kpi"><p class="label"><i class="bod" style="width:10px;height:10px;border-radius:50%;vertical-align:0;background:var(--uz-1)"></i>Čiastočné uzávierky a rozkopávky</p><p class="value" data-pocet="ciastocne">…</p><p class="delta" data-pocet="planovane"></p></div>
      <div class="card kpi"><p class="label"><i class="bod" style="width:10px;height:10px;border-radius:50%;vertical-align:0;background:var(--uz-2)"></i>Poruchy vedení</p><p class="value" data-pocet="poruchy">…</p><p class="delta">voda, kanalizácia, elektrina, plyn…</p></div>
    </section>
    <section class="card">
      <div class="hlavicka">
        <h3>Mapa</h3>
        <label class="vyber">Mestská časť <select id="uz-cast"><option value="">všetky</option></select></label>
      </div>
      <div id="mapa-uzavierky" role="region" aria-label="Mapa aktuálnych uzávierok a porúch na cestách"></div>
      <ul class="uz-zoznam" id="uz-zoznam"><li class="nacitava">Načítavam aktuálne údaje mesta…</li></ul>
      <p class="zdroj">
        Údaje sa načítajú priamo z evidencie <a href="https://bratislava.sk">hlavného mesta</a> pri otvorení stránky
        (<a href="https://services8.arcgis.com/pRlN1m0su5BYaFAS/arcgis/rest/services/Rozkopavky_CSO_view/FeatureServer/0">uzávierky a rozkopávky</a>,
        <a href="https://services8.arcgis.com/pRlN1m0su5BYaFAS/arcgis/rest/services/survey123_603d6cb3f848490c818062302c2c43a8_results/FeatureServer/0">poruchy</a>).
        Zobrazujeme tie, ktoré už začali (alebo začnú do 2 týždňov) a ešte neskončili. Pri poruchách je uvedený plánovaný dátum sprejazdnenia.
        Mesto eviduje miestne cesty – diaľnice a cesty I. triedy spravuje NDS a SSC.
      </p>
    </section>
  </div>

  {scitace && (
    <div id="premavka" data-scitace={JSON.stringify(scitace.kategorie)}>
      <h2 class="sekcia">Kedy je najviac premávky</h2>
      <p class="uvod">
        Mesto má na uliciach sčítače, ktoré každú hodinu počítajú prejazdy. Autá merajú len na nábreží a Dunajskej ulici v centre,
        väčšina sčítačov je na cyklotrasách a mostoch. Priemery sú za posledných {scitace.obdobie.tyzdne} týždňov ({obdobie}).
      </p>
      <section class="card">
        <div class="hlavicka">
          <div class="taby" role="tablist">
            {Object.keys(scitace.kategorie).map((k, i) => (
              <button role="tab" type="button" data-kat={k} aria-selected={i === 0 ? 'true' : 'false'}>{KAT[k]?.[0] ?? k}</button>
            ))}
          </div>
          <label class="vyber">Sčítač <select id="scitac"></select></label>
        </div>
        <div class="kpis male">
          <div><p class="label">Za pracovný deň</p><p class="value" data-s="den"></p><p class="delta" data-s="den-pozn"></p></div>
          <div><p class="label">Ranná špička</p><p class="value" data-s="rano"></p><p class="delta" data-s="rano-pozn"></p></div>
          <div><p class="label">Popoludňajšia špička</p><p class="value" data-s="vecer"></p><p class="delta" data-s="vecer-pozn"></p></div>
        </div>
        <div class="chart"><canvas id="g-scitac" role="img" aria-label="Priemerný počet prejazdov podľa hodiny dňa"></canvas></div>
        <div class="trend" hidden>
          <h3>Dlhodobý vývoj – priemer za deň podľa mesiacov</h3>
          <div class="chart nizky"><canvas id="g-trend" role="img" aria-label="Priemerný denný počet prejazdov podľa mesiacov"></canvas></div>
        </div>
        <div class="tabulka-obal">
          <table class="klik">
            <thead><tr><th>Sčítač</th><th class="num">Za pracovný deň</th><th class="num">Ranná špička</th><th class="num">Popoludní</th></tr></thead>
            <tbody id="scitace-tab"></tbody>
          </table>
        </div>
        <p class="zdroj">
          Zdroj: {Object.entries(scitace.kategorie).map(([k, v]: [string, any], i) => <>{i > 0 && ', '}<a href={v.zdroj.url}>{v.zdroj.nazov}</a></>)};
          data.bratislava.sk, licencia CC BY 4.0. Dni s výpadkom sčítača sú vynechané. Mesto môže údaje spätne opraviť (až 2 mesiace).
        </p>
      </section>
      {csdCesty.length > 0 && (
        <section class="card" id="csd">
          <h3>Diaľnice a hlavné cesty – celoštátne sčítanie dopravy</h3>
          <p class="pozn-csd">
            Priemerný počet vozidiel za 24 hodín na sčítacích úsekoch v Bratislave.
            {csd.narast_2005_2015?.percent != null && <> Na úsekoch sčítaných v rokoch 2005 aj 2015 premávka {csd.narast_2005_2015.percent >= 0 ? 'vzrástla' : 'klesla'} o <b>{Math.abs(csd.narast_2005_2015.percent).toLocaleString('sk-SK')} %</b>.</>}
          </p>
          <div class="tabulka-obal">
            <table>
              <thead><tr><th>Cesta</th><th class="num">2005</th><th class="num">2010</th><th class="num">2015</th><th class="num">Najvyťaženejší úsek 2015</th><th class="num">Nákladné 2015</th></tr></thead>
              <tbody>{csdCesty.map((c: any) => <tr><td>{c.cesta}</td><td class="num">{csdTis(c['2005'])}</td><td class="num">{csdTis(c['2010'])}</td><td class="num">{csdTis(c['2015'])}</td><td class="num">{c['2015'].max.toLocaleString('sk-SK')}</td><td class="num">{c['2015'].nakladne_podiel != null ? c['2015'].nakladne_podiel.toLocaleString('sk-SK') + ' %' : '–'}</td></tr>)}</tbody>
            </table>
          </div>
          <p class="zdroj">{csd.popis} Zdroj: <a href={csd.zdroj.url}>{csd.zdroj.nazov}</a> (data.slovensko.sk).</p>
        </section>
      )}
    </div>
  )}

  {!mhd ? <div class="card"><p>Dáta sa pripravujú.</p></div> : (
    <div id="doprava" data-mapa={mapa} data-cest={grafCest}>
      <h2 class="sekcia">MHD</h2>
      <section class="kpis">
        <div class="card kpi">
          <p class="label">Zastávky MHD</p>
          <p class="value">{fmt(mhd.mesto.zastavky)}</p>
          <p class="delta">v Bratislave, nástupištia zlúčené</p>
        </div>
        <div class="card kpi">
          <p class="label">Odchody za pracovný deň</p>
          <p class="value">{fmt(mhd.mesto.odchody)}</p>
          <p class="delta">zo všetkých zastávok spolu</p>
        </div>
        <div class="card kpi">
          <p class="label">Linky</p>
          <p class="value">{linkySpolu}</p>
          <p class="delta">{Object.entries(mhd.mesto.linky).map(([d, n]) => `${d.toLowerCase()} ${n}`).join(' · ')}</p>
        </div>
        {cest && (
          <div class="card kpi">
            <p class="label">Cestujúci za rok {cestPosl}</p>
            <p class="value">{(cest[cestPosl] / 1e6).toLocaleString('sk-SK', { maximumFractionDigits: 1 })} mil.</p>
            <p class={cest[cestPosl] >= cest[cestPred] ? 'delta up' : 'delta down'}>
              {cest[cestPosl] >= cest[cestPred] ? '+' : '−'}{Math.abs(100 * (cest[cestPosl] / cest[cestPred] - 1)).toLocaleString('sk-SK', { maximumFractionDigits: 1 })} % oproti {cestPred}
            </p>
          </div>
        )}
      </section>

      {mapa && (
        <section class="card">
          <h2>Mapa zastávok MHD</h2>
          <div id="mapa-mhd" role="region" aria-label="Mapa zastávok MHD podľa počtu odchodov"></div>
          <p class="zdroj">Veľkosť bodu = počet odchodov za deň. Ťuknite na zastávku pre linky. Podklad © prispievatelia OpenStreetMap.</p>
        </section>
      )}

      <section class="card">
        <h2>Mestské časti</h2>
        <div class="tabulka-obal">
          <table>
            <thead><tr><th>Mestská časť</th><th class="num">Zastávky</th><th class="num">Linky</th><th class="num">Odchody za deň</th><th class="num">na 1 000 obyv.</th></tr></thead>
            <tbody>
              {casti.map((c: any) => (
                <tr><td>{c.nazov}</td><td class="num">{c.zastavky}</td><td class="num">{c.linky}</td><td class="num">{fmt(c.odchody)}</td><td class="num">{c.odchody_na_1000 != null ? fmt(Math.round(c.odchody_na_1000)) : '–'}</td></tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="zdroj">Zastávka patrí do mestskej časti podľa polohy. Prestupné uzly v centre majú veľa odchodov aj vďaka ľuďom z iných častí mesta.</p>
      </section>

      <section class="card">
        <h2>Najvyťaženejšie zastávky</h2>
        <ol class="zastavky">
          {mhd.zastavky.slice(0, 10).map((z: any) => (
            <li><span class="meno">{z.nazov}</span><span class="pocet">{fmt(z.odchody)} odchodov</span><span class="linky">linky {z.linky.join(', ')}</span></li>
          ))}
        </ol>
      </section>

      {cest && (
        <section class="card">
          <h2>Prepravení cestujúci podľa rokov</h2>
          <div class="chart"><canvas id="g-cest" role="img" aria-label="Počet prepravených cestujúcich MHD podľa rokov"></canvas></div>
          <p class="zdroj">Zdroj: <a href={stat.cestujuci.zdroj.url}>{stat.cestujuci.zdroj.nazov}</a>, data.bratislava.sk, licencia {stat.cestujuci.zdroj.licencia ?? 'CC BY 4.0'}.</p>
        </section>
      )}

      <p class="zdroj">
        Cestovné poriadky: <a href={mhd.zdroj.url}>{mhd.zdroj.nazov}</a> (Dopravný podnik Bratislava, data.bratislava.sk, licencia {mhd.zdroj.licencia}),
        platné {plat(mhd.platnost.od)} – {plat(mhd.platnost.do)}. Počty sú za {datum(mhd.den)} ako typický pracovný deň.
      </p>
    </div>
  )}

  {cyklo && (
    <div id="cyklo">
      <h2 class="sekcia">Cyklistická infraštruktúra</h2>
      <section class="kpis">
        <div class="card kpi">
          <p class="label">Spolu v Bratislave</p>
          <p class="value">{fmt(Math.round(cyklo.mesto.km_spolu))} km</p>
          <p class="delta">cyklocestičky, spoločné chodníky a cyklopruhy</p>
        </div>
        {bajk && (
          <div class="card kpi">
            <p class="label"><i class="bod" style="background:var(--text);height:8px;width:8px;border-radius:50%"></i>Stanice Slovnaft BAjk</p>
            <p class="value">{bajk.stanice.length}</p>
            <p class="delta">zdieľané bicykle</p>
          </div>
        )}
        {Object.entries(cyklo.kategorie).map(([k, nazov], i) => (
          <div class="card kpi">
            <p class="label"><i class="bod" style={`background:var(--cyklo-${i})`}></i>{nazov as string}</p>
            <p class="value">{fmt(Math.round(cyklo.mesto.km[k]))} km</p>
          </div>
        ))}
      </section>

      <section class="card">
        <h3>Mapa cyklotrás</h3>
        <div id="mapa-cyklo" role="region" aria-label="Mapa cyklistickej infraštruktúry v Bratislave" data-bajk={bajk ? JSON.stringify(bajk.stanice.map((s: any) => [s.lat, s.lon, s.nazov])) : ''}></div>
        <div class="legenda-cyklo">
          {Object.values(cyklo.kategorie).map((nazov, i) => <span><i style={`background:var(--cyklo-${i})`}></i>{nazov as string}</span>)}
          {bajk && <span><i class="kruh"></i>Stanica BAjk</span>}
        </div>
      </section>

      <section class="card">
        <h3>Mestské časti</h3>
        <div class="tabulka-obal">
          <table>
            <thead><tr><th>Mestská časť</th><th class="num">Spolu</th><th class="num">Cyklocestičky</th><th class="num">Cyklopruhy</th><th class="num">km na km²</th></tr></thead>
            <tbody>
              {cyklo.mestske_casti.map((c: any) => (
                <tr><td>{c.nazov}</td><td class="num">{km1(c.km_spolu)}</td><td class="num">{km1(c.km.cyklocesticka)}</td><td class="num">{km1(c.km.cyklopruh)}</td><td class="num">{c.km_na_km2?.toLocaleString('sk-SK', { maximumFractionDigits: 2 })}</td></tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="zdroj">
          {bajk && <>Stanice BAjk: <a href={bajk.zdroj.url}>{bajk.zdroj.nazov}</a>, data.bratislava.sk, CC BY 4.0. </>}Cyklotrasy: © <a href={cyklo.zdroj.url}>prispievatelia OpenStreetMap</a> (ODbL), stav {new Date(cyklo.zdroj.stav_osm).toLocaleDateString('sk-SK')}.
          Nejde o oficiálnu evidenciu mesta – údaje závisia od toho, čo dobrovoľníci zmapovali. Obojsmerné trasy zakreslené dvakrát (po oboch stranách cesty) sa rátajú dvakrát.
        </p>
      </section>
    </div>
  )}
</Base>

<script>
  import Chart from 'chart.js/auto';
  import L from 'leaflet';
  import { osmPodklad } from '../scripts/podklad';
  import { uzavierky, poruchy, popup, den, type Obmedzenie } from '../scripts/uzavierky';
  import 'leaflet/dist/leaflet.css';

  const el = document.getElementById('doprava');
  const css = getComputedStyle(document.documentElement);
  const accent = css.getPropertyValue('--accent').trim();
  const muted = css.getPropertyValue('--muted').trim();
  const line = css.getPropertyValue('--line').trim();
  const tmava = document.documentElement.dataset.tema === 'tmava';
  const fmt = (n: number) => n.toLocaleString('sk-SK');

  if (el?.dataset.mapa) {
    const d = JSON.parse(el.dataset.mapa);
    const mapa = L.map('mapa-mhd', { scrollWheelZoom: false, zoomSnap: 0.25, preferCanvas: true });
    osmPodklad().addTo(mapa);
    const hranice = L.geoJSON(d.hranice, { style: { weight: 1, color: muted, fill: false, opacity: 0.6 }, interactive: false }).addTo(mapa);
    mapa.fitBounds(hranice.getBounds(), { padding: [8, 8] });
    const max = Math.max(...d.zastavky.map((z: any[]) => z[3]));
    // od najmenších, aby veľké uzly boli navrchu
    [...d.zastavky].reverse().forEach(([lat, lon, nazov, odchody, linky]: [number, number, string, number, string]) => {
      L.circleMarker([lat, lon], {
        radius: (window.innerWidth < 600 ? 1.5 : 2.5) + (window.innerWidth < 600 ? 6.5 : 11) * Math.sqrt(odchody / max),
        color: tmava ? '#121417' : '#ffffff', weight: 0.8,
        fillColor: accent, fillOpacity: 0.75,
      }).bindPopup(`<strong>${nazov}</strong><br>${fmt(odchody)} odchodov za deň<br><span style="color:${muted}">linky ${linky}</span>`)
        .bindTooltip(nazov, { direction: 'top' })
        .addTo(mapa);
    });
  }

  // Cyklotrasy: GeoJSON sa načíta až keď je mapa blízko obrazovky.
  const cykloEl = document.getElementById('mapa-cyklo');
  if (cykloEl) {
    const farby = [0, 1, 2].map((i) => css.getPropertyValue(`--cyklo-${i}`).trim());
    const poradie = ['cyklocesticka', 'spolocna', 'cyklopruh'];
    const vykresli = async () => {
      const mapa = L.map(cykloEl, { scrollWheelZoom: false, zoomSnap: 0.25 });
      osmPodklad().addTo(mapa);
      mapa.setView([48.15, 17.11], 11.5);
      const geo = await (await fetch('/data/cyklotrasy-bratislava.geojson')).json();
      const vrstva = L.geoJSON(geo, {
        style: (f: any) => ({ color: farby[poradie.indexOf(f.properties.k)] || muted, weight: 2.5, opacity: 0.9 }),
        interactive: false,
      }).addTo(mapa);
      mapa.fitBounds(vrstva.getBounds(), { padding: [8, 8] });
      if (cykloEl.dataset.bajk) {
        const text = css.getPropertyValue('--text').trim();
        for (const [lat, lon, nazov] of JSON.parse(cykloEl.dataset.bajk) as [number, number, string][]) {
          L.circleMarker([lat, lon], { radius: 4, weight: 1.5, color: text, fillColor: tmava ? '#121417' : '#fff', fillOpacity: 1 })
            .bindPopup(`<strong>${nazov}</strong><br>Stanica Slovnaft BAjk`).addTo(mapa);
        }
      }
    };
    new IntersectionObserver((e, o) => {
      if (e[0].isIntersecting) { o.disconnect(); vykresli(); }
    }, { rootMargin: '300px' }).observe(cykloEl);
  }

  Chart.defaults.color = muted;
  Chart.defaults.borderColor = line;
  Chart.defaults.font.family = css.getPropertyValue('--font');
  const esc = (t: string) => t.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);

  // ---------- Uzávierky a poruchy (živé dáta mesta) ----------
  const uzEl = document.getElementById('mapa-uzavierky');
  if (uzEl) {
    const farbaUz = [0, 1, 2].map((i) => css.getPropertyValue(`--uz-${i}`).trim());
    const trieda = (o: Obmedzenie) => (o.typ === 'porucha' ? 2 : o.uzavierka === 'úplná' ? 0 : 1);
    const mapa = L.map(uzEl, { scrollWheelZoom: false, zoomSnap: 0.25 });
    osmPodklad().addTo(mapa);
    mapa.setView([48.15, 17.11], window.innerWidth < 600 ? 10.75 : 11.5);
    const vrstva = L.featureGroup().addTo(mapa);
    const zoznam = document.getElementById('uz-zoznam')!;
    const vyber = document.getElementById('uz-cast') as HTMLSelectElement;
    const nastav = (k: string, t: string) => { const e = document.querySelector(`[data-pocet="${k}"]`); if (e) e.textContent = t; };
    Promise.allSettled([uzavierky(), poruchy()]).then(([u, p]) => {
      const vsetky: Obmedzenie[] = [
        ...(u.status === 'fulfilled' ? u.value : []),
        ...(p.status === 'fulfilled' ? p.value : []),
      ].sort((a, b) => trieda(a) - trieda(b) || (a.do ?? 0) - (b.do ?? 0));
      if (u.status === 'rejected' && p.status === 'rejected') {
        zoznam.innerHTML = '<li class="nacitava">Údaje mesta sa teraz nepodarilo načítať. Skúste to neskôr.</li>';
        ['uplne', 'ciastocne', 'poruchy'].forEach((k) => nastav(k, '–'));
        return;
      }
      const aktivne = vsetky.filter((o) => !o.planovana);
      nastav('uplne', u.status === 'fulfilled' ? String(aktivne.filter((o) => trieda(o) === 0).length) : '–');
      nastav('ciastocne', u.status === 'fulfilled' ? String(aktivne.filter((o) => trieda(o) === 1).length) : '–');
      nastav('poruchy', p.status === 'fulfilled' ? String(aktivne.filter((o) => trieda(o) === 2).length) : '–');
      const plan = vsetky.filter((o) => o.planovana).length;
      if (plan) nastav('planovane', `+ ${plan} plánované do 2 týždňov`);
      const casti = [...new Set(vsetky.map((o) => o.cast).filter(Boolean))].sort((a, b) => a.localeCompare(b, 'sk'));
      vyber.insertAdjacentHTML('beforeend', casti.map((c) => `<option>${esc(c)}</option>`).join(''));
      const vykresli = () => {
        const c = vyber.value;
        const vyb = vsetky.filter((o) => !c || o.cast === c);
        vrstva.clearLayers();
        const body = new Map<Obmedzenie, L.CircleMarker>();
        for (const o of [...vyb].reverse()) {
          const t = trieda(o);
          body.set(o, L.circleMarker([o.lat, o.lon], {
            radius: t === 0 ? 8 : 6, weight: 1.5, color: tmava ? '#121417' : '#ffffff',
            fillColor: farbaUz[t], fillOpacity: o.planovana ? 0.45 : 0.95, dashArray: o.planovana ? '2 2' : undefined,
          }).bindPopup(popup(o)).addTo(vrstva));
        }
        if (vyb.length) mapa.fitBounds(vrstva.getBounds(), { padding: [20, 20], maxZoom: 15 });
        zoznam.innerHTML = vyb.length ? '' : '<li class="nacitava">Žiadne uzávierky ani poruchy.</li>';
        for (const o of vyb) {
          const li = document.createElement('li');
          const t = trieda(o);
          const kedy = o.typ === 'porucha' ? `sprejazdnenie do ${den(o.do)}` : o.planovana ? `od ${den(o.od)}` : `do ${den(o.do)}`;
          li.innerHTML = `<i style="background:${farbaUz[t]}"></i><span class="nadpis">${esc(o.nadpis)}</span>`
            + `<span class="kedy">${o.planovana ? 'plánovaná ' : ''}${kedy}</span>`
            + `<span class="kde">${esc([o.cast, o.typ === 'porucha' ? o.druh.toLowerCase() : o.vplyv?.length ? 'obmedzuje ' + o.vplyv.join(', ') : ''].filter(Boolean).join(' · '))}</span>`;
          li.tabIndex = 0;
          const ukaz = () => { mapa.setView([o.lat, o.lon], 16); body.get(o)?.openPopup(); uzEl.scrollIntoView({ behavior: 'smooth', block: 'center' }); };
          li.addEventListener('click', ukaz);
          li.addEventListener('keydown', (e) => { if (e.key === 'Enter') ukaz(); });
          zoznam.append(li);
        }
      };
      vyber.addEventListener('change', vykresli);
      vykresli();
    });
  }

  // ---------- Sčítače: kedy je najviac premávky ----------
  const prem = document.getElementById('premavka');
  if (prem?.dataset.scitace) {
    const data = JSON.parse(prem.dataset.scitace);
    const JEDNOTKA: Record<string, string> = { auta: 'áut', cyklisti: 'cyklistov', chodci: 'chodcov' };
    const modra = css.getPropertyValue('--cyklo-0').trim();
    const text = css.getPropertyValue('--text').trim();
    const hodiny = Array.from({ length: 24 }, (_, h) => `${h}:00`);
    const sel = document.getElementById('scitac') as HTMLSelectElement;
    const tab = document.getElementById('scitace-tab')!;
    const trendObal = prem.querySelector<HTMLElement>('.trend')!;
    let kat = Object.keys(data)[0];
    const nastav = (k: string, t: string) => { prem.querySelector(`[data-s="${k}"]`)!.textContent = t; };
    const hod = (h: number) => `${h}:00 – ${h + 1}:00`;

    const graf = new Chart(document.getElementById('g-scitac') as HTMLCanvasElement, {
      type: 'line', data: { labels: hodiny, datasets: [] },
      options: {
        maintainAspectRatio: false, interaction: { mode: 'index', intersect: false },
        plugins: { legend: { labels: { boxWidth: 14, boxHeight: 2 } }, tooltip: { callbacks: { label: (c) => ` ${c.dataset.label}: ${c.parsed.y == null ? '–' : fmt(c.parsed.y)}` } } },
        scales: { x: { grid: { display: false }, ticks: { maxRotation: 0, autoSkipPadding: 8 } }, y: { beginAtZero: true, ticks: { callback: (v) => fmt(Number(v)) } } },
      },
    });
    const trend = new Chart(document.getElementById('g-trend') as HTMLCanvasElement, {
      type: 'bar', data: { labels: [], datasets: [{ data: [], backgroundColor: accent, borderRadius: 2 }] },
      options: {
        maintainAspectRatio: false,
        plugins: { legend: { display: false }, tooltip: { callbacks: { label: (c) => ` ${fmt(c.parsed.y)} ${JEDNOTKA[kat]} za deň` } } },
        scales: { x: { grid: { display: false }, ticks: { maxRotation: 0, autoSkipPadding: 12 } }, y: { beginAtZero: true, ticks: { callback: (v) => fmt(Number(v)) } } },
      },
    });

    const ukaz = (i: number) => {
      const s = data[kat].scitace[i];
      const j = JEDNOTKA[kat];
      sel.value = String(i);
      tab.querySelectorAll('tr').forEach((tr, k) => tr.classList.toggle('vybrany', k === i));
      nastav('den', fmt(s.pracovny_den_spolu));
      nastav('den-pozn', `${j} v ${s.smery.length > 1 ? 'oboch smeroch' : 'smere ' + s['smer_' + s.smery[0]]}`);
      for (const [k, sp] of [['rano', s.spicka_rano], ['vecer', s.spicka_vecer]] as const) {
        nastav(k, sp?.hodina != null ? hod(sp.hodina) : '–');
        nastav(`${k}-pozn`, sp?.hodina != null ? `${fmt(sp.pocet)} ${j} za hodinu${sp.smer ? ', smer ' + sp.smer : ''}` : '');
      }
      const sady: any[] = s.smery.map((sm: string, k: number) => ({
        label: `Pracovný deň – smer ${s['smer_' + sm] || sm}`, data: s['pracovny_' + sm],
        borderColor: k ? modra : accent, backgroundColor: k ? modra : accent, borderWidth: 2.5, pointRadius: 0, tension: 0.3,
      }));
      const vikend = hodiny.map((_, h) => s.smery.reduce((a: number | null, sm: string) => (s['vikend_' + sm][h] == null ? a : (a ?? 0) + s['vikend_' + sm][h]), null));
      sady.push({ label: 'Víkend – oba smery spolu', data: vikend, borderColor: muted, borderDash: [5, 4], borderWidth: 1.5, pointRadius: 0, tension: 0.3 });
      if (s.posledny_den) {
        const pd = s.posledny_den;
        const sucet = hodiny.map((_, h) => s.smery.reduce((a: number | null, sm: string) => (pd[sm]?.[h] == null ? a : (a ?? 0) + pd[sm][h]), null));
        const d = new Date(pd.datum).toLocaleDateString('sk-SK', { weekday: 'long', day: 'numeric', month: 'numeric' });
        sady.push({ label: `${d} – spolu`, data: sucet, borderColor: text, borderDash: [1, 3], borderWidth: 1.5, pointRadius: 0, tension: 0.3, hidden: s.smery.length > 1 });
      }
      graf.data.datasets = sady;
      graf.update();
      const mes = Object.entries(s.mesacne ?? {}) as [string, number][];
      trendObal.hidden = mes.length < 3;
      if (mes.length >= 3) {
        trend.data.labels = mes.map(([m]) => `${Number(m.slice(5))}/${m.slice(2, 4)}`);
        trend.data.datasets[0].data = mes.map(([, v]) => v);
        trend.update();
      }
    };
    const kategoria = (k: string) => {
      kat = k;
      prem.querySelectorAll<HTMLButtonElement>('[role=tab]').forEach((b) => b.setAttribute('aria-selected', String(b.dataset.kat === k)));
      const zoz = data[k].scitace;
      sel.innerHTML = zoz.map((s: any, i: number) => `<option value="${i}">${esc(s.nazov)}</option>`).join('');
      const sp = (x: any) => (x?.hodina != null ? `${x.hodina}:00` : '–');
      tab.innerHTML = zoz.map((s: any) => `<tr tabindex="0"><td>${esc(s.nazov)}</td><td class="num">${fmt(s.pracovny_den_spolu)}</td><td class="num">${sp(s.spicka_rano)}</td><td class="num">${sp(s.spicka_vecer)}</td></tr>`).join('');
      tab.querySelectorAll('tr').forEach((tr, i) => {
        tr.addEventListener('click', () => ukaz(i));
        tr.addEventListener('keydown', (e) => { if (e.key === 'Enter') ukaz(i); });
      });
      ukaz(0);
    };
    prem.querySelectorAll<HTMLButtonElement>('[role=tab]').forEach((b) => b.addEventListener('click', () => kategoria(b.dataset.kat!)));
    sel.addEventListener('change', () => ukaz(Number(sel.value)));
    kategoria(kat);
  }

  if (el?.dataset.cest) {
    const g = JSON.parse(el.dataset.cest);
    new Chart(document.getElementById('g-cest') as HTMLCanvasElement, {
      type: 'bar',
      data: { labels: g.roky, datasets: [{ data: g.data, backgroundColor: accent, borderRadius: 3 }] },
      options: {
        maintainAspectRatio: false,
        plugins: { legend: { display: false }, tooltip: { callbacks: { label: (c) => ` ${(c.parsed.y / 1e6).toLocaleString('sk-SK', { maximumFractionDigits: 1 })} mil. cestujúcich` } } },
        scales: { x: { grid: { display: false } }, y: { ticks: { callback: (v) => (Number(v) / 1e6).toLocaleString('sk-SK') + ' mil.' } } },
      },
    });
  }
</script>

<style>
  .hero { padding: 40px 0 24px; }
  .kicker { color: var(--accent); font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; font-size: 0.75rem; margin: 0; }
  h1 { font-size: clamp(2rem, 6vw, 3rem); line-height: 1.1; letter-spacing: -0.03em; margin: 8px 0 12px; }
  .lead { color: var(--muted); font-size: 1.1rem; max-width: 42em; margin: 0; }
  h2 { font-size: 1.1rem; margin: 0 0 16px; }
  section.card { margin-top: 16px; }
  .kpis { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 16px; }
  .kpi .label { color: var(--muted); font-size: 0.85rem; margin: 0; }
  .kpi .value { font-size: 2.1rem; font-weight: 800; letter-spacing: -0.03em; margin: 4px 0; font-variant-numeric: tabular-nums; }
  .delta { margin: 0; font-size: 0.85rem; color: var(--muted); }
  .delta.up { color: #1a7f4b; }
  .delta.down { color: var(--accent); }
  :global(:root[data-tema="tmava"]) .delta.up { color: #4cc38a; }
  #mapa-mhd { height: 460px; border-radius: 10px; overflow: hidden; background: var(--bg); }
  @media (max-width: 600px) { #mapa-mhd { height: 380px; } }
  .chart { position: relative; height: 280px; }
  .tabulka-obal { overflow-x: auto; }
  table { width: 100%; border-collapse: collapse; font-size: 0.92rem; }
  th, td { text-align: left; padding: 8px 6px; border-bottom: 1px solid var(--line); }
  th { color: var(--muted); font-weight: 600; font-size: 0.8rem; }
  .num { text-align: right; font-variant-numeric: tabular-nums; white-space: nowrap; }
  :global(:root) { --cyklo-0: #1f6fd1; --cyklo-1: #138a5e; --cyklo-2: #d97706; }
  :global(:root[data-tema="tmava"]) { --cyklo-0: #7cc4ff; --cyklo-1: #6ee7b7; --cyklo-2: #ffc44d; }
  h2.sekcia { font-size: 1.5rem; letter-spacing: -0.02em; margin: 48px 0 16px; }
  h3 { font-size: 1.05rem; margin: 0 0 14px; }
  #mapa-cyklo { height: 460px; border-radius: 10px; overflow: hidden; background: var(--bg); }
  @media (max-width: 600px) { #mapa-cyklo { height: 380px; } }
  .legenda-cyklo { display: flex; flex-wrap: wrap; gap: 6px 16px; margin-top: 12px; font-size: 0.82rem; color: var(--muted); }
  .legenda-cyklo .kruh { width: 9px; height: 9px; border-radius: 50%; border: 1.5px solid var(--text); background: var(--card); vertical-align: -1px; }
  .legenda-cyklo i, .bod { display: inline-block; width: 14px; height: 4px; border-radius: 2px; margin-right: 6px; vertical-align: 3px; }
  :global(:root) { --uz-0: #c8102e; --uz-1: #d97706; --uz-2: #7a4fd1; }
  :global(:root[data-tema="tmava"]) { --uz-0: #ff6b80; --uz-1: #ffc44d; --uz-2: #c4a7ff; }
  .kotvy { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 16px; }
  .kotvy a { font-size: 0.85rem; padding: 5px 12px; border: 1px solid var(--line); border-radius: 999px; text-decoration: none; background: var(--card); }
  .kotvy a:hover { border-color: var(--accent); }
  #naozivo h2.sekcia { margin-top: 24px; }
  .uvod { color: var(--muted); max-width: 46em; margin: -4px 0 16px; }
  .hlavicka { display: flex; justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap; margin-bottom: 12px; }
  .hlavicka h3 { margin: 0; }
  .vyber { font-size: 0.85rem; color: var(--muted); display: inline-flex; gap: 8px; align-items: center; }
  select { font: inherit; color: var(--text); background: var(--card); border: 1px solid var(--line); border-radius: 8px; padding: 5px 8px; max-width: 60vw; }
  #mapa-uzavierky { height: 440px; border-radius: 10px; overflow: hidden; background: var(--bg); }
  @media (max-width: 600px) { #mapa-uzavierky { height: 360px; } }
  .uz-zoznam { list-style: none; margin: 12px 0 0; padding: 0; max-height: 360px; overflow-y: auto; border-top: 1px solid var(--line); }
  .uz-zoznam :global(li) { display: grid; grid-template-columns: 14px 1fr auto; gap: 2px 10px; padding: 9px 4px; border-bottom: 1px solid var(--line); cursor: pointer; font-size: 0.9rem; }
  .uz-zoznam :global(li:hover), .uz-zoznam :global(li:focus) { background: var(--accent-soft); outline: none; }
  .uz-zoznam :global(li.nacitava) { display: block; color: var(--muted); cursor: default; }
  .uz-zoznam :global(i) { width: 10px; height: 10px; border-radius: 50%; margin-top: 6px; }
  .uz-zoznam :global(.nadpis) { font-weight: 600; }
  .uz-zoznam :global(.kedy) { color: var(--muted); font-size: 0.82rem; white-space: nowrap; text-align: right; }
  .uz-zoznam :global(.kde) { grid-column: 2 / 4; color: var(--muted); font-size: 0.82rem; }
  @media (max-width: 600px) { .uz-zoznam :global(li) { grid-template-columns: 14px 1fr; } .uz-zoznam :global(.kedy) { grid-column: 2; text-align: left; } .uz-zoznam :global(.kde) { grid-column: 2; } }
  .taby { display: inline-flex; border: 1px solid var(--line); border-radius: 10px; padding: 3px; gap: 2px; }
  .taby button { font: inherit; font-size: 0.88rem; border: 0; background: none; color: var(--muted); padding: 5px 14px; border-radius: 7px; cursor: pointer; }
  .taby button[aria-selected='true'] { background: var(--accent); color: var(--na-akcente); }
  .kpis.male { grid-template-columns: repeat(auto-fit, minmax(170px, 1fr)); gap: 12px; margin: 4px 0 16px; }
  .kpis.male .value { font-size: 1.45rem; font-weight: 800; margin: 2px 0; letter-spacing: -0.02em; font-variant-numeric: tabular-nums; }
  .kpis.male .label { color: var(--muted); font-size: 0.8rem; margin: 0; }
  .chart.nizky { height: 200px; }
  .trend { margin-top: 20px; }
  .trend h3 { font-size: 0.95rem; }
  table.klik { margin-top: 20px; }
  table.klik tbody :global(tr) { cursor: pointer; }
  table.klik tbody :global(tr:hover), table.klik tbody :global(tr.vybrany) { background: var(--accent-soft); }
  table.klik tbody :global(td) { padding: 8px 6px; border-bottom: 1px solid var(--line); }
  table.klik tbody :global(td.num) { text-align: right; font-variant-numeric: tabular-nums; white-space: nowrap; }
  .zastavky { margin: 0; padding-left: 1.4em; }
  .zastavky li { padding: 8px 0; border-bottom: 1px solid var(--line); }
  .zastavky .meno { font-weight: 600; }
  .zastavky .pocet { float: right; font-variant-numeric: tabular-nums; }
  .zastavky .linky { display: block; color: var(--muted); font-size: 0.82rem; }
  .pozn-csd { color: var(--muted); font-size: 0.9rem; margin: 6px 0 12px; }
</style>
