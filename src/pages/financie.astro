---
import fs from 'node:fs';
import path from 'node:path';
import Base from '../layouts/Base.astro';

const nacitaj = (subor: string) => {
  const p = path.join(process.cwd(), 'data', subor);
  return fs.existsSync(p) ? JSON.parse(fs.readFileSync(p, 'utf-8')) : null;
};
const rozpocet = nacitaj('rozpocet-bratislava.json');
const zmluvy = nacitaj('zmluvy-bratislava.json');

const mil = (n: number) => (n / 1e6).toLocaleString('sk-SK', { maximumFractionDigits: n >= 1e8 ? 0 : 1 }) + ' mil. €';
const eur = (n: number) => n.toLocaleString('sk-SK', { maximumFractionDigits: 0 }) + ' €';
const fmt = (n: number) => n.toLocaleString('sk-SK');
const datum = (d: string) => new Date(d).toLocaleDateString('sk-SK');

let r: any = null;
if (rozpocet) {
  const c = rozpocet.casti;
  const roky = Object.keys(c.vydavky.roky).sort();
  const rok = roky[roky.length - 1];
  const predch = roky[roky.length - 2];
  const prijmy = c.prijmy.roky[rok]['Spolu'];
  const vydavky = c.vydavky.roky[rok]['Spolu'];
  const programy = Object.entries(c.programy.roky[rok] as Record<string, number>).sort((a, b) => b[1] - a[1]);
  r = {
    rok, predch, roky, prijmy, vydavky,
    kapitalove: c.vydavky.roky[rok]['Kapitálové výdavky'],
    kapitalovePredch: c.vydavky.roky[predch]['Kapitálové výdavky'],
    hosp: c.hospodarenie.roky[rok]['Bez finančných operácií'],
    zdroje: Object.values(c).map((x: any) => x.zdroj),
    graf: JSON.stringify({
      roky,
      prijmy: roky.map((y) => c.prijmy.roky[y]['Spolu']),
      vydavky: roky.map((y) => c.vydavky.roky[y]['Spolu']),
      druhy: c.prijmy_druh.polozky.map((p: string) => ({ nazov: p, data: roky.map((y) => c.prijmy_druh.roky[y][p]) })),
      programy: { stitky: programy.map((p) => p[0]), data: programy.map((p) => p[1]) },
      zmluvy: zmluvy ? { roky: Object.keys(zmluvy.po_rokoch), suma: Object.values(zmluvy.po_rokoch).map((v: any) => v.suma), pocet: Object.values(zmluvy.po_rokoch).map((v: any) => v.pocet) } : null,
    }),
  };
}
const z = zmluvy?.posledny_rok;

// Majetok: názvy a rozlohy mestských častí pre podiel pozemkov.
const majetok = nacitaj('majetok-bratislava.json');
const hranice = nacitaj('hranice-bratislava.geojson');
const obyv = nacitaj('obyvatelstvo-bratislava.json');
const nazvyMc = new Map<string, string>((obyv?.mestske_casti ?? []).map((c: any) => [c.kod.slice(-6), c.nazov_kratky]));
const rozlohy = new Map<string, number>((hranice?.features ?? []).map((f: any) => [f.properties.kod_obce, f.properties.rozloha_km2]));
const rozlohaSpolu = [...rozlohy.values()].reduce((a, b) => a + b, 0);
const podielRozlohy = majetok && rozlohaSpolu ? Math.round(majetok.spolu.vymera_ha / (rozlohaSpolu * 100) * 100) : null;
const majetokCasti = (majetok?.mestske_casti ?? []).map((c: any) => ({
  ...c,
  nazov: nazvyMc.get(c.kod_obce) ?? c.kod_obce,
  podiel: rozlohy.get(c.kod_obce) ? (100 * c.vymera_ha) / (rozlohy.get(c.kod_obce)! * 100) : null,
}));
// Dlh hlavného mesta a mestských častí (MF SR)
const ukaz = nacitaj('mc-ukazovatele.json');
const dlhRoky = ukaz?.dlh ? Object.keys(ukaz.dlh.roky).sort() : [];
const dlhRok = dlhRoky[dlhRoky.length - 1];
const dlhPosl = dlhRok ? ukaz.dlh.roky[dlhRok] : null;
const dlhMesto = dlhRoky.map((y) => ({ rok: y, ...ukaz.dlh.roky[y]['Hlavné mesto'] }));
const dlhMc = dlhPosl ? Object.entries<any>(dlhPosl).filter(([k]) => k !== 'Hlavné mesto').map(([mc, v]) => ({ mc, ...v })).sort((a, b) => b.pomer - a.pomer || b.dlh - a.dlh) : [];
const dlhMcSpolu = dlhMc.reduce((a: number, c: any) => a + c.dlh, 0);
// Faktúry, objednávky a zmluvy (magistrát a mestské organizácie)
const fakt = nacitaj('faktury-bratislava.json');
const fd = (org: string, typ: string) => fakt?.datasety.find((d: any) => d.organizacia === org && d.typ === typ);
const magF = fd('Magistrát', 'faktúry');
const magO = fd('Magistrát', 'objednávky');
const rokTeraz = new Date().getFullYear();
const poslednyCely = (d: any) => d ? Object.keys(d.roky).filter((r) => Number(r) < rokTeraz).sort().pop() : null;
const grafFakt = magF ? JSON.stringify({ roky: Object.keys(magF.roky).filter((r) => Number(r) < rokTeraz), sumy: Object.entries<any>(magF.roky).filter(([r]) => Number(r) < rokTeraz).map(([, v]) => v.suma) }) : '';
const pct = (n: number | null | undefined) => (n == null ? '–' : n.toLocaleString('sk-SK', { maximumFractionDigits: 1 }) + ' %');
const grafPoz = majetok ? JSON.stringify({ stitky: majetok.druhy.map((d: any) => d.nazov), data: majetok.druhy.map((d: any) => d.vymera_ha) }) : '';
---
<Base title="Financie Bratislavy – mestovcislach.sk" description="Rozpočet hlavného mesta Bratislavy, zmluvy, faktúry a objednávky magistrátu a mestských firiem, majetok a dlh mesta a mestských častí.">
  <section class="hero">
    <p class="kicker">Bratislava</p>
    <h1>Financie mesta</h1>
    <p class="lead">Koľko mesto získa, na čo míňa a s kým uzatvára zmluvy. Údaje hlavného mesta (magistrát), bez rozpočtov mestských častí.</p>
  </section>

  {!r ? <div class="card"><p>Dáta sa pripravujú.</p></div> : (
    <div id="financie" data-graf={r.graf} data-poz={grafPoz}>
      <section class="kpis">
        <div class="card kpi">
          <p class="label">Príjmy {r.rok}</p>
          <p class="value">{mil(r.prijmy)}</p>
          <p class="delta">vrátane finančných operácií</p>
        </div>
        <div class="card kpi">
          <p class="label">Výdavky {r.rok}</p>
          <p class="value">{mil(r.vydavky)}</p>
          <p class="delta">vrátane finančných operácií</p>
        </div>
        <div class="card kpi">
          <p class="label">Investície (kapitálové výdavky) {r.rok}</p>
          <p class="value">{mil(r.kapitalove)}</p>
          <p class="delta">{r.predch}: {mil(r.kapitalovePredch)}</p>
        </div>
        <div class="card kpi">
          <p class="label">Hospodárenie {r.rok}</p>
          <p class="value">{r.hosp >= 0 ? '+' : '−'}{mil(Math.abs(r.hosp))}</p>
          <p class="delta">{r.hosp >= 0 ? 'prebytok' : 'schodok'} bez finančných operácií (úvery, fondy)</p>
        </div>
      </section>

      <section class="card">
        <h2>Príjmy a výdavky</h2>
        <div class="chart"><canvas id="g-pv" role="img" aria-label="Príjmy a výdavky mesta podľa rokov"></canvas></div>
        <p class="zdroj">Skutočnosť podľa záverečného účtu, vrátane finančných operácií.</p>
      </section>

      <section class="card">
        <h2>Na čo mesto míňa ({r.rok})</h2>
        <div class="chart tall"><canvas id="g-programy" role="img" aria-label="Bežné a kapitálové výdavky podľa programov"></canvas></div>
        <p class="zdroj">Bežné a kapitálové výdavky podľa programov rozpočtu.</p>
      </section>

      <section class="card">
        <h2>Odkiaľ má mesto peniaze</h2>
        <div class="chart"><canvas id="g-druhy" role="img" aria-label="Príjmy mesta podľa druhu"></canvas></div>
        <p class="zdroj">Daňové príjmy sú najmä podiel na dani z príjmov fyzických osôb a daň z nehnuteľností; granty a transfery zahŕňajú aj eurofondy a peniaze zo štátu.</p>
      </section>

      <p class="zdroj">
        Zdroj: Hlavné mesto SR Bratislava, <a href="https://data.bratislava.sk">data.bratislava.sk</a>, záverečný účet
        ({r.zdroje.map((s: any, i: number) => <>{i > 0 && ', '}<a href={s.url}>{s.nazov.replace(' mesta Bratislava', '').replace(' zo záverečného účtu', '').replace(' podľa záverečného účtu', '')}</a></>)}).
        Licencia CC BY 4.0.
      </p>

      {majetok && (
        <>
          <h2 class="sekcia">Majetok mesta: pozemky</h2>
          <section class="kpis">
            <div class="card kpi">
              <p class="label">Pozemky vo vlastníctve mesta</p>
              <p class="value">{fmt(Math.round(majetok.spolu.vymera_ha))} ha</p>
              <p class="delta">{fmt(majetok.spolu.parcely)} parciel · približne {podielRozlohy} % rozlohy Bratislavy</p>
            </div>
            {majetok.sprava.map((s: any) => (
              <div class="card kpi">
                <p class="label">{s.nazov === 'zverený' ? 'Zverené do správy' : 'Spravuje priamo mesto'}</p>
                <p class="value">{fmt(Math.round(s.vymera_ha))} ha</p>
                <p class="delta">{s.nazov === 'zverený' ? 'mestským častiam a mestským organizáciám' : 'magistrát'} · {fmt(s.parcely)} parciel</p>
              </div>
            ))}
          </section>

          <section class="card">
            <h3>Druhy pozemkov</h3>
            <div class="chart"><canvas id="g-druhy-poz" role="img" aria-label="Výmera mestských pozemkov podľa druhu"></canvas></div>
          </section>

          <section class="card">
            <h3>Kde mesto vlastní pozemky</h3>
            <div class="tabulka-obal">
              <table>
                <thead><tr><th>Mestská časť</th><th class="num">Parcely</th><th class="num">Výmera</th><th class="num">Podiel z rozlohy MČ</th></tr></thead>
                <tbody>
                  {majetokCasti.map((c: any) => (
                    <tr><td>{c.nazov}</td><td class="num">{fmt(c.parcely)}</td><td class="num">{fmt(Math.round(c.vymera_ha))} ha</td><td class="num">{c.podiel != null ? `${c.podiel.toLocaleString('sk-SK', { maximumFractionDigits: 0 })} %` : '–'}</td></tr>
                  ))}
                </tbody>
              </table>
            </div>
            <p class="zdroj">
              Stav k 31. 12. 2025. Výmera zahŕňa aj {fmt(majetok.spolu.spoluvlastnictvo)} parciel v spoluvlastníctve (započítané celou výmerou) a parcely registra C aj E,
              preto je súčet len orientačný. Mestské časti podľa katastrálnych území. Zdroj: <a href={majetok.zdroj.url}>{majetok.zdroj.nazov}</a>, data.bratislava.sk, licencia {majetok.zdroj.licencia ?? 'CC BY 4.0'}.
            </p>
          </section>
        </>
      )}

      {zmluvy && z && (
        <>
          <h2 class="sekcia">Zmluvy magistrátu</h2>
          <section class="card">
            <h3>Zverejnené zmluvy podľa rokov</h3>
            <div class="chart"><canvas id="g-zmluvy" role="img" aria-label="Počet a hodnota zverejnených zmlúv podľa rokov"></canvas></div>
            <p class="zdroj">Spolu {fmt(zmluvy.pocet_spolu)} zmlúv zverejnených od júla 2022. Hodnota je zmluvná suma (pri rámcových zmluvách maximum), nie skutočne vyplatené peniaze.</p>
          </section>

          <section class="card">
            <h3>Najväčší dodávatelia za posledných 12 mesiacov</h3>
            <div class="tabulka-obal">
              <table>
                <thead><tr><th>Dodávateľ</th><th class="num">Zmlúv</th><th class="num">Zmluvná hodnota</th></tr></thead>
                <tbody>
                  {z.dodavatelia.slice(0, 10).map((d: any) => (
                    <tr><td>{d.nazov}<span class="ico">IČO {d.ico}</span></td><td class="num">{d.pocet}</td><td class="num">{mil(d.suma)}</td></tr>
                  ))}
                </tbody>
              </table>
            </div>
          </section>

          <section class="card">
            <h3>Najväčšie zmluvy za posledných 12 mesiacov</h3>
            <ul class="zmluvy">
              {z.najvacsie.slice(0, 10).map((x: any) => (
                <li>
                  <div class="zmluva-hlava"><strong>{eur(x.suma)}</strong><span>{datum(x.datum)}</span></div>
                  <p>{x.dodavatel}{x.dodatok && <span class="stitok">dodatok</span>}</p>
                  <p class="predmet">{x.predmet}</p>
                  {x.odkaz && <a href={x.odkaz}>Zmluva na zverejnovanie.bratislava.sk</a>}
                </li>
              ))}
            </ul>
            <p class="zdroj">
              Od {datum(z.od)}. Bez zmlúv, kde je dodávateľom samo mesto, a bez fyzických osôb (subjekty bez IČO, spolu {eur(z.suma_bez_ico)}).
              Zdroj: <a href={zmluvy.zdroj.url}>{zmluvy.zdroj.nazov}</a>, data.bratislava.sk, licencia {zmluvy.zdroj.licencia ?? 'CC BY-NC 4.0'}.
            </p>
          </section>
        </>
      )}
      {fakt && (
        <>
          <h2 class="sekcia" id="faktury">Faktúry, objednávky a zmluvy</h2>
          {magF && (
            <section class="kpis">
              <div class="card kpi"><p class="label">Faktúry magistrátu ({poslednyCely(magF)})</p><p class="value">{mil(magF.roky[poslednyCely(magF)!].suma)}</p><p class="delta">{fmt(magF.roky[poslednyCely(magF)!].pocet)} faktúr</p></div>
              {magF.median_dni_uhrady && <div class="card kpi"><p class="label">Ako rýchlo mesto platí</p><p class="value">{magF.median_dni_uhrady[poslednyCely(magF)!] ?? Object.values<number>(magF.median_dni_uhrady).pop()} dní</p><p class="delta">medián od doručenia faktúry po úhradu</p></div>}
              {magO && <div class="card kpi"><p class="label">Objednávky magistrátu ({poslednyCely(magO)})</p><p class="value">{mil(magO.roky[poslednyCely(magO)!].suma)}</p><p class="delta">{fmt(magO.roky[poslednyCely(magO)!].pocet)} objednávok</p></div>}
            </section>
          )}
          {magF && (
            <section class="card" data-fakt={grafFakt} id="fakt-graf">
              <h3>Faktúry magistrátu podľa rokov</h3>
              <div class="chart"><canvas id="g-fakt" role="img" aria-label="Suma faktúr magistrátu podľa rokov"></canvas></div>
            </section>
          )}
          <section class="card">
            <div class="dlh-grid">
              {[magF, magO].filter(Boolean).map((d: any) => (
                <div>
                  <h3>Najväčší dodávatelia – {d.typ} magistrátu (posledné 3 roky)</h3>
                  <ol class="dodavatelia">{d.dodavatelia_posledne_3_roky.slice(0, 10).map((x: any) => <li>{x.nazov} <span>{mil(x.suma)} · {fmt(x.pocet)}×</span></li>)}</ol>
                </div>
              ))}
            </div>
          </section>
          <section class="card">
            <h3>Mestské organizácie</h3>
            <div class="tabulka-obal">
              <table>
                <thead><tr><th>Organizácia</th><th>Typ</th><th class="num">Rok</th><th class="num">Počet</th><th class="num">Suma</th><th>Najväčší dodávateľ (3 roky)</th></tr></thead>
                <tbody>
                  {fakt.datasety.filter((d: any) => d.organizacia !== 'Magistrát').map((d: any) => {
                    const r = poslednyCely(d);
                    return <tr><td><a href={d.zdroj}>{d.organizacia}</a></td><td>{d.typ}</td><td class="num">{r}</td><td class="num">{r ? fmt(d.roky[r].pocet) : '–'}</td><td class="num">{r ? mil(d.roky[r].suma) : '–'}</td><td class="mensie">{d.dodavatelia_posledne_3_roky[0]?.nazov ?? '–'}</td></tr>;
                  })}
                </tbody>
              </table>
            </div>
            <p class="zdroj">
              OLO = Odvoz a likvidácia odpadu, Marianum = Pohrebníctvo mesta Bratislavy. Pri zmluvách ide o finančný rámec zmluvy (môže byť viacročný).
              Vynechané sú položky dodávateľov bez IČO a fyzických osôb. Zdroj: faktúry, objednávky a zmluvy na data.bratislava.sk, licencia CC BY 4.0.
            </p>
          </section>
          {magF?.najvacsie_12_mesiacov?.length > 0 && (
            <section class="card">
              <h3>Najväčšie faktúry magistrátu za posledných 12 mesiacov</h3>
              <ul class="zmluvy">
                {magF.najvacsie_12_mesiacov.slice(0, 10).map((x: any) => (
                  <li><div class="zmluva-hlava"><strong>{eur(x.suma)}</strong><span>{datum(x.datum)}</span></div><p>{x.dodavatel}</p>{x.popis && <p class="predmet">{x.popis}</p>}</li>
                ))}
              </ul>
            </section>
          )}
        </>
      )}

      {dlhPosl && (
        <>
          <h2 class="sekcia" id="dlh">Dlh mesta a mestských častí</h2>
          <section class="kpis">
            <div class="card kpi"><p class="label">Dlh hlavného mesta ({dlhRok})</p><p class="value">{mil(dlhPosl['Hlavné mesto'].dlh)}</p><p class="delta">{pct(dlhPosl['Hlavné mesto'].pomer)} bežných príjmov · zákonný limit 60 %</p></div>
            <div class="card kpi"><p class="label">Dlh všetkých mestských častí</p><p class="value">{mil(dlhMcSpolu)}</p><p class="delta">{dlhMc.filter((c: any) => c.dlh === 0).length} zo 17 častí bez dlhu</p></div>
            <div class="card kpi"><p class="label">Dlhová služba mesta</p><p class="value">{pct(dlhPosl['Hlavné mesto'].dlhova_sluzba)}</p><p class="delta">splátky istín a úrokov z bežných príjmov · limit 25 %</p></div>
          </section>
          <section class="card">
            <div class="dlh-grid">
              <div>
                <h3>Hlavné mesto podľa rokov</h3>
                <div class="tabulka-obal"><table>
                  <thead><tr><th>Rok</th><th class="num">Dlh</th><th class="num">Pomer k príjmom</th></tr></thead>
                  <tbody>{dlhMesto.map((r: any) => <tr><td>{r.rok}</td><td class="num">{mil(r.dlh)}</td><td class="num">{pct(r.pomer)}</td></tr>)}</tbody>
                </table></div>
              </div>
              <div>
                <h3>Mestské časti ({dlhRok})</h3>
                <div class="tabulka-obal"><table>
                  <thead><tr><th>Mestská časť</th><th class="num">Dlh</th><th>Pomer k príjmom</th></tr></thead>
                  <tbody>{dlhMc.map((c: any) => <tr><td>{c.mc}</td><td class="num">{c.dlh ? mil(c.dlh) : '0'}</td><td class="nowrap"><span class="pruh" style={`--w:${Math.min(100, (c.pomer / 60) * 100)}%`}></span> {pct(c.pomer)}</td></tr>)}</tbody>
                </table></div>
              </div>
            </div>
            <p class="zdroj">{ukaz.dlh.popis} Zdroj: <a href={ukaz.dlh.zdroj.url}>{ukaz.dlh.zdroj.nazov}</a> (data.slovensko.sk), z finančných výkazov obcí.</p>
          </section>
        </>
      )}
    </div>
  )}
</Base>

<script>
  import Chart from 'chart.js/auto';

  const fg = document.getElementById('fakt-graf');
  if (fg?.dataset.fakt) {
    const d = JSON.parse(fg.dataset.fakt);
    const c = getComputedStyle(document.documentElement);
    new Chart(document.getElementById('g-fakt') as HTMLCanvasElement, {
      type: 'bar', data: { labels: d.roky, datasets: [{ data: d.sumy, backgroundColor: c.getPropertyValue('--accent').trim(), borderRadius: 3 }] },
      options: { maintainAspectRatio: false, plugins: { legend: { display: false }, tooltip: { callbacks: { label: (x) => ' ' + (x.parsed.y / 1e6).toLocaleString('sk-SK', { maximumFractionDigits: 1 }) + ' mil. €' } } },
        scales: { x: { grid: { display: false } }, y: { ticks: { callback: (v) => (Number(v) / 1e6).toLocaleString('sk-SK') + ' mil.' } } } },
    });
  }

  const el = document.getElementById('financie');
  if (el?.dataset.graf) {
    const g = JSON.parse(el.dataset.graf);
    const css = getComputedStyle(document.documentElement);
    const accent = css.getPropertyValue('--accent').trim();
    const muted = css.getPropertyValue('--muted').trim();
    const line = css.getPropertyValue('--line').trim();
    const tmava = window.matchMedia('(prefers-color-scheme: dark)').matches;
    Chart.defaults.color = muted;
    Chart.defaults.borderColor = line;
    Chart.defaults.font.family = css.getPropertyValue('--font');
    const mil = (n: number) => (n / 1e6).toLocaleString('sk-SK', { maximumFractionDigits: 0 }) + ' mil. €';
    const odtiene = tmava ? ['#ff6b80', '#d83a55', '#a92c42', '#7a2433'] : ['#a00d26', '#d3304b', '#ec6a7c', '#f7aab3'];

    new Chart(document.getElementById('g-pv') as HTMLCanvasElement, {
      type: 'bar',
      data: {
        labels: g.roky,
        datasets: [
          { label: 'Príjmy', data: g.prijmy, backgroundColor: muted + '99', borderRadius: 3 },
          { label: 'Výdavky', data: g.vydavky, backgroundColor: accent, borderRadius: 3 },
        ],
      },
      options: {
        maintainAspectRatio: false,
        plugins: { tooltip: { callbacks: { label: (c) => ` ${c.dataset.label}: ${mil(c.parsed.y)}` } } },
        scales: { x: { grid: { display: false } }, y: { ticks: { callback: (v) => mil(Number(v)) } } },
      },
    });

    new Chart(document.getElementById('g-programy') as HTMLCanvasElement, {
      type: 'bar',
      data: { labels: g.programy.stitky, datasets: [{ data: g.programy.data, backgroundColor: accent, borderRadius: 4, maxBarThickness: 22 }] },
      options: {
        indexAxis: 'y',
        maintainAspectRatio: false,
        plugins: { legend: { display: false }, tooltip: { callbacks: { label: (c) => ' ' + mil(c.parsed.x) } } },
        scales: {
          x: { ticks: { callback: (v) => mil(Number(v)) } },
          y: { grid: { display: false }, ticks: { callback: (_, i) => {
            const t = g.programy.stitky[i as number];
            const max = window.innerWidth < 600 ? 18 : 40;
            return t.length > max ? t.slice(0, max - 1).trimEnd() + '…' : t;
          } } },
        },
      },
    });

    new Chart(document.getElementById('g-druhy') as HTMLCanvasElement, {
      type: 'bar',
      data: {
        labels: g.roky,
        datasets: g.druhy.map((d: any, i: number) => ({ label: d.nazov, data: d.data, backgroundColor: odtiene[i], borderRadius: 2 })),
      },
      options: {
        maintainAspectRatio: false,
        plugins: { legend: { position: 'bottom', labels: { boxWidth: 12 } }, tooltip: { callbacks: { label: (c) => ` ${c.dataset.label}: ${mil(c.parsed.y)}` } } },
        scales: { x: { stacked: true, grid: { display: false } }, y: { stacked: true, ticks: { callback: (v) => mil(Number(v)) } } },
      },
    });

    const pc = document.getElementById('g-druhy-poz') as HTMLCanvasElement | null;
    if (pc && el.dataset.poz) {
      const p = JSON.parse(el.dataset.poz);
      new Chart(pc, {
        type: 'bar',
        data: { labels: p.stitky, datasets: [{ data: p.data, backgroundColor: accent, borderRadius: 4, maxBarThickness: 20 }] },
        options: {
          indexAxis: 'y',
          maintainAspectRatio: false,
          plugins: { legend: { display: false }, tooltip: { callbacks: { label: (c) => ` ${Math.round(c.parsed.x).toLocaleString('sk-SK')} ha` } } },
          scales: {
            x: { ticks: { callback: (v) => Number(v).toLocaleString('sk-SK') + ' ha' } },
            y: { grid: { display: false }, ticks: { callback: (_, i) => {
              const t: string = p.stitky[i as number];
              return window.innerWidth < 600 ? t.replace(' a nádvoria', '').replace('Trvalé trávne porasty', 'Trávne porasty') : t;
            } } },
          },
        },
      });
    }

    const zc = document.getElementById('g-zmluvy') as HTMLCanvasElement | null;
    if (zc && g.zmluvy) {
      new Chart(zc, {
        type: 'bar',
        data: {
          labels: g.zmluvy.roky,
          datasets: [{ label: 'Zmluvná hodnota', data: g.zmluvy.suma, backgroundColor: accent, borderRadius: 3 }],
        },
        options: {
          maintainAspectRatio: false,
          plugins: {
            legend: { display: false },
            tooltip: { callbacks: { label: (c) => ` ${mil(c.parsed.y)} · ${g.zmluvy.pocet[c.dataIndex].toLocaleString('sk-SK')} zmlúv` } },
          },
          scales: { x: { grid: { display: false } }, y: { ticks: { callback: (v) => mil(Number(v)) } } },
        },
      });
    }
  }
</script>

