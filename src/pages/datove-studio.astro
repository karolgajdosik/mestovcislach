---
// Dátové štúdio: vlastný pohľad na ukazovatele všetkých obcí – graf, bodový graf, mapa, tabuľka; filter kraj / okres /
// veľkosť; stiahnutie CSV, odkaz na pohľad (stav v adrese), vloženie na iný web (/vlozit/datove-studio?g=studio-vysledok&…).
// Ukazovatele sú rozdelené do tematických oblastí (src/lib/studio-ukazovatele.ts); hodnoty sa načítajú po oblastiach
// z /data/studio/<oblast>.json až keď ich treba – žiadne súbory na obec.
import Base from '../layouts/Base.astro';
import { krajeMapy, SIRKA, VYSKA } from '../lib/obce';
import { OBLASTI, VSETKY_POLIA, OPISY, RAD_PRE } from '../lib/studio-ukazovatele';
import '../styles/stranka.css';
import '../styles/obce.css';
const kraje = krajeMapy();
const norm = (t: string) => t.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase();
// slová, pod ktorými ľudia ukazovateľ hľadajú (vyhľadávanie vo výbere)
const TAGY: Record<string, string> = {
  obyv: 'pocet ludi velkost', z10: 'rast pokles vymieranie', z93: 'rast pokles', hus: 'zahustenie', star: 'starnutie seniori dochodcovia', nar: 'porodnost deti', zom: 'umrtnost',
  mig: 'stahovanie migracia pristahovali odstahovali', cudz: 'cudzinci ukrajinci', vs: 'vysoka skola univerzita vzdelani', zakl: 'nevzdelani', narine: 'madari romovia mensiny narodnostne mensiny',
  rkc: 'katolici cirkev nabozenstvo viera', bezv: 'ateisti nabozenstvo', nez: 'praca nezamestnani', uoz: 'nezamestnani pracu hladaju', firmy: 'podniky spolocnosti sro', zivn: 'szco podnikatelia',
  vyd: 'rozpocet vydavky', inv: 'investicie stavby', dan: 'dane dan z nehnutelnosti podielove dane prijmy', trans: 'dotacie od statu', zav: 'dlhy dlh zadlzenie', uver: 'dlh zadlzenie pozicky',
  hot: 'rezervy hotovost peniaze', zml: 'crz zmluvy', nfp: 'eurofondy eu fondy dotacie', m2: 'velkost bytu', najom: 'najomne byvanie', kanal: 'kanalizacia splasky', zumpa: 'septik',
  plyn: 'plynofikacia', pevne: 'drevo uhlie smog', voda: 'vodovod spotreba', ms: 'skolky skolka materska', zs: 'skola zakladna', ziaci: 'deti skola', vseob: 'lekar obvodny lekari zdravie',
  zubar: 'zubar zubari stomatolog', lekarne: 'lieky lekaren', potr: 'obchod potraviny supermarket', jedlo: 'restauracie krcmy kaviarne', ihr: 'ihrisko deti', sport: 'sportovisko ihrisko futbal',
  zast: 'autobus mhd doprava', nabij: 'elektromobil nabijacky', vlaky: 'vlak zeleznica stanica', cyklo: 'bicykel cyklisti', turist: 'turistika vylety', les: 'lesy priroda',
  vin: 'vino vinohrady', zosuv: 'zosuvy geologia', pam: 'pamiatky hrady kostoly', zmienka: 'historia vznik', tep: 'teplota pocasie', zr: 'dazd pocasie', trop: 'horucavy leto',
  snez: 'sneh zima', mraz: 'zima', pm10: 'smog prach ovzdusie znecistenie', pm25: 'smog prach ovzdusie', no2: 'doprava ovzdusie znecistenie', tri: 'triedenie recyklacia',
  kg: 'smeti odpad', kgz: 'smeti', bio: 'kompost bioodpad', uc: 'volby ucast komunalne', kand: 'kandidati starosta', lozka: 'hotely penziony ubytovanie turisti', vyuz: 'obsadenost hotely',
};
const hladajText = (p: { k: string; n: string; j: string }, o: { n: string }) => norm(`${p.n} ${p.j} ${o.n} ${TAGY[p.k] ?? ''} ${OPISY[p.k] ?? ''}`);
---
<Base title="Dátové štúdio – ukazovatele obcí Slovenska po svojom – mestovcislach.sk" description="Vyberte ukazovatele (nezamestnanosť, vek, vzdelanie, rozpočet, odpad, klíma…) a obce podľa kraja, okresu a veľkosti. Graf, bodový graf, mapa aj tabuľka – na stiahnutie, zdieľanie a vloženie na web.">
  <section class="hero">
    <p class="kicker">Dátové štúdio</p>
    <h1>Čísla obcí po svojom</h1>
    <p class="lead">{VSETKY_POLIA.length} ukazovateľov v {OBLASTI.length} oblastiach pre všetky obce a mestá Slovenska. Vyberte, čo chcete vidieť a pre ktoré obce – a pozrite sa na to ako na graf, mapu alebo tabuľku. Pohľad sa dá stiahnuť, poslať odkazom alebo vložiť na vlastný web.</p>
  </section>

  <div class="ds" id="ds" data-rady={JSON.stringify(RAD_PRE)}>
    <section class="card ds-filter" aria-label="Filter">
      <div class="ds-krok">
        <div class="ds-krok-hl">
          <span class="ds-lbl" id="ds-u-l">1. Čo chcete vidieť – vyberte oblasť a ukazovateľ</span>
          <button type="button" class="ds-hladaj" id="ds-u" aria-haspopup="dialog"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6.5"/><path d="m16 16 4 4"/></svg>Hľadať ukazovateľ</button>
        </div>
        <div class="ds-obl" role="tablist" aria-labelledby="ds-u-l">
          {OBLASTI.map((o, i) => <button type="button" role="tab" id={`ds-obl-${o.id}`} data-o={o.id} aria-controls={`ds-ukp-${o.id}`} aria-selected={i === 2 ? 'true' : 'false'}><b>{o.n}</b><span>{o.polia.length}</span></button>)}
        </div>
        {OBLASTI.map((o, i) => (
          <div class="ds-ukp" role="tabpanel" id={`ds-ukp-${o.id}`} aria-labelledby={`ds-obl-${o.id}`} data-o={o.id} hidden={i !== 2}>
            {o.polia.map((p) => <button type="button" data-k={p.k} aria-pressed="false" title={OPISY[p.k]}>{p.n}</button>)}
          </div>
        ))}
      </div>
      <div class="ds-rad">
        <div class="ds-krok">
          <label class="ds-lbl" for="ds-kraj">2. Kraj</label>
          <select class="ds-dd" id="ds-kraj"><option value="">Všetky kraje</option></select>
        </div>
        <div class="ds-krok">
          <label class="ds-lbl" for="ds-okres">3. Okres</label>
          <select class="ds-dd" id="ds-okres"><option value="">Všetky okresy</option></select>
        </div>
        <div class="ds-krok">
          <label class="ds-lbl" for="ds-min">4. Veľkosť obce</label>
          <select class="ds-dd" id="ds-min">
            {[['0', 'Všetky obce'], ['500', 'od 500 obyvateľov'], ['1000', 'od 1 000 obyvateľov'], ['2000', 'od 2 000 obyvateľov'], ['5000', 'od 5 000 obyvateľov'], ['10000', 'od 10 000 obyvateľov'], ['20000', 'od 20 000 obyvateľov']].map(([v, n]) => <option value={v}>{n}</option>)}
          </select>
        </div>
        <button type="button" class="ds-zobraz" id="ds-zobraz">Zobraziť <b id="ds-pocet">…</b> <span id="ds-pocet-s">obcí</span></button>
      </div>
      <div class="ds-krok ds-krok-obce">
        <label class="ds-lbl" for="ds-obec-q">5. Porovnať konkrétne obce <span class="ds-volit">(voliteľné, najviac 5 – pre Vývoj v čase a Porovnanie obcí)</span></label>
        <div class="ds-obce">
          <span class="ds-obce-cipy" id="ds-obce-cipy"></span>
          <span class="ds-obce-hl">
            <input id="ds-obec-q" type="text" role="combobox" aria-expanded="false" aria-controls="ds-obec-zoz" autocomplete="off" placeholder="+ pridať obec, napr. Badín" />
            <ul class="ds-obec-zoz" id="ds-obec-zoz" role="listbox" hidden></ul>
          </span>
        </div>
      </div>
      <div class="ds-aktivne" id="ds-akt" hidden><span>Aktívne:</span><span class="ds-stitky" id="ds-stitky"></span></div>
    </section>

    <section class="ds-vysledok" aria-label="Výsledok">
      <div class="ds-lista">
        <div class="ds-zalozky" role="tablist" aria-label="Zobrazenie">
          <button type="button" role="tab" data-v="graf" aria-selected="true">Graf</button>
          <button type="button" role="tab" data-v="mapa" aria-selected="false">Mapa</button>
          <button type="button" role="tab" data-v="tabulka" aria-selected="false">Tabuľka</button>
          <button type="button" role="tab" data-v="vyvoj" aria-selected="false">Vývoj v čase</button>
          <button type="button" role="tab" data-v="porovnanie" aria-selected="false">Porovnanie obcí</button>
        </div>
        <div class="ds-akcie">
          <button type="button" id="ds-csv" title="Stiahnuť vybrané obce so všetkými ukazovateľmi"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 4v11m0 0-4-4m4 4 4-4M5 19h14"/></svg><span>CSV</span></button>
          <button type="button" id="ds-odkaz" title="Kopírovať odkaz na tento pohľad"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M10 14a4 4 0 0 0 5.7 0l3-3a4 4 0 0 0-5.7-5.7l-1 1M14 10a4 4 0 0 0-5.7 0l-3 3a4 4 0 0 0 5.7 5.7l1-1"/></svg><span>Odkaz</span></button>
          <button type="button" data-vlozit-otvor="studio-vysledok" title="Vložiť na vlastný web"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m8 8-4 4 4 4m8-8 4 4-4 4"/></svg><span>Vložiť</span></button>
        </div>
      </div>

      <section class="card ds-karta" id="studio-vysledok" data-vlozit-karta data-vlozit-vlastne data-vyska="760">
        <div class="ds-hlava">
          <h2 id="ds-nadpis">Dátové štúdio</h2>
          <p class="ds-podnadpis" id="ds-podnadpis"></p>
          <p class="ds-opis" id="ds-opis"></p>
        </div>
        <div class="ds-suhrn" id="ds-suhrn"></div>

        <div class="ds-pohlad" data-pohlad="graf">
          <div class="ds-volby">
            <label>Zobraziť <select id="ds-n"><option value="15">15</option><option value="25" selected>25</option><option value="50">50</option><option value="100">100</option></select></label>
            <label>Poradie <select id="ds-por"><option value="desc">od najvyššej hodnoty</option><option value="asc">od najnižšej hodnoty</option></select></label>
          </div>
          <div class="ds-stlpce" id="ds-stlpce"></div>
        </div>

        <div class="ds-pohlad" data-pohlad="mapa" hidden>
          <svg class="ds-mapa" id="ds-mapa" viewBox={`0 0 ${SIRKA} ${VYSKA}`} role="img" aria-label="Mapa vybraných obcí podľa hlavného ukazovateľa">
            <g class="ds-kraje">{kraje.map((k) => <path d={k.d}><title>{k.nazov}</title></path>)}</g>
            <g id="ds-mapa-body"></g>
          </svg>
          <div class="ds-legenda" id="ds-legenda"></div>
        </div>

        <div class="ds-pohlad" data-pohlad="tabulka" hidden>
          <div class="tabulka-obal"><table class="ob-tab ds-tab" id="ds-tab"><thead></thead><tbody></tbody></table></div>
          <button type="button" class="ds-viac" id="ds-viac" hidden>Zobraziť všetky</button>
        </div>
        <div class="ds-pohlad" data-pohlad="vyvoj" hidden>
          <div id="ds-vyvoj"></div>
        </div>

        <div class="ds-pohlad" data-pohlad="porovnanie" hidden>
          <div id="ds-porov"></div>
        </div>
        <p class="zdroj" id="ds-zdroj"></p>
      </section>
      <section class="card ds-vysv" aria-labelledby="ds-vysv-n">
        <h2 id="ds-vysv-n">Vysvetlivky – ako čítať čísla</h2>
        <dl>
          <div><dt>Medián</dt><dd>Prostredná hodnota: polovica obcí má viac, polovica menej. Na rozdiel od priemeru ho nepokazí jedna obec s extrémnym číslom.</dd></div>
          <div><dt>Medián výberu a Slovenska</dt><dd>Medián vybraných obcí (kraj, okres, veľkosť) porovnaný s mediánom všetkých obcí Slovenska – hneď vidno, či je výber nad alebo pod bežnou úrovňou.</dd></div>
          <div><dt>Čiarkovaná čiara v grafe</dt><dd>Medián Slovenska. Stĺpce za čiarou majú vyššiu hodnotu ako polovica slovenských obcí.</dd></div>
          <div><dt>Farby na mape</dt><dd>Vybrané obce sú rozdelené do 7 rovnako početných skupín – od najnižších (svetlé) po najvyššie (tmavé) hodnoty. Sivé bodky sú obce mimo výberu.</dd></div>
          <div><dt>Bez údaja</dt><dd>Obec v zdroji chýba (napr. ovzdušie merajú len stanice v okolí niektorých obcí). Takéto obce sa nerátajú ako nula, len sa vynechajú.</dd></div>
          <div><dt>„na obyvateľa“, „na 1 000 obyv.“</dt><dd>Číslo je prepočítané na počet obyvateľov, aby sa dala porovnať malá obec s veľkým mestom.</dd></div>
          <div><dt>p. b. (percentuálny bod)</dt><dd>Rozdiel dvoch percent. Ak nezamestnanosť klesla z 5 % na 4 %, zmena je −1 p. b. (nie −20 %).</dd></div>
          <div><dt>Malé obce</dt><dd>V obci so 100 obyvateľmi stačí pár ľudí a percentá vyskočia. Pri porovnávaní pomôže filter Veľkosť obce.</dd></div>
          <div><dt>Zdroj a rok</dt><dd>Pod každým výsledkom je zdroj a obdobie. Údaje zo sčítania sú z roku 2021, ostatné väčšinou z posledného dostupného roka.</dd></div>
        </dl>
      </section>
      <details class="ds-pbi">
        <summary>Všetky obce a ukazovatele naraz – Excel, Power BI, Google Tabuľky</summary>
        <p><a href="/data/obce-ukazovatele.csv" download>Stiahnuť celý súbor (CSV)</a> – má stálu adresu a obnovuje sa so zberom dát:</p>
        <code>https://mestovcislach.sk/data/obce-ukazovatele.csv</code>
        <p><b>Power BI:</b> Získať údaje → Web → vložte adresu. <b>Excel:</b> Údaje → Z webu. <b>Google Tabuľky:</b> <code>=IMPORTDATA("…")</code>. Oddeľovač je bodkočiarka, desatinná čiarka, kódovanie UTF-8.</p>
      </details>
    </section>
  </div>

  <dialog class="dsp" id="dsp" aria-labelledby="dsp-nadpis">
    <div class="dsp-hlava">
      <h2 id="dsp-nadpis">Vyberte, čo chcete skúmať</h2>
      <button type="button" class="dsp-zavri" id="dsp-zavri" aria-label="Zavrieť">✕</button>
    </div>
    <div class="dsp-hladaj">
      <input type="search" id="dsp-q" placeholder="Hľadať… napr. dane, lesy, škôlky, smog" autocomplete="off" aria-label="Hľadať ukazovateľ" />
    </div>
    <div class="dsp-telo">
      <nav class="dsp-oblasti" aria-label="Oblasti">
        {OBLASTI.map((o) => <button type="button" data-o={o.id}><b>{o.n}</b><small>{o.popis}</small><i>{o.polia.length}</i></button>)}
      </nav>
      <div class="dsp-zoznam" id="dsp-zoznam">
        {OBLASTI.map((o) => (
          <section data-o={o.id}>
            <h3>{o.n}</h3>
            <ul>{o.polia.map((p) => <li><button type="button" data-k={p.k} data-t={hladajText(p, o)}><span>{p.n}</span><em>{OPISY[p.k]}</em><small>{p.j ? `${p.j} · ` : ''}{p.z}</small></button></li>)}</ul>
          </section>
        ))}
        <p class="dsp-nic" hidden>Nič sa nenašlo. Skúste iné slovo alebo vyberte oblasť vľavo.</p>
      </div>
    </div>
  </dialog>
</Base>

<script>
  type Pole = { k: string; n: string; j: string; d: number; z: string; p?: string; opis: string; pocet: number };
  type Oblast = { id: string; n: string; popis: string; polia: Pole[] };
  type D = { kraje: string[]; oblasti: Oblast[]; obce: (string | number | null)[][] };
  type Obec = { kod: string; n: string; okres: string; u: string; kraj: number; h: Record<string, number | null>; lat: number; lon: number };
  const $ = <T extends HTMLElement = HTMLElement>(id: string) => document.getElementById(id) as T;
  const esc = (t: string) => t.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);
  const slug = (s: string) => s.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
  const vlozene = document.documentElement.hasAttribute('data-vlozit');
  // projekcia rovnaká ako src/lib/obce.ts (bod)
  const LON0 = 16.8, LON1 = 22.6, LAT0 = 47.7, LAT1 = 49.65, KX = Math.cos((48.7 * Math.PI) / 180);
  const SIRKA = 1000, VYSKA = Math.round((SIRKA * (LAT1 - LAT0)) / ((LON1 - LON0) * KX));
  const bod = (lon: number, lat: number) => [((lon - LON0) / (LON1 - LON0)) * SIRKA, ((LAT1 - lat) / (LAT1 - LAT0)) * VYSKA];
  const FARBY = ['#fde4e7', '#f9bcc4', '#f2909e', '#e6607a', '#d63a5a', '#b81e42', '#8c0f2f'];
  let OBLASTI: Oblast[] = [], POLE = new Map<string, Pole & { o: Oblast }>(), OBCE: Obec[] = [], KRAJE: string[] = [], OKRESY: [number, string][] = [];
  const nacitane = new Map<string, Promise<void>>();
  const S = { u: 'nez', kraj: '', okres: '', min: '0', v: 'graf', n: '25', por: 'desc', o: '', vi: '' };
  let vsetkyRiadky = false, triedenie: { k: string; smer: number } = { k: '', smer: -1 };

  const pole = (k: string) => POLE.get(k) ?? ({ k, n: k, j: '', d: 1, z: '', opis: '', pocet: 0, o: { id: '', n: '', popis: '', polia: [] } } as Pole & { o: Oblast });
  const nazov = (k: string) => { const p = pole(k); return `${p.n}${p.j ? ` (${p.j})` : ''}`; };
  const f = (k: string, v: number | null | undefined, sJednotkou = true) => {
    if (v == null || !Number.isFinite(v)) return '–';
    const { j, d } = pole(k);
    const t = v.toLocaleString('sk-SK', { maximumFractionDigits: d, minimumFractionDigits: d, useGrouping: !(j === 'rok') });
    return t + (sJednotkou && j && j !== 'rok' ? (j === '%' ? ' %' : ` ${j}`) : '');
  };
  // hodnoty oblasti sa načítajú až pri prvom použití
  function nacitajOblast(id: string) {
    if (!nacitane.has(id)) nacitane.set(id, fetch(`/data/studio/${id}.json`).then((r) => r.json()).then((d: { h: Record<string, (number | null)[]> }) => {
      for (const [k, arr] of Object.entries(d.h)) arr.forEach((v, i) => { if (OBCE[i]) OBCE[i].h[k] = v; });
    }));
    return nacitane.get(id)!;
  }
  const zabezpec = (...kl: string[]) => Promise.all(kl.map((k) => nacitajOblast(pole(k).o.id)));
  async function obnov() { await zabezpec(S.u); kresli(); }
  const median = (a: number[]) => { if (!a.length) return NaN; const s = [...a].sort((x, y) => x - y); const m = s.length >> 1; return s.length % 2 ? s[m] : (s[m - 1] + s[m]) / 2; };

  // ---------- stav v adrese ----------
  function zAdresy() {
    const q = new URLSearchParams(location.search);
    for (const k of Object.keys(S) as (keyof typeof S)[]) { const v = q.get(k); if (v != null) S[k] = v; }
    if (!['graf', 'mapa', 'tabulka', 'vyvoj', 'porovnanie'].includes(S.v)) S.v = 'graf';
    if (!['0', '500', '1000', '2000', '5000', '10000', '20000'].includes(S.min)) S.min = '0';
  }
  const PRED: typeof S = { ...S };
  function dotaz() {
    const q = new URLSearchParams();
    for (const k of Object.keys(S) as (keyof typeof S)[]) if (S[k] !== PRED[k]) q.set(k, S[k]);
    return q.toString() ? `?${q}` : '';
  }
  function doAdresy() {
    if (!vlozene) history.replaceState(null, '', `${location.pathname}${dotaz()}`);
  }

  // ---------- výber ----------
  function vyber(): Obec[] {
    const min = Number(S.min) || 0;
    return OBCE.filter((o) => (S.kraj === '' || String(o.kraj) === S.kraj) && (S.okres === '' || slug(o.okres) === S.okres) && (o.h.obyv ?? 0) >= min);
  }
  function popisVyberu(n: number) {
    const kde = S.okres ? `okres ${OKRESY.find(([, x]) => slug(x) === S.okres)?.[1] ?? ''}` : S.kraj !== '' ? KRAJE[Number(S.kraj)] : 'Slovensko';
    const vel = Number(S.min) ? ` · obce od ${Number(S.min).toLocaleString('sk-SK')} obyvateľov` : '';
    return `${kde}${vel} · ${n.toLocaleString('sk-SK')} ${n === 1 ? 'obec' : n < 5 ? 'obce' : 'obcí'}`;
  }

  // ---------- kreslenie ----------
  function kresli() {
    const vyb = vyber();
    const pU = pole(S.u);
    $('ds-nadpis').textContent = pU.n;
    $('ds-podnadpis').textContent = popisVyberu(vyb.length);
    $('ds-opis').textContent = pU.opis ?? '';
    stitky();
    const hodn = vyb.map((o) => o.h[S.u]).filter((v): v is number => v != null && Number.isFinite(v));
    const mSK = median(OBCE.map((o) => o.h[S.u]).filter((v): v is number => v != null && Number.isFinite(v)));
    const mV = median(hodn);
    const naj = vyb.filter((o) => o.h[S.u] != null).sort((a, b) => (b.h[S.u]! - a.h[S.u]!));
    $('ds-suhrn').innerHTML = hodn.length ? [
      ['Medián výberu', f(S.u, mV)],
      ['Medián Slovenska', f(S.u, mSK)],
      ['Najviac', `${f(S.u, naj[0]?.h[S.u])} <small>${esc(naj[0]?.n ?? '')}</small>`],
      ['Najmenej', `${f(S.u, naj.at(-1)?.h[S.u])} <small>${esc(naj.at(-1)?.n ?? '')}</small>`],
    ].map(([a, b]) => `<div><span>${a}</span><b>${b}</b></div>`).join('') : '<p class="pozn">Pre tento výber nie sú údaje.</p>';
    document.querySelectorAll<HTMLElement>('.ds-pohlad').forEach((p) => (p.hidden = p.dataset.pohlad !== S.v));
    document.querySelectorAll<HTMLButtonElement>('.ds-zalozky button').forEach((b) => b.setAttribute('aria-selected', String(b.dataset.v === S.v)));
    $('ds-suhrn').hidden = S.v === 'porovnanie';
    kresliObceCipy();
    if (S.v === 'graf') kresliStlpce(vyb, mSK);
    else if (S.v === 'mapa') kresliMapu(vyb);
    else if (S.v === 'vyvoj') kresliVyvoj(vyb);
    else if (S.v === 'porovnanie') kresliPorovnanie();
    else kresliTabulku(vyb);
    const bez = vyb.length - hodn.length;
    const kl = [S.u];
    if (S.v === 'porovnanie') { $('ds-zdroj').innerHTML = 'Zdroje sú uvedené pri každom ukazovateli vo výbere (Hľadať ukazovateľ) a v súbore CSV.'; doAdresy(); return; }
    const zdroje = 'Zdroj: ' + kl.map((k) => { const p = pole(k); return `${esc(p.n)} – ${esc(p.z)}${p.p ? ` (${esc(p.p)})` : ''}`; }).join('; ') + '.' + (bez > 0 ? ` Bez údaja: ${bez.toLocaleString('sk-SK')} z ${vyb.length.toLocaleString('sk-SK')} vybraných obcí.` : '');
    $('ds-zdroj').innerHTML = `${zdroje}${vlozene ? ` <a href="https://mestovcislach.sk/datove-studio/${dotaz()}" target="_blank" rel="noopener">Otvoriť v Dátovom štúdiu</a>` : ''}`;
    doAdresy();
  }

  function kresliStlpce(vyb: Obec[], mSK: number) {
    const s = vyb.filter((o) => o.h[S.u] != null).sort((a, b) => (S.por === 'asc' ? a.h[S.u]! - b.h[S.u]! : b.h[S.u]! - a.h[S.u]!)).slice(0, Number(S.n));
    if (!s.length) { $('ds-stlpce').innerHTML = '<p class="pozn">Žiadne údaje.</p>'; return; }
    const vals = s.map((o) => o.h[S.u]!);
    const lo = Math.min(0, ...vals, Number.isFinite(mSK) ? mSK : 0), hi = Math.max(...vals, Number.isFinite(mSK) ? mSK : 0);
    const roz = hi - lo || 1;
    const x = (v: number) => ((v - lo) / roz) * 100;
    const nula = x(0), ciara = Number.isFinite(mSK) ? x(mSK) : -1;
    $('ds-stlpce').innerHTML = s.map((o) => {
      const v = o.h[S.u]!, a = Math.min(x(v), nula), w = Math.abs(x(v) - nula);
      return `<a class="ds-riadok" href="${esc(o.u)}"><span class="ds-meno">${esc(o.n)}<small>${esc(o.okres)}</small></span><span class="ds-pas"><span class="ds-hodnota" style="left:${a.toFixed(2)}%;width:${Math.max(0.4, w).toFixed(2)}%"></span>${ciara >= 0 ? `<span class="ds-median" style="left:${ciara.toFixed(2)}%"></span>` : ''}</span><b>${f(S.u, v)}</b></a>`;
    }).join('') + (ciara >= 0 ? `<p class="ds-legenda-ciara"><span></span>Medián Slovenska ${f(S.u, mSK)}</p>` : '');
  }


  // ---------- vybrané obce na porovnanie (S.o = kódy oddelené bodkou) ----------
  const FARBY_OBCI = ['#2563eb', '#0d9488', '#d97706', '#7c3aed', '#16a34a'];
  const vybraneObce = () => S.o.split('.').filter(Boolean).map((k) => OBCE.findIndex((o) => o.kod === k)).filter((i) => i >= 0);
  function kresliObceCipy() {
    const el = $('ds-obce-cipy');
    el.innerHTML = vybraneObce().map((i, j) => `<button type="button" data-kod="${OBCE[i].kod}" style="--f:${FARBY_OBCI[j]}" aria-label="Odobrať ${esc(OBCE[i].n)}"><i aria-hidden="true"></i>${esc(OBCE[i].n)}<small>${esc(OBCE[i].okres)}</small><b aria-hidden="true">✕</b></button>`).join('');
    el.querySelectorAll<HTMLButtonElement>('button').forEach((b) => b.addEventListener('click', () => { S.o = S.o.split('.').filter((k) => k && k !== b.dataset.kod).join('.'); obnov(); }));
    $<HTMLInputElement>('ds-obec-q').disabled = vybraneObce().length >= 5;
    $<HTMLInputElement>('ds-obec-q').placeholder = vybraneObce().length >= 5 ? 'najviac 5 obcí' : vybraneObce().length ? '+ pridať ďalšiu obec' : '+ pridať obec, napr. Badín';
  }
  {
    const qi = $<HTMLInputElement>('ds-obec-q'), zoz = $('ds-obec-zoz');
    let moz: number[] = [], akt = 0;
    const zatvor = () => { zoz.hidden = true; qi.setAttribute('aria-expanded', 'false'); };
    const pridaj = (i: number) => {
      const k = OBCE[i].kod; const kk = S.o.split('.').filter(Boolean);
      if (!kk.includes(k) && kk.length < 5) S.o = [...kk, k].join('.');
      qi.value = ''; zatvor();
      if (S.v !== 'vyvoj' && S.v !== 'porovnanie') S.v = 'porovnanie';
      obnov();
    };
    const kresliZoz = () => {
      const t = slug(qi.value.trim());
      if (t.length < 2) { zatvor(); return; }
      moz = OBCE.map((o, i) => [slug(o.n), i] as const).filter(([n]) => n.includes(t)).sort((a, b) => (a[0].startsWith(t) ? 0 : 1) - (b[0].startsWith(t) ? 0 : 1) || (OBCE[b[1]].h.obyv ?? 0) - (OBCE[a[1]].h.obyv ?? 0)).slice(0, 8).map(([, i]) => i);
      akt = Math.min(akt, Math.max(0, moz.length - 1));
      zoz.innerHTML = moz.length ? moz.map((i, j) => `<li role="option" data-i="${i}" aria-selected="${j === akt}"><span>${esc(OBCE[i].n)}</span><small>okres ${esc(OBCE[i].okres)} · ${(OBCE[i].h.obyv ?? 0).toLocaleString('sk-SK')} obyv.</small></li>`).join('') : '<li class="ds-pop-nic">Obec sa nenašla</li>';
      zoz.hidden = false; qi.setAttribute('aria-expanded', 'true');
      zoz.querySelectorAll<HTMLLIElement>('li[data-i]').forEach((li) => li.addEventListener('mousedown', (e) => { e.preventDefault(); pridaj(Number(li.dataset.i)); }));
    };
    qi.addEventListener('input', () => { akt = 0; kresliZoz(); });
    qi.addEventListener('blur', zatvor);
    qi.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowDown' || e.key === 'ArrowUp') { e.preventDefault(); akt = Math.max(0, Math.min(moz.length - 1, akt + (e.key === 'ArrowDown' ? 1 : -1))); kresliZoz(); }
      else if (e.key === 'Enter') { e.preventDefault(); if (moz[akt] != null && !zoz.hidden) pridaj(moz[akt]); }
      else if (e.key === 'Escape') zatvor();
    });
  }

  // ---------- Vývoj v čase ----------
  type Rad = { id: string; n: string; j: string; d: number; z: string; roky: string[]; h: (number | null)[][] };
  const RAD_PRE: Record<string, string> = JSON.parse(document.getElementById('ds')!.dataset.rady || '{}');
  const rady = new Map<string, Promise<Rad>>();
  const nacitajRad = (id: string) => { if (!rady.has(id)) rady.set(id, fetch(`/data/studio/vyvoj/${id}.json`).then((r) => r.json())); return rady.get(id)!; };
  async function kresliVyvoj(vyb: Obec[]) {
    const el = $('ds-vyvoj');
    const id = RAD_PRE[S.u];
    if (!id) {
      const tipy = Object.keys(RAD_PRE).filter((k) => POLE.has(k)).filter((k, i, a) => a.findIndex((x) => RAD_PRE[x] === RAD_PRE[k]) === i).slice(0, 14);
      el.innerHTML = `<p class="ds-vyvoj-nic">Pre ukazovateľ „${esc(pole(S.u).n)}“ máme len jeden rok (napr. zo sčítania 2021), takže vývoj sa nedá ukázať. Vývoj v čase je pri týchto ukazovateľoch:</p><div class="ds-ukp">${tipy.map((k) => `<button type="button" data-k="${k}">${esc(pole(k).n)}</button>`).join('')}</div>`;
      el.querySelectorAll<HTMLButtonElement>('button[data-k]').forEach((b) => b.addEventListener('click', async () => { S.u = b.dataset.k!; popisVyberaca('ds-u', S.u); await obnov(); }));
      return;
    }
    el.innerHTML = '<p class="pozn">Načítavam vývoj…</p>';
    const rad = await nacitajRad(id);
    if (S.v !== 'vyvoj' || RAD_PRE[S.u] !== id) return;
    const idxVyb = new Set(vyb.map((o) => OBCE.indexOf(o)));
    const filtrovane = idxVyb.size < OBCE.length;
    const medianRok = (ix: Iterable<number>) => rad.roky.map((_, j) => { const a: number[] = []; for (const i of ix) { const v = rad.h[i]?.[j]; if (v != null) a.push(v); } return a.length ? median(a) : null; });
    const vsetky = OBCE.map((_, i) => i);
    const ciary: { n: string; f: string; h: (number | null)[]; hrubka: number; ciarka?: boolean }[] = [{ n: 'Medián Slovenska', f: 'var(--muted)', h: medianRok(vsetky), hrubka: 2, ciarka: true }];
    if (filtrovane) ciary.push({ n: `Medián výberu (${popisVyberu(vyb.length).split(' · ')[0]})`, f: 'var(--accent)', h: medianRok(idxVyb), hrubka: 3 });
    vybraneObce().forEach((i, j) => ciary.push({ n: OBCE[i].n, f: FARBY_OBCI[j], h: rad.h[i] ?? [], hrubka: 2.5 }));
    // index: každá čiara prepočítaná na 100 v prvom roku s údajom – porovná rast veľkých aj malých obcí
    const mozIdx = !['prir', 'mig', 'vysl'].includes(id); // pri záporných hodnotách index nedáva zmysel
    const idx = S.vi === 'idx' && mozIdx;
    if (idx) for (const c of ciary) { const z = c.h.find((v) => v != null && v !== 0); c.h = c.h.map((v) => (v == null || !z ? null : Math.round((v / z) * 1000) / 10)); }
    const jed = idx ? '' : rad.j, des = idx ? 1 : rad.d;
    const W = 820, H = 360, L = 64, R = 16, T = 16, B = 40;
    const vals = ciary.flatMap((c) => c.h.filter((v): v is number => v != null));
    if (!vals.length) { el.innerHTML = '<p class="pozn">Pre tento výber nie sú údaje o vývoji.</p>'; return; }
    let y0 = Math.min(...vals), y1 = Math.max(...vals);
    if (y0 === y1) { y0 -= 1; y1 += 1; }
    const pad = (y1 - y0) * 0.08; y0 = y0 >= 0 && y0 - pad < 0 ? 0 : y0 - pad; y1 += pad;
    const n = rad.roky.length;
    const X = (j: number) => L + (n === 1 ? (W - L - R) / 2 : (j / (n - 1)) * (W - L - R));
    const Y = (v: number) => T + (1 - (v - y0) / (y1 - y0)) * (H - T - B);
    const fr = (v: number) => v.toLocaleString('sk-SK', { maximumFractionDigits: des, minimumFractionDigits: des });
    const tick = Array.from({ length: 5 }, (_, i) => y0 + ((y1 - y0) * i) / 4);
    const krokX = Math.max(1, Math.ceil(n / 12));
    const cesta = (h: (number | null)[]) => { let d = '', pero = false; h.forEach((v, j) => { if (v == null) { pero = false; return; } d += `${pero ? 'L' : 'M'}${X(j).toFixed(1)},${Y(v).toFixed(1)}`; pero = true; }); return d; };
    const svg = `<svg class="ds-vyvoj-svg" viewBox="0 0 ${W} ${H}" role="img" aria-label="Vývoj ukazovateľa ${esc(rad.n)}">
      ${tick.map((t) => `<line x1="${L}" x2="${W - R}" y1="${Y(t).toFixed(1)}" y2="${Y(t).toFixed(1)}" class="ds-mriezka"/><text x="${L - 8}" y="${(Y(t) + 4).toFixed(1)}" class="ds-os" text-anchor="end">${fr(t)}</text>`).join('')}
      ${rad.roky.map((r, j) => (j % krokX === 0 || j === n - 1 ? `<text x="${X(j).toFixed(1)}" y="${H - 14}" class="ds-os" text-anchor="middle">${esc(r)}</text>` : '')).join('')}
      ${ciary.map((c) => `<path d="${cesta(c.h)}" fill="none" stroke="${c.f}" stroke-width="${c.hrubka}" ${c.ciarka ? 'stroke-dasharray="6 5"' : ''} stroke-linejoin="round" stroke-linecap="round"/>
        ${c.h.map((v, j) => (v == null ? '' : `<circle cx="${X(j).toFixed(1)}" cy="${Y(v).toFixed(1)}" r="${n > 20 ? 2.2 : 3.5}" fill="${c.f}"><title>${esc(c.n)}, ${esc(rad.roky[j])}: ${fr(v)}${jed ? ` ${esc(jed)}` : ''}</title></circle>`)).join('')}`).join('')}
    </svg>`;
    const posl = (h: (number | null)[]) => { for (let j = h.length - 1; j >= 0; j--) if (h[j] != null) return [h[j]!, j] as const; return null; };
    const prvy = (h: (number | null)[]) => { for (let j = 0; j < h.length; j++) if (h[j] != null) return [h[j]!, j] as const; return null; };
    const leg = ciary.map((c) => { const a = prvy(c.h), b = posl(c.h); const zm = a && b && a[1] !== b[1] ? b[0] - a[0] : null;
      return `<li><i style="background:${c.f}${c.ciarka ? ';opacity:.7' : ''}"></i><span>${esc(c.n)}</span><b>${b ? fr(b[0]) + (jed ? ` ${esc(jed)}` : '') : '–'}</b>${zm != null ? `<small class="${zm > 0 ? 'hore' : zm < 0 ? 'dole' : ''}">${zm > 0 ? '+' : ''}${fr(zm)} od ${esc(rad.roky[a![1]])}</small>` : ''}</li>`; }).join('');
    el.innerHTML = `<div class="ds-vyvoj-hl"><p class="ds-vyvoj-n">${esc(rad.n)}${idx ? ' – index (prvý rok = 100)' : rad.j ? ` (${esc(rad.j)})` : ''} · ${esc(rad.roky[0])} – ${esc(rad.roky[n - 1])}</p><div class="ds-seg2" role="radiogroup" aria-label="Zobrazenie hodnôt"${mozIdx ? '' : ' hidden'}><button type="button" role="radio" data-vi="" aria-checked="${!idx}">Hodnoty</button><button type="button" role="radio" data-vi="idx" aria-checked="${idx}" title="Každá čiara začína na 100 – vidno, kto rástol rýchlejšie, aj keď sa obce veľkosťou líšia">Zmena (index)</button></div></div><div class="ds-vyvoj-obal">${svg}</div><ul class="ds-vyvoj-leg">${leg}</ul>`
      + (vybraneObce().length ? '' : '<p class="pozn">Tip: v kroku 5 pridajte konkrétne obce – ich vývoj sa ukáže ako ďalšie čiary.</p>');
    el.querySelectorAll<HTMLButtonElement>('[data-vi]').forEach((b) => b.addEventListener('click', () => { S.vi = b.dataset.vi!; kresliVyvoj(vyber()); doAdresy(); }));
    $('ds-zdroj').textContent = `Zdroj: ${rad.z}. Prepočty na obyvateľov podľa počtu obyvateľov v danom roku.${idx ? ' Index: hodnota v prvom roku s údajom = 100.' : ''}`;
  }

  // ---------- Porovnanie obcí ----------
  async function kresliPorovnanie() {
    const el = $('ds-porov');
    const ix = vybraneObce();
    if (!ix.length) { el.innerHTML = '<p class="ds-vyvoj-nic">Pridajte 2 – 5 obcí v kroku <b>5. Porovnať konkrétne obce</b> nad grafom. Uvidíte ich vedľa seba vo všetkých 120 ukazovateľoch.</p>'; return; }
    el.innerHTML = '<p class="pozn">Načítavam všetky ukazovatele…</p>';
    await Promise.all(OBLASTI.map((o) => nacitajOblast(o.id)));
    if (S.v !== 'porovnanie') return;
    const mSK = (k: string) => median(OBCE.map((o) => o.h[k]).filter((v): v is number => v != null && Number.isFinite(v)));
    const hlava = `<tr><th scope="col">Ukazovateľ</th>${ix.map((i, j) => `<th scope="col" class="ds-porov-obec"><i style="background:${FARBY_OBCI[j]}"></i><a href="${OBCE[i].u}">${esc(OBCE[i].n)}</a><small>${esc(OBCE[i].okres)}</small></th>`).join('')}<th scope="col" class="ds-porov-sk">Medián SK</th></tr>`;
    const telo = OBLASTI.map((o) => `<tr class="ds-porov-obl"><th colspan="${ix.length + 2}" scope="colgroup">${esc(o.n)}</th></tr>` + o.polia.map((p) => {
      const v = ix.map((i) => OBCE[i].h[p.k]); const cisla = v.filter((x): x is number => x != null);
      const mx = cisla.length > 1 ? Math.max(...cisla) : null, mn = cisla.length > 1 ? Math.min(...cisla) : null;
      return `<tr class="${p.k === S.u ? 'ds-porov-akt' : ''}"><th scope="row"><button type="button" data-k="${p.k}" title="${esc(p.opis ?? '')}">${esc(p.n)}</button>${p.j && p.j !== 'rok' ? ` <small>${esc(p.j)}</small>` : ''}</th>${v.map((x) => `<td class="${x != null && mx !== mn && x === mx ? 'ds-max' : x != null && mx !== mn && x === mn ? 'ds-min' : ''}">${f(p.k, x, false)}</td>`).join('')}<td class="ds-porov-sk">${f(p.k, mSK(p.k), false)}</td></tr>`;
    }).join('')).join('');
    el.innerHTML = `<p class="pozn">Tučne najvyššia hodnota spomedzi vybraných obcí, kurzívou najnižšia. Kliknutím na ukazovateľ ho zobrazíte v grafe.</p><div class="tabulka-obal"><table class="ob-tab ds-porov-tab"><thead>${hlava}</thead><tbody>${telo}</tbody></table></div>`;
    el.querySelectorAll<HTMLButtonElement>('button[data-k]').forEach((b) => b.addEventListener('click', async () => { S.u = b.dataset.k!; S.v = 'graf'; popisVyberaca('ds-u', S.u); await obnov(); $('studio-vysledok').scrollIntoView({ block: 'start' }); }));
  }

  function kresliMapu(vyb: Obec[]) {
    const s = vyb.filter((o) => o.h[S.u] != null && o.lat);
    const hod = s.map((o) => o.h[S.u]!).sort((a, b) => a - b);
    const hranice = FARBY.slice(1).map((_, i) => hod[Math.floor(((i + 1) * hod.length) / FARBY.length)] ?? Infinity);
    const trieda = (v: number) => { let i = 0; while (i < hranice.length && v >= hranice[i]) i++; return i; };
    const ostatne = OBCE.filter((o) => o.lat && !vyb.includes(o));
    const r = (o: Obec) => Math.min(9, 2.4 + Math.sqrt(o.h.obyv ?? 0) / 45);
    const kruh = (o: Obec, cls: string, fill?: string) => { const [x, y] = bod(o.lon, o.lat); return `<a href="${esc(o.u)}"><circle cx="${x.toFixed(1)}" cy="${y.toFixed(1)}" r="${r(o).toFixed(1)}" class="${cls}"${fill ? ` style="fill:${fill}"` : ''}><title>${esc(o.n)}: ${f(S.u, o.h[S.u])}</title></circle></a>`; };
    $('ds-mapa-body').innerHTML = (S.kraj !== '' || S.okres || Number(S.min) ? ostatne.map((o) => kruh(o, 'ds-mimo')).join('') : '') + [...s].sort((a, b) => r(b) - r(a)).map((o) => kruh(o, 'ds-vnutri', FARBY[trieda(o.h[S.u]!)])).join('');
    if (S.okres || S.kraj !== '') {
      const xy = s.map((o) => bod(o.lon, o.lat));
      if (xy.length) {
        const xa = xy.map((p) => p[0]), ya = xy.map((p) => p[1]);
        const pad = 30, x0 = Math.max(0, Math.min(...xa) - pad), y0 = Math.max(0, Math.min(...ya) - pad);
        const w = Math.min(SIRKA, Math.max(...xa) + pad) - x0, h = Math.min(VYSKA, Math.max(...ya) + pad) - y0;
        const k = Math.max(w / SIRKA, h / VYSKA, 0.18);
        ($('ds-mapa') as unknown as SVGSVGElement).setAttribute('viewBox', `${x0 + w / 2 - (SIRKA * k) / 2} ${y0 + h / 2 - (VYSKA * k) / 2} ${SIRKA * k} ${VYSKA * k}`);
        $('ds-mapa').style.setProperty('--k', String(k));
      }
    } else { ($('ds-mapa') as unknown as SVGSVGElement).setAttribute('viewBox', `0 0 ${SIRKA} ${VYSKA}`); $('ds-mapa').style.setProperty('--k', '1'); }
    const od = [hod[0], ...hranice];
    $('ds-legenda').innerHTML = hod.length ? FARBY.map((c, i) => (od[i] !== undefined && od[i] !== Infinity ? `<span><i style="background:${c}"></i>${f(S.u, od[i], false)}${i === FARBY.length - 1 || hranice[i] === Infinity ? '+' : ''}</span>` : '')).join('') + `<span class="pozn">${pole(S.u).j ? `${esc(pole(S.u).j)} · ` : ''}7 rovnako početných skupín vybraných obcí</span>` : '';
  }

  function kresliTabulku(vyb: Obec[]) {
    const tab = $('ds-tab') as HTMLTableElement;
    const st: [string, string][] = [['n', 'Obec'], ['okres', 'Okres'], ['obyv', 'Obyvatelia'], [S.u, nazov(S.u)]].filter((x, i, a) => a.findIndex((y) => y[0] === x[0]) === i);
    if (!triedenie.k || !st.some(([k]) => k === triedenie.k)) triedenie = { k: S.u, smer: -1 };
    const hod = (o: Obec, k: string) => (k === 'n' ? o.n : k === 'okres' ? o.okres : o.h[k]);
    const r = [...vyb].sort((a, b) => {
      const x = hod(a, triedenie.k), y = hod(b, triedenie.k);
      if (x == null) return 1; if (y == null) return -1;
      return (typeof x === 'string' ? x.localeCompare(String(y), 'sk') : (x as number) - (y as number)) * triedenie.smer;
    });
    tab.tHead!.innerHTML = `<tr>${st.map(([k, n]) => `<th scope="col"${k !== 'n' && k !== 'okres' ? ' class="num"' : ''} aria-sort="${triedenie.k === k ? (triedenie.smer > 0 ? 'ascending' : 'descending') : 'none'}"><button type="button" data-k="${k}">${esc(n)}${triedenie.k === k ? (triedenie.smer > 0 ? ' ▲' : ' ▼') : ''}</button></th>`).join('')}</tr>`;
    const limit = vsetkyRiadky ? r.length : 200;
    tab.tBodies[0].innerHTML = r.slice(0, limit).map((o) => `<tr>${st.map(([k]) => k === 'n' ? `<td><a href="${esc(o.u)}">${esc(o.n)}</a></td>` : k === 'okres' ? `<td>${esc(o.okres)}</td>` : `<td class="num">${f(k, o.h[k], false)}</td>`).join('')}</tr>`).join('');
    $('ds-viac').hidden = r.length <= limit;
    $('ds-viac').textContent = `Zobraziť všetkých ${r.length.toLocaleString('sk-SK')}`;
    tab.tHead!.querySelectorAll<HTMLButtonElement>('button').forEach((b) => b.addEventListener('click', () => {
      triedenie = triedenie.k === b.dataset.k ? { k: b.dataset.k!, smer: -triedenie.smer } : { k: b.dataset.k!, smer: b.dataset.k === 'n' || b.dataset.k === 'okres' ? 1 : -1 };
      kresliTabulku(vyb);
    }));
  }

  // ---------- ovládanie ----------
  const VEL: [string, string][] = [['0', 'Všetky obce'], ['500', 'od 500 obyvateľov'], ['1000', 'od 1 000 obyvateľov'], ['2000', 'od 2 000 obyvateľov'], ['5000', 'od 5 000 obyvateľov'], ['10000', 'od 10 000 obyvateľov'], ['20000', 'od 20 000 obyvateľov']];
  const okresyKraja = (k: string) => [...new Set(OKRESY.filter(([kk]) => k === '' || String(kk) === k).map(([, n]) => n))].sort((a, b) => a.localeCompare(b, 'sk'));
  const menoOkresu = () => OKRESY.find(([, x]) => slug(x) === S.okres)?.[1] ?? '';
  const krajOkresu = (n: string) => String(OKRESY.find(([, x]) => x === n)?.[0] ?? '');
  const tvar = (n: number) => (n === 1 ? 'obec' : n > 1 && n < 5 ? 'obce' : 'obcí');
  function ukazOblastPanel(id: string) {
    document.querySelectorAll<HTMLButtonElement>('.ds-obl button').forEach((b) => b.setAttribute('aria-selected', String(b.dataset.o === id)));
    document.querySelectorAll<HTMLElement>('.ds-ukp').forEach((d) => (d.hidden = d.dataset.o !== id));
    const akt = document.querySelector<HTMLElement>('.ds-obl [aria-selected="true"]'), r = akt?.parentElement;
    if (akt && r && r.scrollWidth > r.clientWidth) r.scrollLeft = akt.offsetLeft - r.offsetLeft - 16;
  }
  function popisVyberaca(_id: string, k: string) {
    const p = pole(k);
    document.querySelectorAll<HTMLButtonElement>('.ds-ukp button').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.k === k)));
    document.querySelectorAll<HTMLButtonElement>('.ds-obl button').forEach((b) => b.classList.toggle('ds-obl-ma', b.dataset.o === p.o.id));
    ukazOblastPanel(p.o.id);
  }
  document.querySelectorAll<HTMLButtonElement>('.ds-obl button').forEach((b) => b.addEventListener('click', () => ukazOblastPanel(b.dataset.o!)));
  document.querySelectorAll<HTMLButtonElement>('.ds-ukp button').forEach((b) => b.addEventListener('click', async () => {
    if (S.u === b.dataset.k) return;
    S.u = b.dataset.k!; vsetkyRiadky = false; triedenie = { k: '', smer: -1 };
    popisVyberaca('ds-u', S.u);
    $('ds-nadpis').textContent = 'Načítavam…';
    await obnov();
  }));
  function nastavFiltre() {
    if (S.okres && S.kraj !== '' && krajOkresu(menoOkresu()) !== S.kraj) S.okres = '';
    const kr = $<HTMLSelectElement>('ds-kraj'), ok = $<HTMLSelectElement>('ds-okres'), mn = $<HTMLSelectElement>('ds-min');
    kr.value = S.kraj;
    ok.innerHTML = `<option value="">${S.kraj === '' ? 'Všetky okresy' : 'Všetky okresy kraja'}</option>` + (S.kraj === ''
      ? KRAJE.map((k, i) => `<optgroup label="${esc(k)}">${okresyKraja(String(i)).map((n) => `<option value="${slug(n)}">${esc(n)}</option>`).join('')}</optgroup>`).join('')
      : okresyKraja(S.kraj).map((n) => `<option value="${slug(n)}">${esc(n)}</option>`).join(''));
    ok.value = S.okres; mn.value = S.min;
    kr.classList.toggle('ds-dd-on', S.kraj !== ''); ok.classList.toggle('ds-dd-on', !!S.okres); mn.classList.toggle('ds-dd-on', S.min !== '0');
  }
  function stitky() {
    const t: [string, () => void][] = [];
    if (S.kraj !== '') t.push([KRAJE[Number(S.kraj)] ?? '', () => { S.kraj = ''; S.okres = ''; }]);
    if (S.okres) t.push([`okres ${menoOkresu()}`, () => { S.okres = ''; }]);
    if (Number(S.min)) t.push([VEL.find((v) => v[0] === S.min)?.[1] ?? '', () => { S.min = '0'; }]);
    $('ds-akt').hidden = !t.length;
    const el = $('ds-stitky');
    el.innerHTML = t.map(([n], i) => `<button type="button" data-i="${i}" aria-label="Zrušiť filter ${esc(n)}">${esc(n)}<i aria-hidden="true">✕</i></button>`).join('') + `<button type="button" class="ds-zrus" data-i="vsetko">Zrušiť všetko</button>`;
    el.querySelectorAll<HTMLButtonElement>('button').forEach((b) => b.addEventListener('click', () => {
      if (b.dataset.i === 'vsetko') { S.kraj = ''; S.okres = ''; S.min = '0'; } else t[Number(b.dataset.i)][1]();
      zmenFilter();
    }));
    const n = vyber().length;
    $('ds-pocet').textContent = n.toLocaleString('sk-SK'); $('ds-pocet-s').textContent = tvar(n);
  }
  function zmenFilter() { vsetkyRiadky = false; nastavFiltre(); obnov(); }
  function nastavOvladanie() {
    popisVyberaca('ds-u', S.u);
    $<HTMLSelectElement>('ds-kraj').innerHTML = '<option value="">Všetky kraje</option>' + KRAJE.map((k, i) => `<option value="${i}">${esc(k)}</option>`).join('');
    $<HTMLSelectElement>('ds-n').value = S.n; $<HTMLSelectElement>('ds-por').value = S.por;
    nastavFiltre();
  }
  $('ds-kraj').addEventListener('change', (e) => { S.kraj = (e.target as HTMLSelectElement).value; S.okres = ''; zmenFilter(); });
  $('ds-okres').addEventListener('change', (e) => { S.okres = (e.target as HTMLSelectElement).value; if (S.okres) S.kraj = krajOkresu(menoOkresu()); zmenFilter(); });
  $('ds-min').addEventListener('change', (e) => { S.min = (e.target as HTMLSelectElement).value; zmenFilter(); });
  $('ds-zobraz').addEventListener('click', () => document.querySelector('.ds-vysledok')?.scrollIntoView({ behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth', block: 'start' }));
  const zmena = (id: string, k: keyof typeof S) => $<HTMLSelectElement>(id).addEventListener('change', (e) => { S[k] = (e.target as HTMLSelectElement).value; vsetkyRiadky = false; obnov(); });
  zmena('ds-n', 'n'); zmena('ds-por', 'por');
  document.querySelectorAll<HTMLButtonElement>('.ds-zalozky button').forEach((b) => b.addEventListener('click', () => { S.v = b.dataset.v!; obnov(); }));
  $('ds-viac').addEventListener('click', () => { vsetkyRiadky = true; kresli(); });

  // ---------- výber ukazovateľa (oblasti + vyhľadávanie) ----------
  const dlg = $<HTMLDialogElement>('dsp'), q = $<HTMLInputElement>('dsp-q');
  const norm = (t: string) => t.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase();
  const ciel = 'u' as const; let oblastDlg = '';
  function ukazOblast(id: string) {
    oblastDlg = id; q.value = '';
    dlg.querySelectorAll<HTMLButtonElement>('.dsp-oblasti button').forEach((b) => b.setAttribute('aria-current', String(b.dataset.o === id)));
    dlg.querySelectorAll<HTMLElement>('.dsp-zoznam section').forEach((s) => { s.hidden = s.dataset.o !== id; s.querySelectorAll('li').forEach((li) => (li.hidden = false)); });
    dlg.querySelector<HTMLElement>('.dsp-nic')!.hidden = true;
    dlg.querySelector<HTMLButtonElement>('.dsp-oblasti button[aria-current="true"]')?.scrollIntoView({ block: 'nearest', inline: 'nearest' });
    $('dsp-zoznam').scrollTop = 0;
  }
  function hladaj() {
    const t = norm(q.value.trim());
    if (!t) { ukazOblast(oblastDlg || pole(S[ciel]).o.id); return; }
    const slova = t.split(/\s+/);
    let n = 0;
    dlg.querySelectorAll<HTMLButtonElement>('.dsp-oblasti button').forEach((b) => b.setAttribute('aria-current', 'false'));
    dlg.querySelectorAll<HTMLElement>('.dsp-zoznam section').forEach((s) => {
      let m = 0;
      s.querySelectorAll<HTMLLIElement>('li').forEach((li) => { const ok = slova.every((w) => li.querySelector('button')!.dataset.t!.includes(w)); li.hidden = !ok; if (ok) m++; });
      s.hidden = m === 0; n += m;
    });
    dlg.querySelector<HTMLElement>('.dsp-nic')!.hidden = n > 0;
  }
  function otvor(c: 'u', oblast?: string) {
    dlg.querySelectorAll<HTMLButtonElement>('.dsp-zoznam button').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.k === S[c])));
    ukazOblast(oblast ?? pole(S[c]).o.id);
    dlg.showModal();
    if (matchMedia('(pointer: fine)').matches) q.focus();
  }
  async function vyberUkazovatel(k: string) {
    S[ciel] = k; vsetkyRiadky = false; triedenie = { k: '', smer: -1 };
    dlg.close();
    popisVyberaca('ds-u', S.u);
    $('ds-nadpis').textContent = 'Načítavam…';
    await obnov();
  }
  $('ds-u').addEventListener('click', () => otvor('u'));
  $('dsp-zavri').addEventListener('click', () => dlg.close());
  dlg.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
  dlg.querySelectorAll<HTMLButtonElement>('.dsp-oblasti button').forEach((b) => b.addEventListener('click', () => ukazOblast(b.dataset.o!)));
  dlg.querySelectorAll<HTMLButtonElement>('.dsp-zoznam button').forEach((b) => b.addEventListener('click', () => vyberUkazovatel(b.dataset.k!)));
  q.addEventListener('input', hladaj);
  q.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') { const prvy = [...dlg.querySelectorAll<HTMLButtonElement>('.dsp-zoznam button')].find((b) => !b.closest('[hidden]')); if (prvy) { e.preventDefault(); vyberUkazovatel(prvy.dataset.k!); } }
    if (e.key === 'ArrowDown') { e.preventDefault(); [...dlg.querySelectorAll<HTMLButtonElement>('.dsp-zoznam button')].find((b) => !b.closest('[hidden]'))?.focus(); }
  });
  $('dsp-zoznam').addEventListener('keydown', (e) => {
    if (e.key !== 'ArrowDown' && e.key !== 'ArrowUp') return;
    const vid = [...dlg.querySelectorAll<HTMLButtonElement>('.dsp-zoznam button')].filter((b) => !b.closest('[hidden]'));
    const i = vid.indexOf(document.activeElement as HTMLButtonElement);
    if (i < 0) return;
    e.preventDefault();
    if (e.key === 'ArrowUp' && i === 0) q.focus(); else vid[Math.max(0, Math.min(vid.length - 1, i + (e.key === 'ArrowDown' ? 1 : -1)))].focus();
  });

  $('ds-csv').addEventListener('click', async (e) => {
    const tl = e.currentTarget as HTMLButtonElement, txt = tl.textContent;
    tl.textContent = 'Pripravujem…';
    await Promise.all(OBLASTI.map((o) => nacitajOblast(o.id)));
    tl.textContent = txt;
    const vyb = vyber();
    const kl = OBLASTI.flatMap((o) => o.polia.map((p) => p.k));
    const cis = (k: string, v: number | null) => (v == null ? '' : v.toLocaleString('sk-SK', { useGrouping: false, maximumFractionDigits: 3 }));
    const riadky = [['kod_obce', 'obec', 'okres', 'kraj', ...kl.map((k) => `${pole(k).o.n}: ${nazov(k)}`)].map((x) => (/[;"\n]/.test(x) ? `"${x.replace(/"/g, '""')}"` : x)).join(';'),
      ...vyb.map((o) => [o.kod, o.n, o.okres, KRAJE[o.kraj] ?? '', ...kl.map((k) => cis(k, o.h[k]))].map((x) => (/[;"\n]/.test(x) ? `"${x.replace(/"/g, '""')}"` : x)).join(';'))];
    const a = document.createElement('a');
    a.href = URL.createObjectURL(new Blob(['﻿' + riadky.join('\r\n')], { type: 'text/csv;charset=utf-8' }));
    a.download = `mestovcislach-${slug(popisVyberu(vyb.length).split(' · ')[0]) || 'obce'}.csv`;
    document.body.append(a); a.click(); setTimeout(() => { URL.revokeObjectURL(a.href); a.remove(); }, 1000);
  });
  $('ds-odkaz').addEventListener('click', async (e) => {
    const b = e.currentTarget as HTMLButtonElement;
    try { await navigator.clipboard.writeText(location.href); b.textContent = 'Odkaz skopírovaný ✓'; } catch { prompt('Odkaz na tento pohľad:', location.href); }
    setTimeout(() => (b.textContent = 'Kopírovať odkaz na tento pohľad'), 2500);
  });

  // ---------- načítanie ----------
  zAdresy();
  fetch('/data/studio/obce.json').then((r) => r.json()).then(async (d: D) => {
    OBLASTI = d.oblasti;
    for (const o of OBLASTI) for (const p of o.polia) POLE.set(p.k, { ...p, o });
    KRAJE = d.kraje;
    const okr = new Map<string, number>();
    OBCE = d.obce.map((r) => {
      okr.set(String(r[2]), Number(r[3]));
      return { kod: String(r[0]), n: String(r[1]), okres: String(r[2]), kraj: Number(r[3]), u: String(r[4]), h: { obyv: typeof r[5] === 'number' ? r[5] : null }, lat: Number(r[6]) || 0, lon: Number(r[7]) || 0 };
    });
    OKRESY = [...okr].map(([n, k]) => [k, n]);
    if (!POLE.has(S.u)) S.u = 'nez';
    nastavOvladanie();
    await obnov();
  }).catch(() => { $('ds-pocet').textContent = 'Údaje sa nepodarilo načítať. Skúste obnoviť stránku.'; });
</script>

