---
// Dátové štúdio: vlastný pohľad na ukazovatele všetkých obcí – graf, bodový graf, mapa, tabuľka; filter kraj / okres /
// veľkosť; stiahnutie CSV, odkaz na pohľad (stav v adrese), vloženie na iný web (/vlozit/datove-studio?g=studio-vysledok&…).
// Ukazovatele sú rozdelené do tematických oblastí (src/lib/studio-ukazovatele.ts); hodnoty sa načítajú po oblastiach
// z /data/studio/<oblast>.json až keď ich treba – žiadne súbory na obec.
import Base from '../layouts/Base.astro';
import { krajeMapy, SIRKA, VYSKA } from '../lib/obce';
import { OBLASTI, VSETKY_POLIA } from '../lib/studio-ukazovatele';
import '../styles/stranka.css';
import '../styles/obce.css';
const kraje = krajeMapy();
const norm = (t: string) => t.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase();
// slová, pod ktorými ľudia ukazovateľ hľadajú (vyhľadávanie vo výbere)
const TAGY: Record<string, string> = {
  obyv: 'pocet ludi velkost', z10: 'rast pokles vymieranie', z93: 'rast pokles', hus: 'zahustenie', star: 'starnutie seniori dochodcovia', nar: 'porodnost deti', zom: 'umrtnost',
  mig: 'stahovanie migracia pristahovali odstahovali', cudz: 'cudzinci ukrajinci', vs: 'vysoka skola univerzita vzdelani', zakl: 'nevzdelani', narine: 'madari romovia mensiny narodnostne mensiny',
  rkc: 'katolici cirkev nabozenstvo viera', bezv: 'ateisti nabozenstvo', nez: 'praca nezamestnani', uoz: 'nezamestnani pracu hladaju', firmy: 'podniky spolocnosti sro', zivn: 'szco podnikatelia',
  vyd: 'rozpocet vydavky', inv: 'investicie stavby', dan: 'dane dan z nehnutelnosti podielove dane prijmy', trans: 'dotacie od statu', zav: 'dlhy dlh zadlzenie', uver: 'dlh zadlzenie pozicky',
  hot: 'rezervy hotovost peniaze', zml: 'crz zmluvy', nfp: 'eurofondy eu fondy dotacie', m2: 'velkost bytu', najom: 'najomne byvanie', kanal: 'kanalizacia splasky', zumpa: 'septik',
  plyn: 'plynofikacia', pevne: 'drevo uhlie smog', voda: 'vodovod spotreba', ms: 'skolky skolka materska', zs: 'skola zakladna', ziaci: 'deti skola', vseob: 'lekar obvodny lekari zdravie',
  zubar: 'zubar zubari stomatolog', lekarne: 'lieky lekaren', potr: 'obchod potraviny supermarket', jedlo: 'restauracie krcmy kaviarne', ihr: 'ihrisko deti', sport: 'sportovisko ihrisko futbal',
  zast: 'autobus mhd doprava', nabij: 'elektromobil nabijacky', vlaky: 'vlak zeleznica stanica', cyklo: 'bicykel cyklisti', turist: 'turistika vylety', les: 'lesy priroda',
  vin: 'vino vinohrady', zosuv: 'zosuvy geologia', pam: 'pamiatky hrady kostoly', zmienka: 'historia vznik', tep: 'teplota pocasie', zr: 'dazd pocasie', trop: 'horucavy leto',
  snez: 'sneh zima', mraz: 'zima', pm10: 'smog prach ovzdusie znecistenie', pm25: 'smog prach ovzdusie', no2: 'doprava ovzdusie znecistenie', tri: 'triedenie recyklacia',
  kg: 'smeti odpad', kgz: 'smeti', bio: 'kompost bioodpad', uc: 'volby ucast komunalne', kand: 'kandidati starosta', lozka: 'hotely penziony ubytovanie turisti', vyuz: 'obsadenost hotely',
};
const hladajText = (p: { k: string; n: string; j: string }, o: { n: string }) => norm(`${p.n} ${p.j} ${o.n} ${TAGY[p.k] ?? ''}`);
---
<Base title="Dátové štúdio – ukazovatele obcí Slovenska po svojom – mestovcislach.sk" description="Vyberte ukazovatele (nezamestnanosť, vek, vzdelanie, rozpočet, odpad, klíma…) a obce podľa kraja, okresu a veľkosti. Graf, bodový graf, mapa aj tabuľka – na stiahnutie, zdieľanie a vloženie na web.">
  <section class="hero">
    <p class="kicker">Dátové štúdio</p>
    <h1>Čísla obcí po svojom</h1>
    <p class="lead">{VSETKY_POLIA.length} ukazovateľov v {OBLASTI.length} oblastiach pre všetky obce a mestá Slovenska. Vyberte, čo chcete vidieť a pre ktoré obce – a pozrite sa na to ako na graf, mapu alebo tabuľku. Pohľad sa dá stiahnuť, poslať odkazom alebo vložiť na vlastný web.</p>
  </section>

  <div class="ds" id="ds">
    <aside class="ds-panel" aria-label="Nastavenie pohľadu">
      <section class="card ds-krok">
        <h2><span>1</span>Ukazovatele</h2>
        <div class="ds-pole">
          <span>Hlavný ukazovateľ</span>
          <button type="button" class="ds-vyber" id="ds-u" data-ciel="u" aria-haspopup="dialog"><small>Práca a podnikanie</small><b>Miera nezamestnanosti</b></button>
        </div>
        <button type="button" class="ds-vymen" id="ds-vymen" title="Vymeniť ukazovatele">⇅ vymeniť</button>
        <div class="ds-pole">
          <span>Porovnať s (bodový graf a tabuľka)</span>
          <button type="button" class="ds-vyber" id="ds-u2" data-ciel="u2" aria-haspopup="dialog"><small>Obyvatelia</small><b>Priemerný vek</b></button>
        </div>
        <div class="ds-rychle" aria-label="Rýchly výber oblasti">
          {OBLASTI.map((o) => <button type="button" data-o={o.id}>{o.n}</button>)}
        </div>
      </section>

      <section class="card ds-krok">
        <h2><span>2</span>Ktoré obce</h2>
        <label class="ds-pole">Kraj
          <select id="ds-kraj"><option value="">Celé Slovensko</option></select>
        </label>
        <label class="ds-pole">Okres
          <select id="ds-okres"><option value="">Všetky okresy</option></select>
        </label>
        <label class="ds-pole">Veľkosť obce
          <select id="ds-min">
            <option value="0">všetky obce</option>
            <option value="500">od 500 obyvateľov</option>
            <option value="1000">od 1 000 obyvateľov</option>
            <option value="2000">od 2 000 obyvateľov</option>
            <option value="5000">od 5 000 obyvateľov</option>
            <option value="10000">od 10 000 obyvateľov</option>
            <option value="20000">od 20 000 obyvateľov</option>
          </select>
        </label>
        <p class="ds-pocet" id="ds-pocet" aria-live="polite">Načítavam údaje…</p>
      </section>

      <section class="card ds-krok">
        <h2><span>3</span>Uložiť a zdieľať</h2>
        <div class="ds-akcie">
          <button type="button" class="ds-hlavne" id="ds-csv">Stiahnuť tento výber (CSV)</button>
          <button type="button" id="ds-odkaz">Kopírovať odkaz na tento pohľad</button>
          <button type="button" data-vlozit-otvor="studio-vysledok">Vložiť na vlastný web</button>
          <a class="ds-tl" href="/data/obce-ukazovatele.csv" download>Všetky obce a ukazovatele (CSV)</a>
        </div>
        <details class="ds-pbi">
          <summary>Power BI, Excel, Google Tabuľky</summary>
          <p>Celý súbor má stálu adresu a obnovuje sa so zberom dát:</p>
          <code>https://mestovcislach.sk/data/obce-ukazovatele.csv</code>
          <p><b>Power BI:</b> Získať údaje → Web → vložte adresu. <b>Excel:</b> Údaje → Z webu. <b>Google Tabuľky:</b> <code>=IMPORTDATA("…")</code>. Oddeľovač je bodkočiarka, desatinná čiarka, kódovanie UTF-8.</p>
        </details>
      </section>
    </aside>

    <section class="ds-vysledok" aria-label="Výsledok">
      <div class="ds-zalozky" role="tablist" aria-label="Zobrazenie">
        <button type="button" role="tab" data-v="graf" aria-selected="true">Graf</button>
        <button type="button" role="tab" data-v="body" aria-selected="false">Bodový graf</button>
        <button type="button" role="tab" data-v="mapa" aria-selected="false">Mapa</button>
        <button type="button" role="tab" data-v="tabulka" aria-selected="false">Tabuľka</button>
      </div>

      <section class="card ds-karta" id="studio-vysledok" data-vlozit-karta data-vlozit-vlastne data-vyska="760">
        <div class="ds-hlava">
          <h2 id="ds-nadpis">Dátové štúdio</h2>
          <p class="ds-podnadpis" id="ds-podnadpis"></p>
        </div>
        <div class="ds-suhrn" id="ds-suhrn"></div>

        <div class="ds-pohlad" data-pohlad="graf">
          <div class="ds-volby">
            <label>Zobraziť <select id="ds-n"><option value="15">15</option><option value="25" selected>25</option><option value="50">50</option><option value="100">100</option></select></label>
            <label>Poradie <select id="ds-por"><option value="desc">od najvyššej hodnoty</option><option value="asc">od najnižšej hodnoty</option></select></label>
          </div>
          <div class="ds-stlpce" id="ds-stlpce"></div>
        </div>

        <div class="ds-pohlad" data-pohlad="body" hidden>
          <div class="ds-body-obal"><svg id="ds-svg" viewBox="0 0 800 520" role="img" aria-label="Bodový graf vybraných obcí"></svg></div>
          <p class="pozn">Každý bod je obec (väčší bod = viac obyvateľov). Čiarkované čiary sú mediány Slovenska. Kliknutím na bod otvoríte obec.</p>
        </div>

        <div class="ds-pohlad" data-pohlad="mapa" hidden>
          <svg class="ds-mapa" id="ds-mapa" viewBox={`0 0 ${SIRKA} ${VYSKA}`} role="img" aria-label="Mapa vybraných obcí podľa hlavného ukazovateľa">
            <g class="ds-kraje">{kraje.map((k) => <path d={k.d}><title>{k.nazov}</title></path>)}</g>
            <g id="ds-mapa-body"></g>
          </svg>
          <div class="ds-legenda" id="ds-legenda"></div>
        </div>

        <div class="ds-pohlad" data-pohlad="tabulka" hidden>
          <div class="tabulka-obal"><table class="ob-tab ds-tab" id="ds-tab"><thead></thead><tbody></tbody></table></div>
          <button type="button" class="ds-viac" id="ds-viac" hidden>Zobraziť všetky</button>
        </div>
        <p class="zdroj" id="ds-zdroj"></p>
      </section>
    </section>
  </div>

  <dialog class="dsp" id="dsp" aria-labelledby="dsp-nadpis">
    <div class="dsp-hlava">
      <h2 id="dsp-nadpis">Vyberte hlavný ukazovateľ</h2>
      <button type="button" class="dsp-zavri" id="dsp-zavri" aria-label="Zavrieť">✕</button>
    </div>
    <div class="dsp-hladaj">
      <input type="search" id="dsp-q" placeholder="Hľadať… napr. dane, lesy, škôlky, smog" autocomplete="off" aria-label="Hľadať ukazovateľ" />
    </div>
    <div class="dsp-telo">
      <nav class="dsp-oblasti" aria-label="Oblasti">
        {OBLASTI.map((o) => <button type="button" data-o={o.id}><b>{o.n}</b><small>{o.popis}</small><i>{o.polia.length}</i></button>)}
      </nav>
      <div class="dsp-zoznam" id="dsp-zoznam">
        {OBLASTI.map((o) => (
          <section data-o={o.id}>
            <h3>{o.n}</h3>
            <ul>{o.polia.map((p) => <li><button type="button" data-k={p.k} data-t={hladajText(p, o)}><span>{p.n}</span><small>{p.j ? `${p.j} · ` : ''}{p.z}</small></button></li>)}</ul>
          </section>
        ))}
        <p class="dsp-nic" hidden>Nič sa nenašlo. Skúste iné slovo alebo vyberte oblasť vľavo.</p>
      </div>
    </div>
  </dialog>
</Base>

<script>
  type Pole = { k: string; n: string; j: string; d: number; z: string; p?: string; pocet: number };
  type Oblast = { id: string; n: string; popis: string; polia: Pole[] };
  type D = { kraje: string[]; oblasti: Oblast[]; obce: (string | number | null)[][] };
  type Obec = { kod: string; n: string; okres: string; u: string; kraj: number; h: Record<string, number | null>; lat: number; lon: number };
  const $ = <T extends HTMLElement = HTMLElement>(id: string) => document.getElementById(id) as T;
  const esc = (t: string) => t.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);
  const slug = (s: string) => s.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
  const vlozene = document.documentElement.hasAttribute('data-vlozit');
  // projekcia rovnaká ako src/lib/obce.ts (bod)
  const LON0 = 16.8, LON1 = 22.6, LAT0 = 47.7, LAT1 = 49.65, KX = Math.cos((48.7 * Math.PI) / 180);
  const SIRKA = 1000, VYSKA = Math.round((SIRKA * (LAT1 - LAT0)) / ((LON1 - LON0) * KX));
  const bod = (lon: number, lat: number) => [((lon - LON0) / (LON1 - LON0)) * SIRKA, ((LAT1 - lat) / (LAT1 - LAT0)) * VYSKA];
  const FARBY = ['#fde4e7', '#f9bcc4', '#f2909e', '#e6607a', '#d63a5a', '#b81e42', '#8c0f2f'];
  let OBLASTI: Oblast[] = [], POLE = new Map<string, Pole & { o: Oblast }>(), OBCE: Obec[] = [], KRAJE: string[] = [], OKRESY: [number, string][] = [];
  const nacitane = new Map<string, Promise<void>>();
  const S = { u: 'nez', u2: 'vek', kraj: '', okres: '', min: '0', v: 'graf', n: '25', por: 'desc' };
  let vsetkyRiadky = false, triedenie: { k: string; smer: number } = { k: '', smer: -1 };

  const pole = (k: string) => POLE.get(k) ?? ({ k, n: k, j: '', d: 1, z: '', pocet: 0, o: { id: '', n: '', popis: '', polia: [] } } as Pole & { o: Oblast });
  const nazov = (k: string) => { const p = pole(k); return `${p.n}${p.j ? ` (${p.j})` : ''}`; };
  const f = (k: string, v: number | null | undefined, sJednotkou = true) => {
    if (v == null || !Number.isFinite(v)) return '–';
    const { j, d } = pole(k);
    const t = v.toLocaleString('sk-SK', { maximumFractionDigits: d, minimumFractionDigits: d, useGrouping: !(j === 'rok') });
    return t + (sJednotkou && j && j !== 'rok' ? (j === '%' ? ' %' : ` ${j}`) : '');
  };
  // hodnoty oblasti sa načítajú až pri prvom použití
  function nacitajOblast(id: string) {
    if (!nacitane.has(id)) nacitane.set(id, fetch(`/data/studio/${id}.json`).then((r) => r.json()).then((d: { h: Record<string, (number | null)[]> }) => {
      for (const [k, arr] of Object.entries(d.h)) arr.forEach((v, i) => { if (OBCE[i]) OBCE[i].h[k] = v; });
    }));
    return nacitane.get(id)!;
  }
  const zabezpec = (...kl: string[]) => Promise.all(kl.map((k) => nacitajOblast(pole(k).o.id)));
  async function obnov() { await zabezpec(S.u, S.u2); kresli(); }
  const median = (a: number[]) => { if (!a.length) return NaN; const s = [...a].sort((x, y) => x - y); const m = s.length >> 1; return s.length % 2 ? s[m] : (s[m - 1] + s[m]) / 2; };

  // ---------- stav v adrese ----------
  function zAdresy() {
    const q = new URLSearchParams(location.search);
    for (const k of Object.keys(S) as (keyof typeof S)[]) { const v = q.get(k); if (v != null) S[k] = v; }
  }
  const PRED: typeof S = { ...S };
  function dotaz() {
    const q = new URLSearchParams();
    for (const k of Object.keys(S) as (keyof typeof S)[]) if (S[k] !== PRED[k]) q.set(k, S[k]);
    return q.toString() ? `?${q}` : '';
  }
  function doAdresy() {
    if (!vlozene) history.replaceState(null, '', `${location.pathname}${dotaz()}`);
  }

  // ---------- výber ----------
  function vyber(): Obec[] {
    const min = Number(S.min) || 0;
    return OBCE.filter((o) => (S.kraj === '' || String(o.kraj) === S.kraj) && (S.okres === '' || slug(o.okres) === S.okres) && (o.h.obyv ?? 0) >= min);
  }
  function popisVyberu(n: number) {
    const kde = S.okres ? `okres ${OKRESY.find(([, x]) => slug(x) === S.okres)?.[1] ?? ''}` : S.kraj !== '' ? KRAJE[Number(S.kraj)] : 'Slovensko';
    const vel = Number(S.min) ? ` · obce od ${Number(S.min).toLocaleString('sk-SK')} obyvateľov` : '';
    return `${kde}${vel} · ${n.toLocaleString('sk-SK')} ${n === 1 ? 'obec' : n < 5 ? 'obce' : 'obcí'}`;
  }

  // ---------- kreslenie ----------
  function kresli() {
    const vyb = vyber();
    const pU = pole(S.u);
    $('ds-nadpis').textContent = pU.n;
    $('ds-podnadpis').textContent = popisVyberu(vyb.length);
    $('ds-pocet').textContent = `Vybraných: ${popisVyberu(vyb.length).split(' · ').pop()}`;
    const hodn = vyb.map((o) => o.h[S.u]).filter((v): v is number => v != null && Number.isFinite(v));
    const mSK = median(OBCE.map((o) => o.h[S.u]).filter((v): v is number => v != null && Number.isFinite(v)));
    const mV = median(hodn);
    const naj = vyb.filter((o) => o.h[S.u] != null).sort((a, b) => (b.h[S.u]! - a.h[S.u]!));
    $('ds-suhrn').innerHTML = hodn.length ? [
      ['Medián výberu', f(S.u, mV)],
      ['Medián Slovenska', f(S.u, mSK)],
      ['Najviac', `${f(S.u, naj[0]?.h[S.u])} <small>${esc(naj[0]?.n ?? '')}</small>`],
      ['Najmenej', `${f(S.u, naj.at(-1)?.h[S.u])} <small>${esc(naj.at(-1)?.n ?? '')}</small>`],
    ].map(([a, b]) => `<div><span>${a}</span><b>${b}</b></div>`).join('') : '<p class="pozn">Pre tento výber nie sú údaje.</p>';
    document.querySelectorAll<HTMLElement>('.ds-pohlad').forEach((p) => (p.hidden = p.dataset.pohlad !== S.v));
    document.querySelectorAll<HTMLButtonElement>('.ds-zalozky button').forEach((b) => b.setAttribute('aria-selected', String(b.dataset.v === S.v)));
    if (S.v === 'graf') kresliStlpce(vyb, mSK);
    else if (S.v === 'body') kresliBody(vyb);
    else if (S.v === 'mapa') kresliMapu(vyb);
    else kresliTabulku(vyb);
    const bez = vyb.length - hodn.length;
    const kl = S.v === 'body' || S.v === 'tabulka' ? [...new Set([S.u, S.u2])] : [S.u];
    const zdroje = 'Zdroj: ' + kl.map((k) => { const p = pole(k); return `${esc(p.n)} – ${esc(p.z)}${p.p ? ` (${esc(p.p)})` : ''}`; }).join('; ') + '.' + (bez > 0 ? ` Bez údaja: ${bez.toLocaleString('sk-SK')} z ${vyb.length.toLocaleString('sk-SK')} vybraných obcí.` : '');
    $('ds-zdroj').innerHTML = `${zdroje}${vlozene ? ` <a href="https://mestovcislach.sk/datove-studio/${dotaz()}" target="_blank" rel="noopener">Otvoriť v Dátovom štúdiu</a>` : ''}`;
    doAdresy();
  }

  function kresliStlpce(vyb: Obec[], mSK: number) {
    const s = vyb.filter((o) => o.h[S.u] != null).sort((a, b) => (S.por === 'asc' ? a.h[S.u]! - b.h[S.u]! : b.h[S.u]! - a.h[S.u]!)).slice(0, Number(S.n));
    if (!s.length) { $('ds-stlpce').innerHTML = '<p class="pozn">Žiadne údaje.</p>'; return; }
    const vals = s.map((o) => o.h[S.u]!);
    const lo = Math.min(0, ...vals, Number.isFinite(mSK) ? mSK : 0), hi = Math.max(...vals, Number.isFinite(mSK) ? mSK : 0);
    const roz = hi - lo || 1;
    const x = (v: number) => ((v - lo) / roz) * 100;
    const nula = x(0), ciara = Number.isFinite(mSK) ? x(mSK) : -1;
    $('ds-stlpce').innerHTML = s.map((o) => {
      const v = o.h[S.u]!, a = Math.min(x(v), nula), w = Math.abs(x(v) - nula);
      return `<a class="ds-riadok" href="${esc(o.u)}"><span class="ds-meno">${esc(o.n)}<small>${esc(o.okres)}</small></span><span class="ds-pas"><span class="ds-hodnota" style="left:${a.toFixed(2)}%;width:${Math.max(0.4, w).toFixed(2)}%"></span>${ciara >= 0 ? `<span class="ds-median" style="left:${ciara.toFixed(2)}%"></span>` : ''}</span><b>${f(S.u, v)}</b></a>`;
    }).join('') + (ciara >= 0 ? `<p class="ds-legenda-ciara"><span></span>Medián Slovenska ${f(S.u, mSK)}</p>` : '');
  }

  function kresliBody(vyb: Obec[]) {
    const svg = $('ds-svg') as unknown as SVGSVGElement;
    const W = 800, H = 520, L = 64, R = 20, T = 20, B = 52;
    const b = vyb.filter((o) => o.h[S.u2] != null && o.h[S.u] != null);
    if (!b.length) { svg.innerHTML = `<text x="${W / 2}" y="${H / 2}" text-anchor="middle" class="ds-osi">Žiadne údaje</text>`; return; }
    const xs = b.map((o) => o.h[S.u2]!), ys = b.map((o) => o.h[S.u]!);
    const rozsah = (a: number[]) => { let lo = Math.min(...a), hi = Math.max(...a); if (lo === hi) { lo -= 1; hi += 1; } const p = (hi - lo) * 0.06; return [lo - p, hi + p]; };
    const [x0, x1] = rozsah(xs), [y0, y1] = rozsah(ys);
    const X = (v: number) => L + ((v - x0) / (x1 - x0)) * (W - L - R), Y = (v: number) => H - B - ((v - y0) / (y1 - y0)) * (H - T - B);
    const tik = (a: number, z: number) => { const k = (z - a) / 5; const p = 10 ** Math.floor(Math.log10(k)); const kr = [1, 2, 2.5, 5, 10].map((m) => m * p).find((m) => m >= k) ?? k; const out = []; for (let v = Math.ceil(a / kr) * kr; v <= z; v += kr) out.push(+v.toFixed(6)); return out; };
    const mx = median(OBCE.map((o) => o.h[S.u2]).filter((v): v is number => v != null)), my = median(OBCE.map((o) => o.h[S.u]).filter((v): v is number => v != null));
    const veľ = (o: Obec) => Math.max(3, Math.min(16, Math.sqrt(o.h.obyv ?? 0) / 14));
    let h = '';
    for (const v of tik(y0, y1)) h += `<line x1="${L}" x2="${W - R}" y1="${Y(v)}" y2="${Y(v)}" class="ds-mriezka"/><text x="${L - 8}" y="${Y(v) + 4}" text-anchor="end" class="ds-osi">${f(S.u, v, false)}</text>`;
    for (const v of tik(x0, x1)) h += `<text x="${X(v)}" y="${H - B + 18}" text-anchor="middle" class="ds-osi">${f(S.u2, v, false)}</text>`;
    if (mx >= x0 && mx <= x1) h += `<line x1="${X(mx)}" x2="${X(mx)}" y1="${T}" y2="${H - B}" class="ds-med"/>`;
    if (my >= y0 && my <= y1) h += `<line x1="${L}" x2="${W - R}" y1="${Y(my)}" y2="${Y(my)}" class="ds-med"/>`;
    h += `<text x="${(L + W - R) / 2}" y="${H - 10}" text-anchor="middle" class="ds-os-nazov">${esc(nazov(S.u2))}</text>`;
    h += `<text transform="translate(16 ${(T + H - B) / 2}) rotate(-90)" text-anchor="middle" class="ds-os-nazov">${esc(nazov(S.u))}</text>`;
    const zor = [...b].sort((a, c) => (c.h.obyv ?? 0) - (a.h.obyv ?? 0));
    h += zor.map((o) => `<a href="${esc(o.u)}"><circle cx="${X(o.h[S.u2]!).toFixed(1)}" cy="${Y(o.h[S.u]!).toFixed(1)}" r="${veľ(o).toFixed(1)}" class="ds-bod"><title>${esc(o.n)} (${esc(o.okres)}): ${esc(pole(S.u).n)} ${f(S.u, o.h[S.u])}, ${esc(pole(S.u2).n)} ${f(S.u2, o.h[S.u2])}</title></circle></a>`).join('');
    // menovky najväčších obcí (najviac 12)
    if (zor.length <= 60) h += zor.slice(0, 12).map((o) => { const x = X(o.h[S.u2]!), vl = x > W - 160; return `<text x="${(vl ? x - veľ(o) - 3 : x + veľ(o) + 3).toFixed(1)}" y="${(Y(o.h[S.u]!) + 4).toFixed(1)}" class="ds-menovka"${vl ? ' text-anchor="end"' : ''}>${esc(o.n)}</text>`; }).join('');
    svg.innerHTML = h;
  }

  function kresliMapu(vyb: Obec[]) {
    const s = vyb.filter((o) => o.h[S.u] != null && o.lat);
    const hod = s.map((o) => o.h[S.u]!).sort((a, b) => a - b);
    const hranice = FARBY.slice(1).map((_, i) => hod[Math.floor(((i + 1) * hod.length) / FARBY.length)] ?? Infinity);
    const trieda = (v: number) => { let i = 0; while (i < hranice.length && v >= hranice[i]) i++; return i; };
    const ostatne = OBCE.filter((o) => o.lat && !vyb.includes(o));
    const r = (o: Obec) => Math.min(9, 2.4 + Math.sqrt(o.h.obyv ?? 0) / 45);
    const kruh = (o: Obec, cls: string, fill?: string) => { const [x, y] = bod(o.lon, o.lat); return `<a href="${esc(o.u)}"><circle cx="${x.toFixed(1)}" cy="${y.toFixed(1)}" r="${r(o).toFixed(1)}" class="${cls}"${fill ? ` style="fill:${fill}"` : ''}><title>${esc(o.n)}: ${f(S.u, o.h[S.u])}</title></circle></a>`; };
    $('ds-mapa-body').innerHTML = (S.kraj !== '' || S.okres || Number(S.min) ? ostatne.map((o) => kruh(o, 'ds-mimo')).join('') : '') + [...s].sort((a, b) => r(b) - r(a)).map((o) => kruh(o, 'ds-vnutri', FARBY[trieda(o.h[S.u]!)])).join('');
    if (S.okres || S.kraj !== '') {
      const xy = s.map((o) => bod(o.lon, o.lat));
      if (xy.length) {
        const xa = xy.map((p) => p[0]), ya = xy.map((p) => p[1]);
        const pad = 30, x0 = Math.max(0, Math.min(...xa) - pad), y0 = Math.max(0, Math.min(...ya) - pad);
        const w = Math.min(SIRKA, Math.max(...xa) + pad) - x0, h = Math.min(VYSKA, Math.max(...ya) + pad) - y0;
        const k = Math.max(w / SIRKA, h / VYSKA, 0.18);
        ($('ds-mapa') as unknown as SVGSVGElement).setAttribute('viewBox', `${x0 + w / 2 - (SIRKA * k) / 2} ${y0 + h / 2 - (VYSKA * k) / 2} ${SIRKA * k} ${VYSKA * k}`);
        $('ds-mapa').style.setProperty('--k', String(k));
      }
    } else { ($('ds-mapa') as unknown as SVGSVGElement).setAttribute('viewBox', `0 0 ${SIRKA} ${VYSKA}`); $('ds-mapa').style.setProperty('--k', '1'); }
    const od = [hod[0], ...hranice];
    $('ds-legenda').innerHTML = hod.length ? FARBY.map((c, i) => (od[i] !== undefined && od[i] !== Infinity ? `<span><i style="background:${c}"></i>${f(S.u, od[i], false)}${i === FARBY.length - 1 || hranice[i] === Infinity ? '+' : ''}</span>` : '')).join('') + `<span class="pozn">${pole(S.u).j ? `${esc(pole(S.u).j)} · ` : ''}7 rovnako početných skupín vybraných obcí</span>` : '';
  }

  function kresliTabulku(vyb: Obec[]) {
    const tab = $('ds-tab') as HTMLTableElement;
    const st: [string, string][] = [['n', 'Obec'], ['okres', 'Okres'], ['obyv', 'Obyvatelia'], [S.u, nazov(S.u)], ...(S.u2 !== S.u && S.u2 !== 'obyv' ? [[S.u2, nazov(S.u2)] as [string, string]] : [])].filter((x, i, a) => a.findIndex((y) => y[0] === x[0]) === i);
    if (!triedenie.k || !st.some(([k]) => k === triedenie.k)) triedenie = { k: S.u, smer: -1 };
    const hod = (o: Obec, k: string) => (k === 'n' ? o.n : k === 'okres' ? o.okres : o.h[k]);
    const r = [...vyb].sort((a, b) => {
      const x = hod(a, triedenie.k), y = hod(b, triedenie.k);
      if (x == null) return 1; if (y == null) return -1;
      return (typeof x === 'string' ? x.localeCompare(String(y), 'sk') : (x as number) - (y as number)) * triedenie.smer;
    });
    tab.tHead!.innerHTML = `<tr>${st.map(([k, n]) => `<th scope="col"${k !== 'n' && k !== 'okres' ? ' class="num"' : ''} aria-sort="${triedenie.k === k ? (triedenie.smer > 0 ? 'ascending' : 'descending') : 'none'}"><button type="button" data-k="${k}">${esc(n)}${triedenie.k === k ? (triedenie.smer > 0 ? ' ▲' : ' ▼') : ''}</button></th>`).join('')}</tr>`;
    const limit = vsetkyRiadky ? r.length : 200;
    tab.tBodies[0].innerHTML = r.slice(0, limit).map((o) => `<tr>${st.map(([k]) => k === 'n' ? `<td><a href="${esc(o.u)}">${esc(o.n)}</a></td>` : k === 'okres' ? `<td>${esc(o.okres)}</td>` : `<td class="num">${f(k, o.h[k], false)}</td>`).join('')}</tr>`).join('');
    $('ds-viac').hidden = r.length <= limit;
    $('ds-viac').textContent = `Zobraziť všetkých ${r.length.toLocaleString('sk-SK')}`;
    tab.tHead!.querySelectorAll<HTMLButtonElement>('button').forEach((b) => b.addEventListener('click', () => {
      triedenie = triedenie.k === b.dataset.k ? { k: b.dataset.k!, smer: -triedenie.smer } : { k: b.dataset.k!, smer: b.dataset.k === 'n' || b.dataset.k === 'okres' ? 1 : -1 };
      kresliTabulku(vyb);
    }));
  }

  // ---------- ovládanie ----------
  function naplnOkresy() {
    const sel = $<HTMLSelectElement>('ds-okres');
    const ok = OKRESY.filter(([k]) => S.kraj === '' || String(k) === S.kraj).map(([, n]) => n).sort((a, b) => a.localeCompare(b, 'sk'));
    sel.innerHTML = `<option value="">Všetky okresy</option>` + [...new Set(ok)].map((n) => `<option value="${slug(n)}">${esc(n)}</option>`).join('');
    if (S.okres && !ok.some((n) => slug(n) === S.okres)) S.okres = '';
    sel.value = S.okres;
  }
  function popisVyberaca(id: string, k: string) {
    const p = pole(k);
    $(id).innerHTML = `<small>${esc(p.o.n)}</small><b>${esc(p.n)}</b>`;
  }
  function nastavOvladanie() {
    popisVyberaca('ds-u', S.u); popisVyberaca('ds-u2', S.u2);
    $<HTMLSelectElement>('ds-kraj').value = S.kraj; naplnOkresy();
    $<HTMLSelectElement>('ds-min').value = S.min; $<HTMLSelectElement>('ds-n').value = S.n; $<HTMLSelectElement>('ds-por').value = S.por;
  }
  const zmena = (id: string, k: keyof typeof S, potom?: () => void) => $<HTMLSelectElement>(id).addEventListener('change', (e) => { S[k] = (e.target as HTMLSelectElement).value; potom?.(); vsetkyRiadky = false; obnov(); });
  zmena('ds-kraj', 'kraj', () => { S.okres = ''; naplnOkresy(); }); zmena('ds-okres', 'okres'); zmena('ds-min', 'min'); zmena('ds-n', 'n'); zmena('ds-por', 'por');
  document.querySelectorAll<HTMLButtonElement>('.ds-zalozky button').forEach((b) => b.addEventListener('click', () => { S.v = b.dataset.v!; obnov(); }));
  $('ds-viac').addEventListener('click', () => { vsetkyRiadky = true; kresli(); });

  // ---------- výber ukazovateľa (oblasti + vyhľadávanie) ----------
  const dlg = $<HTMLDialogElement>('dsp'), q = $<HTMLInputElement>('dsp-q');
  const norm = (t: string) => t.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase();
  let ciel: 'u' | 'u2' = 'u', oblastDlg = '';
  function ukazOblast(id: string) {
    oblastDlg = id; q.value = '';
    dlg.querySelectorAll<HTMLButtonElement>('.dsp-oblasti button').forEach((b) => b.setAttribute('aria-current', String(b.dataset.o === id)));
    dlg.querySelectorAll<HTMLElement>('.dsp-zoznam section').forEach((s) => { s.hidden = s.dataset.o !== id; s.querySelectorAll('li').forEach((li) => (li.hidden = false)); });
    dlg.querySelector<HTMLElement>('.dsp-nic')!.hidden = true;
    dlg.querySelector<HTMLButtonElement>('.dsp-oblasti button[aria-current="true"]')?.scrollIntoView({ block: 'nearest', inline: 'nearest' });
    $('dsp-zoznam').scrollTop = 0;
  }
  function hladaj() {
    const t = norm(q.value.trim());
    if (!t) { ukazOblast(oblastDlg || pole(S[ciel]).o.id); return; }
    const slova = t.split(/\s+/);
    let n = 0;
    dlg.querySelectorAll<HTMLButtonElement>('.dsp-oblasti button').forEach((b) => b.setAttribute('aria-current', 'false'));
    dlg.querySelectorAll<HTMLElement>('.dsp-zoznam section').forEach((s) => {
      let m = 0;
      s.querySelectorAll<HTMLLIElement>('li').forEach((li) => { const ok = slova.every((w) => li.querySelector('button')!.dataset.t!.includes(w)); li.hidden = !ok; if (ok) m++; });
      s.hidden = m === 0; n += m;
    });
    dlg.querySelector<HTMLElement>('.dsp-nic')!.hidden = n > 0;
  }
  function otvor(c: 'u' | 'u2', oblast?: string) {
    ciel = c;
    $('dsp-nadpis').textContent = c === 'u' ? 'Vyberte hlavný ukazovateľ' : 'Vyberte ukazovateľ na porovnanie';
    dlg.querySelectorAll<HTMLButtonElement>('.dsp-zoznam button').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.k === S[c])));
    ukazOblast(oblast ?? pole(S[c]).o.id);
    dlg.showModal();
    if (matchMedia('(pointer: fine)').matches) q.focus();
  }
  async function vyberUkazovatel(k: string) {
    S[ciel] = k; vsetkyRiadky = false; triedenie = { k: '', smer: -1 };
    dlg.close();
    popisVyberaca('ds-u', S.u); popisVyberaca('ds-u2', S.u2);
    $('ds-nadpis').textContent = 'Načítavam…';
    await obnov();
  }
  $('ds-u').addEventListener('click', () => otvor('u'));
  $('ds-u2').addEventListener('click', () => otvor('u2'));
  document.querySelectorAll<HTMLButtonElement>('.ds-rychle button').forEach((b) => b.addEventListener('click', () => otvor('u', b.dataset.o)));
  $('ds-vymen').addEventListener('click', () => { [S.u, S.u2] = [S.u2, S.u]; triedenie = { k: '', smer: -1 }; popisVyberaca('ds-u', S.u); popisVyberaca('ds-u2', S.u2); obnov(); });
  $('dsp-zavri').addEventListener('click', () => dlg.close());
  dlg.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
  dlg.querySelectorAll<HTMLButtonElement>('.dsp-oblasti button').forEach((b) => b.addEventListener('click', () => ukazOblast(b.dataset.o!)));
  dlg.querySelectorAll<HTMLButtonElement>('.dsp-zoznam button').forEach((b) => b.addEventListener('click', () => vyberUkazovatel(b.dataset.k!)));
  q.addEventListener('input', hladaj);
  q.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') { const prvy = [...dlg.querySelectorAll<HTMLButtonElement>('.dsp-zoznam button')].find((b) => !b.closest('[hidden]')); if (prvy) { e.preventDefault(); vyberUkazovatel(prvy.dataset.k!); } }
    if (e.key === 'ArrowDown') { e.preventDefault(); [...dlg.querySelectorAll<HTMLButtonElement>('.dsp-zoznam button')].find((b) => !b.closest('[hidden]'))?.focus(); }
  });
  $('dsp-zoznam').addEventListener('keydown', (e) => {
    if (e.key !== 'ArrowDown' && e.key !== 'ArrowUp') return;
    const vid = [...dlg.querySelectorAll<HTMLButtonElement>('.dsp-zoznam button')].filter((b) => !b.closest('[hidden]'));
    const i = vid.indexOf(document.activeElement as HTMLButtonElement);
    if (i < 0) return;
    e.preventDefault();
    if (e.key === 'ArrowUp' && i === 0) q.focus(); else vid[Math.max(0, Math.min(vid.length - 1, i + (e.key === 'ArrowDown' ? 1 : -1)))].focus();
  });

  $('ds-csv').addEventListener('click', async (e) => {
    const tl = e.currentTarget as HTMLButtonElement, txt = tl.textContent;
    tl.textContent = 'Pripravujem…';
    await Promise.all(OBLASTI.map((o) => nacitajOblast(o.id)));
    tl.textContent = txt;
    const vyb = vyber();
    const kl = OBLASTI.flatMap((o) => o.polia.map((p) => p.k));
    const cis = (k: string, v: number | null) => (v == null ? '' : v.toLocaleString('sk-SK', { useGrouping: false, maximumFractionDigits: 3 }));
    const riadky = [['kod_obce', 'obec', 'okres', 'kraj', ...kl.map((k) => `${pole(k).o.n}: ${nazov(k)}`)].map((x) => (/[;"\n]/.test(x) ? `"${x.replace(/"/g, '""')}"` : x)).join(';'),
      ...vyb.map((o) => [o.kod, o.n, o.okres, KRAJE[o.kraj] ?? '', ...kl.map((k) => cis(k, o.h[k]))].map((x) => (/[;"\n]/.test(x) ? `"${x.replace(/"/g, '""')}"` : x)).join(';'))];
    const a = document.createElement('a');
    a.href = URL.createObjectURL(new Blob(['﻿' + riadky.join('\r\n')], { type: 'text/csv;charset=utf-8' }));
    a.download = `mestovcislach-${slug(popisVyberu(vyb.length).split(' · ')[0]) || 'obce'}.csv`;
    document.body.append(a); a.click(); setTimeout(() => { URL.revokeObjectURL(a.href); a.remove(); }, 1000);
  });
  $('ds-odkaz').addEventListener('click', async (e) => {
    const b = e.currentTarget as HTMLButtonElement;
    try { await navigator.clipboard.writeText(location.href); b.textContent = 'Odkaz skopírovaný ✓'; } catch { prompt('Odkaz na tento pohľad:', location.href); }
    setTimeout(() => (b.textContent = 'Kopírovať odkaz na tento pohľad'), 2500);
  });

  // ---------- načítanie ----------
  zAdresy();
  fetch('/data/studio/obce.json').then((r) => r.json()).then(async (d: D) => {
    OBLASTI = d.oblasti;
    for (const o of OBLASTI) for (const p of o.polia) POLE.set(p.k, { ...p, o });
    KRAJE = d.kraje;
    const okr = new Map<string, number>();
    OBCE = d.obce.map((r) => {
      okr.set(String(r[2]), Number(r[3]));
      return { kod: String(r[0]), n: String(r[1]), okres: String(r[2]), kraj: Number(r[3]), u: String(r[4]), h: { obyv: typeof r[5] === 'number' ? r[5] : null }, lat: Number(r[6]) || 0, lon: Number(r[7]) || 0 };
    });
    OKRESY = [...okr].map(([n, k]) => [k, n]);
    $<HTMLSelectElement>('ds-kraj').innerHTML = `<option value="">Celé Slovensko</option>` + KRAJE.map((k, i) => `<option value="${i}">${esc(k)}</option>`).join('');
    if (!POLE.has(S.u)) S.u = 'nez';
    if (!POLE.has(S.u2)) S.u2 = 'vek';
    nastavOvladanie();
    await obnov();
  }).catch(() => { $('ds-pocet').textContent = 'Údaje sa nepodarilo načítať. Skúste obnoviť stránku.'; });
</script>

<style>
  .ds { display: flex; flex-wrap: wrap; gap: 20px; align-items: flex-start; margin-top: 8px; }
  .ds-panel { flex: 1 1 280px; max-width: 340px; display: flex; flex-direction: column; gap: 14px; }
  .ds-panel .card { margin-top: 0 !important; }
  .ds-vysledok { flex: 999 1 600px; min-width: 0; display: flex; flex-direction: column; gap: 12px; }
  .ds-krok h2 { display: flex; align-items: center; gap: 8px; font-size: 1rem !important; margin: 0 0 12px !important; }
  .ds-krok h2 span { display: inline-flex; width: 22px; height: 22px; border-radius: 11px; background: var(--text); color: var(--card); font-size: 0.75rem; align-items: center; justify-content: center; }
  .ds-pole { display: flex; flex-direction: column; gap: 4px; font-size: 0.85rem; font-weight: 600; margin-bottom: 10px; }
  .ds-pole select, .ds-volby select { min-height: 42px; border: 1px solid var(--line); border-radius: 10px; padding: 0 10px; font: inherit; font-weight: 500; background: var(--bg); color: var(--text); }
  .ds-pocet { margin: 4px 0 0; font-size: 0.85rem; color: var(--muted); }
  .ds-akcie { display: flex; flex-direction: column; gap: 8px; }
  .ds-akcie button, .ds-tl { min-height: 44px; padding: 0 14px; border: 1px solid var(--line); border-radius: 10px; background: var(--card); color: var(--text); font: inherit; font-size: 0.9rem; font-weight: 600; cursor: pointer; display: flex; align-items: center; justify-content: center; text-decoration: none; text-align: center; }
  .ds-akcie button:hover, .ds-tl:hover { border-color: var(--accent); }
  .ds-akcie .ds-hlavne { background: var(--accent); color: var(--na-akcente, #fff); border-color: var(--accent); }
  .ds-pbi { margin-top: 12px; font-size: 0.85rem; }
  .ds-pbi summary { cursor: pointer; font-weight: 600; }
  .ds-pbi code { display: block; margin: 6px 0; padding: 8px; border-radius: 8px; background: var(--bg); word-break: break-all; font-size: 0.78rem; }
  .ds-pbi p code { display: inline; padding: 1px 4px; }
  .ds-zalozky { display: flex; flex-wrap: wrap; gap: 4px; padding: 5px; border: 1px solid var(--line); border-radius: 14px; background: var(--card); align-self: flex-start; }
  .ds-zalozky button { min-height: 40px; padding: 0 16px; border: 0; border-radius: 10px; background: transparent; color: var(--text); font: inherit; font-size: 0.92rem; font-weight: 600; cursor: pointer; }
  .ds-zalozky button[aria-selected='true'] { background: var(--accent); color: var(--na-akcente, #fff); }
  .ds-karta { margin-top: 0 !important; }
  .ds-hlava h2 { margin: 0 !important; }
  .ds-podnadpis { margin: 2px 0 0; color: var(--muted); font-size: 0.9rem; }
  .ds-suhrn { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 10px; margin: 14px 0; }
  .ds-suhrn :global(div) { padding: 10px 12px; border-radius: 12px; background: var(--bg); display: flex; flex-direction: column; gap: 2px; }
  .ds-suhrn :global(span) { font-size: 0.78rem; color: var(--muted); }
  .ds-suhrn :global(b) { font-size: 1.15rem; }
  .ds-suhrn :global(small) { display: block; font-size: 0.75rem; font-weight: 500; color: var(--muted); }
  .ds-volby { display: flex; flex-wrap: wrap; gap: 12px; margin-bottom: 12px; font-size: 0.85rem; font-weight: 600; }
  .ds-volby label { display: flex; align-items: center; gap: 6px; }
  .ds-stlpce :global(.ds-riadok) { display: grid; grid-template-columns: minmax(110px, 200px) minmax(0, 1fr) 76px; gap: 10px; align-items: center; padding: 3px 0; color: var(--text); text-decoration: none; font-size: 0.9rem; }
  .ds-stlpce :global(.ds-riadok:hover .ds-meno) { color: var(--accent); }
  .ds-stlpce :global(.ds-meno) { text-align: right; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; font-weight: 500; }
  .ds-stlpce :global(.ds-meno small) { display: block; font-size: 0.72rem; color: var(--muted); font-weight: 400; }
