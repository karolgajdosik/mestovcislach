---
// Hlavička stránky mesta s fotografiou: obrázok cez celú šírku obsahu, nadpis na ňom, autor a licencia v rohu.
import { foto } from '../lib/fotky';
const { slug, nazov } = Astro.props as { slug: string; nazov: string };
const f = foto(slug);
---
{f ? (
  <header class="foto-hero">
    <img src={f.src} srcset={f.srcset} sizes="(max-width: 1100px) 100vw, 1040px" alt={`${nazov} – pohľad na mesto`} fetchpriority="high" decoding="async" width="1600" height="900" />
    <div class="fh-text"><slot /></div>
    <p class="fh-kredit">Foto: <a href={f.zdroj} rel="noopener">{f.autor}</a>, {f.licenciaUrl ? <a href={f.licenciaUrl} rel="noopener license">{f.licencia}</a> : f.licencia}, Wikimedia Commons, farebne upravené</p>
  </header>
) : <header class="hero"><slot /></header>}

<style>
  .foto-hero { position: relative; margin: 20px 0 18px; border-radius: 18px; overflow: hidden; min-height: clamp(220px, 34vw, 360px); display: flex; align-items: flex-end; background: #1d1d1f; isolation: isolate; }
  /* jednotný vzhľad fotiek: tlmené farby, vyšší kontrast, jemný modro-červený nádych (farby webu) */
  .foto-hero img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; z-index: -3; filter: saturate(0.65) contrast(1.18) brightness(1.02); }
  .foto-hero::before { content: ''; position: absolute; inset: 0; z-index: -2; pointer-events: none; background: linear-gradient(115deg, rgba(19, 33, 63, 0.45), rgba(179, 18, 46, 0.25)); mix-blend-mode: multiply; }
  .foto-hero::after { content: ''; position: absolute; inset: 0; z-index: -1; background: linear-gradient(to top, rgba(0, 0, 0, 0.72) 0%, rgba(0, 0, 0, 0.35) 45%, rgba(0, 0, 0, 0) 75%); }
  .fh-text { padding: 26px 26px 34px; color: #fff; max-width: 46em; }
  .fh-text :global(.kicker) { color: #ffd6dc !important; text-shadow: 0 1px 2px rgba(0, 0, 0, 0.5); }
  .fh-text :global(h1) { color: #fff; margin: 6px 0 0 !important; text-shadow: 0 2px 12px rgba(0, 0, 0, 0.45); }
  .fh-kredit { position: absolute; right: 10px; bottom: 6px; margin: 0; font-size: 0.68rem; color: rgba(255, 255, 255, 0.85); text-shadow: 0 1px 2px rgba(0, 0, 0, 0.7); max-width: 70%; text-align: right; }
  .fh-kredit a { color: inherit; }
  @media (max-width: 600px) {
    .foto-hero { margin: 12px -4px 14px; border-radius: 14px; }
    .fh-text { padding: 18px 16px 20px; }
    .fh-kredit { top: 6px; bottom: auto; right: 8px; font-size: 0.62rem; max-width: 85%; }
  }
</style>
