---
// Firmy vlastnené mestom – hospodárenie z účtovných závierok (data/mesta/firmy.json, scripts/zber_firmy_miest.py).
import fs from 'node:fs';
import path from 'node:path';

const { mesto, nadpis = 'h2' } = Astro.props as { mesto: string; nadpis?: 'h2' | 'h3' };
const p = path.join(process.cwd(), 'data', 'mesta', 'firmy.json');
const d = fs.existsSync(p) ? JSON.parse(fs.readFileSync(p, 'utf-8')) : null;
const firmy: any[] = (d?.mesta?.[mesto] ?? []).filter((f: any) => Object.keys(f.roky).length);
const mil = (n: number | undefined) => (n == null ? '–' : `${(n / 1e6).toLocaleString('sk-SK', { maximumFractionDigits: Math.abs(n) < 1e6 ? 2 : 1 })} mil. €`);
const riadky = firmy.map((f) => {
  const roky = Object.keys(f.roky).sort();
  const rok = roky[roky.length - 1];
  const r = f.roky[rok];
  const pred = f.roky[roky[roky.length - 2]];
  return { ...f, rok, r, zmena: pred?.vynosy ? (100 * (r.vynosy - pred.vynosy)) / pred.vynosy : null, trend: roky.slice(-6).map((y) => f.roky[y].vysledok ?? 0) };
});
const Tag = nadpis;
---
{riadky.length > 0 && (
  <section class="card firmy" id="firmy">
    <Tag class="f-nadpis">Firmy mesta</Tag>
    <p class="f-uvod">Obchodné spoločnosti, ktorých jediným alebo spoluvlastníkom je mesto – výnosy, výsledok hospodárenia, úvery a majetok z poslednej účtovnej závierky.</p>
    <div class="tabulka-obal"><table>
      <thead><tr><th>Firma</th><th class="num">Rok</th><th class="num">Výnosy</th><th class="num">Výsledok</th><th class="num">Osobné náklady</th><th class="num">Bankové úvery</th><th class="num">Majetok</th></tr></thead>
      <tbody>
        {riadky.map((f) => (
          <tr>
            <td><span translate="no">{f.nazov}</span><small>{f.vlastnictvo === 'jediný' ? '100 % mesto' : 'mesto spoluvlastník'} · IČO {f.ico}</small></td>
            <td class="num">{f.rok}</td>
            <td class="num">{mil(f.r.vynosy)}{f.zmena != null && <small>{f.zmena >= 0 ? '+' : '−'}{Math.abs(f.zmena).toLocaleString('sk-SK', { maximumFractionDigits: 0 })} % medziročne</small>}</td>
            <td class={`num ${(f.r.vysledok ?? 0) < 0 ? 'zaporne' : ''}`}>{(f.r.vysledok ?? 0) >= 0 ? '+' : '−'}{mil(Math.abs(f.r.vysledok ?? 0))}</td>
            <td class="num">{mil(f.r.osobne_naklady)}</td>
            <td class="num">{f.r.bankove_uvery ? mil(f.r.bankove_uvery) : '0'}</td>
            <td class="num">{mil(f.r.majetok)}</td>
          </tr>
        ))}
      </tbody>
    </table></div>
    <p class="zdroj">
      Vlastníctvo podľa <a href={d.zdroje.rpo.url}>Registra právnických osôb</a> (akcionár alebo spoločník je mesto{riadky.some((f) => f.overenie !== 'RPO') ? '; pri niektorých akciových spoločnostiach register akcionára neuvádza – podľa výročnej správy' : ''}),
      hospodárenie z individuálnych účtovných závierok v <a href={d.zdroje.ruz.url}>Registri účtovných závierok</a>. Výnosy firiem zahŕňajú aj platby od mesta (napr. za dopravu či údržbu).
      Mikro účtovné jednotky so zjednodušenou závierkou tu nie sú.
    </p>
  </section>
)}

<style>
  .firmy { margin-top: 16px; }
  .f-nadpis { font-size: 1.15rem; margin: 0 0 6px; }
  .f-uvod { color: var(--muted); font-size: 0.9rem; margin: 0 0 10px; }
  .tabulka-obal { overflow-x: auto; }
  table { width: 100%; border-collapse: collapse; font-size: 0.9rem; }
  th, td { text-align: left; padding: 8px; border-bottom: 1px solid var(--line); vertical-align: top; }
  th { color: var(--muted); font-size: 0.78rem; }
  td small { display: block; color: var(--muted); font-size: 0.75rem; }
  .num { text-align: right; font-variant-numeric: tabular-nums; white-space: nowrap; }
  td.zaporne { color: #c8102e; }
  :global(:root[data-tema='tmava']) td.zaporne { color: #ff8a8a; }
  .zdroj { font-size: 0.8rem; color: var(--muted); margin: 12px 0 0; }
</style>
