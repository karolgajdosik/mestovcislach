---
// Plávajúce okno AI asistenta (odpovedá cez /api/asistent z údajov webu).
---
<button class="ai-tlacidlo" id="ai-otvor" type="button" aria-expanded="false" aria-controls="ai-okno" title="AI asistent – tlačidlo môžete potiahnuť kamkoľvek">
  <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path fill="currentColor" d="M12 3C6.5 3 2 6.6 2 11c0 2.2 1.1 4.2 3 5.6V21l3.7-2.3c1 .2 2.1.3 3.3.3 5.5 0 10-3.6 10-8s-4.5-8-10-8Zm-4 9.3a1.3 1.3 0 1 1 0-2.6 1.3 1.3 0 0 1 0 2.6Zm4 0a1.3 1.3 0 1 1 0-2.6 1.3 1.3 0 0 1 0 2.6Zm4 0a1.3 1.3 0 1 1 0-2.6 1.3 1.3 0 0 1 0 2.6Z"/></svg>
  <span>AI asistent</span>
</button>

<section class="ai-okno" id="ai-okno" role="dialog" aria-label="Asistent mestovcislach.sk" hidden>
  <header>
    <div>
      <strong>AI asistent</strong>
      <span>odpovedá z údajov tohto webu</span>
    </div>
    <button type="button" class="ai-zavri" id="ai-zavri" aria-label="Zavrieť">×</button>
  </header>
  <div class="ai-spravy" id="ai-spravy" aria-live="polite">
    <div class="ai-uvod">
      <p>Dobrý deň! Opýtajte sa na čokoľvek, čo je na webe – miesta na mape, MHD, voľby, rozpočet, ovzdušie, uzávierky, Dunaj či výstrahy.</p>
      <div class="ai-navrhy">
        <button type="button">Najbližšia otvorená lekáreň pri mne</button>
        <button type="button">Ktorá lekáreň v Petržalke je teraz otvorená?</button>
        <button type="button">Kedy je ráno najväčšia premávka na nábreží?</button>
        <button type="button">Aké uzávierky sú dnes v Ružinove?</button>
        <button type="button">Ako volila Petržalka v roku 2023?</button>
      </div>
    </div>
  </div>
  <div class="ai-moznosti">
    <button type="button" id="ai-poloha" aria-pressed="false" title="Použiť vašu polohu pri hľadaní najbližších miest">
      <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true"><path fill="currentColor" d="M12 2a7 7 0 0 0-7 7c0 5.2 7 13 7 13s7-7.8 7-13a7 7 0 0 0-7-7Zm0 9.5A2.5 2.5 0 1 1 12 6.5a2.5 2.5 0 0 1 0 5Z"/></svg>
      <span>Pri mne</span>
    </button>
    <span class="ai-poloha-stav" id="ai-poloha-stav"></span>
  </div>
  <form class="ai-vstup" id="ai-form">
    <input id="ai-otazka" type="text" maxlength="500" placeholder="Napíšte otázku…" autocomplete="off" aria-label="Otázka" />
    <button type="submit" aria-label="Odoslať">
      <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M3 20.5 21 12 3 3.5 3 10l12 2-12 2z"/></svg>
    </button>
  </form>
  <p class="ai-pozn">AI sa môže mýliť – dôležité údaje si overte v zdroji. Otázky ani polohu neukladáme.</p>
</section>

<script>
  type Sprava = { rola: 'user' | 'assistant'; text: string; odkazy?: { url: string; nazov: string }[] };
  const okno = document.getElementById('ai-okno')!;
  const tlacidlo = document.getElementById('ai-otvor')!;
  const spravy = document.getElementById('ai-spravy')!;
  const form = document.getElementById('ai-form') as HTMLFormElement;
  const vstup = document.getElementById('ai-otazka') as HTMLInputElement;
  let historia: Sprava[] = [];
  try { historia = JSON.parse(sessionStorage.getItem('ai:historia') ?? '[]'); } catch { /* nevadí */ }
  // Poloha „Pri mne“: zaokrúhlená na ~100 m, drží sa len počas návštevy (sessionStorage)
  let poloha: { lat: number; lon: number } | null = null;
  try { poloha = JSON.parse(sessionStorage.getItem('ai:poloha') ?? 'null'); } catch { /* nevadí */ }
  const btnPoloha = document.getElementById('ai-poloha')!;
  const stavPolohy = document.getElementById('ai-poloha-stav')!;
  const ukazPolohu = () => {
    btnPoloha.setAttribute('aria-pressed', String(!!poloha));
    stavPolohy.textContent = poloha ? 'poloha zapnutá – ťuknite znova na vypnutie' : '';
  };
  const zistiPolohu = () => new Promise<boolean>((ok) => {
    if (!('geolocation' in navigator)) { stavPolohy.textContent = 'prehliadač nepodporuje polohu'; return ok(false); }
    stavPolohy.textContent = 'zisťujem polohu…';
    navigator.geolocation.getCurrentPosition((p) => {
      const lat = Math.round(p.coords.latitude * 1000) / 1000, lon = Math.round(p.coords.longitude * 1000) / 1000;
      if (lat < 47.9 || lat > 48.35 || lon < 16.8 || lon > 17.4) {
        poloha = null; stavPolohy.textContent = 'ste mimo Bratislavy – poloha sa nepoužije'; return ok(false);
      }
      poloha = { lat, lon };
      try { sessionStorage.setItem('ai:poloha', JSON.stringify(poloha)); } catch { /* nevadí */ }
      ukazPolohu(); ok(true);
    }, (e) => {
      stavPolohy.textContent = e.code === 1 ? 'prístup k polohe ste nepovolili' : 'polohu sa nepodarilo zistiť';
      ok(false);
    }, { enableHighAccuracy: false, timeout: 10000, maximumAge: 300000 });
  });
  btnPoloha.addEventListener('click', () => {
    if (poloha) { poloha = null; try { sessionStorage.removeItem('ai:poloha'); } catch { /* nevadí */ } ukazPolohu(); return; }
    zistiPolohu();
  });
  ukazPolohu();

  const uloz = () => { try { sessionStorage.setItem('ai:historia', JSON.stringify(historia.slice(-20))); } catch { /* nevadí */ } };

  const esc = (t: string) => t.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);
  function format(text: string) {
    const riadky = esc(text).replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>')
      .replace(/\[([^\]]+)\]\((https?:\/\/[^\s)]+|\/[^\s)]*)\)/g, '<a href="$2" target="_blank" rel="noopener">$1</a>')
      .replace(/(^|[\s(])(https?:\/\/[^\s<)]+)/g, '$1<a href="$2" target="_blank" rel="noopener">$2</a>')
      .split('\n');
    let html = '', zoznam = false;
    for (const r of riadky) {
      const m = r.match(/^\s*(?:[-*•]|\d+\.)\s+(.*)$/);
      if (m) { if (!zoznam) { html += '<ul>'; zoznam = true; } html += `<li>${m[1]}</li>`; continue; }
      if (zoznam) { html += '</ul>'; zoznam = false; }
      if (r.trim()) html += `<p>${r}</p>`;
    }
    return html + (zoznam ? '</ul>' : '');
  }
  function pridaj(s: Sprava) {
    spravy.querySelector('.ai-uvod')?.setAttribute('hidden', '');
    const el = document.createElement('div');
    el.className = `ai-sprava ${s.rola}`;
    el.innerHTML = s.rola === 'user' ? `<p>${esc(s.text)}</p>` : format(s.text)
      + (s.odkazy?.length ? `<div class="ai-odkazy">${s.odkazy.map((o) => `<a href="${esc(o.url)}">${esc(o.nazov)} →</a>`).join('')}</div>` : '');
    spravy.append(el);
    spravy.scrollTop = spravy.scrollHeight;
    return el;
  }
  historia.forEach(pridaj);

  const prepni = (otvor: boolean) => {
    okno.hidden = !otvor;
    tlacidlo.setAttribute('aria-expanded', String(otvor));
    document.body.classList.toggle('ai-otvorene', otvor);
    if (otvor) { vstup.focus(); spravy.scrollTop = spravy.scrollHeight; }
  };
  // Tlačidlo sa dá potiahnuť kamkoľvek na stránke; poloha sa pamätá (localStorage, ak je dostupný).
  // Krátke ťuknutie bez pohybu okno otvorí, potiahnutie nie.
  const KLUC_POLOHY = 'ai:tlacidlo';
  let presunute = false;
  const obmedz = (x: number, y: number) => {
    const r = tlacidlo.getBoundingClientRect();
    return [Math.min(Math.max(8, x), innerWidth - r.width - 8), Math.min(Math.max(8, y), innerHeight - r.height - 8)];
  };
  const umiestni = (x: number, y: number) => {
    [x, y] = obmedz(x, y);
    Object.assign(tlacidlo.style, { left: `${x}px`, top: `${y}px`, right: 'auto', bottom: 'auto' });
  };
  try {
    const ul = JSON.parse(localStorage.getItem(KLUC_POLOHY) ?? 'null');
    // uložené ako podiel šírky/výšky okna, aby sedelo aj po zmene veľkosti
    if (ul) requestAnimationFrame(() => umiestni(ul.x * innerWidth, ul.y * innerHeight));
  } catch { /* nevadí */ }
  let start: { x: number; y: number; l: number; t: number; id: number } | null = null;
  tlacidlo.addEventListener('pointerdown', (e) => {
    const r = tlacidlo.getBoundingClientRect();
    start = { x: e.clientX, y: e.clientY, l: r.left, t: r.top, id: e.pointerId };
    presunute = false;
  });
  tlacidlo.addEventListener('pointermove', (e) => {
    if (!start || e.pointerId !== start.id) return;
    const dx = e.clientX - start.x, dy = e.clientY - start.y;
    if (!presunute && Math.hypot(dx, dy) < 6) return;
    if (!presunute) { presunute = true; tlacidlo.setPointerCapture(e.pointerId); tlacidlo.classList.add('tahane'); }
    umiestni(start.l + dx, start.t + dy);
  });
  const koniec = () => {
    if (!start) return;
    start = null;
    tlacidlo.classList.remove('tahane');
    if (presunute) {
      const r = tlacidlo.getBoundingClientRect();
      try { localStorage.setItem(KLUC_POLOHY, JSON.stringify({ x: r.left / innerWidth, y: r.top / innerHeight })); } catch { /* nevadí */ }
    }
  };
  tlacidlo.addEventListener('pointerup', koniec);
  tlacidlo.addEventListener('pointercancel', koniec);
  // dvojklik vráti tlačidlo do rohu
  tlacidlo.addEventListener('dblclick', () => {
    Object.assign(tlacidlo.style, { left: '', top: '', right: '', bottom: '' });
    try { localStorage.removeItem(KLUC_POLOHY); } catch { /* nevadí */ }
  });
  addEventListener('resize', () => { if (tlacidlo.style.left) { const r = tlacidlo.getBoundingClientRect(); umiestni(r.left, r.top); } });

  // okno sa otvorí pri tlačidle (na širokej obrazovke), na mobile ostáva ako panel zdola
  // poloha tlačidla sa zisťuje pred otvorením okna (otvorené okno tlačidlo skryje)
  const umiestniOkno = (t: DOMRect) => {
    if (innerWidth <= 600 || !tlacidlo.style.left) { Object.assign(okno.style, { left: '', top: '', right: '', bottom: '' }); return; }
    const w = okno.offsetWidth || 400, h = okno.offsetHeight || 600;
    const x = Math.min(Math.max(8, t.right - w), innerWidth - w - 8);
    const y = Math.max(8, t.top + t.height / 2 > innerHeight / 2 ? t.bottom - h : Math.min(t.top, innerHeight - h - 8));
    Object.assign(okno.style, { left: `${x}px`, top: `${y}px`, right: 'auto', bottom: 'auto' });
  };
  tlacidlo.addEventListener('click', (e) => {
    if (presunute) { e.preventDefault(); presunute = false; return; }
    const t = tlacidlo.getBoundingClientRect();
    prepni(okno.hidden);
    if (!okno.hidden) umiestniOkno(t);
  });
  document.getElementById('ai-zavri')!.addEventListener('click', () => prepni(false));
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !okno.hidden) prepni(false); });

  async function posli(otazka: string) {
    otazka = otazka.trim();
    if (!otazka) return;
    // „pri mne“ bez polohy → najprv požiadať o polohu
    if (!poloha && /pri mne|okolo mňa|blízko mňa|v mojom okolí/i.test(otazka)) await zistiPolohu();
    const predtym = historia.map(({ rola, text }) => ({ rola, text }));
    const ja: Sprava = { rola: 'user', text: otazka };
    historia.push(ja); pridaj(ja); uloz();
    vstup.value = ''; vstup.disabled = true;
    const caka = document.createElement('div');
    caka.className = 'ai-sprava assistant caka';
    caka.innerHTML = '<span></span><span></span><span></span>';
    spravy.append(caka); spravy.scrollTop = spravy.scrollHeight;
    try {
      const r = await fetch('/api/asistent', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ otazka, historia: predtym, stream: true, poloha }) });
      if (!r.ok || !r.body || !(r.headers.get('content-type') ?? '').includes('event-stream')) {
        const d = await r.json().catch(() => ({}));
        caka.remove();
        if (!r.ok || !d.odpoved) { pridaj({ rola: 'assistant', text: d.chyba ?? 'Asistent teraz neodpovedá. Skúste to o chvíľu.' }); return; }
        const s: Sprava = { rola: 'assistant', text: d.odpoved, odkazy: d.odkazy };
        historia.push(s); pridaj(s); uloz();
        return;
      }
      // Postupné zobrazovanie odpovede
      const s: Sprava = { rola: 'assistant', text: '' };
      let el: HTMLElement | null = null;
      let naplanovane = false;
      const vykresli = () => {
        naplanovane = false;
        const text = s.text.replace(/<think>[\s\S]*?(<\/think>|$)/g, '').trimStart();
        if (!text) return;
        if (!el) { caka.remove(); el = pridaj({ ...s, text }); }
        else el.innerHTML = format(text) + (s.odkazy?.length ? `<div class="ai-odkazy">${s.odkazy.map((o) => `<a href="${esc(o.url)}">${esc(o.nazov)} →</a>`).join('')}</div>` : '');
        const dole = spravy.scrollHeight - spravy.scrollTop - spravy.clientHeight < 80;
        if (dole) spravy.scrollTop = spravy.scrollHeight;
      };
      const reader = r.body.getReader();
      const dec = new TextDecoder();
      let buf = '';
      let chyba = '';
      for (;;) {
        const { done, value } = await reader.read();
        if (done) break;
        buf += dec.decode(value, { stream: true });
        let i: number;
        while ((i = buf.indexOf('\n\n')) >= 0) {
          const udalost = buf.slice(0, i); buf = buf.slice(i + 2);
          const data = udalost.replace(/^data:\s?/gm, '');
          if (data === '[DONE]') continue;
          try {
            const d = JSON.parse(data);
            if (d.t) s.text += d.t;
            if (d.odkazy) s.odkazy = d.odkazy;
            if (d.chyba) chyba = d.chyba;
          } catch { /* ignorovať */ }
          if (!naplanovane) { naplanovane = true; requestAnimationFrame(vykresli); }
        }
      }
      s.text = s.text.replace(/<think>[\s\S]*?<\/think>/g, '').trim();
      caka.remove();
      if (!s.text) { pridaj({ rola: 'assistant', text: chyba || 'Asistent teraz neodpovedá. Skúste to o chvíľu.' }); return; }
      if (chyba) s.text += `\n\n(${chyba})`;
      vykresli();
      historia.push(s); uloz();
    } catch {
      caka.remove();
      pridaj({ rola: 'assistant', text: 'Nepodarilo sa spojiť so serverom. Skontrolujte pripojenie.' });
    } finally {
      vstup.disabled = false; vstup.focus();
    }
  }
  form.addEventListener('submit', (e) => { e.preventDefault(); posli(vstup.value); });
  // otázka z vyhľadávania v hlavičke
  window.addEventListener('asistent:otazka', (e) => { const q = String((e as CustomEvent).detail ?? '').trim(); if (okno.hidden) { const t = tlacidlo.getBoundingClientRect(); prepni(true); umiestniOkno(t); } if (q) posli(q); });
  okno.querySelectorAll<HTMLButtonElement>('.ai-navrhy button').forEach((b) => b.addEventListener('click', () => posli(b.textContent ?? '')));
</script>

<style>
  .ai-tlacidlo {
    position: fixed; right: 16px; bottom: 16px; z-index: 1200; display: inline-flex; align-items: center; gap: 8px;
    padding: 12px 18px; border: 0; border-radius: 999px; background: var(--accent); color: #fff; font: inherit; font-weight: 700;
    box-shadow: 0 6px 20px #0003; cursor: pointer;
  }
  .ai-tlacidlo:hover { filter: brightness(1.08); }
  .ai-tlacidlo { touch-action: none; user-select: none; -webkit-user-select: none; }
  .ai-tlacidlo.tahane { cursor: grabbing; box-shadow: 0 12px 32px #0005; transform: scale(1.04); }
  :global(body.ai-otvorene) .ai-tlacidlo { display: none; }
  .ai-okno {
    position: fixed; right: 16px; bottom: 16px; z-index: 1201; width: min(400px, calc(100vw - 32px)); height: min(600px, calc(100dvh - 140px));
    display: flex; flex-direction: column; background: var(--card); border: 1px solid var(--line); border-radius: 16px; box-shadow: 0 12px 40px #0004; overflow: hidden;
  }
  .ai-okno[hidden] { display: none; }
  @media (max-width: 600px) {
    .ai-okno { right: 0; left: 0; bottom: 0; width: 100%; height: calc(100dvh - 100px); border-radius: 16px 16px 0 0; }
    .ai-tlacidlo { padding: 11px 15px; }
  }
  header { display: flex; justify-content: space-between; align-items: center; padding: 12px 16px; border-bottom: 1px solid var(--line); }
  header div { display: flex; flex-direction: column; }
  header span { color: var(--muted); font-size: 0.78rem; }
  .ai-zavri { border: 0; background: none; color: var(--muted); font-size: 1.6rem; line-height: 1; cursor: pointer; padding: 0 4px; }
  .ai-spravy { flex: 1; overflow-y: auto; padding: 14px 16px; display: flex; flex-direction: column; gap: 10px; font-size: 0.92rem; }
  .ai-uvod p { margin: 0 0 12px; color: var(--muted); }
  .ai-navrhy { display: flex; flex-direction: column; gap: 6px; }
  .ai-navrhy button { text-align: left; font: inherit; font-size: 0.86rem; padding: 8px 12px; border: 1px solid var(--line); border-radius: 10px; background: var(--bg); color: var(--text); cursor: pointer; }
  .ai-navrhy button:hover { border-color: var(--accent); }
  .ai-spravy :global(.ai-sprava) { max-width: 92%; padding: 9px 12px; border-radius: 12px; line-height: 1.45; overflow-wrap: anywhere; }
  .ai-spravy :global(.ai-sprava p) { margin: 0 0 6px; }
  .ai-spravy :global(.ai-sprava p:last-child) { margin-bottom: 0; }
  .ai-spravy :global(.ai-sprava ul) { margin: 4px 0 6px; padding-left: 18px; }
  .ai-spravy :global(.ai-sprava li) { margin: 2px 0; }
  .ai-spravy :global(.ai-sprava.user) { align-self: flex-end; background: var(--accent); color: #fff; }
  .ai-spravy :global(.ai-sprava.assistant) { align-self: flex-start; background: var(--bg); border: 1px solid var(--line); }
  .ai-spravy :global(.ai-sprava .ai-odkazy) { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 8px; }
  .ai-spravy :global(.ai-sprava .ai-odkazy a) { font-size: 0.8rem; padding: 3px 9px; border: 1px solid var(--line); border-radius: 999px; text-decoration: none; background: var(--card); }
  .ai-spravy :global(.caka) { display: inline-flex; gap: 4px; }
  .ai-spravy :global(.caka span) { width: 7px; height: 7px; border-radius: 50%; background: var(--muted); animation: bodka 1s infinite alternate; }
  .ai-spravy :global(.caka span:nth-child(2)) { animation-delay: .2s; }
  .ai-spravy :global(.caka span:nth-child(3)) { animation-delay: .4s; }
  @keyframes bodka { to { opacity: .25; } }
  .ai-moznosti { display: flex; align-items: center; gap: 8px; padding: 8px 12px 0; border-top: 1px solid var(--line); font-size: 0.78rem; color: var(--muted); }
  .ai-moznosti button { display: inline-flex; align-items: center; gap: 5px; font: inherit; font-size: 0.8rem; padding: 4px 10px; border: 1px solid var(--line); border-radius: 999px; background: var(--bg); color: var(--text); cursor: pointer; }
  .ai-moznosti button[aria-pressed='true'] { background: var(--accent); border-color: var(--accent); color: #fff; }
  .ai-vstup { display: flex; gap: 8px; padding: 8px 12px 10px; }
  .ai-vstup input { flex: 1; font: inherit; font-size: 16px; padding: 9px 12px; border: 1px solid var(--line); border-radius: 10px; background: var(--bg); color: var(--text); min-width: 0; }
  .ai-vstup button { border: 0; border-radius: 10px; background: var(--accent); color: #fff; padding: 0 14px; cursor: pointer; }
  .ai-pozn { margin: 0; padding: 0 14px 10px; font-size: 0.72rem; color: var(--muted); }
</style>
