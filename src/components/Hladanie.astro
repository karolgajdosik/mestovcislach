---
// Fulltextové vyhľadávanie v hlavičke: stránky, datasety, miesta, ulice, poslanci, firmy.
// Index /data/hladanie.json a knižnica MiniSearch sa načítajú až pri prvom otvorení (alebo pri prejdení myšou).
---
<button class="hl-tlacidlo" id="hladanie-otvor" type="button" aria-haspopup="dialog" aria-controls="hladanie-dialog" title="Hľadať (/)">
  <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5" /><path d="m15.5 15.5 5 5" /></svg>
  <span class="hl-text">Hľadať</span>
  <kbd>/</kbd>
</button>

<dialog class="hladanie-dialog" id="hladanie-dialog" aria-label="Vyhľadávanie">
  <div class="hl-panel">
    <div class="hl-pole">
      <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5" /><path d="m15.5 15.5 5 5" /></svg>
      <input id="hladanie-vstup" type="search" placeholder="Napr. Romanova, tenis Petržalka, nehody, Augustinič…" autocomplete="off" spellcheck="false"
        role="combobox" aria-expanded="true" aria-controls="hladanie-vysledky" aria-autocomplete="list" />
      <button type="button" class="hladanie-zavri" id="hladanie-zavri" aria-label="Zavrieť vyhľadávanie">Esc</button>
    </div>
    <div class="hladanie-vysledky" id="hladanie-vysledky" role="listbox" aria-label="Výsledky"></div>
    <p class="hl-pata"><span><kbd>↑</kbd><kbd>↓</kbd> výber</span><span><kbd>Enter</kbd> otvoriť</span><span><kbd>Esc</kbd> zavrieť</span></p>
  </div>
</dialog>

<script>
  import type MiniSearchT from 'minisearch';
  import { SLOVNIK } from '../i18n/slovnik';
  import { tr } from '../scripts/preklad';
  // preklady názvov sekcií a kategórií ako ďalšie kľúčové slová – hľadať sa dá aj po anglicky, nemecky, poľsky, maďarsky
  const vsetkyJazyky = (t: string) => (SLOVNIK[t] ?? []).join(' ');

  type Polozka = { id: number; g: string; t: string; s: string; u: string; w: string; x: string; lat?: number; lon?: number };
  const SKUPINY: Record<string, { max: number; vaha: number }> = {
    'Stránky': { max: 4, vaha: 1.6 }, 'Mestské časti': { max: 3, vaha: 2 }, 'Miesta': { max: 6, vaha: 1 }, 'Ulice': { max: 4, vaha: 1.1 },
    'Katalóg dát': { max: 5, vaha: 1 }, 'Poslanci': { max: 4, vaha: 1.4 }, 'Firmy a organizácie': { max: 4, vaha: 0.9 },
  };
  const RYCHLE = ['/vybavenost#spadova-skola', '/doprava#naozivo', '/volby#komunalne', '/volby#hlasovania', '/financie#zmluvy-mc', '/mapa'];

  const dialog = document.getElementById('hladanie-dialog') as HTMLDialogElement;
  const vstup = document.getElementById('hladanie-vstup') as HTMLInputElement;
  const vysl = document.getElementById('hladanie-vysledky')!;
  const norm = (t: string) => t.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '');
  const esc = (t: string) => t.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);

  let index: Promise<{ ms: MiniSearchT<Polozka>; polozky: Polozka[] }> | null = null;
  const nacitaj = () => (index ??= Promise.all([import('minisearch'), fetch('/data/hladanie.json').then((r) => r.json())]).then(([{ default: MiniSearch }, d]) => {
    const polozky: Polozka[] = d.polozky.map((p: any[], id: number) => ({ id, g: p[0], t: p[1], s: p[2] ?? '', u: p[3] ?? '', w: p[4] ?? '', x: p[0] === 'Stránky' ? vsetkyJazyky(p[1]) : p[0] === 'Miesta' ? vsetkyJazyky(p[4]) : '', lat: p[5], lon: p[6] }));
    const ms = new MiniSearch<Polozka>({
      fields: ['t', 's', 'w', 'x'],
      processTerm: (t) => { const n = norm(t); return n.length > 1 || /\d/.test(n) ? n : null; },
      searchOptions: { boost: { t: 3, w: 1.5, x: 1.5, s: 0.5 }, prefix: true, fuzzy: (term) => (term.length > 4 ? 0.2 : false) },
    });
    ms.addAll(polozky);
    return { ms, polozky };
  }));

  // odkaz podľa typu položky (pri miestach a uliciach ho skladáme tu – index je menší)
  const odkaz = (p: Polozka) => {
    if (p.g === 'Miesta') return `/mapa#miesto&${new URLSearchParams({ lat: String(p.lat), lon: String(p.lon), n: p.t, k: p.w })}`;
    if (p.g === 'Ulice') return `/vybavenost?ulica=${encodeURIComponent(`${p.t}, ${p.s}`)}#spadova-skola`;
    return p.u;
  };
  // popis ako HTML: preložiteľná časť a časť s názvami (translate="no")
  const nt = (t: string) => `<span translate="no">${esc(t)}</span>`;
  const popis = (p: Polozka) => (p.g === 'Ulice' ? nt(`${p.s}, ${tr('Spádová škola podľa adresy')}`)
    : p.g === 'Miesta' ? nt([tr(p.w), p.s].filter(Boolean).join(', '))
    : ['Poslanci', 'Firmy a organizácie'].includes(p.g) ? nt(p.s) : esc(p.s));
  const BEZ_PREKLADU = new Set(['Miesta', 'Ulice', 'Poslanci', 'Firmy a organizácie', 'Mestské časti']);

  // zvýraznenie hľadaných slov bez ohľadu na diakritiku (slovenské písmená sa normalizujú na jeden znak)
  function zvyrazni(text: string, slova: string[]) {
    const n = [...text].map((c) => norm(c)[0] ?? c).join('');
    const znaky = [...text];
    const oznac = new Array(znaky.length).fill(false);
    for (const w of slova) {
      if (w.length < 2) continue;
      let i = n.indexOf(w);
      while (i >= 0) { for (let j = i; j < i + w.length && j < oznac.length; j++) oznac[j] = true; i = n.indexOf(w, i + 1); }
    }
    let out = '', v = false;
    znaky.forEach((c, i) => { if (oznac[i] !== v) { out += oznac[i] ? '<mark>' : '</mark>'; v = oznac[i]; } out += esc(c); });
    return out + (v ? '</mark>' : '');
  }

  let vybrany = 0;
  let riadky: HTMLAnchorElement[] = [];
  const oznac = (i: number) => {
    riadky.forEach((r, j) => r.setAttribute('aria-selected', String(j === i)));
    vybrany = i;
    riadky[i]?.scrollIntoView({ block: 'nearest' });
    if (riadky[i]) vstup.setAttribute('aria-activedescendant', riadky[i].id);
  };
  const riadok = (u: string, t: string, s: string, g: string, i: number) =>
    `<a class="hl-riadok" role="option" id="hladanie-r${i}" href="${esc(u)}" data-g="${esc(g)}"><span class="hl-ikona" aria-hidden="true"></span><span class="hl-obsah"><span class="hl-nazov">${t}</span>${s ? `<span class="hl-popis">${s}</span>` : ''}</span></a>`;

  async function hladaj() {
    const q = vstup.value.trim();
    const { ms, polozky } = await nacitaj();
    if (q !== vstup.value.trim()) return; // medzitým sa zmenil text
    let html = '', i = 0;
    if (q.length < 2) {
      html = `<p class="hl-skupina">Často hľadané</p>` + RYCHLE.map((u) => polozky.find((p) => p.g === 'Stránky' && p.u === u)).filter(Boolean)
        .map((p) => riadok(p!.u, esc(p!.t), esc(p!.s), p!.g, i++)).join('');
    } else {
      let najdene = ms.search(q, { combineWith: 'AND' });
      if (!najdene.length) najdene = ms.search(q, { combineWith: 'OR' });
      const slova = norm(q).split(/[^a-z0-9]+/).filter(Boolean);
      const skupiny = new Map<string, { skore: number; p: Polozka[] }>();
      for (const r of najdene) {
        const p = polozky[r.id as number];
        const sk = skupiny.get(p.g) ?? { skore: 0, p: [] };
        // presný začiatok názvu dostane prednosť
        const bonus = norm(p.t).startsWith(norm(q)) ? 2 : 1;
        sk.skore = Math.max(sk.skore, r.score * bonus * (SKUPINY[p.g]?.vaha ?? 1));
        if (sk.p.length < (SKUPINY[p.g]?.max ?? 4)) sk.p.push(p);
        skupiny.set(p.g, sk);
      }
      for (const [g, sk] of [...skupiny].sort((a, b) => b[1].skore - a[1].skore)) {
        html += `<p class="hl-skupina">${esc(g)}</p>` + sk.p.map((p) => riadok(odkaz(p), BEZ_PREKLADU.has(g) ? `<span translate="no">${zvyrazni(p.t, slova)}</span>` : zvyrazni(p.t, slova), popis(p), g, i++)).join('');
      }
      if (!najdene.length) html += `<p class="hl-prazdne">Nič sme nenašli. Skúste iné slovo alebo sa opýtajte asistenta.</p>`;
      html += `<p class="hl-skupina">Asistent</p><a class="hl-riadok hl-ai" role="option" id="hladanie-r${i++}" href="#" data-ai="1"><span class="hl-ikona" aria-hidden="true"></span><span class="hl-obsah"><span class="hl-nazov" translate="no">${esc(tr('AI asistent'))}: „${esc(q)}“</span><span class="hl-popis">odpovie z údajov webu a pridá odkazy</span></span></a>`;
    }
    vysl.innerHTML = html;
    riadky = [...vysl.querySelectorAll<HTMLAnchorElement>('.hl-riadok')];
    oznac(0);
  }

  function otvor() {
    if (dialog.open) return;
    dialog.showModal();
    vstup.select();
    hladaj();
  }
  function zavri() { if (dialog.open) dialog.close(); }

  function prejdi(a: HTMLAnchorElement) {
    if (a.dataset.ai) {
      const q = vstup.value.trim();
      zavri();
      window.dispatchEvent(new CustomEvent('asistent:otazka', { detail: q }));
      return;
    }
    const ciel = new URL(a.href);
    zavri();
    // rovnaká stránka: len zmena kotvy (mapa a stránky reagujú na hashchange)
    if (ciel.pathname === location.pathname && ciel.search === location.search) {
      if (location.hash === ciel.hash) window.dispatchEvent(new HashChangeEvent('hashchange'));
      else location.hash = ciel.hash;
      document.getElementById(decodeURIComponent(ciel.hash.slice(1)).split('&')[0])?.scrollIntoView({ behavior: 'smooth' });
    } else location.href = a.href;
  }

  const btn = document.getElementById('hladanie-otvor')!;
  btn.addEventListener('click', otvor);
  btn.addEventListener('pointerenter', () => nacitaj(), { once: true });
  document.getElementById('hladanie-zavri')!.addEventListener('click', zavri);
  dialog.addEventListener('click', (e) => { if (e.target === dialog) zavri(); });
  dialog.addEventListener('keydown', (e) => { if (e.key === 'Escape') { e.preventDefault(); zavri(); } });
  let casovac: number;
  vstup.addEventListener('input', () => { clearTimeout(casovac); casovac = window.setTimeout(hladaj, 60); });
  vstup.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowDown') { e.preventDefault(); oznac(Math.min(vybrany + 1, riadky.length - 1)); }
    else if (e.key === 'ArrowUp') { e.preventDefault(); oznac(Math.max(vybrany - 1, 0)); }
    else if (e.key === 'Enter' && riadky[vybrany]) { e.preventDefault(); prejdi(riadky[vybrany]); }
    else if (e.key === 'Escape') { e.preventDefault(); zavri(); }
  });
  vysl.addEventListener('click', (e) => {
    const a = (e.target as HTMLElement).closest<HTMLAnchorElement>('.hl-riadok');
    if (a && !(e as MouseEvent).ctrlKey && !(e as MouseEvent).metaKey) { e.preventDefault(); prejdi(a); }
  });
  vysl.addEventListener('pointermove', (e) => {
    const a = (e.target as HTMLElement).closest<HTMLAnchorElement>('.hl-riadok');
    if (a) oznac(riadky.indexOf(a));
  });
  document.addEventListener('keydown', (e) => {
    const t = e.target as HTMLElement;
    const pise = t.matches('input, textarea, select, [contenteditable]');
    if ((e.key === 'k' && (e.ctrlKey || e.metaKey)) || (e.key === '/' && !pise)) { e.preventDefault(); otvor(); }
  });
</script>

<style is:global>
  .hl-tlacidlo {
    display: flex; align-items: center; gap: 8px; flex-shrink: 0; margin-left: 16px;
    height: 36px; padding: 0 8px 0 10px; border: 1px solid var(--line); border-radius: 18px;
    background: var(--bg); color: var(--muted); font: inherit; font-size: 0.9rem; cursor: pointer;
  }
  .hl-tlacidlo:hover { border-color: var(--muted); color: var(--text); }
  .hl-tlacidlo:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .hl-tlacidlo svg, .hl-pole svg { width: 18px; height: 18px; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; flex-shrink: 0; }
  .hl-text { white-space: nowrap; }
  .hl-tlacidlo kbd, .hladanie-dialog kbd {
    font: inherit; font-size: 0.75rem; line-height: 1; padding: 3px 6px; border-radius: 5px;
    border: 1px solid var(--line); background: var(--card); color: var(--muted);
  }
  @media (max-width: 1400px) { .hl-text { display: none; } .hl-tlacidlo { width: 36px; padding: 0; justify-content: center; } .hl-tlacidlo kbd { display: none; } }

  .hladanie-dialog {
    width: min(680px, calc(100vw - 24px)); max-height: min(640px, calc(100dvh - 48px)); margin: 8vh auto auto; padding: 0;
    border: 1px solid var(--line); border-radius: 14px; background: var(--card); color: var(--text);
    box-shadow: 0 24px 60px -12px rgb(0 0 0 / 0.35);
  }
  .hladanie-dialog::backdrop { background: rgb(15 18 22 / 0.45); backdrop-filter: blur(2px); }
  .hladanie-dialog[open] { animation: hl-in 140ms ease-out; }
  @keyframes hl-in { from { opacity: 0; transform: translateY(-6px) scale(0.99); } }
  @media (prefers-reduced-motion: reduce) { .hladanie-dialog[open] { animation: none; } }
  @media (max-width: 600px) { .hladanie-dialog { margin: 0; width: 100vw; max-width: 100vw; max-height: 100dvh; height: 100dvh; border-radius: 0; border: 0; } }
  .hl-panel { display: flex; flex-direction: column; max-height: inherit; height: 100%; }
  .hl-pole { display: flex; align-items: center; gap: 10px; padding: 14px 16px; border-bottom: 1px solid var(--line); color: var(--muted); }
  .hl-pole input { flex: 1; min-width: 0; border: 0; outline: 0; background: transparent; color: var(--text); font: inherit; font-size: 1.15rem; }
  .hl-pole input::-webkit-search-cancel-button { display: none; }
  .hladanie-zavri { border: 1px solid var(--line); background: var(--bg); color: var(--muted); border-radius: 6px; font: inherit; font-size: 0.75rem; padding: 4px 8px; cursor: pointer; }
  .hladanie-vysledky { overflow-y: auto; padding: 4px 8px 10px; overscroll-behavior: contain; flex: 1; }
  .hl-skupina { margin: 12px 8px 4px; font-size: 0.8rem; font-weight: 600; color: var(--muted); }
  .hl-riadok { display: flex; gap: 12px; align-items: flex-start; padding: 8px 10px; border-radius: 8px; text-decoration: none; color: var(--text); border-left: 3px solid transparent; }
  .hl-riadok[aria-selected='true'] { background: color-mix(in srgb, var(--accent) 9%, transparent); border-left-color: var(--accent); }
  .hl-obsah { display: flex; flex-direction: column; min-width: 0; }
  .hl-nazov { font-weight: 600; overflow: hidden; text-overflow: ellipsis; }
  .hl-nazov mark { background: none; color: var(--accent); text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 3px; }
  .hl-popis { font-size: 0.85rem; color: var(--muted); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .hl-prazdne { margin: 16px 10px 4px; color: var(--muted); }
  /* ikona podľa skupiny – malá geometrická značka, nie emoji */
  .hl-ikona { width: 10px; height: 10px; margin-top: 6px; flex-shrink: 0; border-radius: 50%; background: var(--muted); }
  .hl-riadok[data-g='Stránky'] .hl-ikona { border-radius: 2px; background: var(--text); }
  .hl-riadok[data-g='Miesta'] .hl-ikona { background: var(--accent); }
  .hl-riadok[data-g='Ulice'] .hl-ikona { border-radius: 2px; height: 4px; margin-top: 9px; background: var(--accent); }
  .hl-riadok[data-g='Katalóg dát'] .hl-ikona { border-radius: 2px; background: none; border: 2px solid var(--muted); width: 8px; height: 8px; }
  .hl-riadok[data-g='Poslanci'] .hl-ikona { background: #1f6fd1; }
  .hl-riadok[data-g='Mestské časti'] .hl-ikona { border-radius: 2px; transform: rotate(45deg); background: var(--text); }
  .hl-ai .hl-ikona { background: linear-gradient(135deg, var(--accent), #1f6fd1); }
  .hl-pata { display: flex; gap: 16px; margin: 0; padding: 10px 16px; border-top: 1px solid var(--line); font-size: 0.8rem; color: var(--muted); }
  .hl-pata kbd { margin-right: 3px; }
  @media (max-width: 600px) { .hl-pata { display: none; } }
</style>
