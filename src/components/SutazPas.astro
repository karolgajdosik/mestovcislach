---
// Upútavka na Súťaž miest na úvodnej stránke: priebežné poradie tohto týždňa (functions/api/sutaz.ts) a tlačidlo hrať.
import { MESTA } from '../mesta';
const mesta = Object.fromEntries(MESTA.filter((m) => m.aktivne).map((m) => [m.slug, m.nazov]));
---
<section class="sp" aria-labelledby="sp-h" data-mesta={JSON.stringify(mesta)}>
  <div class="sp-text">
    <p class="sp-stitok"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 21h8M12 17v4M7 4h10v4a5 5 0 0 1-10 0z"/><path d="M7 6H4v1a3 3 0 0 0 3 3M17 6h3v1a3 3 0 0 1-3 3"/></svg> Súťaž miest</p>
    <h2 id="sp-h">Ktoré mesto vyhrá tento týždeň?</h2>
    <p>Päť otázok o krajských mestách, rovnakých pre všetkých. Hrajte za svoje mesto – rozhoduje priemer bodov.</p>
    <p class="sp-poradie" id="sp-poradie" aria-live="polite"></p>
  </div>
  <a class="sp-hraj" href="/sutaz">Hrať za svoje mesto <span aria-hidden="true">→</span></a>
</section>

<script>
  const sek = document.querySelector<HTMLElement>('.sp');
  if (sek) {
    const M: Record<string, string> = JSON.parse(sek.dataset.mesta!);
    fetch('/api/sutaz').then((r) => (r.ok ? r.json() : Promise.reject())).then((d) => {
      const tab = (t: Record<string, [number, number]>) => Object.entries(t ?? {}).filter(([, [h]]) => h > 0).map(([s, [h, b]]) => ({ s, h, p: b / h })).sort((a, b) => b.p - a.p || b.h - a.h);
      const akt = tab(d.tabulka), min = tab(d.minuly?.tabulka);
      const el = document.getElementById('sp-poradie')!;
      const f = (x: number) => x.toLocaleString('sk-SK', { maximumFractionDigits: 1 });
      if (akt.length) el.textContent = `Teraz vedie: ${akt.slice(0, 3).map((x, i) => `${i + 1}. ${M[x.s]} (${f(x.p)} b.)`).join(', ')}.`;
      else if (min.length) el.textContent = `Minulý týždeň vyhralo mesto ${M[min[0].s]}. Tento týždeň zatiaľ nikto nehral – buďte prvý.`;
      else el.textContent = 'Tento týždeň zatiaľ nikto nehral – buďte prvý.';
    }).catch(() => {});
  }
</script>

<style>
  .sp { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 14px 24px; margin: 0 0 24px; padding: 18px 20px; border-radius: 16px;
    background: linear-gradient(120deg, color-mix(in srgb, #d97706 14%, var(--card)), var(--card)); border: 1px solid color-mix(in srgb, #d97706 35%, var(--line)); }
  .sp-text { flex: 1 1 360px; }
  .sp-stitok { display: inline-flex; align-items: center; gap: 6px; margin: 0; font-size: 0.8rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; color: var(--muted); }
  .sp-stitok svg { width: 18px; height: 18px; fill: none; stroke: #d97706; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  .sp h2 { margin: 4px 0 6px; font-size: 1.25rem; }
  .sp p { margin: 0; }
  .sp-poradie { margin-top: 6px !important; font-weight: 600; }
  .sp-poradie:empty { display: none; }
  .sp-hraj { display: inline-flex; align-items: center; gap: 6px; min-height: 44px; padding: 0 18px; border-radius: 22px; background: var(--accent); color: var(--na-akcente, #fff); font-weight: 700; text-decoration: none; white-space: nowrap; }
  .sp-hraj:hover { filter: brightness(1.08); }
</style>
