---
// „Video a prelet“: krátke video „… v číslach“ (canvas, dá sa stiahnuť ako MP4/WebM) a 3D prelet nad územím (MapLibre, po kliknutí).
// Údaje pripraví stránka (obec, mestská časť, mesto) – komponent nič nesťahuje pri načítaní stránky okrem fotky do videa.
import type { VideoData } from '../scripts/video-obce';
import '../styles/obce.css';

interface Props {
  nazov: string;
  /** „nad obcou“, „nad mestskou časťou“, „nad mestom“ */
  nad: string;
  video: VideoData;
  prelet?: { stred: [number, number]; bbox?: [number, number, number, number] | null; km2?: number | null; titulky: [string, string][]; pamiatky?: { n: string; p: [number, number]; t: string; q: string; f?: { u: string; a: string; l: string; s: string }; w?: string }[] } | null;
}
const { nazov, nad, video, prelet } = Astro.props;
---
<section class="card pv" id="video" aria-labelledby="pv-h">
  <h2 id="pv-h">Video a prelet {nad}</h2>
  <div class="pv-mriezka">
    <div class="pv-video" data-video={JSON.stringify(video)}>
      <div class="pv-platno"><canvas width="1280" height="720" aria-label={`Video ${nazov} v číslach`} role="img"></canvas>
        <button type="button" class="pv-hraj" aria-label="Prehrať video"><span aria-hidden="true">▶</span></button>
      </div>
      <div class="pv-ovl">
        <button type="button" class="ob-akcia" data-v="hraj">▶ Prehrať</button>
        <label class="pv-format">Formát <select data-v="format"><option value="16x9">na šírku 16 : 9</option><option value="9x16">na výšku 9 : 16 (sociálne siete)</option></select></label>
        <button type="button" class="ob-akcia" data-v="stiahni">Stiahnuť video</button>
      </div>
      <p class="pozn pv-stav" aria-live="polite">Video sa skladá v prehliadači z údajov tejto stránky ({Math.round(video.snimky.length * 4)} s). Môžete ho stiahnuť a zdieľať – uveďte zdroj mestovcislach.sk.</p>
    </div>
    {prelet && (
      <div class="pr" data-prelet={JSON.stringify({ nazov, ...prelet })}>
        <div class="pr-uvod">
          <p><b>3D prelet {nad}</b> – kamera obletí územie s reliéfom terénu a zastaví sa pri významných pamiatkach a miestach – s titulkami a hovoreným slovom (slovenský hlas prehliadača). Mapou môžete kedykoľvek pohnúť sami.</p>
          <button type="button" class="ob-akcia pr-start">▶ Spustiť prelet</button>
        </div>
        <div class="pr-okno" hidden>
          <div class="pr-bok"><ol class="pr-kapitoly" aria-label="Zastávky preletu" hidden></ol></div>
          <div class="pr-scena">
          <div class="pr-mapa"></div>
          <div class="pr-titulok"><img class="pr-foto" alt="" hidden decoding="async" referrerpolicy="no-referrer" /><div class="pr-text"><b></b><span></span><small class="pr-kredit" hidden></small></div></div>
          <div class="pr-ovl">
            <button type="button" data-pr="spat" aria-label="Predchádzajúca zastávka" title="Predchádzajúca zastávka">⏮</button>
            <button type="button" data-pr="pauza">⏸ Pauza</button>
            <button type="button" data-pr="dalej" aria-label="Ďalšia zastávka" title="Ďalšia zastávka">⏭</button>
            <button type="button" data-pr="hlas" hidden>🔊 Hlas</button>
            <button type="button" data-pr="podklad">🛰 Letecká snímka</button>
            <button type="button" data-pr="cela" aria-label="Na celú obrazovku">⛶</button>
            <button type="button" data-pr="zavriet" aria-label="Zavrieť prelet">✕</button>
          </div>
          </div>
        </div>
        <p class="zdroj pr-zdroj" hidden></p>
      </div>
    )}
  </div>
</section>

<script>
  import { VideoObce, type VideoData } from '../scripts/video-obce';
  import { kedViditelne } from '../scripts/ked-viditelne';

  document.querySelectorAll<HTMLElement>('.pv-video').forEach((box) => {
    const canvas = box.querySelector('canvas')!;
    const d = JSON.parse(box.dataset.video!) as VideoData;
    const v = new VideoObce(canvas, d);
    const stav = box.querySelector<HTMLElement>('.pv-stav')!;
    const tlHraj = box.querySelector<HTMLButtonElement>('[data-v="hraj"]')!;
    const velke = box.querySelector<HTMLButtonElement>('.pv-hraj')!;
    const format = box.querySelector<HTMLSelectElement>('[data-v="format"]')!;
    const tlStiahni = box.querySelector<HTMLButtonElement>('[data-v="stiahni"]')!;
    let pripravene: Promise<void> | null = null;
    const priprav = () => (pripravene ??= v.priprav().then(() => v.nastavRozmer(canvas.width, canvas.height)));
    // fotka a prvý obrázok až keď je video blízko obrazovky
    kedViditelne(box, () => { priprav(); }, '300px');
    const tlacidla = () => { const h = v.jeHra(); tlHraj.textContent = h ? '⏸ Pauza' : '▶ Prehrať'; velke.hidden = h; };
    v.onCas = () => tlacidla();
    const hraj = async () => {
      await priprav();
      if (v.jeHra()) { v.pauza(); tlacidla(); return; }
      const od = v.aktualny() >= v.trvanie - 0.05 ? 0 : v.aktualny() > 0.7 ? v.aktualny() : 0;
      const p = v.hraj(od); tlacidla(); await p; tlacidla();
    };
    tlHraj.addEventListener('click', hraj);
    velke.addEventListener('click', hraj);
    format.addEventListener('change', () => {
      v.pauza();
      const vysoke = format.value === '9x16';
      box.classList.toggle('pv-vysoke', vysoke);
      v.nastavRozmer(vysoke ? 1080 : 1280, vysoke ? 1920 : 720);
      tlacidla();
    });
    tlStiahni.addEventListener('click', async () => {
      await priprav();
      tlStiahni.disabled = true; tlHraj.disabled = true; format.disabled = true;
      const povodny = stav.textContent;
      try {
        const { blob, pripona } = await v.nahraj((p) => { stav.textContent = `Nahrávam video… ${Math.round(p * 100)} %`; });
        const a = document.createElement('a');
        a.href = URL.createObjectURL(blob);
        a.download = `${d.slug}-v-cislach${format.value === '9x16' ? '-na-vysku' : ''}.${pripona}`;
        document.body.append(a); a.click();
        setTimeout(() => { URL.revokeObjectURL(a.href); a.remove(); }, 2000);
        stav.textContent = `Hotovo – video sa stiahlo (${pripona.toUpperCase()}, ${(blob.size / 1e6).toLocaleString('sk-SK', { maximumFractionDigits: 1 })} MB).`;
      } catch (e) {
        stav.textContent = `Video sa nepodarilo nahrať: ${(e as Error).message} Skúste iný prehliadač (Chrome, Edge, Safari).`;
        setTimeout(() => { stav.textContent = povodny; }, 8000);
      } finally {
        tlStiahni.disabled = false; tlHraj.disabled = false; format.disabled = false; tlacidla();
      }
    });
  });

  document.querySelectorAll<HTMLElement>('.pr').forEach((el) => {
    el.querySelector('.pr-start')?.addEventListener('click', () => {
      // iPhone/Safari: reč sa musí „odomknúť“ priamo v kliknutí, inak neskôr nezaznie
      try { if ('speechSynthesis' in window) { const u = new SpeechSynthesisUtterance(' '); u.volume = 0; window.speechSynthesis.speak(u); } } catch { /* bez hlasu */ }
      import('../scripts/prelet').then(({ spustiPrelet }) => spustiPrelet(el)).catch(() => {
        const t = el.querySelector('.pr-titulok b');
        if (t) t.textContent = 'Mapu sa nepodarilo načítať.';
      });
    }, { once: true });
  });
</script>

<style>
  .pv-mriezka { display: grid; gap: 18px; grid-template-columns: minmax(0, 1fr); }
  /* položky mriežky nesmú rásť podľa obsahu (dlhý pás zastávok by roztiahol mapu na tisíce px) */
  .pv-mriezka > * { min-width: 0; }
  @media (min-width: 960px) { .pv-mriezka:has(.pr) { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); } }
  .pv-platno { position: relative; border-radius: 14px; overflow: hidden; background: #1d2433; }
  .pv-platno canvas { display: block; width: 100%; height: auto; aspect-ratio: 16 / 9; }
  .pv-vysoke .pv-platno { max-width: 360px; margin: 0 auto; }
  .pv-vysoke .pv-platno canvas { aspect-ratio: 9 / 16; }
  .pv-hraj { position: absolute; inset: 0; margin: auto; width: 76px; height: 76px; border-radius: 50%; border: 0; background: rgba(224, 40, 63, 0.92); color: #fff; font-size: 30px; cursor: pointer; box-shadow: 0 6px 22px rgba(0, 0, 0, 0.35); }
  .pv-hraj[hidden] { display: none; }
  .pv-ovl { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; margin-top: 10px; }
  .pv-format { display: inline-flex; align-items: center; gap: 6px; font-size: 0.85rem; font-weight: 600; }
  .pv-format select { font: inherit; padding: 6px 8px; border: 1px solid var(--line); border-radius: 10px; background: var(--card); color: var(--text); }
  .pr-uvod { display: flex; flex-direction: column; gap: 10px; align-items: flex-start; height: 100%; justify-content: center; padding: 18px; border: 1px dashed var(--line); border-radius: 14px; background: var(--bg); }
  .pr-uvod p { margin: 0; }
  .pr-uvod[hidden] { display: none; }
  /* otvorený prelet na celú šírku sekcie */
  .pr.pr-otvoreny { grid-column: 1 / -1; }
  .pr-okno { position: relative; border-radius: 14px; overflow: hidden; background: #1d2433; }
  .pr-okno[hidden] { display: none; }
  .pr-mapa { width: 100%; aspect-ratio: 16 / 9; }
  .pr-okno:fullscreen, .pr-okno:-webkit-full-screen { border-radius: 0; }
  .pr-okno:fullscreen .pr-mapa, .pr-okno:-webkit-full-screen .pr-mapa { aspect-ratio: auto; height: 100vh; height: 100dvh; }
  /* náhradná „celá obrazovka“ (iPhone): pevné okno cez celý prehliadač */
  .pr-okno.pr-max { position: fixed; inset: 0; z-index: 2000; border-radius: 0; }
  .pr-okno.pr-max .pr-mapa { aspect-ratio: auto; height: 100vh; height: 100dvh; }
  :global(html.pr-max-otvorene) { overflow: hidden; }
  /* sekcia má content-visibility (obce.css) – pri maximalizácii ju vypnúť, inak by pevné okno ostalo orezané v sekcii */
  .pv:has(.pr-okno.pr-max), .pv:has(.pr-okno:fullscreen) { content-visibility: visible; contain: none; }
  .pr-titulok { position: absolute; left: 12px; bottom: 30px; max-width: calc(100% - 24px); padding: 10px 14px; border-radius: 12px; background: rgba(15, 18, 26, 0.78); color: #fff; display: flex; flex-direction: column; gap: 2px; pointer-events: none; transition: opacity 0.4s; }
  .pr-titulok { flex-direction: row; align-items: center; gap: 12px; }
  .pr-text { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
  .pr-foto { width: 88px; height: 62px; object-fit: cover; border-radius: 8px; flex: none; background: #333; }
  .pr-foto[hidden], .pr-kredit[hidden] { display: none; }
  .pr-kredit { font-size: 0.68rem; opacity: 0.7; }
  @media (max-width: 600px) { .pr-foto { width: 64px; height: 52px; } .pr-titulok span { font-size: 0.78rem; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; } }
  .pr-titulok b { font-size: 1.1rem; }
  .pr-titulok span { font-size: 0.85rem; opacity: 0.88; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
  .pr-titulok.pr-skryty { opacity: 0; }
  .pr-ovl { position: absolute; left: 12px; top: 12px; right: 52px; display: flex; flex-wrap: wrap; gap: 6px; }
  .pr-ovl button:disabled { opacity: 0.7; cursor: default; }
  .pr-ovl button { min-height: 34px; padding: 0 12px; border: 0; border-radius: 17px; background: rgba(15, 18, 26, 0.78); color: #fff; font: inherit; font-size: 0.85rem; font-weight: 700; cursor: pointer; }
  .pr-ovl button[hidden] { display: none; }
  /* okno: vľavo stále viditeľný zoznam zastávok, vpravo scéna (mapa + titulok + ovládanie) */
  .pr-okno:not([hidden]) { display: flex; }
  .pr-scena { position: relative; flex: 1; min-width: 0; }
  .pr-bok { position: relative; flex: none; width: 210px; background: #1d2433; border-right: 1px solid rgba(255, 255, 255, 0.1); }
  .pr-bok:not(:has(.pr-kapitoly:not([hidden]))) { display: none; }
  .pr-kapitoly { position: absolute; inset: 0; margin: 0; padding: 10px 6px; list-style: none; display: flex; flex-direction: column; gap: 1px; overflow-y: auto; scrollbar-width: thin; scrollbar-color: rgba(255, 255, 255, 0.3) transparent; }
  .pr-kapitoly[hidden] { display: none; }
  .pr-kapitoly::before { content: 'Zastávky'; padding: 0 6px 4px; color: rgba(255, 255, 255, 0.55); font-size: 0.66rem; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; }
  /* položky vytvára skript – bez atribútu Astro, preto :global */
  .pr-kapitoly :global(li) { flex: none; }
  .pr-kapitoly :global(button) { display: flex; align-items: center; gap: 6px; width: 100%; min-height: 26px; padding: 2px 6px; border: 0; border-radius: 6px; background: transparent; color: rgba(255, 255, 255, 0.88); font: inherit; font-size: 0.74rem; font-weight: 500; line-height: 1.2; text-align: left; cursor: pointer; }
  .pr-kapitoly :global(button:hover) { background: rgba(255, 255, 255, 0.1); color: #fff; }
  .pr-kapitoly :global(button.pr-akt) { background: #e0283f; color: #fff; font-weight: 700; }
  .pr-kapitoly :global(img) { width: 26px; height: 20px; flex: none; object-fit: cover; border-radius: 3px; background: #333; }
  .pr-kapitoly :global(span) { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  /* značka pri aktuálnej pamiatke (vytvára skript) */
  :global(.pr-znacka) { width: 26px; height: 34px; pointer-events: none; }
  :global(.pr-znacka span) { display: block; width: 26px; height: 26px; border-radius: 50% 50% 50% 0; background: #e0283f; border: 3px solid #fff; transform: rotate(-45deg); box-shadow: 0 3px 10px rgba(0, 0, 0, 0.4); animation: pr-pulz 1.6s ease-in-out infinite; }
  @keyframes -global-pr-pulz { 50% { transform: rotate(-45deg) scale(1.15); } }
  /* zväčšený režim: rovnaký zoznam, len o kúsok väčšie písmo */
  .pr-okno.pr-velke .pr-bok { width: 240px; }
  .pr-okno.pr-velke .pr-kapitoly { padding: 14px 8px; }
  .pr-okno.pr-velke .pr-kapitoly :global(button) { min-height: 30px; font-size: 0.8rem; }
  .pr-okno.pr-velke .pr-kapitoly :global(img) { width: 32px; height: 24px; }
  .pr-okno.pr-velke .pr-titulok { bottom: 28px; max-width: min(560px, calc(100% - 24px)); }
  .pr-okno.pr-velke .pr-foto { width: 128px; height: 90px; }
  /* úzke okno (mobil): mapa hore, pod ňou stále viditeľný zoznam malým písmom pod sebou */
  @media (max-width: 760px) {
    .pr-okno:not([hidden]) { flex-direction: column; }
    .pr-bok, .pr-okno.pr-velke .pr-bok { order: 2; width: auto; border-right: 0; border-top: 1px solid rgba(255, 255, 255, 0.1); }
    .pr-kapitoly { position: static; padding: 8px 6px; }
    .pr-okno.pr-velke .pr-scena { flex: none; }
    .pr-okno.pr-velke .pr-mapa { height: 62vh !important; height: 62dvh !important; }
    .pr-okno.pr-velke .pr-bok { flex: 1; min-height: 0; }
    .pr-okno.pr-velke .pr-kapitoly { position: absolute; inset: 0; }
    .pr-okno.pr-velke .pr-foto { width: 64px; height: 48px; }
    /* titulok pod mapou (nie cez ňu), aby nezakrýval pamiatku */
    .pr-titulok, .pr-okno.pr-velke .pr-titulok { position: static; max-width: none; border-radius: 0; background: #262e40; padding: 8px 10px; }
    .pr-titulok.pr-skryty { display: none; }
    .pr-titulok span { -webkit-line-clamp: 2; }
  }
  /* mobil: vyššia mapa, aby sa ovládanie a titulok neprekrývali */
  @media (max-width: 600px) {
    .pr-mapa { aspect-ratio: 1 / 1; max-height: 62vh; }
    .pr-okno.pr-max .pr-mapa, .pr-okno:fullscreen .pr-mapa { max-height: none; }
    .pr-ovl { right: 46px; gap: 4px; }
    .pr-ovl button { min-height: 32px; padding: 0 10px; font-size: 0.8rem; }
    .pr-titulok { left: 8px; bottom: 24px; max-width: calc(100% - 16px); padding: 8px 10px; }
    .pr-titulok b { font-size: 0.98rem; }
  }
</style>
