---
// Pás s fotografiou na vrchu podstránok mesta (Život v meste, Samospráva, Moja adresa, sekcie Bratislavy…).
// Fotky a autori: src/lib/fotky.ts. Vkladá ho Base.astro podľa adresy stránky (fotoPreStranku).
import { foto } from '../lib/fotky';
const { kluc, popis } = Astro.props as { kluc: string; popis: string };
const f = foto(kluc);
---
{f && (
  <figure class="foto-pas">
    <img src={f.src} srcset={f.srcset} sizes="(max-width: 1100px) 100vw, 1040px" alt={popis} decoding="async" fetchpriority="high" width="1600" height="500" />
    <figcaption>Foto: <a href={f.zdroj} rel="noopener">{f.autor}</a>, {f.licenciaUrl ? <a href={f.licenciaUrl} rel="noopener license">{f.licencia}</a> : f.licencia}, Wikimedia Commons</figcaption>
  </figure>
)}

<style>
  .foto-pas { position: relative; margin: 20px 0 0; height: clamp(120px, 17vw, 190px); border-radius: 16px; overflow: hidden; background: var(--line); }
  .foto-pas img { width: 100%; height: 100%; object-fit: cover; object-position: center 55%; display: block; }
  .foto-pas figcaption { position: absolute; right: 8px; bottom: 5px; font-size: 0.66rem; color: rgba(255, 255, 255, 0.92); text-shadow: 0 1px 3px rgba(0, 0, 0, 0.85); max-width: 85%; text-align: right; }
  .foto-pas figcaption a { color: inherit; }
  @media (max-width: 600px) { .foto-pas { margin: 12px -4px 0; border-radius: 12px; } }
</style>
