---
import Asistent from '../components/Asistent.astro';
interface Props {
  title: string;
  description?: string;
}
const { title, description = 'Otvorené dáta o slovenských mestách a obciach – prehľadne a so zdrojmi.' } = Astro.props;
// Náhľadový obrázok pri zdieľaní (public/og/<sekcia>.png, generuje scripts/og_obrazky.py)
const OG = ['mapa', 'obyvatelia', 'volby', 'financie', 'doprava', 'vybavenost', 'prostredie', 'bezpecnost', 'katalog'];
const sekcia = Astro.url.pathname.split('/').filter(Boolean)[0] ?? '';
const ogObrazok = new URL(`/og/${OG.includes(sekcia) ? sekcia : 'index'}.png`, Astro.site ?? 'https://mestovcislach.sk');
const adresa = new URL(Astro.url.pathname, Astro.site ?? 'https://mestovcislach.sk');
---
<!doctype html>
<html lang="sk">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={adresa} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="mestovčíslach.sk" />
    <meta property="og:locale" content="sk_SK" />
    <meta property="og:title" content={title.replace(/ – mestovcislach\.sk$/, '')} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={adresa} />
    <meta property="og:image" content={ogObrazok} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <header class="top">
      <div class="wrap">
        <a class="logo" href="/">mesto<span>v</span>číslach</a>
        <nav>
          {[['/', 'Prehľad'], ['/mapa', 'Mapa'], ['/obyvatelia', 'Obyvatelia'], ['/volby', 'Voľby'], ['/financie', 'Financie'], ['/doprava', 'Doprava'], ['/vybavenost', 'Vybavenosť'], ['/prostredie', 'Prostredie'], ['/bezpecnost', 'Bezpečnosť'], ['/katalog', 'Katalóg dát']].map(([href, text]) => (
            <a href={href} aria-current={Astro.url.pathname.replace(/\/$/, '') === href.replace(/\/$/, '') || (href === '/katalog' && Astro.url.pathname.startsWith('/katalog/')) ? 'page' : undefined}>{text}</a>
          ))}
        </nav>
      </div>
    </header>
    <div class="zive" aria-label="Živé údaje o Bratislave">
      <div class="wrap zive-obsah">
        <span class="zive-titul"><i></i>Teraz</span>
        <span class="chip" id="z-pocasie" title="Počasie v Bratislave (Open-Meteo)">…</span>
        <a class="chip" id="z-vystrahy" href="/#dnes" title="Výstrahy SHMÚ pre Bratislavu">Výstrahy …</a>
        <a class="chip" id="z-ovzdusie" href="/prostredie#ovzdusie-teraz" title="Index kvality ovzdušia zo staníc SHMÚ v Bratislave">Ovzdušie …</a>
        <a class="chip" id="z-dunaj" href="/prostredie#dunaj" title="Vodný stav Dunaja v Bratislave (SHMÚ)">Dunaj …</a>
        <a class="chip" id="z-morava" href="/prostredie#morava" title="Vodný stav Moravy v Devínskej Novej Vsi (SHMÚ)" hidden></a>
        <a class="chip" id="z-cesty" href="/doprava#naozivo" title="Uzávierky a poruchy na cestách (hlavné mesto)">Cesty …</a>
      </div>
    </div>
    <main class="wrap">
      <slot />
    </main>
    <footer class="wrap foot">
      <p>
        mestovcislach.sk zbiera verejne dostupné otvorené dáta. Pri každom údaji je uvedený zdroj.
        Kód je otvorený na <a href="https://github.com/karolgajdosik/mestovcislach">GitHube</a>. Všetky datasety mesta a čo s nimi robíme: <a href="/katalog">Katalóg dát</a>.
        Živá lišta: počasie <a href="https://open-meteo.com">Open-Meteo</a> (CC BY 4.0), výstrahy, ovzdušie a Dunaj <a href="https://www.shmu.sk">SHMÚ</a>, cesty hlavné mesto SR Bratislava.
      </p>
    </footer>
    <Asistent />
  </body>
</html>

<script>
  import { pocasie, vystrahy, dunaj, cesty, stupenDunaja, javVystrahy, ovzdusie, farbaOvzdusia } from '../scripts/zive';
  const chip = (id: string, html: string, stav = '') => {
    const el = document.getElementById(id);
    if (!el) return;
    el.innerHTML = html;
    if (stav) el.dataset.stav = stav;
  };
  const sipka = (t: string) => (t === 'stúpa' ? ' ↑' : t === 'klesá' ? ' ↓' : '');
  pocasie().then((p) => chip('z-pocasie', `<b>${p.teplota} °C</b> ${p.stav} <small>${p.min}/${p.max} °C</small>`))
    .catch(() => document.getElementById('z-pocasie')?.remove());
  vystrahy().then((d) => {
    const v = d.vystrahy ?? [];
    if (!v.length) return chip('z-vystrahy', 'Výstrahy: <b>žiadne</b>', 'ok');
    const naj = v[0];
    const javy = [...new Set(v.map((x: any) => javVystrahy(x.udalost)))];
    chip('z-vystrahy', `Výstraha: <b>${javy.join(', ')}</b> · ${naj.stupen}`, naj.farba);
  }).catch(() => chip('z-vystrahy', 'Výstrahy: –'));
  dunaj().then((d) => {
    const s = stupenDunaja(d);
    chip('z-dunaj', `Dunaj <b>${d.stav} cm</b>${sipka(d.trend)}${s ? ` · ${s}. stupeň` : ''}`, s === 3 ? 'red' : s === 2 ? 'orange' : s === 1 ? 'yellow' : 'ok');
  }).catch(() => chip('z-dunaj', 'Dunaj: –'));
  // Morava sa v lište ukáže len pri povodňovej aktivite
  fetch('/api/dunaj?rieka=morava').then((r) => (r.ok ? r.json() : Promise.reject())).then((d) => {
    const s = [3, 2, 1].find((k) => d.spa?.[k] && d.stav >= d.spa[k]);
    if (!s) return;
    const e = document.getElementById('z-morava');
    if (e) e.hidden = false;
    chip('z-morava', `Morava <b>${d.stav} cm</b>${sipka(d.trend)} · ${s}. stupeň`, s === 3 ? 'red' : s === 2 ? 'orange' : 'yellow');
  }).catch(() => {});
  ovzdusie().then((d) => {
    if (!d.mesto) return chip('z-ovzdusie', 'Ovzdušie: –');
    chip('z-ovzdusie', `Ovzdušie: <b>${d.mesto.kategoria.nazov}</b>`, farbaOvzdusia(d.mesto.kategoria.stupen));
  }).catch(() => chip('z-ovzdusie', 'Ovzdušie: –'));
  cesty().then((c) => chip('z-cesty', `Cesty: <b>${c.uzavierky}</b> uzávierok${c.uplne ? ` (${c.uplne} úplných)` : ''} · <b>${c.poruchy}</b> porúch`, c.uplne ? 'orange' : ''))
    .catch(() => chip('z-cesty', 'Cesty: –'));
</script>

<style is:global>
  [hidden] { display: none !important; }
  :root {
    --bg: #f7f7f5;
    --card: #ffffff;
    --text: #1b1d21;
    --muted: #5d636e;
    --line: #e3e4e0;
    --accent: #c8102e;
    --accent-soft: #c8102e1a;
    --font: system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #121417;
      --card: #1b1e23;
      --text: #eceef1;
      --muted: #9aa1ad;
      --line: #2c3037;
      --accent: #ff4d63;
      --accent-soft: #ff4d6326;
    }
  }
  * { box-sizing: border-box; }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--text);
    font: 16px/1.55 var(--font);
    -webkit-font-smoothing: antialiased;
  }
  a { color: inherit; text-underline-offset: 3px; }
  .wrap { max-width: 1040px; margin: 0 auto; padding: 0 16px; }
  /* Hlavička a živá lišta ostávajú navrchu aj pri rolovaní (nad mapami Leaflet, ktoré majú z-index do 1000). */
  html { scroll-padding-top: 108px; }
  .top { border-bottom: 1px solid var(--line); background: var(--card); position: sticky; top: 0; z-index: 1100; }
  .top .wrap { display: flex; justify-content: space-between; align-items: center; height: 56px; }
  .logo { font-weight: 800; font-size: 1.15rem; text-decoration: none; letter-spacing: -0.02em; }
  .logo span { color: var(--accent); }
  .top nav { display: flex; gap: 18px; overflow-x: auto; scrollbar-width: none; margin-left: 16px; }
  .top nav::-webkit-scrollbar { display: none; }
  @media (max-width: 480px) { .top nav { gap: 14px; padding-right: 18px; -webkit-mask-image: linear-gradient(to right, #000 85%, transparent); mask-image: linear-gradient(to right, #000 85%, transparent); } .top nav a { font-size: 0.88rem; white-space: nowrap; } .logo { font-size: 1.05rem; flex-shrink: 0; } }
  .top nav a { color: var(--muted); text-decoration: none; font-size: 0.95rem; padding: 4px 0; border-bottom: 2px solid transparent; }
  .top nav a[aria-current='page'] { color: var(--text); border-bottom-color: var(--accent); }
  .zive { background: var(--bg); border-bottom: 1px solid var(--line); font-size: 0.82rem; position: sticky; top: 56px; z-index: 1099; }
  .zive-obsah { display: flex; align-items: center; gap: 8px; height: 40px; overflow-x: auto; scrollbar-width: none; white-space: nowrap; }
  .zive-obsah::-webkit-scrollbar { display: none; }
  .zive-titul { color: var(--muted); font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; font-size: 0.7rem; display: inline-flex; align-items: center; gap: 6px; flex-shrink: 0; }
  .zive-titul i { width: 7px; height: 7px; border-radius: 50%; background: #1a7f4b; box-shadow: 0 0 0 3px #1a7f4b33; animation: pulz 2s infinite; }
  @keyframes pulz { 50% { box-shadow: 0 0 0 5px #1a7f4b11; } }
  @media (prefers-reduced-motion: reduce) { .zive-titul i { animation: none; } }
  .chip { display: inline-flex; align-items: center; gap: 4px; padding: 3px 10px; border: 1px solid var(--line); border-radius: 999px; background: var(--card); color: var(--text); text-decoration: none; flex-shrink: 0; }
  .chip small { color: var(--muted); }
  a.chip:hover { border-color: var(--accent); }
  .chip[data-stav]::before { content: ''; width: 7px; height: 7px; border-radius: 50%; margin-right: 2px; background: var(--muted); }
  .chip[data-stav='ok']::before { background: #1a7f4b; }
  .chip[data-stav='yellow']::before { background: #e6b800; }
  .chip[data-stav='orange']::before { background: #f08c00; }
  .chip[data-stav='red']::before { background: #d0021b; }
  .foot { color: var(--muted); font-size: 0.85rem; padding-top: 48px; padding-bottom: 48px; }
  .card { background: var(--card); border: 1px solid var(--line); border-radius: 14px; padding: 20px; }
  .zdroj { color: var(--muted); font-size: 0.8rem; margin: 12px 0 0; }
  /* Podkladová mapa OSM: tlmená, aby vynikli údaje; v tmavom režime invertovaná. */
  /* Okno s podrobnosťami o mieste na mape (src/scripts/miesto.ts) */
  .leaflet-popup-content .mf { display: flex; flex-direction: column; gap: 3px; min-width: 200px; max-width: 260px; font-size: 13px; line-height: 1.4; }
  .mf-foto { display: block; margin: -2px 0 6px; }
  .mf-foto img { display: block; width: 100%; height: 150px; object-fit: cover; border-radius: 6px; background: #eee; }
  .mf-nazov { font-size: 14px; }
  .mf-kat, .mf-hod, .mf-zdroj { color: #5d636e; }
  .mf-hod { font-size: 12px; }
  .mf-zdroj { font-size: 11px; }
  .mf-otv { font-weight: 600; }
  .mf-otv.ano { color: #1a7f4b; }
  .mf-otv.nie { color: #c8102e; }
  .mf-odkazy { margin-top: 4px; }
  .podklad-osm { filter: grayscale(1) contrast(0.85) brightness(1.08); }
  @media (prefers-color-scheme: dark) { .podklad-osm { filter: grayscale(1) invert(1) brightness(0.8) contrast(0.85); } }
</style>
