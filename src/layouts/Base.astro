---
import fs from 'node:fs';
import path from 'node:path';
import Asistent from '../components/Asistent.astro';
import Hladanie from '../components/Hladanie.astro';
import Zobrazenie from '../components/Zobrazenie.astro';
import Jazyk from '../components/Jazyk.astro';
import { MESTA, mestoZCesty, jeSpolocna } from '../mesta';
import { maMapu, maSamospravu } from '../lib/mapa';
import { maZivot } from '../lib/temy';
import FotoPas from '../components/FotoPas.astro';
import Rozcestnik from '../components/Rozcestnik.astro';
import { fotoPreStranku } from '../lib/fotky';
interface Props {
  title: string;
  description?: string;
  /** štruktúrované údaje schema.org (JSON-LD) pre vyhľadávače */
  jsonld?: Record<string, any> | Record<string, any>[];
}
const { title: celyTitulok, description = 'Otvorené dáta o slovenských mestách a obciach – prehľadne a so zdrojmi.', jsonld } = Astro.props;
// vyhľadávače zobrazia ~60 znakov – dlhý prvý diel titulku (napr. názov datasetu) skrátime, prípona ostane
// pri dlhom titulku vypadne „Katalóg dát“ a pod. (názov sa neskracuje, aby titulky ostali jedinečné)
const title = celyTitulok.length <= 75 ? celyTitulok : celyTitulok.replace(/ – (Katalóg dát|Život v meste|Samospráva)(?= – [^–]+ – mestovcislach\.sk$| – mestovcislach\.sk$)/, '');
// Náhľadový obrázok pri zdieľaní (public/og/<sekcia>.png, generuje scripts/og_obrazky.py)
// Hlavné menu: odkaz, názov, ikona (SVG cesty, ťah 1.8)
const MENU_MESTA: [string, string, string][] = [
  ['', 'Prehľad', '<path d="M3.5 11 12 4l8.5 7"/><path d="M5.5 9.5V20h4.5v-5.5h4V20h4.5V9.5"/>'],
  ['mestske-casti', 'Mestské časti', '<path d="M4 4.5h7v7H4zM13 4.5h7v4.5h-7zM13 11h7v8.5h-7zM4 13.5h7v6H4z"/>'],
  ['mapa', 'Mapa', '<path d="M9 4.5 3.5 6.5v13l5.5-2 6 2 5.5-2v-13l-5.5 2-6-2Z"/><path d="M9 4.5v13M15 6.5v13"/>'],
  ['adresa', 'Moja adresa', '<path d="M12 21s-6.5-5.6-6.5-11a6.5 6.5 0 0 1 13 0c0 5.4-6.5 11-6.5 11Z"/><path d="M9.3 10.4 12 8l2.7 2.4V13H9.3Z"/>'],
  ['obyvatelia', 'Obyvatelia', '<circle cx="9" cy="8" r="3.3"/><path d="M2.8 20c.6-3.5 3.1-5.4 6.2-5.4s5.6 1.9 6.2 5.4"/><circle cx="17" cy="9" r="2.5"/><path d="M17 14.6c2.2.2 3.8 1.8 4.3 4.4"/>'],
  ['volby', 'Voľby', '<path d="M4 11h16v9H4z"/><path d="M8 11V4h8v7"/><path d="m10 7.6 1.4 1.4L14.2 6"/>'],
  ['financie', 'Financie', '<ellipse cx="12" cy="6" rx="7" ry="2.5"/><path d="M5 6v6c0 1.4 3.1 2.5 7 2.5s7-1.1 7-2.5V6"/><path d="M5 12v6c0 1.4 3.1 2.5 7 2.5s7-1.1 7-2.5v-6"/>'],
  ['doprava', 'Doprava', '<rect x="5" y="3.5" width="14" height="13.5" rx="3"/><path d="M5 10h14M8 17v3M16 17v3"/><circle cx="8.6" cy="13.4" r=".9"/><circle cx="15.4" cy="13.4" r=".9"/>'],
  ['vystavba', 'Výstavba', '<path d="M3 20h18M5 20V9l5-3v14M10 9h9v11M13 12h3M13 15h3M8 2.5v3.5"/><path d="M4 4.5l4-2 9 3"/>'],
  ['vybavenost', 'Vybavenosť', '<path d="M4 20V8.5L12 4l8 4.5V20"/><path d="M9.5 20v-5h5v5M8 11h2M14 11h2M2.5 20h19"/>'],
  ['prostredie', 'Prostredie', '<path d="M5 19.5C5 11 10 6 20 4.5 19 14 14 19.5 5.5 19.5Z"/><path d="M5 19.5c2.8-4 6-7 10-9.2"/>'],
  ['bezpecnost', 'Bezpečnosť', '<path d="M12 3 5 6v5.2c0 4.4 3 8.2 7 9.8 4-1.6 7-5.4 7-9.8V6l-7-3Z"/><path d="m9 12 2 2 4-4.2"/>'],
  ['katalog', 'Katalóg dát', '<ellipse cx="12" cy="5.5" rx="7" ry="2.5"/><path d="M5 5.5v13c0 1.4 3.1 2.5 7 2.5s7-1.1 7-2.5v-13"/><path d="M5 12c0 1.4 3.1 2.5 7 2.5s7-1.1 7-2.5"/>'],
];
const mesto = mestoZCesty(Astro.url.pathname);
// Nové podstránky pre všetky mestá (src/pages/[mesto]/…): zobrazia sa, len ak má mesto potrebné dáta
const maSubor = (...p: string[]) => fs.existsSync(path.join(process.cwd(), ...p));
const castiOsm = (() => { try { return Object.keys(JSON.parse(fs.readFileSync(path.join(process.cwd(), 'data', 'mesta', 'casti-osm.json'), 'utf-8')).mesta); } catch { return []; } })();
const NOVE: [string, string, string, boolean][] = [
  ['odchody', 'Odchody MHD', '<rect x="5" y="3.5" width="14" height="14" rx="3"/><path d="M5 11h14M8.5 14.5h.01M15.5 14.5h.01M8 17.5 6.5 20.5M16 17.5l1.5 3"/>', maSubor('data', 'odchody', `${mesto.slug}.json`)],
  ['dosah', 'Kam sa dostanem', '<circle cx="12" cy="12" r="8.5"/><circle cx="12" cy="12" r="4.5"/><circle cx="12" cy="12" r="1"/>', maSubor('data', 'dosah', `${mesto.slug}.json`)],
  ['novinky', 'Čo je nové', '<path d="M5 4.5h11.5a2 2 0 0 1 2 2V19a1.5 1.5 0 0 0 3 0V9.5h-3"/><path d="M5 4.5V19a1.5 1.5 0 0 0 1.5 1.5h14.5M8.5 8.5h6M8.5 12h6M8.5 15.5h4"/>', true],
  ['kalendar', 'Kalendár', '<rect x="3.5" y="5" width="17" height="15.5" rx="2.5"/><path d="M3.5 10h17M8 3v4M16 3v4M7.5 14h2M11 14h2M14.5 14h2M7.5 17h2M11 17h2"/>', true],
  ['zastupitelstvo', 'Zastupiteľstvo', '<path d="M3 20.5h18M4.5 9.5h15M12 3.5l8 4.5H4z"/><path d="M6.5 9.5v8.5M10 9.5v8.5M14 9.5v8.5M17.5 9.5v8.5"/>', true],
  ['skoly', 'Školy', '<path d="m2.5 9 9.5-4.5L21.5 9 12 13.5z"/><path d="M6.5 11v5c1.5 1.6 3.4 2.4 5.5 2.4s4-.8 5.5-2.4v-5M21.5 9v5.5"/>', maSubor('data', 'mesta', 'skoly.json')],
  ['mestske-casti', 'Mestské časti', '<path d="M4 4.5h7v7H4zM13 4.5h7v4.5h-7zM13 11h7v8.5h-7zM4 13.5h7v6H4z"/>', !mesto.plne && mesto.slug === 'kosice'], // profily častí (src/lib/casti-mesta.ts)
  ['stvrte', 'Ktorá štvrť', '<path d="M3 20.5V11l5-3.5 5 3.5v9.5M13 20.5V7.5l4-3 4 3v13M2 20.5h20"/><path d="M6.5 14h3M15.5 11h3M15.5 14.5h3"/>', mesto.slug === 'bratislava' || mesto.slug === 'kosice' || castiOsm.includes(mesto.slug)],
  ['dane', 'Kam idú dane', '<circle cx="12" cy="12" r="8.5"/><path d="M15 8.6a4 4 0 1 0 0 6.8M7 10.8h6M7 13.2h6"/>', true],
  ['pribeh', '10 rokov v číslach', '<path d="M4 20V10M9.5 20V4M15 20v-7M20.5 20V8"/>', true],
  ['kviz', 'Kvíz', '<circle cx="12" cy="12" r="8.5"/><path d="M9.6 9.5a2.5 2.5 0 1 1 3.4 2.3c-.6.3-1 .8-1 1.5v.6M12 16.8v.2"/>', true],
];
const NASTROJE: [string, string, string][] = ['kviz', 'stvrte', 'dane', 'skoly', 'zastupitelstvo', 'novinky'].map((k) => { const x = NOVE.find((n) => n[0] === k)!; return [k, k === 'stvrte' ? 'Ktorá štvrť je pre mňa' : k === 'dane' ? 'Kam idú moje dane' : x[1], x[2]]; });
const NOVE_MENU = NOVE.filter((x) => x[3]).map(([h, n, i]) => [`/${mesto.slug}/${h}`, n, i] as [string, string, string]);
const spolocna = jeSpolocna(Astro.url.pathname.replace(/\/$/, '') || '/');
const zivaLista = !spolocna;
const ba = mesto.slug === 'bratislava';
const kotva = (h: string) => (ba ? h : `/${mesto.slug}#teraz`);
const rieka: any = (mesto as any).rieka_id;
// Mestá bez vlastných podstránok: menu so skokmi na sekcie prehľadu
const IKONA = Object.fromEntries(MENU_MESTA.map(([h, , i]) => [h, i]));
const PIN = '<path d="M12 21s-6.5-5.6-6.5-11a6.5 6.5 0 0 1 13 0c0 5.4-6.5 11-6.5 11Z"/><circle cx="12" cy="10" r="2.3"/>';
const MENU: [string, string, string][] = spolocna
  ? [...MESTA.filter((x) => x.aktivne).map((x) => [`/${x.slug}`, x.nazov, PIN] as [string, string, string]), ['/porovnanie', 'Porovnanie miest', IKONA['katalog']], ['/porovnaj', 'Porovnaj dve mestá', IKONA['mestske-casti']]]
  : mesto.plne
  ? [...MENU_MESTA.slice(0, -1).map(([h, n, i]) => [`/${mesto.slug}${h ? `/${h}` : ''}`, n, i] as [string, string, string]), ...NOVE_MENU, [`/${mesto.slug}/katalog`, 'Katalóg dát', MENU_MESTA.at(-1)![2]]]
  : [
      [`/${mesto.slug}`, 'Prehľad', IKONA['']],
      [`/${mesto.slug}#teraz`, 'Teraz', IKONA['prostredie']],
      [`/${mesto.slug}#obyvatelia`, 'Obyvatelia', IKONA['obyvatelia']],
      [`/${mesto.slug}/volby`, 'Voľby', IKONA['volby']],
      [`/${mesto.slug}#praca`, 'Práca a bývanie', IKONA['vybavenost']],
      [`/${mesto.slug}#stavby`, 'Čo sa stavia', IKONA['vystavba']],
      ...(maZivot(mesto.slug) ? [[`/${mesto.slug}/zivot`, 'Život v meste', IKONA['bezpecnost']] as [string, string, string]] : []),
      ...(maSamospravu(mesto.slug) ? [[`/${mesto.slug}/samosprava`, 'Samospráva', IKONA['financie']] as [string, string, string]] : []),
      ...(maMapu(mesto.slug) ? [[`/${mesto.slug}/mapa`, 'Mapa', IKONA['mapa']] as [string, string, string]] : []),
      [`/${mesto.slug}/adresa`, 'Moja adresa', IKONA['adresa']],
      ...((mesto as any).katalog ? [[`/${mesto.slug}/katalog`, 'Katalóg dát', IKONA['katalog']] as [string, string, string]] : []),
      ...NOVE_MENU,
      ['/porovnanie', 'Porovnanie', IKONA['mestske-casti']],
    ];
const OG = ['mestske-casti', 'vystavba', 'upozornenia', 'mapa', 'obyvatelia', 'volby', 'financie', 'doprava', 'vybavenost', 'prostredie', 'bezpecnost', 'katalog'];
const casti = Astro.url.pathname.split('/').filter(Boolean);
const sekcia = (casti[0] === mesto.slug ? casti[1] : casti[0]) ?? '';
// stránky mesta bez vlastného obrázka sekcie: fotka mesta (public/og/mesto-<slug>.jpg z fotiek Wikimedia Commons)
const ogMesta = !spolocna && sekcia && maSubor('public', 'og', `${sekcia}-${mesto.slug}.png`) ? `/og/${sekcia}-${mesto.slug}.png` : null;
const ogObrazok = new URL(ogMesta ?? (OG.includes(sekcia) ? `/og/${sekcia}.png` : !spolocna ? `/og/mesto-${mesto.slug}.jpg` : '/og/index.png'), Astro.site ?? 'https://mestovcislach.sk');
const adresa = new URL(Astro.url.pathname, Astro.site ?? 'https://mestovcislach.sk');
// na stránkach s mapou (vlastný ľavý panel) je bočné menu len pás ikon
const fotoPas = fotoPreStranku(Astro.url.pathname);
const uzkeBocne = /\/mapa\/?$/.test(Astro.url.pathname);
---
<!doctype html>
<html lang="sk" data-mesto={mesto.slug}>
  <head>
    <meta charset="utf-8" />
    <!-- režim, písmo a jazyk pred vykreslením (samostatný súbor kvôli CSP bez inline skriptov) -->
    <script is:inline src="/nastavenia.js"></script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="mestovčíslach" />
    {!Astro.url.pathname.startsWith('/404') && <link rel="canonical" href={adresa} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="mestovčíslach.sk" />
    <meta property="og:locale" content="sk_SK" />
    <meta property="og:title" content={title.replace(/ – mestovcislach\.sk$/, '')} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={adresa} />
    <meta property="og:image" content={ogObrazok} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="sitemap" href="/sitemap.xml" />
    {(Array.isArray(jsonld) ? jsonld : jsonld ? [jsonld] : []).map((j) => (
      <script is:inline type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', ...j }).replace(/</g, '\\u003c')} />
    ))}
  </head>
  <body data-mesto={spolocna ? undefined : mesto.slug} data-mesto-nazov={spolocna ? undefined : mesto.nazov}>
    <a class="preskocit" href="#obsah">Preskočiť na obsah</a>
    <header class="top">
      <div class="wrap hlava">
        <a class="logo" href="/" translate="no">mesto<span>v</span>číslach</a>
        <a class="mesto-volba mv-hlava" href="/" title="Vybrať iné mesto">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21s-6.5-5.6-6.5-11a6.5 6.5 0 0 1 13 0c0 5.4-6.5 11-6.5 11Z"/><circle cx="12" cy="10" r="2.3"/></svg>
          <span translate="no">{spolocna ? 'Vybrať mesto' : mesto.nazov}</span>
          <svg class="sipka" viewBox="0 0 24 24" aria-hidden="true"><path d="m7 10 5 5 5-5"/></svg>
        </a>

        <Hladanie />
        <div class="hlava-akcie">
          {!spolocna && <a class="zvoncek" href={`/${mesto.slug}/upozornenia`} title="Upozornenia pre vašu mestskú časť" aria-label="Upozornenia"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 16V11a6 6 0 1 1 12 0v5l1.5 2h-15z"/><path d="M10 20.5a2 2 0 0 0 4 0"/></svg></a>}
          <Jazyk />
          <Zobrazenie />
        </div>
      </div>
      <nav class="menu" aria-label="Hlavné menu">
        <div class="wrap menu-pas">
          <a class="mesto-volba mv-pas" href="/" title="Vybrať iné mesto">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21s-6.5-5.6-6.5-11a6.5 6.5 0 0 1 13 0c0 5.4-6.5 11-6.5 11Z"/><circle cx="12" cy="10" r="2.3"/></svg>
            <span translate="no">{spolocna ? 'Vybrať mesto' : mesto.nazov}</span>
            <svg class="sipka" viewBox="0 0 24 24" aria-hidden="true"><path d="m7 10 5 5 5-5"/></svg>
          </a>
          {MENU.map(([href, text, ikona]) => {
            const aktivne = href === `/${mesto.slug}` ? Astro.url.pathname.replace(/\/$/, '') === href : Astro.url.pathname.replace(/\/$/, '') === href || Astro.url.pathname.startsWith(href + '/');
            return (
              <a href={href} aria-current={aktivne ? 'page' : undefined} class={href.endsWith('/mapa') ? 'menu-mapa' : undefined}>
                <svg viewBox="0 0 24 24" aria-hidden="true" set:html={ikona} />
                <span>{text}</span>
              </a>
            );
          })}
        </div>
      </nav>
      <nav class="mesta-pas" aria-label="Mestá">
        <div class="mp-obsah">
          {MESTA.filter((x) => x.aktivne).map((x) => (
            <a href={`/${x.slug}`} aria-current={!spolocna && x.slug === mesto.slug ? 'true' : undefined} translate="no">{x.nazov.includes(' ') ? <><span class="mp-dlhe">{x.nazov}</span><span class="mp-kratke" aria-hidden="true">{x.nazov.replace(/^(\S)\S*\s/, '$1. ')}</span></> : x.nazov}</a>
          ))}
          <span class="mp-oddel" aria-hidden="true"></span>
          <a href="/porovnanie" aria-current={Astro.url.pathname.startsWith('/porovnanie') ? 'page' : undefined}>Porovnanie miest</a>
        </div>
      </nav>
    </header>
    <div class="preklad-pruh" id="preklad-pruh" translate="no" hidden><div class="wrap"><span class="pp-text"></span> <button type="button" lang="sk">Slovenská verzia</button></div></div>
    {zivaLista && <div class="zive" role="region" aria-label={`Živé údaje – ${mesto.nazov}`} data-mesto={mesto.slug} data-stred={JSON.stringify(mesto.stred)} data-rieka={rieka ?? ''}>
      <div class="wrap zive-obsah">
        <span class="zive-titul"><i></i>Teraz</span>
        <span class="chip" id="z-pocasie" title={`Počasie – ${mesto.nazov} (Open-Meteo)`}>…</span>
        <a class="chip" id="z-vystrahy" href={ba ? '/bratislava#dnes' : `/${mesto.slug}#teraz`} title="Výstrahy SHMÚ">Výstrahy …</a>
        <a class="chip" id="z-ovzdusie" href={kotva('/bratislava/prostredie#ovzdusie-teraz')} title="Index kvality ovzdušia zo staníc SHMÚ">Ovzdušie …</a>
        {rieka && <a class="chip" id="z-dunaj" href={kotva('/bratislava/prostredie#dunaj')} title="Vodný stav (SHMÚ)">{ba ? 'Dunaj' : 'Rieka'} …</a>}
        {ba && <a class="chip" id="z-morava" href="/bratislava/prostredie#morava" title="Vodný stav Moravy v Devínskej Novej Vsi (SHMÚ)" hidden></a>}
        {ba && <a class="chip" id="z-cesty" href="/bratislava/doprava#naozivo" title="Uzávierky a poruchy na cestách (hlavné mesto)">Cesty …</a>}
      </div>
    </div>}
    <div class={`telo${uzkeBocne ? ' uzke' : ''}`}>
      {spolocna && <aside class="bocne" aria-label="Rozcestník"><Rozcestnik rezim="bocne" nastroje={NASTROJE} /></aside>}
      {!spolocna && (
        <nav class="bocne" aria-label={`Sekcie – ${mesto.nazov}`}>
          <p class="bocne-mesto" translate="no">{mesto.nazov}</p>
          <ul>
            {MENU.filter(([href]) => href !== '/porovnanie').map(([href, text, ikona]) => {
              const aktivne = href === `/${mesto.slug}` ? Astro.url.pathname.replace(/\/$/, '') === href : Astro.url.pathname.replace(/\/$/, '') === href || Astro.url.pathname.startsWith(href + '/');
              return (
                <li><a href={href} aria-current={aktivne ? 'page' : undefined} class={href.endsWith('/mapa') ? 'menu-mapa' : undefined} title={uzkeBocne ? text : undefined}>
                  <svg viewBox="0 0 24 24" aria-hidden="true" set:html={ikona} />
                  <span>{text}</span>
                </a></li>
              );
            })}
          </ul>
        </nav>
      )}
      <main class="wrap" id="obsah" tabindex="-1">
        {!spolocna && fotoPas && <FotoPas kluc={fotoPas.kluc} popis={`${fotoPas.popis} – ${mesto.nazov}`} />}
        <slot />
      </main>
    </div>
    <footer class="wrap foot">
      <p>
        mestovcislach.sk zbiera verejne dostupné otvorené dáta. Pri každom údaji je uvedený zdroj.
        Kód je otvorený na <a href="https://github.com/karolgajdosik/mestovcislach">GitHube</a>. Všetky datasety mesta a čo s nimi robíme: <a href="/bratislava/katalog">Katalóg dát</a>.
        Živá lišta: počasie <a href="https://open-meteo.com">Open-Meteo</a> (CC BY 4.0), výstrahy, ovzdušie a Dunaj <a href="https://www.shmu.sk">SHMÚ</a>, cesty hlavné mesto SR Bratislava.
      </p>
      <p class="foot-odkazy">{!spolocna && <><a href={`/${mesto.slug}/upozornenia`}>Upozornenia</a> · </>}<a href="/porovnanie">Porovnanie miest</a> · <a href="/sukromie">Ochrana súkromia</a> · <a href="/pristupnost">Prístupnosť</a> · Bez cookies a sledovania · <a href="mailto:info@mestovcislach.sk">info@mestovcislach.sk</a></p>
    </footer>
    <Asistent mesto={spolocna ? undefined : mesto} />
    {/* Mobil a tablet (do 1099 px): dolná lišta + celoobrazovkové menu namiesto posúvacieho pásu */}
    <nav class="dolna-lista" aria-label="Rýchla navigácia">
      {(spolocna
        ? [['/', 'Mestá', PIN], ['/porovnanie', 'Porovnanie', IKONA['mestske-casti']]]
        : [[`/${mesto.slug}/kviz`, 'Kvíz', NOVE.find((x) => x[0] === 'kviz')![2]], ...(maMapu(mesto.slug) || mesto.plne ? [[`/${mesto.slug}/mapa`, 'Mapa', IKONA['mapa']]] : []), [`/${mesto.slug}/adresa`, 'Pri mne', IKONA['adresa']]]
      ).map(([href, text, ikona]) => {
        const akt = href === '/' ? Astro.url.pathname === '/' : Astro.url.pathname.replace(/\/$/, '') === href;
        return <a href={href} aria-current={akt ? 'page' : undefined}><svg viewBox="0 0 24 24" aria-hidden="true" set:html={ikona} /><span>{text}</span></a>;
      })}
      <button type="button" class="dl-asistent" aria-label="AI asistent"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 5.5h16v10H9l-5 4v-14Z"/><path d="M8.5 10.5h.01M12 10.5h.01M15.5 10.5h.01"/></svg><span>Asistent</span></button>
      <button type="button" class="dl-menu" aria-haspopup="dialog" aria-controls="menu-plne"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg><span>Menu</span></button>
    </nav>
    <dialog class="menu-plne" id="menu-plne" aria-label="Menu">
      <div class="mp-hlava">
        <strong translate="no">{spolocna ? 'mestovčíslach.sk' : mesto.nazov}</strong>
        <button type="button" class="mp-zavriet" aria-label="Zavrieť menu"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg></button>
      </div>
      {!spolocna && (
        <ul class="mp-sekcie">
          {MENU.filter(([href]) => href !== '/porovnanie').map(([href, text, ikona]) => {
            const akt = href === `/${mesto.slug}` ? Astro.url.pathname.replace(/\/$/, '') === href : Astro.url.pathname.replace(/\/$/, '') === href || Astro.url.pathname.startsWith(href + '/');
            return <li><a href={href} aria-current={akt ? 'page' : undefined} class={href.endsWith('/mapa') ? 'menu-mapa' : undefined}><svg viewBox="0 0 24 24" aria-hidden="true" set:html={ikona} /><span>{text}</span></a></li>;
          })}
        </ul>
      )}
      {spolocna ? <Rozcestnik rezim="menu" nastroje={NASTROJE} /> : (
        <>
          <p class="mp-nadpis">Iné mesto</p>
          <ul class="mp-mesta">
            {MESTA.filter((x) => x.aktivne).map((x) => <li><a href={`/${x.slug}`} aria-current={x.slug === mesto.slug ? 'true' : undefined} translate="no">{x.nazov}</a></li>)}
          </ul>
          <p class="mp-dalsie"><a href="/porovnanie">Porovnanie miest</a> · <a href={`/${mesto.slug}/upozornenia`}>Upozornenia</a> · <a href="/sukromie">Ochrana súkromia</a></p>
        </>
      )}
    </dialog>
  </body>
</html>

<script>
  import { grafyNaVlozenie } from '../scripts/vlozit';
  grafyNaVlozenie();

  // inštalácia ako aplikácia a stránky aj bez internetu (public/sw.js) – nie v náhľade a vo vloženom grafe
  if ('serviceWorker' in navigator && location.hostname === 'mestovcislach.sk' && !document.documentElement.hasAttribute('data-vlozit')) {
    addEventListener('load', () => navigator.serviceWorker.register('/sw.js').catch(() => {}));
  }

  // dolná lišta na mobile: celoobrazovkové menu a otvorenie asistenta
  {
    const menu = document.getElementById('menu-plne') as HTMLDialogElement | null;
    document.querySelector('.dl-menu')?.addEventListener('click', () => menu?.showModal());
    menu?.querySelector('.mp-zavriet')?.addEventListener('click', () => menu.close());
    menu?.addEventListener('click', (e) => { if (e.target === menu) menu.close(); });
    // odkazy zatvoria menu (okrem dlaždíc rozcestníka, ktoré najprv ukážu výber mesta – href „#…“)
    menu?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => { if (!a.getAttribute('href')?.startsWith('#')) menu.close(); }));
    // naposledy otvorené mesto pre rozcestník (len v tomto prehliadači)
    const tm = document.body.dataset.mesto;
    if (tm) { try { localStorage.setItem('mesto-posledne', JSON.stringify({ slug: tm, nazov: document.body.dataset.mestoNazov })); } catch { /* bez úložiska */ } }
    document.querySelector('.dl-asistent')?.addEventListener('click', () => (document.getElementById('ai-otvor') as HTMLButtonElement | null)?.click());
  }

  // bočné menu (široké obrazovky): pri skokoch na sekcie prehľadu (#teraz, #volby…) zvýrazní sekciu, ktorá je práve na obrazovke
  {
    const odkazy = [...document.querySelectorAll<HTMLAnchorElement>('.bocne a[href*="#"]')];
    const sekcie = odkazy.map((a) => document.getElementById(a.hash.slice(1))).filter(Boolean) as HTMLElement[];
    const prehlad = document.querySelector<HTMLAnchorElement>(`.bocne a[href="${location.pathname.replace(/\/$/, '')}"]`);
    if (sekcie.length && prehlad) {
      const nastav = (a: HTMLAnchorElement | null) => {
        document.querySelectorAll('.bocne a[aria-current]').forEach((x) => x.removeAttribute('aria-current'));
        (a ?? prehlad).setAttribute('aria-current', 'page');
      };
      const viditelne = new Map<Element, boolean>();
      const io = new IntersectionObserver((zaznamy) => {
        zaznamy.forEach((z) => viditelne.set(z.target, z.isIntersecting));
        const prva = sekcie.find((s) => viditelne.get(s));
        nastav(prva ? odkazy.find((a) => a.hash === '#' + prva.id) ?? null : null);
      }, { rootMargin: '-140px 0px -55% 0px' });
      sekcie.forEach((s) => io.observe(s));
    }
  }
  // aktívna položka menu do stredu pásu – vpravo od prilepeného výberu mesta (mobil)
  {
    const pas = document.querySelector<HTMLElement>('.menu-pas');
    const akt = pas?.querySelector<HTMLElement>('a[aria-current="page"]');
    if (pas && akt && pas.scrollWidth > pas.clientWidth) {
      const vyber = pas.querySelector<HTMLElement>('.mv-pas');
      const lavo = vyber && getComputedStyle(vyber).position === 'sticky' ? vyber.offsetWidth + 14 : 0;
      pas.scrollLeft = akt.offsetLeft - pas.offsetLeft - lavo - (pas.clientWidth - lavo - akt.offsetWidth) / 2;
    }
  }

  // Prístupnosť: mapy ako pomenované oblasti, posúvateľné tabuľky dostupné z klávesnice (aj pre neskôr pridaný obsah)
  const pristupnost = () => {
    document.querySelectorAll<HTMLElement>('.leaflet-container:not([role="region"])').forEach((m) => {
      m.setAttribute('role', 'region');
      if (!m.hasAttribute('aria-label')) m.setAttribute('aria-label', 'Mapa – posun šípkami, priblíženie klávesmi + a −');
    });
    document.querySelectorAll<HTMLElement>('.tabulka-obal:not([tabindex])').forEach((t) => {
      if (t.scrollWidth <= t.clientWidth + 2 && t.scrollHeight <= t.clientHeight + 2) return;
      t.tabIndex = 0;
      t.setAttribute('role', 'region');
      const nadpis = t.closest('section, .card')?.querySelector('h2, h3')?.textContent?.trim();
      t.setAttribute('aria-label', `${nadpis ?? 'Tabuľka'} – posúvateľná tabuľka`);
    });
  };
  let a11yCasovac = 0;
  const a11yNeskor = () => { clearTimeout(a11yCasovac); a11yCasovac = window.setTimeout(pristupnost, 200); };
  addEventListener('load', pristupnost);
  // skok na sekciu (#teraz z dolnej lišty): grafy a obrázky nad ňou sa dokreslia neskôr, preto po načítaní dorovnať
  addEventListener('load', () => {
    const h = decodeURIComponent(location.hash.slice(1));
    const ciel = h && document.getElementById(h);
    if (ciel) setTimeout(() => ciel.scrollIntoView({ block: 'start' }), 150);
  });
  addEventListener('resize', a11yNeskor);
  // prepínače (napr. ročník volieb) odkryjú skryté tabuľky – po kliknutí skontrolovať znova
  document.addEventListener('click', a11yNeskor);
  new MutationObserver(a11yNeskor).observe(document.body, { childList: true, subtree: true });

  import { pocasie, vystrahy, dunaj, cesty, stupenDunaja, javVystrahy, ovzdusie, farbaOvzdusia } from '../scripts/zive';
  const chip = (id: string, html: string, stav = '') => {
    const el = document.getElementById(id);
    if (!el) return;
    el.innerHTML = html;
    if (stav) el.dataset.stav = stav;
  };
  const sipka = (t: string) => (t === 'stúpa' ? ' ↑' : t === 'klesá' ? ' ↓' : '');
  // živá lišta – údaje mesta podľa atribútov lišty
  const lista = document.querySelector<HTMLElement>('.zive');
  if (lista) {
    const zMesto = lista.dataset.mesto ?? 'bratislava';
    const zStred = JSON.parse(lista.dataset.stred ?? '[48.1486,17.1077]');
    const zRieka = lista.dataset.rieka ?? '';
    pocasie(zStred).then((p) => chip('z-pocasie', `<b>${p.teplota} °C</b> ${p.stav} <small>${p.min}/${p.max} °C</small>`))
      .catch(() => document.getElementById('z-pocasie')?.remove());
    vystrahy(zMesto).then((d) => {
      const v = d.vystrahy ?? [];
      if (!v.length) return chip('z-vystrahy', 'Výstrahy: <b>žiadne</b>', 'ok');
      const naj = v[0];
      const javy = [...new Set(v.map((x: any) => javVystrahy(x.udalost)))];
      chip('z-vystrahy', `Výstraha: <b>${javy.join(', ')}</b> · ${naj.stupen}`, naj.farba);
    }).catch(() => chip('z-vystrahy', 'Výstrahy: –'));
    if (zRieka) dunaj(zRieka).then((d) => {
      const s = stupenDunaja(d);
      chip('z-dunaj', `${zRieka === 'dunaj' ? 'Dunaj' : d.stanica.split('–').pop().trim()} <b>${d.stav} cm</b>${sipka(d.trend)}${s ? ` · ${s}. stupeň` : ''}`, s === 3 ? 'red' : s === 2 ? 'orange' : s === 1 ? 'yellow' : 'ok');
    }).catch(() => chip('z-dunaj', 'Rieka: –'));
    // Morava sa v lište ukáže len pri povodňovej aktivite
    if (zMesto === 'bratislava') fetch('/api/dunaj?rieka=morava').then((r) => (r.ok ? r.json() : Promise.reject())).then((d) => {
      const s = [3, 2, 1].find((k) => d.spa?.[k] && d.stav >= d.spa[k]);
      if (!s) return;
      const e = document.getElementById('z-morava');
      if (e) e.hidden = false;
      chip('z-morava', `Morava <b>${d.stav} cm</b>${sipka(d.trend)} · ${s}. stupeň`, s === 3 ? 'red' : s === 2 ? 'orange' : 'yellow');
    }).catch(() => {});
    ovzdusie(zMesto).then((d) => {
      if (!d.mesto) return chip('z-ovzdusie', 'Ovzdušie: –');
      chip('z-ovzdusie', `Ovzdušie: <b>${d.mesto.kategoria.nazov}</b>`, farbaOvzdusia(d.mesto.kategoria.stupen));
    }).catch(() => chip('z-ovzdusie', 'Ovzdušie: –'));
    if (zMesto === 'bratislava') cesty().then((c) => chip('z-cesty', `Cesty: <b>${c.uzavierky}</b> uzávierok${c.uplne ? ` (${c.uplne} úplných)` : ''} · <b>${c.poruchy}</b> porúch`, c.uplne ? 'orange' : ''))
      .catch(() => chip('z-cesty', 'Cesty: –'));
  }
</script>

<style is:global>
  [hidden] { display: none !important; }
  /* Prístupnosť: viditeľné zameranie pri ovládaní klávesnicou, odkaz na preskočenie navigácie */
  :focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  main:focus { outline: none; }
  .preskocit { position: absolute; left: 8px; top: -60px; z-index: 2000; padding: 10px 16px; border-radius: 8px; background: var(--text); color: var(--card); font-weight: 700; text-decoration: none; }
  .preskocit:focus { top: 8px; }
  /* popis zdrojov na mapách v tmavom režime (kontrast) */
  :root[data-tema="tmava"] .leaflet-container .leaflet-control-attribution { background: rgb(27 30 35 / 0.88); color: #c9ced6; }
  :root[data-tema="tmava"] .leaflet-container .leaflet-control-attribution a { color: #8ccbff; }
  /* kým beží prvý strojový preklad, obsah je stlmený */
  html.prekladam main { opacity: 0.35; transition: opacity 0.2s; }
  .preklad-pruh { background: var(--accent-soft); border-bottom: 1px solid var(--line); font-size: 0.8rem; color: var(--text); }
  .preklad-pruh .wrap { display: flex; flex-wrap: wrap; gap: 4px 10px; align-items: center; padding-top: 6px; padding-bottom: 6px; }
  .preklad-pruh button { border: 0; background: none; padding: 0; color: var(--accent); font: inherit; font-weight: 600; text-decoration: underline; cursor: pointer; }
  :root {
    --bg: #f7f7f5;
    --card: #ffffff;
    --text: #1b1d21;
    --muted: #5d636e;
    --line: #e3e4e0;
    --accent: #c8102e;
    --accent-soft: #c8102e1a;
    --na-akcente: #ffffff; /* text na pozadí v akcentovej farbe */
    --font: system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
  }
  /* Tmavý režim: data-tema nastavuje skript v <head> podľa voľby používateľa alebo systému */
  :root[data-tema="tmava"] {
    color-scheme: dark;
    --bg: #121417;
    --card: #1b1e23;
    --text: #eceef1;
    --muted: #9aa1ad;
    --line: #2c3037;
    --accent: #ff4d63;
    --accent-soft: #ff4d6326;
    --na-akcente: #16181c;
  }
  /* Režim pre slabozrakých: vysoký kontrast, výraznejšie okraje a odkazy, väčšie riadkovanie, bez animácií */
  :root[data-slabozraky] {
    --bg: #ffffff; --card: #ffffff; --text: #000000; --muted: #262626; --line: #6b6b6b; --accent: #a3001b; --accent-soft: #a3001b22;
  }
  :root[data-slabozraky][data-tema="tmava"] {
    --bg: #000000; --card: #0a0a0a; --text: #ffffff; --muted: #ececec; --line: #9a9a9a; --accent: #ff8a9a; --accent-soft: #ff8a9a33; --na-akcente: #000000;
  }
  /* biely text na svetlom akcente by bol nečitateľný */
  /* text na akcente rieši token --na-akcente */
  :root[data-slabozraky] body { line-height: 1.7; letter-spacing: 0.01em; }
  :root[data-slabozraky] a { text-decoration: underline; text-underline-offset: 3px; text-decoration-thickness: 2px; }
  :root[data-slabozraky] :focus-visible { outline: 3px solid var(--accent) !important; outline-offset: 3px; }
  :root[data-slabozraky] .card { border-width: 2px; }
  :root[data-slabozraky] *, :root[data-slabozraky] *::before, :root[data-slabozraky] *::after { animation: none !important; transition: none !important; }
  * { box-sizing: border-box; }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--text);
    font: 1rem/1.55 var(--font);
    -webkit-font-smoothing: antialiased;
  }
  a { color: inherit; text-underline-offset: 3px; }
  .wrap { max-width: 1040px; margin: 0 auto; padding: 0 16px; }
  /* Hlavička a živá lišta ostávajú navrchu aj pri rolovaní (nad mapami Leaflet, ktoré majú z-index do 1000). */
  html { scroll-padding-top: 108px; }
  /* Hlavička: riadok s logom, vyhľadávaním a nastaveniami + pás hlavného menu s ikonami */
  :root { --vyska-hlavicky: 112px; }
  .top { background: var(--card); position: sticky; top: 0; z-index: 1100; box-shadow: 0 1px 0 var(--line); }
  .hlava { display: flex; align-items: center; gap: 12px; height: 60px; }
  .logo { font-weight: 800; font-size: 1.2rem; text-decoration: none; letter-spacing: -0.02em; flex-shrink: 0; color: var(--text); }
  .logo span { color: var(--accent); }
  .hlava-akcie { display: flex; align-items: center; margin-left: auto; flex-shrink: 0; }
  .zvoncek { display: flex; align-items: center; justify-content: center; width: 36px; height: 36px; margin-right: 6px; border: 1px solid var(--line); border-radius: 18px; background: var(--bg); color: var(--muted); }
  .zvoncek:hover { border-color: var(--muted); color: var(--text); }
  .zvoncek svg { width: 18px; height: 18px; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
  .menu { border-top: 1px solid var(--line); background: var(--card); }
  /* pás menu môže byť širší ako obsah stránky, aby sa všetky sekcie zmestili */
  .top .hlava { max-width: 1300px; }
  .menu .menu-pas { max-width: 1380px; }
  .menu-pas { display: flex; gap: 2px; height: 52px; align-items: center; overflow-x: auto; scrollbar-width: none; scroll-snap-type: x proximity; scroll-padding: 0 16px; }
  .menu-pas::-webkit-scrollbar { display: none; }
  .menu a {
    display: inline-flex; align-items: center; gap: 5px; flex-shrink: 0; height: 38px; padding: 0 9px 0 7px; border-radius: 19px;
    color: var(--text); text-decoration: none; font-size: 0.9rem; font-weight: 600; white-space: nowrap; scroll-snap-align: start;
    transition: background 0.15s, color 0.15s;
  }
  .menu a svg { width: 19px; height: 19px; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; color: var(--accent); flex-shrink: 0; }
  .menu a:hover { background: color-mix(in srgb, var(--accent) 9%, transparent); }
  /* Mapa – najpraktickejšia časť webu, preto zvýraznená */
  .menu a.menu-mapa { color: var(--accent); background: color-mix(in srgb, var(--accent) 9%, transparent); box-shadow: inset 0 0 0 1.5px var(--accent); padding: 0 12px 0 9px; }
  .menu a.menu-mapa:hover { background: color-mix(in srgb, var(--accent) 16%, transparent); }
  .menu a[aria-current='page'] { background: var(--text); color: var(--card); }
  .menu a[aria-current='page'] svg { color: var(--card); }
  .mesto-volba { display: inline-flex; align-items: center; gap: 5px; flex-shrink: 0; height: 36px; padding: 0 10px 0 9px; border: 1.5px solid var(--line); border-radius: 18px; color: var(--text); text-decoration: none; font-weight: 800; font-size: 0.92rem; background: var(--bg); }
  .mesto-volba:hover { border-color: var(--accent); }
  .mesto-volba svg { width: 18px; height: 18px; fill: none; stroke: var(--accent); stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
  .mesto-volba .sipka { width: 15px; height: 15px; stroke: var(--muted); margin-left: -2px; }
  .mv-hlava { margin-left: 12px; }
  .menu a.mv-pas { display: none; margin-right: 6px; }
  @media (max-width: 760px) {
    .mv-hlava { display: none; }
    /* výber mesta ostáva prilepený vľavo, aj keď sa pás menu posúva */
    .menu a.mv-pas { display: inline-flex; position: sticky; left: 0; z-index: 2; margin-right: 8px; background: var(--bg);
      box-shadow: 0 0 0 6px var(--card), -18px 0 0 6px var(--card), 12px 0 10px 2px var(--card); }
    .menu a.mv-pas:hover { background: var(--bg); }
    .menu-pas { scroll-padding-left: 140px; -webkit-mask-image: linear-gradient(to right, #000 calc(100% - 28px), transparent) !important; mask-image: linear-gradient(to right, #000 calc(100% - 28px), transparent) !important; }
  }
  @media (min-width: 1300px) { .menu-pas { justify-content: space-between; } }
  @media (max-width: 1299px) {
    /* posúvateľný pás – okraje sa jemne strácajú */
    .menu-pas { -webkit-mask-image: linear-gradient(to right, transparent, #000 16px, #000 calc(100% - 28px), transparent); mask-image: linear-gradient(to right, transparent, #000 16px, #000 calc(100% - 28px), transparent); }
  }
  @media (max-width: 600px) {
    :root { --vyska-hlavicky: 104px; }
    .hlava { height: 56px; gap: 8px; }
    .logo { font-size: 1.05rem; }
    .hlava-akcie { margin-left: 0; }
    .menu-pas { height: 48px; }
    .menu a { height: 36px; font-size: 0.88rem; padding: 0 12px 0 10px; }
  }
  @media (max-width: 360px) {
    .hlava { gap: 6px; }
    .logo { font-size: 0.95rem; }
  }
  @media (prefers-reduced-motion: reduce) { .menu a { transition: none; } }
  /* ---------- Mobil a tablet: dolná lišta a celoobrazovkové menu ---------- */
  .dolna-lista, .menu-plne:not([open]) { display: none; }
  @media (max-width: 1099px) {
    :root { --vyska-hlavicky: 200px; } /* hlavička 60 px + mestá 76 px + dolná lišta 64 px – pre výšku máp */
    html { scroll-padding-top: 146px; --skok-okraj: 0px; } /* hlavička 135 px; sekcie s vlastným scroll-margin by inak skočili príliš nízko */
    .top .menu { display: none; }
    /* všetkých 8 miest stále na očiach: mriežka 4 × 2 pod logom */
    .top .mesta-pas { display: block; border-top: 1px solid var(--line); background: var(--card); }
    .mp-obsah { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 4px; padding: 6px 12px 8px; max-width: 760px; margin: 0 auto; }
    .mesta-pas a { display: flex; align-items: center; justify-content: center; height: 30px; padding: 0 4px; border-radius: 15px; text-decoration: none; color: var(--text); font-weight: 600; font-size: 0.82rem; white-space: nowrap; overflow: hidden; background: var(--bg); border: 1px solid var(--line); }
    .mesta-pas a[aria-current] { background: var(--text); color: var(--card); border-color: var(--text); }
    .mesta-pas .mp-oddel, .mesta-pas a[href='/porovnanie'] { display: none; }
  }
  .mp-kratke { display: none; }
  @media (max-width: 599px) {
    .mesta-pas a { position: relative; }
    .mp-kratke { display: inline; }
    .mp-dlhe { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  }
  @media (max-width: 1099px) {
    body { padding-bottom: calc(64px + env(safe-area-inset-bottom)); }
    .dolna-lista {
      display: flex; position: fixed; left: 0; right: 0; bottom: 0; z-index: 1150; height: calc(64px + env(safe-area-inset-bottom));
      padding: 0 4px env(safe-area-inset-bottom); background: var(--card); border-top: 1px solid var(--line); box-shadow: 0 -4px 16px #0000000f;
    }
